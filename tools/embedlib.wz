// embedlib.wz -- writes the standard library into a source file the compiler carries.
//
// A downloaded compiler is one file, and one file has no lib/ beside it, so
// include "io.wz" fails for anyone who did not clone the repository. This program
// turns lib/*.wz into Wantzel source that fills a table at startup; the compiler falls
// back to that table when a bare library name is not found on disk.
//
//   embedlib <output.wz> <name> <file> [<name> <file> ...]
//
// The caller lists the files, so what the library IS stays in build.sh rather than
// being discovered here. Regenerating is part of the build, and
// tests/toolchain/embedded_lib_current.sh fails if the generated file is stale.
//
// The sources go in as string literals rather than as bytes: a literal is limited to
// 4095 bytes so they are emitted in chunks, but the result is compact and compiles in
// milliseconds. Four bytes need escaping on the way in, and getting that wrong is the
// one way this can silently produce a library that differs from lib/ -- which is why
// the test compares byte for byte rather than trusting the generator.

program embedlib;

include "io.wz";

const
  MAXSRC = 1048576;      // one library file
  MAXOUT = 8388608;      // the generated source
  CHUNK  = 1400;         // bytes per literal, well under the 4095 limit after escaping

var
  out: array[0..MAXOUT - 1] of char;
  outlen: int;
  buf: array[0..MAXSRC - 1] of char;
  buflen: int;
  name: array[0..255] of char;
  namelen: int;
  path: array[0..1023] of char;
  a, i, fd, n, pa, nfiles, total: int;

procedure put(s: str);
begin
  outlen := io.push(out, outlen, s);
end;

procedure putn(v: int);
var d: array[0..31] of char; m, k: int;
begin
  if v = 0 then begin out[outlen] := '0'; outlen := outlen + 1; return; end;
  m := 0;
  while v > 0 do begin d[m] := chr(48 + (v mod 10)); v := v div 10; m := m + 1; end;
  k := m - 1;
  while k >= 0 do begin out[outlen] := d[k]; outlen := outlen + 1; k := k - 1; end;
end;

function argstr(a: int; dst: array of char): int;
var j: int;
begin
  j := 0;
  while argch(a, j) <> chr(0) do begin dst[j] := argch(a, j); j := j + 1; end;
  dst[j] := chr(0);
  return j;
end;

// One byte, escaped so it survives being read back as a string literal.
//
// The two characters are written separately on purpose: put("\n") would emit a real
// newline, and what belongs in the generated source is the backslash and the letter.
// Writing a generator that writes escapes is where this is easy to get wrong, which is
// why the test compares the result against lib/ byte for byte.
procedure putesc(c: char);
begin
  if (c = chr(92)) or (c = chr(34)) or (c = chr(10)) or (c = chr(9)) then
  begin
    out[outlen] := chr(92); outlen := outlen + 1;
    if c = chr(10) then out[outlen] := 'n'
    else if c = chr(9) then out[outlen] := 't'
    else out[outlen] := c;
    outlen := outlen + 1;
  end
  else begin out[outlen] := c; outlen := outlen + 1; end;
end;

// A literal holding bytes [from, to) of buf, as one emb.add call.
procedure putchunk(from: int; upto: int);
var j: int;
begin
  put("  emb.add(\"");
  j := from;
  while j < upto do begin putesc(buf[j]); j := j + 1; end;
  put("\");\n");
end;

begin
  if (argc() < 4) or ((argc() - 2) mod 2 <> 0) then
  begin
    io.puts(STDERR, "usage: embedlib <output.wz> <name> <file> [<name> <file> ...]\n");
    halt(1);
  end;

  outlen := 0;
  put("// Generated by tools/embedlib.wz -- do not edit by hand.\n");
  put("//\n");
  put("// The standard library, carried inside the compiler so that a binary which was\n");
  put("// downloaded rather than built can still resolve include \"io.wz\". A file on\n");
  put("// disk still wins: this is the fallback, not the source of truth.\n");
  put("//\n");
  put("// build.sh regenerates this; tests/toolchain/embedded_lib_current.sh fails when\n");
  put("// it no longer matches lib/.\n\n");

  put("procedure emb.fill;\nbegin\n");

  a := 2;
  nfiles := 0;
  total := 0;
  while a < argc() do
  begin
    namelen := argstr(a, name);
    i := argstr(a + 1, path);

    pa := addr(path);
    fd := sys3(SYS.open, pa, 0, 0);
    if fd < 0 then
    begin
      io.puts(STDERR, "embedlib: cannot read ");
      io.puts(STDERR, "a file named on the command line\n");
      halt(1);
    end;
    buflen := 0;
    while true do
    begin
      pa := addr(buf[buflen]);
      n := io.read(fd, pa, 65536);
      if n <= 0 then break;
      buflen := buflen + n;
      if buflen + 65536 > MAXSRC then
      begin
        io.puts(STDERR, "embedlib: a library file is too large\n");
        halt(1);
      end;
    end;
    i := sys1(SYS.close, fd);

    put("  emb.begin(\"");
    i := 0;
    while i < namelen do begin putesc(name[i]); i := i + 1; end;
    put("\");\n");

    i := 0;
    while i < buflen do
    begin
      if i + CHUNK < buflen then putchunk(i, i + CHUNK)
      else putchunk(i, buflen);
      i := i + CHUNK;
    end;

    put("  emb.done;\n");
    nfiles := nfiles + 1;
    total := total + buflen;
    a := a + 2;
  end;

  put("end;\n");

  i := argstr(1, path);
  pa := addr(path);
  fd := sys3(SYS.open, pa, 577, 420);
  if fd < 0 then begin io.puts(STDERR, "embedlib: cannot write the output\n"); halt(1); end;
  pa := addr(out);
  if io.write(fd, pa, outlen) <> outlen then
  begin
    io.puts(STDERR, "embedlib: short write\n");
    halt(1);
  end;
  i := sys1(SYS.close, fd);

  io.puts(STDOUT, "embedlib: ");
  io.putn(STDOUT, nfiles);
  io.puts(STDOUT, " files, ");
  io.putn(STDOUT, total);
  io.puts(STDOUT, " bytes\n");
end.
