// mcpfiles.wz -- an MCP server that lets a model look around a directory.
//
//   mcpfiles /path/to/project          speak MCP over stdin/stdout
//   mcpfiles /path/to/project 8080     the same over HTTP on that port
//
// Read-only and sandboxed: every path is resolved inside the given root, and
// anything that starts with "/" or contains ".." is refused.  Searching uses
// the SIMD scan, so it walks a tree at roughly memchr speed.
//
// The four tools are declared in one `tools` block; the compiler generates the
// tools/list text, the argument parsers, the dispatch and the result writers,
// and this program only writes the handlers (tool.<name>).


include "mcphttp.wz";
include "fs.wz";

const
  MAXPATH  = 4096;
  FILEBUF  = 4194304;       // largest file read or searched: 4 MB
  QUEUEBUF = 1048576;
  MAXQUEUE = 8192;
  MAXLINE  = 300;

type ListDirArgs = schema
  path: text[MAXPATH]? "path relative to the root";
end;

type ListDirResult = schema
  text: text "the directory listing, one entry per line";
end;

type ReadFileArgs = schema
  path:   text[MAXPATH] "path relative to the root";
  offset: int? "byte offset to start at";
  limit:  int? "how many bytes to return, at most 262144";
end;

type ReadFileResult = schema
  text: text "the file contents";
end;

type FileInfoArgs = schema
  path: text[MAXPATH] "path relative to the root";
end;

type FileInfoResult = schema
  text: text "size, kind and modification time";
end;

type SearchArgs = schema
  query: text[255] "the literal text to look for";
  path:  text[MAXPATH]? "directory to search, relative to the root; defaults to the root";
  max:   int? "maximum number of matches, default 100";
end;

type SearchResult = schema
  text: text "matching lines with their file and line number";
end;

tools
  list_dir(ListDirArgs): ListDirResult "List the entries of a directory inside the served root. Give path as a relative path, or omit it for the root itself." readonly;
  read_file(ReadFileArgs): ReadFileResult "Read a text file inside the served root." readonly;
  file_info(FileInfoArgs): FileInfoResult "Size, kind and modification time of a path inside the served root." readonly;
  search(SearchArgs): SearchResult "Search every text file under a directory for a literal string, and return matching lines with their file and line number." readonly;
end;

include "tools.wz";

var
  app.root:    array[0..MAXPATH - 1] of char;
  app.rootlen: int;
  app.path:    array[0..MAXPATH - 1] of char;    // absolute, NUL terminated
  app.rel:     array[0..MAXPATH - 1] of char;    // relative to the root
  app.rellen:  int;
  app.file:    array[0..FILEBUF - 1] of char;
  app.needle:  array[0..255] of char;
  app.ndlen:   int;

  app.qbuf:  array[0..QUEUEBUF - 1] of char;
  app.qat:   array[0..MAXQUEUE - 1] of int;
  app.qlen:  array[0..MAXQUEUE - 1] of int;
  app.qhead, app.qtail, app.qfill: int;

  app.hits, app.scanned, app.bytes, app.limit: int;

// ---- paths ----------------------------------------------------------

// app.path := root ("/" rel), and app.rel := rel
procedure app.build;
var n, i: int;
begin
  n := 0;
  while n < app.rootlen do
  begin
    app.path[n] := app.root[n];
    n := n + 1;
  end;
  if app.rellen > 0 then
  begin
    app.path[n] := '/';
    n := n + 1;
    i := 0;
    while i < app.rellen do
    begin
      app.path[n] := app.rel[i];
      n := n + 1;
      i := i + 1;
    end;
  end;
  app.path[n] := chr(0);
end;

// app.rel := b[at..upto); false when it tries to leave the root
function app.setrel(b: array of char; at: int; upto: int): bool;
var i: int;
    c: char;
begin
  app.rellen := 0;
  if upto - at >= MAXPATH - 2 then return false;
  i := at;
  while i < upto do
  begin
    c := b[i];
    if c = chr(0) then return false;
    if (i = at) and (c = '/') then return false;
    if c = '.' then
    begin
      if i + 1 < upto then
      begin
        if b[i + 1] = '.' then return false;
      end;
    end;
    app.rel[app.rellen] := c;
    app.rellen := app.rellen + 1;
    i := i + 1;
  end;
  // trim a trailing slash
  if app.rellen > 0 then
  begin
    if app.rel[app.rellen - 1] = '/' then app.rellen := app.rellen - 1;
  end;
  app.build;
  return true;
end;

// app.rel := <queued directory> "/" <current entry>
procedure app.descend(qi: int);
var n, i: int;
begin
  n := 0;
  i := 0;
  while i < app.qlen[qi] do
  begin
    app.rel[n] := app.qbuf[app.qat[qi] + i];
    n := n + 1;
    i := i + 1;
  end;
  if n > 0 then
  begin
    app.rel[n] := '/';
    n := n + 1;
  end;
  i := 0;
  while i < fs.namelen do
  begin
    app.rel[n] := fs.name[i];
    n := n + 1;
    i := i + 1;
  end;
  app.rellen := n;
  app.build;
end;

procedure app.usequeued(qi: int);
var i: int;
begin
  app.rellen := 0;
  i := 0;
  while i < app.qlen[qi] do
  begin
    app.rel[app.rellen] := app.qbuf[app.qat[qi] + i];
    app.rellen := app.rellen + 1;
    i := i + 1;
  end;
  app.build;
end;

// ---- tool: list_dir --------------------------------------------------

function tool.list_dir(a: array of ListDirArgs; r: array of ListDirResult): int;
var fd, n, files, dirs, at: int;
begin
  app.rellen := 0;
  app.build;
  if a[0].path_ok then
  begin
    if not app.setrel(a[0].path, 0, a[0].path_n) then return tool.fail("that path is outside the served directory");
  end;
  fd := fs.opendir(addr(app.path[0]));
  if fd < 0 then return tool.fail("cannot open that directory");
  at := tool.vn;
  n := 0;
  files := 0;
  dirs := 0;
  while fs.next(fd) do
  begin
    if n >= 1000 then break;
    if fs.type = DT_DIR then
    begin
      at := io.push(tool.vbuf, at, "dir    ");
      dirs := dirs + 1;
    end
    else if fs.type = DT_LNK then at := io.push(tool.vbuf, at, "link   ")
    else
    begin
      at := io.push(tool.vbuf, at, "file   ");
      files := files + 1;
    end;
    at := json.escslice(tool.vbuf, at, fs.name, 0, fs.namelen);
    at := io.push(tool.vbuf, at, "\\n");
    n := n + 1;
  end;
  fs.close(fd);
  if n = 0 then at := io.push(tool.vbuf, at, "(empty directory)\\n");
  at := io.push(tool.vbuf, at, "\\n");
  at := io.pushnum(tool.vbuf, at, dirs);
  at := io.push(tool.vbuf, at, " directories, ");
  at := io.pushnum(tool.vbuf, at, files);
  at := io.push(tool.vbuf, at, " files");
  r[0].text_at := tool.vn; r[0].text_end := at; tool.vn := at;
  return 0;
end;

// ---- tool: file_info -------------------------------------------------

function tool.file_info(a: array of FileInfoArgs; r: array of FileInfoResult): int;
var at: int;
begin
  app.rellen := 0;
  app.build;
  if not app.setrel(a[0].path, 0, a[0].path_n) then return tool.fail("that path is outside the served directory");
  if not fs.stat(addr(app.path[0])) then return tool.fail("no such path");
  at := tool.vn;
  at := json.escslice(tool.vbuf, at, app.rel, 0, app.rellen);
  if app.rellen = 0 then at := io.push(tool.vbuf, at, ".");
  at := io.push(tool.vbuf, at, "\\n");
  if fs.isdir then at := io.push(tool.vbuf, at, "kind: directory\\n")
  else if fs.isfile then at := io.push(tool.vbuf, at, "kind: file\\n")
  else at := io.push(tool.vbuf, at, "kind: other\\n");
  at := io.push(tool.vbuf, at, "size: ");
  at := io.pushnum(tool.vbuf, at, fs.size);
  at := io.push(tool.vbuf, at, " bytes\\nmodified: ");
  at := io.pushnum(tool.vbuf, at, fs.mtime);
  at := io.push(tool.vbuf, at, " (unix seconds)\\nmode: ");
  at := io.pushnum(tool.vbuf, at, band(fs.mode, 511));
  at := io.push(tool.vbuf, at, " (octal-ish, decimal here)");
  r[0].text_at := tool.vn; r[0].text_end := at; tool.vn := at;
  return 0;
end;

// ---- tool: read_file -------------------------------------------------

function tool.read_file(a: array of ReadFileArgs; r: array of ReadFileResult): int;
var fd, rd, got, offset, limit, at: int;
begin
  app.rellen := 0;
  app.build;
  if not app.setrel(a[0].path, 0, a[0].path_n) then return tool.fail("that path is outside the served directory");
  if not fs.stat(addr(app.path[0])) then return tool.fail("no such file");
  if fs.isdir then return tool.fail("that is a directory; use list_dir");
  fd := fs.open(addr(app.path[0]));
  if fd < 0 then return tool.fail("cannot open that file");
  offset := 0;
  if a[0].offset_ok then offset := a[0].offset;
  limit := 0;
  if a[0].limit_ok then limit := a[0].limit;
  if offset > 0 then sys3(8, fd, offset, 0);
  if limit <= 0 then limit := 65536;
  if limit > 262144 then limit := 262144;
  got := 0;
  while got < limit do
  begin
    rd := io.read(fd, addr(app.file[got]), limit - got);
    if rd <= 0 then break;
    got := got + rd;
  end;
  fs.close(fd);
  at := tool.vn;
  at := json.escslice(tool.vbuf, at, app.file, 0, got);
  r[0].text_at := tool.vn; r[0].text_end := at; tool.vn := at;
  return 0;
end;

// ---- tool: search ----------------------------------------------------

procedure app.enqueue;
var i: int;
begin
  if app.qtail >= MAXQUEUE then return;
  if app.qfill + app.rellen >= QUEUEBUF then return;
  app.qat[app.qtail] := app.qfill;
  app.qlen[app.qtail] := app.rellen;
  i := 0;
  while i < app.rellen do
  begin
    app.qbuf[app.qfill] := app.rel[i];
    app.qfill := app.qfill + 1;
    i := i + 1;
  end;
  app.qtail := app.qtail + 1;
end;

function app.hidden: bool;
begin
  if fs.namelen = 0 then return true;
  return fs.name[0] = '.';
end;

// search the file at app.path, appending "rel:line: text" per match to tool.vbuf
procedure app.grep;
var fd, r, got, at, hit, ls, le, i, line, probe: int;
begin
  // no stat first: opening tells us just as much, one syscall cheaper
  fd := fs.open(addr(app.path[0]));
  if fd < 0 then return;
  got := 0;
  while got < FILEBUF do
  begin
    r := io.read(fd, addr(app.file[got]), FILEBUF - got);
    if r <= 0 then break;
    got := got + r;
  end;
  fs.close(fd);
  app.scanned := app.scanned + 1;
  app.bytes := app.bytes + got;
  probe := got;
  if probe > 1024 then probe := 1024;
  if scan(app.file, 0, probe, chr(0)) < probe then return;   // binary
  at := 0;
  line := 1;
  while true do
  begin
    hit := fs.find(app.file, at, got, app.needle, app.ndlen);
    if hit < 0 then return;
    while at < hit do
    begin
      i := scan(app.file, at, hit, chr(10));
      if i >= hit then break;
      line := line + 1;
      at := i + 1;
    end;
    ls := hit;
    while ls > 0 do
    begin
      if app.file[ls - 1] = chr(10) then break;
      ls := ls - 1;
    end;
    le := scan(app.file, hit, got, chr(10));
    if le - ls > MAXLINE then le := ls + MAXLINE;
    if app.hits > 0 then tool.vn := io.push(tool.vbuf, tool.vn, "\\n");
    tool.vn := json.escslice(tool.vbuf, tool.vn, app.rel, 0, app.rellen);
    tool.vn := io.push(tool.vbuf, tool.vn, ":");
    tool.vn := io.pushnum(tool.vbuf, tool.vn, line);
    tool.vn := io.push(tool.vbuf, tool.vn, ": ");
    tool.vn := json.escslice(tool.vbuf, tool.vn, app.file, ls, le);
    app.hits := app.hits + 1;
    if app.hits >= app.limit then return;
    at := hit + app.ndlen;
    if at >= got then return;
  end;
end;

function tool.search(a: array of SearchArgs; r: array of SearchResult): int;
var fd, qi, t0, ms, startlen, textat, at, i: int;
begin
  textat := tool.vn;
  app.ndlen := a[0].query_n;
  if app.ndlen <= 0 then return tool.fail("the query is empty");
  if app.ndlen > 255 then return tool.fail("the query is too long");
  i := 0;
  while i < app.ndlen do
  begin
    app.needle[i] := a[0].query[i];
    i := i + 1;
  end;
  app.rellen := 0;
  if a[0].path_ok then
  begin
    if not app.setrel(a[0].path, 0, a[0].path_n) then return tool.fail("that path is outside the served directory");
  end;
  app.limit := 100;
  if a[0].max_ok then
  begin
    app.limit := a[0].max;
    if app.limit <= 0 then app.limit := 1;
    if app.limit > 1000 then app.limit := 1000;
  end;
  t0 := io.now;
  app.qhead := 0;
  app.qtail := 0;
  app.qfill := 0;
  app.hits := 0;
  app.scanned := 0;
  app.bytes := 0;
  app.enqueue;                       // app.rel already holds the start point
  startlen := app.rellen;
  while app.qhead < app.qtail do
  begin
    if app.hits >= app.limit then break;
    qi := app.qhead;
    app.qhead := app.qhead + 1;
    app.usequeued(qi);
    fd := fs.opendir(addr(app.path[0]));
    if fd >= 0 then
    begin
      while fs.next(fd) do
      begin
        if app.hits >= app.limit then break;
        if not app.hidden then
        begin
          app.descend(qi);
          if fs.type = DT_DIR then app.enqueue
          else if fs.type = DT_REG then app.grep;
        end;
      end;
      fs.close(fd);
    end;
  end;
  ms := (io.now - t0) div 1000000;
  at := tool.vn;
  if app.hits = 0 then at := io.push(tool.vbuf, at, "no matches");
  at := io.push(tool.vbuf, at, "\\n\\n");
  at := io.pushnum(tool.vbuf, at, app.hits);
  at := io.push(tool.vbuf, at, " matches, ");
  at := io.pushnum(tool.vbuf, at, app.scanned);
  at := io.push(tool.vbuf, at, " files searched, ");
  at := io.pushnum(tool.vbuf, at, app.bytes div 1024);
  at := io.push(tool.vbuf, at, " kB in ");
  at := io.pushnum(tool.vbuf, at, ms);
  at := io.push(tool.vbuf, at, " ms");
  r[0].text_at := textat; r[0].text_end := at; tool.vn := at;
  return 0;
end;

// ---- HTTP transport ---------------------------------------------------

procedure app.request;
begin
  if tool.rest("/tools/") then return;
  if http.pathis("/mcp") then
  begin
    mcp.http;
    return;
  end;
  http.add("{\"detail\":\"not found: MCP is at POST /mcp, REST at POST /tools/<tool>\"}");
  http.finish(404, "application/json");
end;

// ---- start -------------------------------------------------------------

var
  port, i: int;
  c: char;

begin
  mcp.name := "wantzel-files";
  mcp.version := "1.0";
  if argc() < 2 then
  begin
    io.puts(STDERR, "usage: mcpfiles <root directory> [http port]\n");
    halt(1);
  end;
  i := 0;
  while true do
  begin
    c := argch(1, i);
    if c = chr(0) then break;
    if i >= MAXPATH - 2 then halt(1);
    app.root[i] := c;
    i := i + 1;
  end;
  // drop a trailing slash so joins do not double it
  if i > 1 then
  begin
    if app.root[i - 1] = '/' then i := i - 1;
  end;
  app.rootlen := i;
  app.root[i] := chr(0);
  app.rellen := 0;
  app.build;
  if not fs.stat(addr(app.path[0])) then
  begin
    io.puts(STDERR, "mcpfiles: cannot see that directory\n");
    halt(1);
  end;
  if not fs.isdir then
  begin
    io.puts(STDERR, "mcpfiles: the root must be a directory\n");
    halt(1);
  end;
  port := 0;
  if argc() > 2 then
  begin
    i := 0;
    while true do
    begin
      c := argch(2, i);
      if c = chr(0) then break;
      if (c >= '0') and (c <= '9') then port := port * 10 + (ord(c) - 48);
      i := i + 1;
    end;
  end;
  if port > 0 then
  begin
    io.puts(STDERR, "wantzel-files serving ");
    io.out(STDERR, addr(app.root[0]), app.rootlen);
    io.puts(STDERR, " on http://127.0.0.1:");
    io.putn(STDERR, port);
    io.puts(STDERR, "/\n");
    http.serve(port, 2);
  end
  else mcp.stdio;
end.
