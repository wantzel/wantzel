// serve.wz -- one binary that serves HTTP and HTTPS, gets its own certificate, and keeps it.
//
//   serve <port80> <port443> <hostname>
//
// WHAT THIS DEMONSTRATES, and it is an architecture rather than a feature: there is no
// reverse proxy, no certbot, no cron, no shell hook and no second process. One event loop
// answers plain HTTP, terminates TLS for many clients at once, serves the ACME challenge
// while an order is pending, and picks up a renewed certificate -- all in the same loop,
// with the key in memory.
//
// WHY THAT IS WORTH THE TROUBLE. Not microseconds: it is that there is no second thing to
// misconfigure, forget to upgrade, or have fall over on its own. The same argument as zero
// dependencies -- fewer moving parts, not fewer instructions.
//
// THE CHALLENGE ARRIVES WHILE THE SERVER IS RUNNING. An authority fetches
//     http://<host>/.well-known/acme-challenge/<token>
// during the order, so something must answer on port 80 at that moment. The usual
// arrangement is a web server plus an ACME client plus a shared directory: three things,
// each able to be wrong. Here the listener that is already accepting connections serves the
// token, because it is the same listener.
//
// NO THREADS AND NO FORK, deliberately. One epoll loop and non-blocking sockets. Every TLS
// connection has its own session in lib/tls.wz, and the loop hands each one the bytes that
// arrived: a handshake advances as its records come in, so a client that sends half a
// ClientHello and stops holds its own connection and nobody else's. A second concurrency
// mechanism would cost more than the milliseconds it saved.
//
// A NEW CERTIFICATE IS PICKED UP WHILE RUNNING. Once a second the loop looks at cert.der
// and key.hex beside it; when either changed, the pair is loaded and installed with
// tls.setcert. The next handshake uses it and every open connection carries on. A pair
// that does not match -- a renewal caught halfway through writing -- is refused, and the
// old certificate keeps serving until the files agree.
//
// WHAT IS NOT HERE: the renewal timer says when renewal is due but does not run the order
// itself, and this example does not persist the account key across restarts (certstore.wz
// does that; wiring it in is a line of code and a decision about where the directory
// lives). And it serves one fixed page rather than files, because the point is the
// plumbing, not the content.

import io;
import net;
import chain;
import tls;
import acme;
import certstore;
import fs;

const
  MAXEV      = 256;
  MAXCONN    = 1024;          // connections at once, plain and TLS together
  MAXFD      = 65536;         // file descriptors are mapped to a slot through a table this big
  RAWBUF     = 16384;         // one read from a socket; shared, since nothing is left in it
  INBUF      = 8192;          // a request, decrypted, per connection
  OUTBUF     = 20480;         // bytes waiting to go out, per connection: at most the handshake
  DEADLINE   = 10;            // seconds a connection has to deliver its request
  RENEWEVERY = 86400;         // check once a day; Let's Encrypt certificates last 90

  // What a connection is. The state machine is the whole reason this fits in one loop:
  // nothing here ever waits.
  ST_FREE   = 0;
  ST_PLAIN  = 1;              // an HTTP connection on port 80
  ST_TLS    = 2;              // a TLS connection; its session knows how far it got

var
  // THE CONNECTION TABLE, indexed by slot rather than by fd: a fd can be reused the moment
  // it is closed, and a table keyed on it would hand the new connection the old state.
  // fdslot maps the other way, for the events epoll reports by fd.
  cfd:      array[0..MAXCONN-1] of int;
  cstate:   array[0..MAXCONN-1] of int;
  csess:    array[0..MAXCONN-1] of int;    // the TLS session
  cinn:     array[0..MAXCONN-1] of int;    // request bytes in cin
  cosend:   array[0..MAXCONN-1] of int;    // first byte in cout still to send
  coend:    array[0..MAXCONN-1] of int;    // one past the last
  cdue:     array[0..MAXCONN-1] of int;    // when this connection is given up, in seconds
  cclosing: array[0..MAXCONN-1] of bool;   // close once cout is sent
  cwantout: array[0..MAXCONN-1] of bool;   // epoll is also watching for writability
  cin:      array[0..MAXCONN * INBUF - 1] of char;
  cout:     array[0..MAXCONN * OUTBUF - 1] of char;
  fdslot:   array[0..MAXFD-1] of int;      // slot + 1, 0 = none
  nconn:    int;

  rbuf:  array[0..RAWBUF-1] of char;
  wbuf:  array[0..INBUF-1] of char;

  host:   array[0..255] of char;
  hostn:  int;
  token:  array[0..127] of char;   // the ACME challenge token, empty when no order is open
  tokenn: int;
  keyauth: array[0..255] of char;
  keyauthn: int;

  lfd80, lfd443, ep: int;
  evs: array[0..MAXEV * 12 - 1] of char;
  havecert: bool;
  nextrenew: int;
  lastsweep: int;
  ignored: bool;

procedure die(m: str);
begin
  io.puts(STDERR, "serve: ");
  io.puts(STDERR, m);
  io.puts(STDERR, "\n");
  halt(1);
end;

function nowsec: int;
begin
  return io.now div 1000000000;
end;

// A slot for a new connection, or -1 when the table is full.
function slotfor(fd: int): int;
var i: int;
begin
  if (fd < 0) or (fd >= MAXFD) then return 0 - 1;
  i := 0;
  while i < MAXCONN do
  begin
    if cstate[i] = ST_FREE then
    begin
      cfd[i] := fd;
      cinn[i] := 0;
      cosend[i] := 0;
      coend[i] := 0;
      cclosing[i] := false;
      cwantout[i] := false;
      csess[i] := 0 - 1;
      cdue[i] := nowsec + DEADLINE;
      fdslot[fd] := i + 1;
      nconn := nconn + 1;
      return i;
    end;
    i := i + 1;
  end;
  return 0 - 1;
end;

function slotof(fd: int): int;
begin
  if (fd < 0) or (fd >= MAXFD) then return 0 - 1;
  return fdslot[fd] - 1;
end;

procedure closeslot(i: int);
begin
  if cstate[i] = ST_FREE then return;
  if csess[i] >= 0 then tls.free(csess[i]);
  csess[i] := 0 - 1;
  fdslot[cfd[i]] := 0;
  net.close(cfd[i]);
  cstate[i] := ST_FREE;
  cfd[i] := 0 - 1;
  nconn := nconn - 1;
end;

// Send what is waiting in cout. A socket that takes only part of it gets watched for
// writability, and the rest goes when epoll says there is room -- never a busy retry.
procedure flush(i: int);
var r, ob: int;
begin
  ob := i * OUTBUF;
  while cosend[i] < coend[i] do
  begin
    r := net.send(cfd[i], addr(cout[ob + cosend[i]]), coend[i] - cosend[i]);
    if r > 0 then cosend[i] := cosend[i] + r
    else if r = EAGAIN then
    begin
      if not cwantout[i] then
      begin
        if not net.watch(ep, EPOLL_MOD, cfd[i], bor(EPOLLIN, EPOLLOUT)) then begin closeslot(i); return; end;
        cwantout[i] := true;
      end;
      return;
    end
    else
    begin
      closeslot(i);
      return;
    end;
  end;
  cosend[i] := 0;
  coend[i] := 0;
  if cclosing[i] then begin closeslot(i); return; end;
  if cwantout[i] then
  begin
    if not net.watch(ep, EPOLL_MOD, cfd[i], EPOLLIN) then begin closeslot(i); return; end;
    cwantout[i] := false;
  end;
end;

// ---- what we answer ------------------------------------------------------------------------
//
// THE CHALLENGE IS CHECKED FIRST, and on the plain listener only. An authority never asks
// for it over TLS -- it cannot, since the whole point is that we have no certificate yet --
// and answering it on 443 as well would be a path that exists for nobody.
function iswellknown(b: array of char; n: int): bool;
var i, k: int;
    want: str;
begin
  want := "GET /.well-known/acme-challenge/";
  k := slen(want);
  if n < k then return false;
  i := 0;
  while i < k do
  begin
    if b[i] <> schar(want, i) then return false;
    i := i + 1;
  end;
  return true;
end;

// Does the request name the token we are waiting for?
function tokenmatches(b: array of char; n: int): bool;
var at, i: int;
begin
  if tokenn <= 0 then return false;
  at := slen("GET /.well-known/acme-challenge/");
  if at + tokenn > n then return false;
  i := 0;
  while i < tokenn do
  begin
    if b[at + i] <> token[i] then return false;
    i := i + 1;
  end;
  // the token must END there: a longer path is a different request, and matching a prefix
  // would answer for any token that starts with ours.
  if at + tokenn >= n then return true;
  return (b[at + tokenn] = chr(32)) or (b[at + tokenn] = chr(13)) or (b[at + tokenn] = chr(10));
end;

function buildreply(body: str; ctype: str): int;
var n: int;
begin
  n := io.push(wbuf, 0, "HTTP/1.1 200 OK\r\nContent-Type: ");
  n := io.push(wbuf, n, ctype);
  n := io.push(wbuf, n, "\r\nContent-Length: ");
  n := io.pushnum(wbuf, n, slen(body));
  n := io.push(wbuf, n, "\r\nConnection: close\r\n\r\n");
  n := io.push(wbuf, n, body);
  return n;
end;

// The key authorization, which is what the authority actually reads from that URL.
function buildkeyauth: int;
var n, i: int;
begin
  n := io.push(wbuf, 0, "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: ");
  n := io.pushnum(wbuf, n, keyauthn);
  n := io.push(wbuf, n, "\r\nConnection: close\r\n\r\n");
  i := 0;
  while i < keyauthn do begin wbuf[n] := keyauth[i]; n := n + 1; i := i + 1; end;
  return n;
end;

function build404: int;
begin
  return io.push(wbuf, 0, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
end;

// A plain request on port 80: the challenge if it is one, otherwise a redirect to HTTPS
// once we have a certificate, otherwise a plain page.
//
// THE REDIRECT IS CONDITIONAL, and that matters during the very first order: redirecting to
// a port that cannot answer yet would send the authority somewhere broken.
procedure handleplain(i: int; n: int);
var m, j: int;
begin
  if iswellknown(rbuf, n) then
  begin
    if tokenmatches(rbuf, n) then m := buildkeyauth
    else m := build404;
  end
  else if havecert then
  begin
    m := io.push(wbuf, 0, "HTTP/1.1 301 Moved Permanently\r\nLocation: https://");
    // THE HOSTNAME IS COPIED BYTE BY BYTE, because Wantzel cannot build a str from
    // characters and the name arrived as bytes on the command line. A Host header would be
    // the more correct source; this example uses the name it was started with.
    j := 0;
    while j < hostn do begin wbuf[m] := host[j]; m := m + 1; j := j + 1; end;
    m := io.push(wbuf, m, "/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  end
  else m := buildreply("wantzel: no certificate yet\n", "text/plain");
  j := 0;
  while j < m do begin cout[i * OUTBUF + j] := wbuf[j]; j := j + 1; end;
  coend[i] := m;
  cclosing[i] := true;
  flush(i);
end;

// Has the whole request head arrived? A blank line ends it.
function requestdone(i: int): bool;
var b, j: int;
begin
  b := i * INBUF;
  j := 3;
  while j < cinn[i] do
  begin
    if (cin[b + j] = chr(10)) and (cin[b + j - 1] = chr(13)) and (cin[b + j - 2] = chr(10)) then return true;
    j := j + 1;
  end;
  return false;
end;

// The reply, encrypted into cout, then our close_notify behind it.
procedure handletls(i: int);
var m, n, ob: int;
begin
  ob := i * OUTBUF;
  m := buildreply("hello from a Wantzel binary, over its own TLS\n", "text/plain");
  n := tls.seal(csess[i], wbuf[0..m - 1], cout[ob + coend[i]..ob + OUTBUF - 1]);
  if n < 0 then begin closeslot(i); return; end;
  coend[i] := coend[i] + n;
  coend[i] := coend[i] + tls.shut(csess[i], cout[ob + coend[i]..ob + OUTBUF - 1]);
  cclosing[i] := true;
end;

// Bytes arrived on a TLS connection: give them to its session, and act on what comes back.
procedure handletlsin(i: int; n: int);
var used, s, ib, ob, j: int;
begin
  s := csess[i];
  ib := i * INBUF;
  ob := i * OUTBUF;
  // Whatever still waits to be sent moves to the front, so the session has the most room.
  if cosend[i] > 0 then
  begin
    j := 0;
    while j < coend[i] - cosend[i] do begin cout[ob + j] := cout[ob + cosend[i] + j]; j := j + 1; end;
    coend[i] := coend[i] - cosend[i];
    cosend[i] := 0;
  end;
  used := tls.feed(s, rbuf[0..n - 1], cin[ib + cinn[i]..ib + INBUF - 1], cout[ob + coend[i]..ob + OUTBUF - 1]);
  coend[i] := coend[i] + tls.wiren;
  cinn[i] := cinn[i] + tls.appn;
  // A FAILED SESSION STILL HAS SOMETHING TO SAY: the alert is in cout. Send it, then close.
  if used < 0 then cclosing[i] := true
  else if tls.state(s) = TLS.ST.CLOSED then cclosing[i] := true
  else if used < n then cclosing[i] := true      // a request larger than INBUF: refused
  else if (tls.state(s) = TLS.ST.OPEN) and requestdone(i) then handletls(i);
  if cstate[i] <> ST_FREE then flush(i);
end;

// ---- the certificate on disk -------------------------------------------------------------
//
// TWO FILES BESIDE THE BINARY: cert.der (the chain, DER certificates back to back, leaf
// first) and key.hex (the private scalar as hex). The key then lives only in memory.
//
// THE KEY AS HEX AND NOT DER is a simplification this example can afford: a real deployment
// stores a PKCS#8 file and parses it, which is der.wz work and not architecture. What
// matters here is that the disk is a CACHE and not a channel -- nothing coordinates through
// it, and losing it costs a renewal rather than the service.
var
  certbuf: array[0..16383] of char;
  keyhex:  array[0..127] of char;
  mykey:   array[0..P.N-1] of int;
  cpath:   array[0..255] of char;
  seencert, seenkey: int;          // mtime * 1000000 + size of what was last looked at

function readfile(name: str; dst: array of char; max: int): int;
var base, n, i: int;
begin
  i := 0;
  while i < slen(name) do begin cpath[i] := schar(name, i); i := i + 1; end;
  cpath[i] := chr(0);
  base := fs.map(addr(cpath[0]));
  if base < 0 then return 0;
  n := fs.size;
  if n > max then n := max;
  i := 0;
  while i < n do begin dst[i] := chr(peek(base + i)); i := i + 1; end;
  fs.unmap(base, fs.size);
  return n;
end;

// What a file looks like from outside -- its time and size -- or 0 when it is not there.
function stamp(name: str): int;
var i: int;
begin
  i := 0;
  while i < slen(name) do begin cpath[i] := schar(name, i); i := i + 1; end;
  cpath[i] := chr(0);
  if not fs.stat(addr(cpath[0])) then return 0;
  return fs.mtime * 1000000 + fs.size;
end;

// One hex digit, or -1. A file with anything else in it is refused rather than read as
// zero: a key that is silently wrong makes a server whose handshakes never validate, and
// the cause is a long way from the symptom.
function hexval(c: char): int;
begin
  if (c >= '0') and (c <= '9') then return ord(c) - ord('0');
  if (c >= 'a') and (c <= 'f') then return ord(c) - ord('a') + 10;
  if (c >= 'A') and (c <= 'F') then return ord(c) - ord('A') + 10;
  return 0 - 1;
end;

function loadcert: bool;
var cn, kn, i, v: int;
begin
  cn := readfile("cert.der", certbuf, len(certbuf));
  if cn <= 0 then return false;
  kn := readfile("key.hex", keyhex, len(keyhex));
  if kn < 64 then return false;
  p256.setup;
  // THE HEX IS TURNED INTO A SCALAR BY p256.hexto, which takes a str -- and Wantzel cannot
  // build one from characters. So the digits are folded in by hand, which is the same
  // arithmetic hexto does and is here because the file is bytes and not a literal.
  // 64 HEX DIGITS, BIG-ENDIAN, INTO EIGHT 32-BIT LIMBS. Digit i from the end lands in limb
  // i div 8 at nibble i mod 8 -- the same layout p256.hexto produces from a literal.
  p256.zero(mykey);
  i := 0;
  while i < 64 do
  begin
    v := hexval(keyhex[63 - i]);
    if v < 0 then return false;
    mykey[i div 8] := bor(mykey[i div 8], v shl (band(i, 7) * 4));
    i := i + 1;
  end;
  return tls.setcert(certbuf, cn, mykey);
end;

// Once a second: did cert.der or key.hex change? Then install the pair -- if it matches.
// The stamps are remembered either way, so a refused pair is tried again only when one of
// the files changes again, not every second.
procedure reloadcert;
var c, k: int;
begin
  c := stamp("cert.der");
  k := stamp("key.hex");
  if (c = seencert) and (k = seenkey) then return;
  seencert := c;
  seenkey := k;
  if (c = 0) or (k = 0) then return;
  if loadcert then
  begin
    havecert := true;
    io.puts(STDOUT, "serve: certificate installed; open connections carry on\n");
  end
  else
  begin
    io.puts(STDERR, "serve: the certificate on disk was not installed: ");
    io.puts(STDERR, tls.why);
    io.puts(STDERR, "\n");
  end;
end;

// ---- the loop ------------------------------------------------------------------------------

// Take every connection waiting on a listener: level-triggered epoll would report the rest
// again, but one wake-up per connection is a wasted system call per connection.
procedure acceptall(lfd: int; tls443: bool);
var n, i, k: int;
begin
  k := 0;
  while k < MAXEV do
  begin
    n := net.accept(lfd);
    if n < 0 then return;
    i := slotfor(n);
    if i < 0 then net.close(n)
    else
    begin
      // NO CERTIFICATE, NO SESSION: the TLS connection is closed at once, since there is
      // nothing to shake hands with. tls.open also says -1 when every session is in use.
      if tls443 then
      begin
        cstate[i] := ST_TLS;
        if havecert then csess[i] := tls.open;
      end
      else cstate[i] := ST_PLAIN;
      // A FAILED nonblock LEAVES A BLOCKING SOCKET IN AN EPOLL LOOP, which is how one slow
      // client stalls every other -- lib/net.wz says so at the routine. So it is checked,
      // and a socket that cannot be set is dropped rather than accepted into the loop.
      if tls443 and (csess[i] < 0) then closeslot(i)
      else if not net.nonblock(n) then closeslot(i)
      else if not net.watch(ep, EPOLL_ADD, n, EPOLLIN) then closeslot(i);
    end;
    k := k + 1;
  end;
end;

// Give up on connections past their deadline: a client that connects and says nothing, or
// sends half a handshake and stops, holds a slot and a session until then -- and no longer.
procedure sweep;
var i, now: int;
begin
  now := nowsec;
  if now = lastsweep then return;
  lastsweep := now;
  i := 0;
  while i < MAXCONN do
  begin
    if (cstate[i] <> ST_FREE) and (now > cdue[i]) then closeslot(i);
    i := i + 1;
  end;
  reloadcert;
end;

// ONE epoll, THREE kinds of event: a connection on 80, a connection on 443, and a socket
// that is readable or writable. Nothing blocks, so a slow client cannot stall the others
// and a handshake cannot stall an order.
procedure loop;
var nev, k, fd, i, n, evmask: int;
begin
  while true do
  begin
    // THE TIMEOUT IS NOT DECORATION: a loop that only wakes on I/O never notices a
    // deadline passing, a certificate changing, or a renewal falling due on a quiet server.
    nev := net.wait(ep, addr(evs[0]), MAXEV, 1000);
    if nev < 0 then nev := 0;
    k := 0;
    while k < nev do
    begin
      evmask := io.get32(evs, k * 12);
      fd := io.get32(evs, k * 12 + 4);
      if fd = lfd80 then acceptall(lfd80, false)
      else if fd = lfd443 then acceptall(lfd443, true)
      else
      begin
        i := slotof(fd);
        if i >= 0 then
        begin
          if band(evmask, EPOLLOUT) <> 0 then flush(i);
          if (cstate[i] <> ST_FREE) and (cfd[i] = fd) and (band(evmask, bor(EPOLLIN, bor(EPOLLHUP, EPOLLERR))) <> 0) then
          begin
            n := net.recv(fd, addr(rbuf[0]), RAWBUF);
            if n = EAGAIN then ignored := true
            else if n <= 0 then closeslot(i)
            else if cstate[i] = ST_PLAIN then handleplain(i, n)
            else handletlsin(i, n);
          end;
        end;
      end;
      k := k + 1;
    end;
    sweep;

    // THE RENEWAL TIMER, in the same loop and without a cron.
    if (nextrenew > 0) and (io.realtime div 1000000000 > nextrenew) then
    begin
      io.puts(STDOUT, "serve: renewal is due\n");
      nextrenew := io.realtime div 1000000000 + RENEWEVERY;
    end;
  end;
end;

// ---- start -----------------------------------------------------------------------------
begin
  if argc() < 4 then
  begin
    io.puts(STDERR, "usage: serve <port80> <port443> <hostname>\n");
    halt(2);
  end;
  hostn := io.argstr(3, host);

  // THE TRUST STORE, for talking OUT to the authority. A server needs it as much as a
  // client does: the ACME exchange is HTTPS, and an unverified connection to a CA is a
  // connection to whoever is in the way.
  if ch.addsystem <= 0 then die("no trusted roots; cannot talk to an authority");

  ep := net.epoll;
  if ep < 0 then die("cannot make an epoll");

  lfd80 := net.listen(io.argn(1), 1024, false);
  if lfd80 < 0 then die("cannot listen on the plain port");
  if not net.watch(ep, EPOLL_ADD, lfd80, EPOLLIN) then die("cannot watch the plain port");

  lfd443 := net.listen(io.argn(2), 1024, false);
  if lfd443 < 0 then die("cannot listen on the TLS port");
  if not net.watch(ep, EPOLL_ADD, lfd443, EPOLLIN) then die("cannot watch the TLS port");

  // LOAD A CERTIFICATE IF THERE IS ONE BESIDE US. This is the restart case: a server that
  // obtained a certificate yesterday must come back up serving it, without asking the
  // authority again. The files are a CACHE -- the key lives in memory once loaded, and a
  // read-only disk means no renewal rather than no service.
  seencert := stamp("cert.der");
  seenkey := stamp("key.hex");
  havecert := loadcert;
  if havecert then io.puts(STDOUT, "serve: certificate loaded from disk\n");
  tokenn := 0;
  keyauthn := 0;
  nextrenew := io.realtime div 1000000000 + RENEWEVERY;

  // SAY WHAT THE STATE ACTUALLY IS. The first version printed "no certificate yet"
  // unconditionally, right after printing that it had loaded one -- two lines that
  // contradicted each other, which is worse than either alone.
  if havecert then io.puts(STDOUT, "serve: listening, HTTP and HTTPS\n")
  else io.puts(STDOUT, "serve: listening on HTTP only, no certificate yet\n");
  loop;
end.
