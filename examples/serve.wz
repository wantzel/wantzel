// serve.wz -- one binary that serves HTTP and HTTPS, gets its own certificate, and keeps it.
//
//   serve <port80> <port443> <hostname> [--acme a.b.c.d:port] [--email <address>]
//
// WHAT THIS DEMONSTRATES, and it is an architecture rather than a feature: there is no
// reverse proxy, no certbot, no cron, no shell hook and no second process. One accept loop
// answers plain HTTP, terminates TLS, serves the ACME challenge while an order is pending,
// and renews on a timer -- all in the same event loop, with the key in memory.
//
// WHY THAT IS WORTH THE TROUBLE. Not microseconds: it is that there is no second thing to
// misconfigure, forget to upgrade, or have fall over on its own. The same argument as zero
// dependencies -- fewer moving parts, not fewer instructions.
//
// THE CHALLENGE ARRIVES WHILE THE SERVER IS RUNNING. An authority fetches
//     http://<host>/.well-known/acme-challenge/<token>
// during the order, so something must answer on port 80 at that moment. The usual
// arrangement is a web server plus an ACME client plus a shared directory: three things,
// each able to be wrong. Here the listener that is already accepting connections serves the
// token, because it is the same listener.
//
// NO THREADS AND NO FORK, deliberately. One epoll loop, non-blocking sockets, and the
// handshake driven as part of it. A second concurrency mechanism costs more than the
// milliseconds it would save -- see the note in the ticket this came from.
//
// WHAT IS NOT HERE: the renewal timer fires and re-runs the order, but this example does
// not persist the account key across restarts (certstore.wz does that; wiring it in is a
// line of code and a decision about where the directory lives). And it serves one fixed
// page rather than files, because the point is the plumbing, not the content.

include "io.wz";
include "net.wz";
include "chain.wz";
include "tls.wz";
include "acme.wz";
include "certstore.wz";
include "fs.wz";

const
  MAXEV     = 64;
  MAXCONN   = 64;             // enough for a demonstration; an epoll loop scales far past it
  BUF       = 16384;
  RENEWEVERY = 86400;         // check once a day; Let's Encrypt certificates last 90

  // What a connection is doing. The state machine is the whole reason this fits in one
  // loop: nothing here ever waits.
  ST_FREE   = 0;
  ST_PLAIN  = 1;              // an HTTP connection on port 80
  ST_TLS    = 2;              // a TLS connection, handshake done
  ST_CLOSE  = 3;

var
  // the connection table, indexed by slot rather than by fd: a fd can be reused the moment
  // it is closed, and a table keyed on it would hand the new connection the old state.
  cfd:    array[0..MAXCONN-1] of int;
  cstate: array[0..MAXCONN-1] of int;
  cplain: array[0..MAXCONN-1] of bool;

  rbuf:  array[0..BUF-1] of char;
  wbuf: array[0..BUF-1] of char;

  host:   array[0..255] of char;
  hostn:  int;
  token:  array[0..127] of char;   // the ACME challenge token, empty when no order is open
  tokenn: int;
  keyauth: array[0..255] of char;
  keyauthn: int;

  lfd80, lfd443, ep: int;
  evs: array[0..MAXEV * 12 - 1] of char;
  havecert: bool;
  nextrenew: int;

procedure die(m: str);
begin
  io.puts(STDERR, "serve: ");
  io.puts(STDERR, m);
  io.puts(STDERR, "\n");
  halt(1);
end;

function slotfor(fd: int): int;
var i: int;
begin
  i := 0;
  while i < MAXCONN do
  begin
    if cstate[i] = ST_FREE then
    begin
      cfd[i] := fd;
      return i;
    end;
    i := i + 1;
  end;
  return 0 - 1;
end;

function slotof(fd: int): int;
var i: int;
begin
  i := 0;
  while i < MAXCONN do
  begin
    if (cstate[i] <> ST_FREE) and (cfd[i] = fd) then return i;
    i := i + 1;
  end;
  return 0 - 1;
end;

procedure closeslot(i: int);
begin
  if cstate[i] = ST_FREE then return;
  net.close(cfd[i]);
  cstate[i] := ST_FREE;
  cfd[i] := 0 - 1;
end;

// ---- what we answer ------------------------------------------------------------------------
//
// THE CHALLENGE IS CHECKED FIRST, and on the plain listener only. An authority never asks
// for it over TLS -- it cannot, since the whole point is that we have no certificate yet --
// and answering it on 443 as well would be a path that exists for nobody.
function iswellknown(b: array of char; n: int): bool;
var i, k: int;
    want: str;
begin
  want := "GET /.well-known/acme-challenge/";
  k := slen(want);
  if n < k then return false;
  i := 0;
  while i < k do
  begin
    if b[i] <> schar(want, i) then return false;
    i := i + 1;
  end;
  return true;
end;

// Does the request name the token we are waiting for?
function tokenmatches(b: array of char; n: int): bool;
var at, i: int;
begin
  if tokenn <= 0 then return false;
  at := slen("GET /.well-known/acme-challenge/");
  if at + tokenn > n then return false;
  i := 0;
  while i < tokenn do
  begin
    if b[at + i] <> token[i] then return false;
    i := i + 1;
  end;
  // the token must END there: a longer path is a different request, and matching a prefix
  // would answer for any token that starts with ours.
  if at + tokenn >= n then return true;
  return (b[at + tokenn] = chr(32)) or (b[at + tokenn] = chr(13)) or (b[at + tokenn] = chr(10));
end;

function buildreply(body: str; ctype: str): int;
var n: int;
begin
  n := io.push(wbuf, 0, "HTTP/1.1 200 OK\r\nContent-Type: ");
  n := io.push(wbuf, n, ctype);
  n := io.push(wbuf, n, "\r\nContent-Length: ");
  n := io.pushnum(wbuf, n, slen(body));
  n := io.push(wbuf, n, "\r\nConnection: close\r\n\r\n");
  n := io.push(wbuf, n, body);
  return n;
end;

// The key authorization, which is what the authority actually reads from that URL.
function buildkeyauth: int;
var n, i: int;
begin
  n := io.push(wbuf, 0, "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: ");
  n := io.pushnum(wbuf, n, keyauthn);
  n := io.push(wbuf, n, "\r\nConnection: close\r\n\r\n");
  i := 0;
  while i < keyauthn do begin wbuf[n] := keyauth[i]; n := n + 1; i := i + 1; end;
  return n;
end;

function build404: int;
begin
  return io.push(wbuf, 0, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
end;

// A plain request on port 80: the challenge if it is one, otherwise a redirect to HTTPS
// once we have a certificate, otherwise a plain page.
//
// THE REDIRECT IS CONDITIONAL, and that matters during the very first order: redirecting to
// a port that cannot answer yet would send the authority somewhere broken.
procedure handleplain(i: int; n: int);
var m, j: int;
begin
  if iswellknown(rbuf, n) then
  begin
    if tokenmatches(rbuf, n) then m := buildkeyauth
    else m := build404;
  end
  else if havecert then
  begin
    m := io.push(wbuf, 0, "HTTP/1.1 301 Moved Permanently\r\nLocation: https://");
    // THE HOSTNAME IS COPIED BYTE BY BYTE, because Wantzel cannot build a str from
    // characters and the name arrived as bytes on the command line. A Host header would be
    // the more correct source; this example uses the name it was started with.
    j := 0;
    while j < hostn do begin wbuf[m] := host[j]; m := m + 1; j := j + 1; end;
    m := io.push(wbuf, m, "/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  end
  else m := buildreply("wantzel: no certificate yet\n", "text/plain");
  // THE RESULT IS IGNORED ON PURPOSE: the connection is closed either way, and a partial
  // send on a reply this small means the peer is gone. Retrying it would be a loop that
  // never ends for a client that has already left.
  j := net.send(cfd[i], addr(wbuf[0]), m);
  closeslot(i);
end;

procedure handletls(i: int; n: int);
var m: int;
begin
  m := buildreply("hello from a Wantzel binary, over its own TLS\n", "text/plain");
  if not tls.write(wbuf, m) then closeslot(i);
  tls.close;
  closeslot(i);
end;

// ---- the certificate on disk -------------------------------------------------------------
//
// TWO FILES BESIDE THE BINARY: cert.der (the chain, DER) and key.hex (the private scalar as
// hex). Both are read once at startup and the key then lives only in memory.
//
// THE KEY AS HEX AND NOT DER is a simplification this example can afford: a real deployment
// stores a PKCS#8 file and parses it, which is der.wz work and not architecture. What
// matters here is that the disk is a CACHE and not a channel -- nothing coordinates through
// it, and losing it costs a renewal rather than the service.
var
  certbuf: array[0..8191] of char;
  keyhex:  array[0..127] of char;
  mykey:   array[0..P.N-1] of int;
  cpath:   array[0..255] of char;

function readfile(name: str; dst: array of char; max: int): int;
var base, n, i: int;
begin
  i := 0;
  while i < slen(name) do begin cpath[i] := schar(name, i); i := i + 1; end;
  cpath[i] := chr(0);
  base := fs.map(addr(cpath[0]));
  if base < 0 then return 0;
  n := fs.size;
  if n > max then n := max;
  i := 0;
  while i < n do begin dst[i] := chr(peek(base + i)); i := i + 1; end;
  fs.unmap(base, fs.size);
  return n;
end;

// One hex digit, or -1. A file with anything else in it is refused rather than read as
// zero: a key that is silently wrong makes a server whose handshakes never validate, and
// the cause is a long way from the symptom.
function hexval(c: char): int;
begin
  if (c >= '0') and (c <= '9') then return ord(c) - ord('0');
  if (c >= 'a') and (c <= 'f') then return ord(c) - ord('a') + 10;
  if (c >= 'A') and (c <= 'F') then return ord(c) - ord('A') + 10;
  return 0 - 1;
end;

function loadcert: bool;
var cn, kn, i, v: int;
begin
  cn := readfile("cert.der", certbuf, len(certbuf));
  if cn <= 0 then return false;
  kn := readfile("key.hex", keyhex, len(keyhex));
  if kn < 64 then return false;
  p256.setup;
  // THE HEX IS TURNED INTO A SCALAR BY p256.hexto, which takes a str -- and Wantzel cannot
  // build one from characters. So the digits are folded in by hand, which is the same
  // arithmetic hexto does and is here because the file is bytes and not a literal.
  // 64 HEX DIGITS, BIG-ENDIAN, INTO EIGHT 32-BIT LIMBS. Digit i from the end lands in limb
  // i div 8 at nibble i mod 8 -- the same layout p256.hexto produces from a literal.
  p256.zero(mykey);
  i := 0;
  while i < 64 do
  begin
    v := hexval(keyhex[63 - i]);
    if v < 0 then return false;
    mykey[i div 8] := bor(mykey[i div 8], v shl (band(i, 7) * 4));
    i := i + 1;
  end;
  return tls.setcert(certbuf, cn, mykey);
end;

// ---- the loop ------------------------------------------------------------------------------
//
// ONE epoll, THREE kinds of event: a connection on 80, a connection on 443, and data on an
// accepted socket. Nothing blocks, so a slow client cannot stall the others and a handshake
// cannot stall an order.
//
// THE TLS HANDSHAKE IS THE ONE PLACE THIS EXAMPLE SIMPLIFIES. tls.accept drives the whole
// exchange before returning, which on a non-blocking socket means it can fail with nothing
// read yet. A production server turns that into a state machine like the rest of the loop;
// doing so here would triple the size of the example without showing anything new about the
// architecture. The ticket says as much: measure first, and only then split it up.
procedure loop;
var nev, k, fd, i, n: int;
begin
  while true do
  begin
    // THE TIMEOUT IS NOT DECORATION: a loop that only wakes on I/O never notices that a
    // certificate is expiring on a quiet server. One second is far more often than needed
    // and costs nothing.
    nev := net.wait(ep, addr(evs[0]), MAXEV, 1000);
    if nev < 0 then nev := 0;
    k := 0;
    while k < nev do
    begin
      fd := io.get32(evs, k * 12 + 4);
      if fd = lfd80 then
      begin
        n := net.accept(lfd80);
        if n >= 0 then
        begin
          i := slotfor(n);
          if i < 0 then net.close(n)
          else
          begin
            cstate[i] := ST_PLAIN;
            cplain[i] := true;
            // A FAILED nonblock LEAVES A BLOCKING SOCKET IN AN EPOLL LOOP, which is how
            // one slow client stalls every other -- lib/net.wz says so at the routine. So
            // it is checked, and a socket that cannot be set is dropped rather than
            // accepted into the loop.
            if not net.nonblock(n) then closeslot(i)
            else if not net.watch(ep, EPOLL_ADD, n, EPOLLIN) then closeslot(i);
          end;
        end;
      end
      else if fd = lfd443 then
      begin
        n := net.accept(lfd443);
        if n >= 0 then
        begin
          if not havecert then net.close(n)
          else
          begin
            i := slotfor(n);
            if i < 0 then net.close(n)
            else
            begin
              // THE HANDSHAKE RUNS ON A BLOCKING SOCKET, on purpose: see the note above.
              // It is the one thing in this loop that waits, and it is bounded by the
              // socket's own timeout rather than by us.
              cstate[i] := ST_TLS;
              cplain[i] := false;
              if tls.accept(n) then
              begin
                n := tls.read(rbuf, BUF);
                if n > 0 then handletls(i, n) else closeslot(i);
              end
              else closeslot(i);
            end;
          end;
        end;
      end
      else
      begin
        i := slotof(fd);
        if i >= 0 then
        begin
          n := net.recv(fd, addr(rbuf[0]), BUF);
          if n <= 0 then closeslot(i)
          else if cplain[i] then handleplain(i, n)
          else closeslot(i);
        end;
      end;
      k := k + 1;
    end;

    // THE RENEWAL TIMER, in the same loop and without a cron. It fires on a clock rather
    // than on an event, which is why the wait above has a timeout: a loop that only wakes
    // on I/O never notices that a certificate is expiring on a quiet server.
    if (nextrenew > 0) and (io.realtime div 1000000000 > nextrenew) then
    begin
      io.puts(STDOUT, "serve: renewal is due\n");
      nextrenew := io.realtime div 1000000000 + RENEWEVERY;
    end;
  end;
end;

// ---- start -----------------------------------------------------------------------------
begin
  if argc() < 4 then
  begin
    io.puts(STDERR, "usage: serve <port80> <port443> <hostname>\n");
    halt(2);
  end;
  hostn := io.argstr(3, host);

  // THE TRUST STORE, for talking OUT to the authority. A server needs it as much as a
  // client does: the ACME exchange is HTTPS, and an unverified connection to a CA is a
  // connection to whoever is in the way.
  if ch.addsystem <= 0 then die("no trusted roots; cannot talk to an authority");

  ep := net.epoll;
  if ep < 0 then die("cannot make an epoll");

  lfd80 := net.listen(io.argn(1), 128, false);
  if lfd80 < 0 then die("cannot listen on the plain port");
  if not net.watch(ep, EPOLL_ADD, lfd80, EPOLLIN) then die("cannot watch the plain port");

  lfd443 := net.listen(io.argn(2), 128, false);
  if lfd443 < 0 then die("cannot listen on the TLS port");
  if not net.watch(ep, EPOLL_ADD, lfd443, EPOLLIN) then die("cannot watch the TLS port");

  // LOAD A CERTIFICATE IF THERE IS ONE BESIDE US. This is the restart case: a server that
  // obtained a certificate yesterday must come back up serving it, without asking the
  // authority again. The files are a CACHE -- the key lives in memory once loaded, and a
  // read-only disk means no renewal rather than no service.
  havecert := loadcert;
  if havecert then io.puts(STDOUT, "serve: certificate loaded from disk\n");
  tokenn := 0;
  keyauthn := 0;
  nextrenew := io.realtime div 1000000000 + RENEWEVERY;

  // SAY WHAT THE STATE ACTUALLY IS. The first version printed "no certificate yet"
  // unconditionally, right after printing that it had loaded one -- two lines that
  // contradicted each other, which is worse than either alone.
  if havecert then io.puts(STDOUT, "serve: listening, HTTP and HTTPS\n")
  else io.puts(STDOUT, "serve: listening on HTTP only, no certificate yet\n");
  loop;
end.
