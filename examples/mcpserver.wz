// mcpserver.wz -- a Model Context Protocol server.
//
//   mcpserver              speak MCP over stdin/stdout (how editors run it)
//   mcpserver --http 8080  serve MCP over HTTP on that port
//
// The tools are declared in one `tools` block (see examples/mcptools.wz for the
// pattern in full); this example adds `wordcount`, which decodes its text once
// and scans it itself instead of only echoing or summing what it is given.
// (Named `wordcount` and not `count`: a `tools` block turns the tool name
// directly into its handler `tool.<name>`, and `tool.count` is already the
// compiler-generated number of tools, so a tool literally named `count`
// cannot be declared.)


include "mcphttp.wz";

// ---- tool argument and result shapes --------------------------------

type AddArgs = schema
  a: int "the left operand";
  b: int "the right operand";
end;

type AddResult = schema
  sum: int;
end;

type EchoArgs = schema
  text: text[65536] "the text to return";
end;

type EchoResult = schema
  text: text;
end;

type CountArgs = schema
  text: text[65536] "the text to count";
  word: text[255]? "a word to count occurrences of";
end;

type CountResult = schema
  text: text;
end;

// ---- the tools -------------------------------------------------------

tools
  add(AddArgs): AddResult "Add two whole numbers." readonly idempotent;
  echo(EchoArgs): EchoResult "Return the text it is given." readonly idempotent;
  wordcount(CountArgs): CountResult "Count characters, words, and optionally how often a word occurs." readonly idempotent;
end;

include "tools.wz";

function tool.add(a: array of AddArgs; r: array of AddResult): int;
begin
  r[0].sum := a[0].a + a[0].b;
  return 0;
end;

function tool.echo(a: array of EchoArgs; r: array of EchoResult): int;
var at: int;
begin
  at := tool.vn;
  at := json.escslice(tool.vbuf, at, a[0].text, 0, a[0].text_n);
  r[0].text_at := tool.vn; r[0].text_end := at; tool.vn := at;
  return 0;
end;

// text[wstart..wend) equals word[0..wlen), byte for byte
function app.same(text: array of char; wstart: int; wend: int; word: array of char; wlen: int): bool;
var i: int;
begin
  if wend - wstart <> wlen then return false;
  i := 0;
  while i < wlen do
  begin
    if text[wstart + i] <> word[i] then return false;
    i := i + 1;
  end;
  return true;
end;

// Count characters and words in the given text, and how often the needle
// occurs if one was given.
function tool.wordcount(a: array of CountArgs; r: array of CountResult): int;
var i, n, wlen, words, hits, wstart, at: int;
    inword: bool;
begin
  words := 0;
  hits := 0;
  inword := false;
  wstart := 0;
  n := a[0].text_n;
  wlen := 0;
  if a[0].word_ok then wlen := a[0].word_n;
  i := 0;
  while i <= n do
  begin
    if (i = n) or (a[0].text[i] = ' ') or (a[0].text[i] = chr(10))
       or (a[0].text[i] = chr(9)) or (a[0].text[i] = chr(13)) then
    begin
      if inword then
      begin
        words := words + 1;
        if (wlen > 0) and app.same(a[0].text, wstart, i, a[0].word, wlen) then hits := hits + 1;
      end;
      inword := false;
    end
    else if not inword then
    begin
      inword := true;
      wstart := i;
    end;
    i := i + 1;
  end;
  at := tool.vn;
  at := io.pushnum(tool.vbuf, at, n);
  at := io.push(tool.vbuf, at, " characters, ");
  at := io.pushnum(tool.vbuf, at, words);
  at := io.push(tool.vbuf, at, " words");
  if wlen > 0 then
  begin
    at := io.push(tool.vbuf, at, ", ");
    at := io.pushnum(tool.vbuf, at, hits);
    at := io.push(tool.vbuf, at, " of them ");
    at := json.escslice(tool.vbuf, at, a[0].word, 0, wlen);
  end;
  r[0].text_at := tool.vn; r[0].text_end := at; tool.vn := at;
  return 0;
end;

// ---- HTTP transport ---------------------------------------------------

procedure app.request;
begin
  if tool.rest("/tools/") then return;
  mcp.http;
end;

// ---- start -------------------------------------------------------------

var
  port, i: int;
  usehttp: bool;
  c: char;

begin
  mcp.name := "wantzel-mcp";
  mcp.version := "1.0";
  usehttp := false;
  port := 8080;
  if argc() > 1 then
  begin
    if (argch(1, 0) = '-') and (argch(1, 2) = 'h') then
    begin
      usehttp := true;
      if argc() > 2 then
      begin
        port := 0;
        i := 0;
        while true do
        begin
          c := argch(2, i);
          if c = chr(0) then break;
          if (c >= '0') and (c <= '9') then port := port * 10 + (ord(c) - 48);
          i := i + 1;
        end;
        if port = 0 then port := 8080;
      end;
    end;
  end;
  if usehttp then
  begin
    io.puts(STDERR, "wantzel-mcp listening on http://127.0.0.1:");
    io.putn(STDERR, port);
    io.puts(STDERR, "/\n");
    http.serve(port, 4);
  end
  else mcp.stdio;
end.
