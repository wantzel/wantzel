# What build.sh produces: the compiler itself, and the bootstrap that built it. The whole
# point is that you can rebuild them from bootstrap/boot.c, so they do not belong in git.
/bin/

# Temporary output of the toolchain tests.
/tmp/

# What a library test writes to have a real file to work on. A test RUNS in its own
# temporary directory, but running one by hand from the repository root leaves this here --
# twice now, and both times it reached a commit.
/fs_map_proef.txt

# Never a token in a repository. This is a safety net: nothing here reads a .env, but
# if a copy ever drifts in, it must not be committed.
.env

# Built once per worktree by tests/lib/portlib.sh, from tests/helpers/freeport.wz. Not
# reproducible-output like /bin/wantzel (it's a test tool, not the compiler), but the same
# reasoning applies: it's a build product, not a source.
/tests/helpers/.freeport-bin

# Worktrees for parallel work. They belong OUTSIDE the repository, in a directory next to
# it, where no repository sees them. This is the safety net in case one is ever created
# inside: a worktree in a commit would carry the whole tree twice, and this repository
# is public.
/wt-*/
/worktrees/
