# What build.sh produces: the compiler itself, and the bootstrap that built it. The whole
# point is that you can rebuild them from bootstrap/boot.c, so they do not belong in git.
/bin/

# Temporary output of the toolchain tests.
/tmp/

# Generated from lib/ by bootstrap/tools/embedlib.wz, every time build.sh runs. It is 227 kB of
# machine-written source: committing it would double the diff of every library change
# for no gain, and a fresh clone builds it before it is needed.
# tests/toolchain/embedded_lib_current.sh fails if it is stale.
/src/embedded.wz

# Never a token in a repository. This is a safety net: nothing here reads a .env, but
# if a copy ever drifts in, it must not be committed.
.env

# Worktrees for parallel work. They belong OUTSIDE the repository, in wstack/ itself,
# where no repository sees them. This is the safety net in case one is ever created
# inside: a worktree in a commit would carry the whole tree twice, and this repository
# is public.
/wt-*/
/worktrees/
