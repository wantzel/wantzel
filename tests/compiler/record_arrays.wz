// records in arrays, nested records, arrays inside records, array-of-record parameters, bounds checks.
import io;
type
  Vec = record
    x, y: real;
  end;
  Body = record
    id: int;
    pos, vel: Vec;
    tags: array[0..3] of int;
    label: array[0..7] of char;
  end;
var
  bodies: array[1..3] of Body;
  i: int;
  s: real;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
procedure step(bs: array of Body; dt: real);
var i: int;
begin
  i := 0;
  while i < len(bs) do
  begin
    bs[i].pos.x := bs[i].pos.x + bs[i].vel.x * dt;
    bs[i].pos.y := bs[i].pos.y + bs[i].vel.y * dt;
    bs[i].tags[0] := bs[i].tags[0] + 1;
    i := i + 1;
  end;
end;
function sumx(bs: array of Body): real;
var i: int; t: real;
begin
  i := 0;
  while i < len(bs) do begin t := t + bs[i].pos.x; i := i + 1; end;
  return t;
end;
begin
  i := 1;
  while i <= 3 do
  begin
    bodies[i].id := i;
    bodies[i].pos.x := real(i);
    bodies[i].pos.y := 0.0;
    bodies[i].vel.x := 1.0;
    bodies[i].vel.y := real(i) * 2.0;
    bodies[i].tags[3] := i * 100;
    bodies[i].label[0] := chr(64 + i);
    i := i + 1;
  end;
  step(bodies, 0.5);
  step(bodies, 0.5);
  show("b1.pos.x x10 = ", trunc(bodies[1].pos.x * 10.0));     // 1+1 = 2 -> 20
  show("b3.pos.y x10 = ", trunc(bodies[3].pos.y * 10.0));     // 6 -> 60
  show("b2.tags[0] = ", bodies[2].tags[0]);                    // 2
  show("b2.tags[3] = ", bodies[2].tags[3]);                    // 200
  show("b3.label[0] = ", ord(bodies[3].label[0]));             // 67
  s := sumx(bodies);
  show("sumx x10 = ", trunc(s * 10.0));                        // (2+3+4)*10 = 90
  show("len(tags) = ", len(bodies[2].tags));
  show("size = ", addr(bodies[2]) - addr(bodies[1]));          // 8 + 16 + 16 + 32 + 8 = 80
  bodies[1] := bodies[3];
  show("b1.id after copy = ", bodies[1].id);                   // 3
  i := 4;
  bodies[i].id := 0;                                           // runtime error
end.
