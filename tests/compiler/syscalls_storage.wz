// The storage system calls, identical on Linux and Windows: files that are
// created, appended, truncated, renamed and deleted; fsync; lseek; anonymous
// and file-backed mmap through view(); flock; getrandom; the realtime clock.
program t;
include "io.wz";
var
  name1, name2, dirn: array[0..31] of char;
  buf: array[0..63] of char;
  rnd1, rnd2: array[0..15] of char;
  fd, n, i, p, same: int;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
function readall(path: array of char): int;
var fd, n: int;
begin
  fd := sys3(SYS.open, addr(path[0]), O_RDONLY, 0);
  if fd < 0 then return -1;
  n := sys3(SYS.read, fd, addr(buf[0]), 64);
  sys1(SYS.close, fd);
  return n;
end;
function fill(m: array of char): int;
var i, s: int;
begin
  for i := 0 to len(m) - 1 do m[i] := chr(i mod 251);
  s := 0;
  for i := 0 to len(m) - 1 do s := s + ord(m[i]);
  return s;
end;
begin
  n := io.push(name1, 0, "sc_test1.tmp"); name1[n] := chr(0);
  n := io.push(name2, 0, "sc_test2.tmp"); name2[n] := chr(0);
  n := io.push(dirn, 0, "sc_dir.tmp"); dirn[n] := chr(0);
  { create, write, append }
  fd := sys3(SYS.open, addr(name1[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd > 0 then show("create fd ok ", 1) else show("create fd ok ", 0);
  show("write ", sys3(SYS.write, fd, sadr("hello"), 5));
  show("fsync ", sys1(SYS.fsync, fd));
  sys1(SYS.close, fd);
  fd := sys3(SYS.open, addr(name1[0]), bor(O_WRONLY, O_APPEND), 0);
  show("append ", sys3(SYS.write, fd, sadr(" world"), 6));
  sys1(SYS.close, fd);
  n := readall(name1);
  io.out(STDOUT, addr(buf[0]), n); io.puts(STDOUT, "\n");
  { lseek and truncate }
  fd := sys3(SYS.open, addr(name1[0]), O_RDWR, 0);
  show("lseek end = ", sys3(SYS.lseek, fd, 0, SEEK_END));
  show("lseek 6 = ", sys3(SYS.lseek, fd, 6, SEEK_SET));
  n := sys3(SYS.read, fd, addr(buf[0]), 64);
  io.out(STDOUT, addr(buf[0]), n); io.puts(STDOUT, "\n");
  show("ftruncate ", sys2(SYS.ftruncate, fd, 5));
  show("flock ex ", sys2(SYS.flock, fd, LOCK_EX));
  show("flock un ", sys2(SYS.flock, fd, LOCK_UN));
  sys1(SYS.close, fd);
  n := readall(name1);
  io.out(STDOUT, addr(buf[0]), n); io.puts(STDOUT, "\n");
  { rename }
  show("rename ", sys2(SYS.rename, addr(name1[0]), addr(name2[0])));
  show("old gone ", readall(name1));
  n := readall(name2);
  io.out(STDOUT, addr(buf[0]), n); io.puts(STDOUT, "\n");
  { file-backed mmap, read-only }
  fd := sys3(SYS.open, addr(name2[0]), O_RDONLY, 0);
  p := sys6(SYS.mmap, 0, 5, PROT_READ, MAP_SHARED, fd, 0);
  if p > 0 then show("file mmap byte 1 = ", peek(p + 1)) else show("file mmap failed ", p);
  show("munmap ", sys2(SYS.munmap, p, 5));
  sys1(SYS.close, fd);
  { anonymous mmap of 1 MB, filled through a view }
  p := sys6(SYS.mmap, 0, 1048576, bor(PROT_READ, PROT_WRITE), bor(MAP_PRIVATE, MAP_ANONYMOUS), -1, 0);
  if p > 0 then show("anon mmap sum = ", fill(view(p, 1048576))) else show("anon mmap failed ", p);
  show("munmap ", sys2(SYS.munmap, p, 1048576));
  { directories and deletion }
  show("mkdir ", sys2(SYS.mkdir, addr(dirn[0]), 493));
  show("rmdir ", sys1(SYS.rmdir, addr(dirn[0])));
  show("unlink ", sys1(SYS.unlink, addr(name2[0])));
  show("gone ", readall(name2));
  { randomness and the clock }
  show("getrandom ", sys3(SYS.getrandom, addr(rnd1[0]), 16, 0));
  show("getrandom ", sys3(SYS.getrandom, addr(rnd2[0]), 16, 0));
  same := 0;
  for i := 0 to 15 do if rnd1[i] = rnd2[i] then same := same + 1;
  if same < 16 then show("random differs ", 1) else show("random differs ", 0);
  if io.realtime > 1700000000000000000 then show("realtime after 2023 ", 1) else show("realtime after 2023 ", 0);
  if io.now > 0 then show("monotonic ", 1) else show("monotonic ", 0);
end.
