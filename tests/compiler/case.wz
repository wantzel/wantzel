// case on int and char, multiple labels, constants as labels, else, nesting, inside loops.
program t;
include "io.wz";
const
  THREE = 3;
  QUOTE = '"';
var
  i, hits: int;
  c: char;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
function classify(n: int): int;
begin
  case n of
    0: return 100;
    1, 2: return 200;
    THREE: return 300;
    -1: return 400;
  else
    return 500;
  end;
end;
function kind(ch: char): int;
begin
  case ch of
    'a', 'e', 'i', 'o', 'u': return 1;
    QUOTE: return 3;
    '0': return 4;
  end;
  return 2;
end;
begin
  show("classify(0) = ", classify(0));
  show("classify(2) = ", classify(2));
  show("classify(3) = ", classify(3));
  show("classify(-1) = ", classify(-1));
  show("classify(9) = ", classify(9));
  show("kind(a) = ", kind('a'));
  show("kind(z) = ", kind('z'));
  show("kind(quote) = ", kind('"'));
  show("kind(0) = ", kind('0'));
  hits := 0;
  i := 0;
  while i < 10 do
  begin
    case i mod 4 of
      0: hits := hits + 1;
      1: begin hits := hits + 10; if i > 5 then begin i := i + 1; continue; end; end;
      2: case i of
           2: hits := hits + 100;
           6: hits := hits + 1000;
         end;
    else
      hits := hits + 10000;
    end;
    i := i + 1;
  end;
  show("hits = ", hits);          { i=0:1 1:10 2:100 3:10000 4:1 5:10 6:1000 7:10000 8:1 9:10(+skip) = 21133 }
  c := 'e';
  case c of 'e': show("c is e ", 1); else show("c is e ", 0); end;
end.
