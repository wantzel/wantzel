// schema.wz -- the compiled schema parser, end to end.

include "json.wz";

type Msg = schema
  jsonrpc: text;
  id:      int?;
  method:  text of ("initialize", "tools/list", "tools/call", "ping");
  params:  json?;
  loud:    bool?;
end;

var
  m: Msg;
  doc: array[0..2047] of char;
  n: int;

procedure load(s: str);
var i: int;
begin
  n := slen(s);
  i := 0;
  while i < n do
  begin
    doc[i] := schar(s, i);
    i := i + 1;
  end;
end;

procedure show;
var r: int;
begin
  r := Msg.parse(doc, 0, n, m);
  if r < 0 then
  begin
    io.puts(STDOUT, "rejected\n");
    return;
  end;
  io.puts(STDOUT, "method=");
  io.putn(STDOUT, m.method);
  io.puts(STDOUT, " id=");
  if m.id_ok then io.putn(STDOUT, m.id) else io.puts(STDOUT, "-");
  io.puts(STDOUT, " loud=");
  if m.loud_ok then
  begin
    if m.loud then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  end
  else io.puts(STDOUT, "-");
  io.puts(STDOUT, " params=");
  if m.params_ok then io.out(STDOUT, addr(doc[m.params_at]), m.params_end - m.params_at)
  else io.puts(STDOUT, "-");
  io.puts(STDOUT, "\n");
end;

// Same parse, but reporting _ok and _null per field: the distinction between
// "the key was absent" and "the key was present with the value null".
procedure shownull;
var r: int;
begin
  r := Msg.parse(doc, 0, n, m);
  if r < 0 then
  begin
    io.puts(STDOUT, "rejected\n");
    return;
  end;
  io.puts(STDOUT, "accepted");
  io.puts(STDOUT, " id_ok=");
  if m.id_ok then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  io.puts(STDOUT, " id_null=");
  if m.id_null then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  io.puts(STDOUT, " loud_ok=");
  if m.loud_ok then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  io.puts(STDOUT, " loud_null=");
  if m.loud_null then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  io.puts(STDOUT, " params_ok=");
  if m.params_ok then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  io.puts(STDOUT, " params_null=");
  if m.params_null then io.puts(STDOUT, "yes") else io.puts(STDOUT, "no");
  io.puts(STDOUT, "\n");
end;

// the key the last parse refused, or "-" when it failed on something else
procedure badkey;
begin
  io.puts(STDOUT, "  badkey=");
  if json.badkey1 > json.badkey0 then io.out(STDOUT, addr(doc[json.badkey0]), json.badkey1 - json.badkey0)
  else io.puts(STDOUT, "-");
  io.puts(STDOUT, "\n");
end;

// the first key the last parse IGNORED and how many there were, or "-" when it declared
// every key it was given
procedure ignored;
begin
  io.puts(STDOUT, "  ignored=");
  if json.ignoredn > 0 then io.out(STDOUT, addr(doc[json.ignored0]), json.ignored1 - json.ignored0)
  else io.puts(STDOUT, "-");
  io.puts(STDOUT, " n=");
  io.putn(STDOUT, json.ignoredn);
  io.puts(STDOUT, "\n");
end;

begin
  load("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"a\":1}}");
  show;
  // whitespace everywhere, and a value that contains a } inside a string: the skipper
  // must not end the object there.  This used to use an UNDECLARED key for the nesting,
  // which no longer parses at all, so it rides on params, which is json.
  load("{ \"method\":\"ping\" , \"params\":[1,{\"x\":\"}\"}], \"jsonrpc\":\"2.0\", \"id\":-3, \"loud\":true }");
  show;
  // An UNDECLARED key is SKIPPED, not refused: a caller may send a superset of what the
  // schema declares and still be answered.  But it is RECORDED, so a renamed or removed
  // field does not vanish -- the layer above can name what it dropped instead of
  // returning a normal answer computed with the default in silence.
  load("{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"extra\":1}");
  show;
  ignored;
  // whatever the undeclared value holds, including a nested object with a '}' inside a
  // string: the skipper walks it rather than stopping at the first brace it sees
  load("{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"extra\":[1,{\"x\":\"}\"}]}");
  show;
  ignored;
  // a key that differs only in case is a DIFFERENT JSON key: JSON is case-sensitive even
  // though Wantzel identifiers are not.  So this does NOT fill `method` -- it is ignored
  // like any other undeclared key, and the required `method` is then missing.
  load("{\"jsonrpc\":\"2.0\",\"Method\":\"ping\"}");
  show;
  ignored;
  // two undeclared keys: the first is the one named, and both are counted
  load("{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"aaa\":1,\"bbb\":2}");
  show;
  ignored;
  // and a clean object leaves nothing behind from the parse before it
  load("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}");
  show;
  badkey;
  ignored;
  // A DECLARED key with a value the schema cannot hold is still refused, even in a
  // document that also carries an undeclared key: tolerance is for keys the schema does
  // not know, never for values it cannot hold.  Here `method` is a text and gets a
  // number, which its own arm refuses before the undeclared key is ever reached.
  load("{\"jsonrpc\":\"2.0\",\"method\":5,\"extra\":1}");
  show;
  // and it names the DECLARED field it choked on -- badkey is now only ever that, since
  // an undeclared key is no longer a failure at all
  badkey;
  // and a required field that is ONLY present as an undeclared lookalike is missing,
  // which is what keeps a renamed REQUIRED field from slipping through as a default
  load("{\"jsonrpc\":\"2.0\",\"methodd\":\"ping\"}");
  show;
  ignored;
  load("{\"jsonrpc\":\"2.0\",\"method\":\"initialize\"}");
  show;
  load("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\"}");
  show;
  load("{\"id\":1,\"method\":\"ping\"}");
  show;
  load("{\"jsonrpc\":\"2.0\",\"method\":");
  show;
  load("[1,2,3]");
  show;
  // A required field given as JSON null is not a value: it must be rejected,
  // exactly as an absent key is.  _ok alone only says the key was present.
  load("{\"jsonrpc\":null,\"method\":\"ping\"}");
  show;
  load("{\"jsonrpc\":\"2.0\",\"method\":null}");
  show;
  // An OPTIONAL field given as null still parses and sets both _ok and _null.
  // The `_ok and not _null` idiom rests on this; it must not change.
  load("{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":null,\"loud\":null,\"params\":null}");
  shownull;
  // And with those optional keys absent, _ok and _null are both false.
  load("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}");
  shownull;
  io.puts(STDOUT, "constants: ");
  io.putn(STDOUT, Msg.method.initialize);
  io.putn(STDOUT, Msg.method.tools_list);
  io.putn(STDOUT, Msg.method.tools_call);
  io.putn(STDOUT, Msg.method.ping);
  io.puts(STDOUT, " fields=");
  io.putn(STDOUT, Msg.fields);
  io.puts(STDOUT, "\n");
end.
