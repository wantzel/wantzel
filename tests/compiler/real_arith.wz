// real: literals, + - * /, unary minus, comparisons, constants.
// Reals are printed through trunc/round so the test needs no formatter.
import io;
const
  PI = 3.14159265358979;
  NEG = -2.5;
  K = 1e3;
var
  a, b, c: real;
  i: int;
  ok: bool;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
function half(x: real): real;
begin
  return x / 2.0;
end;
begin
  a := 1.5; b := 2.25;
  c := a + b;                     show("1.5+2.25 x100 = ", trunc(c * 100.0));       // 375
  c := a - b;                     show("1.5-2.25 x100 = ", trunc(c * 100.0));       // -75
  c := a * b;                     show("1.5*2.25 x1000 = ", trunc(c * 1000.0));     // 3375
  c := b / a;                     show("2.25/1.5 x100 = ", trunc(c * 100.0));       // 150
  c := -a;                        show("-1.5 x10 = ", trunc(c * 10.0));             // -15
  c := PI * 2.0;                  show("2pi x1000 = ", trunc(c * 1000.0));          // 6283
  c := NEG * K;                   show("-2.5e3 = ", trunc(c));                      // -2500
  c := 0.1 + 0.2;
  ok := c = 0.3;                  if ok then show("0.1+0.2=0.3 ", 1) else show("0.1+0.2=0.3 ", 0);   // 0
  ok := c > 0.3;                  if ok then show("0.1+0.2>0.3 ", 1) else show("0.1+0.2>0.3 ", 0);   // 1
  ok := a < b;                    if ok then show("1.5<2.25 ", 1) else show("1.5<2.25 ", 0);         // 1
  ok := a <= 1.5;                 if ok then show("1.5<=1.5 ", 1) else show("1.5<=1.5 ", 0);         // 1
  ok := a >= b;                   if ok then show("1.5>=2.25 ", 1) else show("1.5>=2.25 ", 0);       // 0
  ok := a <> b;                   if ok then show("1.5<>2.25 ", 1) else show("1.5<>2.25 ", 0);       // 1
  c := half(7.0);                 show("half(7) x10 = ", trunc(c * 10.0));          // 35
  c := 2.0 * 3.0 + 4.0 / 8.0;     show("2*3+4/8 x10 = ", trunc(c * 10.0));         // 65
  c := (1.0 - 3.0) * 2.5;         show("(1-3)*2.5 = ", trunc(c));                  // -5
  i := 0; c := 0.0;
  while i < 10 do begin c := c + 0.1; i := i + 1; end;
  show("sum of ten 0.1, x1e6 = ", round(c * 1000000.0));                           // 1000000
  show("123456789.0 = ", trunc(123456789.0));
  show("1.5e-3 x1e6 = ", trunc(1.5e-3 * 1000000.0));                               // 1500
end.
