// snipex.wz -- pull one snippet body out of the VS Code snippet file, with the
// placeholders resolved the way an editor fills them when you tab straight through.
//
//   snipex <snippets.json> <prefix>
//
// Written in Wantzel rather than in sed or Python: tooling that lives in this repository
// is written in the language (CLAUDE.md), and sed turned out to be the wrong tool anyway
// -- an attempt with sed produced the whole JSON string as one line and the test failed
// on a "newline in string literal" that came from the extractor, not the snippet.
//
// ${1:name} becomes name, a bare $0 or $1 vanishes, and \" and \n in the JSON become a
// quote and a newline. That is what a user gets by pressing tab through.

include "io.wz";
include "json.wz";
include "kv.wz";

var
  src: array[0..65535] of char;
  out: array[0..65535] of char;
  want: array[0..63] of char;
  path: array[0..1023] of char;
  n, wn, i, fd, cur, at, upto: int;
  found: bool;

// write out[0..n) and a newline
procedure emit(b: array of char; upto: int);
begin
  if upto > 0 then io.out(STDOUT, addr(b[0]), upto);
  io.puts(STDOUT, "\n");
end;

// Copy the JSON string body src[a..b) into out at `at`, resolving placeholders.
// Returns the new length.
function expand(a: int; b: int; at: int): int;
var i, j: int;
    c: char;
begin
  i := a;
  while i < b do
  begin
    c := src[i];
    if (c = '\\') and (i + 1 < b) then
    begin
      i := i + 1;
      c := src[i];
      if c = 'n' then begin out[at] := chr(10); at := at + 1; end
      else if c = 't' then begin out[at] := chr(9); at := at + 1; end
      else begin out[at] := c; at := at + 1; end;
      i := i + 1;
    end
    else if c = '$' then
    begin
      i := i + 1;
      if (i < b) and (src[i] = '{') then
      begin
        // ${N:default} -> default
        i := i + 1;
        while (i < b) and (src[i] <> ':') and (src[i] <> '}') do i := i + 1;
        if (i < b) and (src[i] = ':') then
        begin
          i := i + 1;
          while (i < b) and (src[i] <> '}') do
          begin
            out[at] := src[i]; at := at + 1; i := i + 1;
          end;
        end;
        if (i < b) and (src[i] = '}') then i := i + 1;
      end
      else
        // $0, $1 -- nothing to insert
        while (i < b) and (src[i] >= '0') and (src[i] <= '9') do i := i + 1;
    end
    else begin out[at] := c; at := at + 1; i := i + 1; end;
  end;
  return at;
end;

begin
  if argc() < 3 then begin io.puts(STDERR, "usage: snipex <snippets.json> <prefix>\n"); halt(2); end;
  i := 0;
  while argch(1, i) <> chr(0) do begin path[i] := argch(1, i); i := i + 1; end;
  path[i] := chr(0);
  wn := 0;
  while argch(2, wn) <> chr(0) do begin want[wn] := argch(2, wn); wn := wn + 1; end;

  fd := sys3(SYS.open, addr(path[0]), O_RDONLY, 0);
  if fd < 0 then begin io.puts(STDERR, "snipex: cannot open the snippet file\n"); halt(1); end;
  n := io.read(fd, addr(src[0]), len(src));
  sys1(SYS.close, fd);
  if n <= 0 then begin io.puts(STDERR, "snipex: the snippet file is empty\n"); halt(1); end;

  // walk the top-level object: every value is a snippet with a "prefix" and a "body"
  found := false;
  cur := kv.first(src, 0, n);
  while (cur >= 0) and not found do
  begin
    at := kv.vat; upto := kv.vend;
    if kv.find(src, at, upto, "prefix") then
      if kv.same(src, kv.vat, kv.vend, want, 0, wn) or
         ((kv.vend - kv.vat = wn + 2) and (src[kv.vat] = '"')) then
      begin
        // compare the text of the prefix with what was asked for
        i := 0;
        found := true;
        while i < wn do
        begin
          if src[kv.vat + 1 + i] <> want[i] then found := false;
          i := i + 1;
        end;
        if kv.vend - kv.vat <> wn + 2 then found := false;
      end;
    if found then
    begin
      if not kv.find(src, at, upto, "body") then
      begin
        io.puts(STDERR, "snipex: that snippet has no body\n"); halt(1);
      end;
      // the body is an array of strings; print each, joined by newlines
      i := kv.vat + 1;
      upto := kv.vend - 1;
      at := 0;
      while i < upto do
      begin
        if src[i] = '"' then
        begin
          cur := json.strend(src, i + 1, upto);
          if cur < 0 then begin io.puts(STDERR, "snipex: malformed body\n"); halt(1); end;
          at := expand(i + 1, cur, at);
          out[at] := chr(10); at := at + 1;
          i := cur + 1;
        end
        else i := i + 1;
      end;
      if at > 0 then io.out(STDOUT, addr(out[0]), at);
      halt(0);
    end;
    cur := kv.next(src, cur, n);
  end;
  io.puts(STDERR, "snipex: no snippet with that prefix\n");
  halt(1);
end.
