// procnet <port> -- the process and network system calls a server needs at startup,
// printed so the ELF and the .exe can be compared line for line.
//
//   getpid     a server writes its pid to a lock file before it serves anything
//   kill(p,0)  and asks whether the pid in an old lock file is still alive
//   connect    a client socket, to a listening port and to a closed one
//   nanosleep  sleeps for the time asked, not for a fixed moment
//
// The pid itself differs per run and per platform, so only its sign is printed.
include "io.wz";
include "proc.wz";
include "net.wz";

var
  me, port, lfd, cfd, afd, r, t0, ms: int;
  ts: array[0..15] of char;

procedure say(what: str; n: int);
begin
  io.puts(STDOUT, what); io.putn(STDOUT, n); io.puts(STDOUT, "\n");
end;

begin
  port := io.argn(1);
  me := proc.self;
  if me > 0 then io.puts(STDOUT, "own pid: positive\n") else say("own pid: ", me);
  if proc.alive(me) then io.puts(STDOUT, "alive(own pid): yes\n") else io.puts(STDOUT, "alive(own pid): no\n");
  if proc.alive(999999) then io.puts(STDOUT, "alive(999999): yes\n") else io.puts(STDOUT, "alive(999999): no\n");
  say("kill(999999, 15): ", proc.kill(999999, 15));

  lfd := net.listen(port, 8, false);
  if lfd < 0 then begin say("listen: ", lfd); halt(1); end;
  cfd := net.connect(127, 0, 0, 1, port);
  if cfd >= 0 then io.puts(STDOUT, "connect to a listening port: ok\n") else say("connect to a listening port: ", cfd);
  afd := net.accept(lfd);
  if afd >= 0 then io.puts(STDOUT, "accept: ok\n") else say("accept: ", afd);
  say("connect to a closed port: ", net.connect(127, 0, 0, 1, port + 1));

  // 300 ms: long enough that a sleep of 1 ms cannot pass for it
  ts[8] := chr(band(300000000, 255));
  ts[9] := chr(band(300000000 shr 8, 255));
  ts[10] := chr(band(300000000 shr 16, 255));
  ts[11] := chr(band(300000000 shr 24, 255));
  t0 := io.now;
  r := sys2(SYS.nanosleep, addr(ts[0]), 0);
  ms := (io.now - t0) div 1000000;
  if ms >= 290 then io.puts(STDOUT, "nanosleep 300 ms: slept at least 290 ms\n") else say("nanosleep 300 ms: slept only ms ", ms);
end.
