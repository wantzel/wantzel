// The client for epollsets.wz: connect to port A, then to port B, and hold both open
// until the server exits. Exit 2 or 3 when a connect fails, so a caller can retry while
// the server is still starting.
include "net.wz";
var
  buf: array[0..15] of char;
  fa, fb: int;
function arg(k: int): int;
var i, v: int;
begin
  v := 0;
  i := 0;
  while argch(k, i) <> chr(0) do
  begin
    v := v * 10 + (ord(argch(k, i)) - 48);
    i := i + 1;
  end;
  return v;
end;
begin
  fa := net.connect(127, 0, 0, 1, arg(1));
  if fa < 0 then halt(2);
  fb := net.connect(127, 0, 0, 1, arg(2));
  if fb < 0 then halt(3);
  // hold both open until the server exits: it never accepts, so this returns then
  if net.recv(fa, addr(buf[0]), 16) < 0 then halt(0);
end.
