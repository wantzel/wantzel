// The examples of docs/memory.md, executed: list with a counter, text arena with
// slices, index-linked nodes with a free list, a hash table on two arrays, view,
// anonymous and file-backed mmap, and a record table as a file format.
program t;
include "io.wz";
const
  MAXITEMS = 1000;
  NIL = -1;
  HSIZE = 1024;
type
  Item = record
    key: int;
    weight: real;
  end;
  Node = record
    value: int;
    next: int;
  end;
var
  items: array[0..MAXITEMS - 1] of Item;
  nitems: int;
  arena: array[0..1048575] of char;
  used: int;
  nodes: array[0..255] of Node;
  free, head: int;
  hkey, hval: array[0..HSIZE - 1] of int;
  hcount: int;
  path: array[0..31] of char;
  p, fd, i, n, at: int;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
// --- §2 list ---
function items.add(key: int; w: real): int;
begin
  if nitems >= MAXITEMS then return -1;
  items[nitems].key := key;
  items[nitems].weight := w;
  nitems := nitems + 1;
  return nitems - 1;
end;
function total(a: array of Item): real;
var i: int; t: real;
begin
  for i := 0 to len(a) - 1 do t := t + a[i].weight;
  return t;
end;
// --- §3 arena ---
function text.store(s: array of char): int;
var i, at: int;
begin
  if used + len(s) > len(arena) then return -1;
  at := used;
  for i := 0 to len(s) - 1 do arena[used + i] := s[i];
  used := used + len(s);
  return at;
end;
procedure put(s: array of char);
begin
  if len(s) > 0 then io.out(STDOUT, addr(s[0]), len(s));
  io.puts(STDOUT, "\n");
end;
// --- §4 nodes ---
procedure nodes.init;
var i: int;
begin
  for i := 0 to len(nodes) - 1 do nodes[i].next := i + 1;
  nodes[len(nodes) - 1].next := NIL;
  free := 0;
  head := NIL;
end;
function nodes.alloc: int;
var i: int;
begin
  if free = NIL then return NIL;
  i := free;
  free := nodes[i].next;
  return i;
end;
procedure nodes.release(i: int);
begin
  nodes[i].next := free;
  free := i;
end;
procedure nodes.push(v: int);
var i: int;
begin
  i := nodes.alloc;
  if i = NIL then return;
  nodes[i].value := v;
  nodes[i].next := head;
  head := i;
end;
function nodes.sum: int;
var i, t: int;
begin
  i := head;
  while i <> NIL do begin t := t + nodes[i].value; i := nodes[i].next; end;
  return t;
end;
// --- §5 hash ---
function hash.slot(key: int): int;
var i: int;
begin
  i := band(key * 2654435761, HSIZE - 1);
  while (hkey[i] <> 0) and (hkey[i] <> key) do i := band(i + 1, HSIZE - 1);
  return i;
end;
function hash.put(key: int; v: int): bool;
var i: int;
begin
  if hcount * 2 >= HSIZE then return false;
  i := hash.slot(key);
  if hkey[i] = 0 then hcount := hcount + 1;
  hkey[i] := key;
  hval[i] := v;
  return true;
end;
function hash.get(key: int): int;
var i: int;
begin
  i := hash.slot(key);
  if hkey[i] = 0 then return -1;
  return hval[i];
end;
// --- §6/§7 view and mmap ---
procedure fill(b: array of char; c: char);
var i: int;
begin
  for i := 0 to len(b) - 1 do b[i] := c;
end;
function sumb(b: array of char): int;
var i, t: int;
begin
  for i := 0 to len(b) - 1 do t := t + ord(b[i]);
  return t;
end;
procedure bump(a: array of Item);
var i: int;
begin
  for i := 0 to len(a) - 1 do a[i].key := a[i].key + 100;
end;
begin
  // §2
  for i := 1 to 10 do n := items.add(i, real(i) * 0.5);
  show("nitems = ", nitems);
  show("total x10 = ", trunc(total(items[0..nitems - 1]) * 10.0));   // 27.5 -> 275
  i := 0;
  while items.add(0, 0.0) >= 0 do i := i + 1;
  show("added until full = ", i);                                     // 990
  // §3
  at := text.store("hello");
  n := text.store(", world");
  put(arena[at..at + 11]);
  show("used = ", used);
  // §4
  nodes.init;
  for i := 1 to 5 do nodes.push(i * 10);
  show("nodes sum = ", nodes.sum);                                    // 150
  i := head; head := nodes[i].next; nodes.release(i);                 // drop the top one (50)
  show("nodes sum after release = ", nodes.sum);                      // 100
  n := 0;
  while nodes.alloc <> NIL do n := n + 1;
  show("free nodes were = ", n);                                      // 252
  // §5
  for i := 1 to 400 do if not hash.put(i * 7919, i) then show("put failed at ", i);
  show("hash get 7919*200 = ", hash.get(7919 * 200));                 // 200
  show("hash get missing = ", hash.get(12345));                       // -1
  show("hash count = ", hcount);
  if hash.put(99, 1) then show("hash full ", 0) else show("hash full ", 1);   // 400*2 < 1024, so it fits: 0
  // §6
  fill(view(addr(arena[8]), 8), 'x');
  show("arena[7] = ", ord(arena[7])); show("arena[8] = ", ord(arena[8]));
  // §7 anonymous
  p := sys6(SYS.mmap, 0, 1048576, bor(PROT_READ, PROT_WRITE), bor(MAP_PRIVATE, MAP_ANONYMOUS), -1, 0);
  if p > 0 then begin fill(view(p, 1048576), chr(3)); show("anon sum = ", sumb(view(p, 1048576))); end;
  show("munmap = ", sys2(SYS.munmap, p, 1048576));
  // §8 a record table as a file, read back through mmap
  n := io.push(path, 0, "mp_items.tmp"); path[n] := chr(0);
  fd := sys3(SYS.open, addr(path[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  n := 10 * (addr(items[1]) - addr(items[0]));
  show("written = ", sys3(SYS.write, fd, addr(items[0]), n));
  sys1(SYS.close, fd);
  fd := sys3(SYS.open, addr(path[0]), O_RDWR, 0);
  p := sys6(SYS.mmap, 0, n, bor(PROT_READ, PROT_WRITE), MAP_SHARED, fd, 0);
  bump(view(p, 10));
  show("mapped total x10 = ", trunc(total(view(p, 10)) * 10.0));
  show("msync = ", sys3(SYS.msync, p, n, 4));
  sys2(SYS.munmap, p, n);
  n := sys3(SYS.read, fd, addr(arena[0]), n);                        // the file itself changed
  sys1(SYS.close, fd);
  show("key of item 3 in file = ", io.get64(arena, 3 * 16));         // 4 + 100
  sys1(SYS.unlink, addr(path[0]));
end.
