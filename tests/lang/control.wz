// spec §5: if/else chains, while, repeat, nested break/continue, blocks, halt.
include "io.wz";
var
  i, j, s: int;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
begin
  i := 5;
  if i < 3 then show("branch ", 1)
  else if i < 6 then show("branch ", 2)
  else show("branch ", 3);
  if i = 5 then
  begin
    show("block ", 1);
    show("block ", 2);
  end;
  s := 0; i := 0;
  while i < 10 do
  begin
    i := i + 1;
    if i = 3 then continue;
    if i = 8 then break;
    s := s + i;
  end;
  show("while: s = ", s);         // 1+2+4+5+6+7 = 25
  show("while: i = ", i);         // 8
  s := 0; i := 0;
  while i < 3 do
  begin
    i := i + 1;
    j := 0;
    while j < 5 do
    begin
      j := j + 1;
      if j = 2 then continue;     // continue in a nested loop goes to the inner test
      if j > 3 then break;        // break leaves the inner loop only
      s := s + i * j;
    end;
  end;
  show("nested while: s = ", s);  // i*(1+3) for i=1..3 = 24
  show("nested while: i = ", i);
  i := 0;
  while true do
  begin
    i := i + 1;
    if i >= 4 then break;
  end;
  show("while true: i = ", i);
  io.puts(STDOUT, "before halt\n");
  halt(3);
  io.puts(STDOUT, "not reached\n");
end.
