// lib/kv.wz: a small JSON object as compact text -- isobject, iteration
// (first/next), find, same, match (membership on the filter side, containment
// on the stored side), contains/haselem, merge (jsonb-style) and count, on
// good and malformed input.
include "kv.wz";
var
  ob: array[0..255] of char;      // the object under test
  fb: array[0..255] of char;      // a filter or a patch
  ab: array[0..63] of char;       // left side of same
  bb: array[0..63] of char;       // right side of same
  ob_n, fb_n, ab_n, bb_n: int;
  out: array[0..255] of char;
  tiny: array[0..3] of char;
  cur, res: int;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
procedure yn(s: str; v: bool);
begin
  io.puts(STDOUT, s);
  if v then io.puts(STDOUT, "1\n") else io.puts(STDOUT, "0\n");
end;
// print b[at..upto) followed by a newline
procedure slice(b: array of char; at: int; upto: int);
begin
  if upto > at then io.out(STDOUT, addr(b[at]), upto - at);
  io.puts(STDOUT, "\n");
end;
procedure isobj(s: str);
begin
  ob_n := io.push(ob, 0, s);
  io.puts(STDOUT, "isobject ");
  io.puts(STDOUT, s);
  if kv.isobject(ob, 0, ob_n) then io.puts(STDOUT, " -> 1\n") else io.puts(STDOUT, " -> 0\n");
end;
// decode the value of key k with kv.text and print it, or say it was refused.
// The key goes through a buffer because a str VARIABLE is not an array of char --
// only a literal is (docs/language.md, routines).
procedure text(k: str);
var n: int;
begin
  io.puts(STDOUT, "text ");
  io.puts(STDOUT, k);
  ab_n := io.push(ab, 0, k);
  if not kv.find(ob, 0, ob_n, ab[0..ab_n - 1]) then begin io.puts(STDOUT, " -> no key\n"); return; end;
  n := kv.text(ob, out, 0);
  if n < 0 then begin io.puts(STDOUT, " -> refused\n"); return; end;
  io.puts(STDOUT, " -> [");
  if n > 0 then io.out(STDOUT, addr(out[0]), n);
  io.puts(STDOUT, "]\n");
end;
procedure same(a: str; b: str);
begin
  ab_n := io.push(ab, 0, a);
  bb_n := io.push(bb, 0, b);
  io.puts(STDOUT, "same ");
  io.puts(STDOUT, a);
  io.puts(STDOUT, " ~ ");
  io.puts(STDOUT, b);
  if kv.same(ab, 0, ab_n, bb, 0, bb_n) then io.puts(STDOUT, " -> 1\n") else io.puts(STDOUT, " -> 0\n");
end;
// does the stored value a contain the filter value b?
procedure contains(a: str; b: str);
begin
  ab_n := io.push(ab, 0, a);
  bb_n := io.push(bb, 0, b);
  io.puts(STDOUT, "contains ");
  io.puts(STDOUT, a);
  io.puts(STDOUT, " > ");
  io.puts(STDOUT, b);
  if kv.contains(ab, 0, ab_n, bb, 0, bb_n) then io.puts(STDOUT, " -> 1\n") else io.puts(STDOUT, " -> 0\n");
end;
// is b an element of the array a?
procedure haselem(a: str; b: str);
begin
  ab_n := io.push(ab, 0, a);
  bb_n := io.push(bb, 0, b);
  io.puts(STDOUT, "haselem ");
  io.puts(STDOUT, a);
  io.puts(STDOUT, " ? ");
  io.puts(STDOUT, b);
  if kv.haselem(ab, 0, ab_n, bb, 0, bb_n) then io.puts(STDOUT, " -> 1\n") else io.puts(STDOUT, " -> 0\n");
end;
// match the current ob against the filter f
procedure match(f: str);
begin
  fb_n := io.push(fb, 0, f);
  io.puts(STDOUT, "match ");
  io.puts(STDOUT, f);
  if kv.match(ob, 0, ob_n, fb, 0, fb_n) then io.puts(STDOUT, " -> 1\n") else io.puts(STDOUT, " -> 0\n");
end;
procedure merge(base: str; patch: str);
begin
  ob_n := io.push(ob, 0, base);
  fb_n := io.push(fb, 0, patch);
  io.puts(STDOUT, "merge ");
  io.puts(STDOUT, base);
  io.puts(STDOUT, " + ");
  io.puts(STDOUT, patch);
  io.puts(STDOUT, " -> ");
  res := kv.merge(ob, 0, ob_n, fb, 0, fb_n, out);
  if res < 0 then io.puts(STDOUT, "-1\n") else slice(out, 0, res);
end;
procedure count(s: str);
begin
  ob_n := io.push(ob, 0, s);
  io.puts(STDOUT, "count ");
  io.puts(STDOUT, s);
  io.puts(STDOUT, " -> ");
  io.putn(STDOUT, kv.count(ob, 0, ob_n));
  io.puts(STDOUT, "\n");
end;
begin
  // isobject
  isobj("{\"a\":1}");
  isobj("  {\"a\":1,\"b\":[1,2]}  ");
  isobj("{}");
  isobj(" { } ");
  isobj("");
  isobj("[1]");
  isobj("{\"a\":1} x");
  isobj("{\"a\":1");
  isobj("{\"a\"}");
  isobj("{\"a\":}");
  isobj("{\"a\":1,}");
  isobj("{,}");
  isobj("{a:1}");
  isobj("{\"a\":\"unterminated}");
  isobj("{\"a\":[1,2}");
  isobj("{\"a\":1 \"b\":2}");
  // iteration over three keys with nested values and loose whitespace
  ob_n := io.push(ob, 0, " { \"n\" : 1 , \"arr\" : [1, 2, {\"x\": \"]\"}] , \"obj\" : { \"k\" : \"v\" } } ");
  cur := kv.first(ob, 0, ob_n);
  while cur >= 0 do
  begin
    io.puts(STDOUT, "key ");
    io.out(STDOUT, addr(ob[kv.kat]), kv.kend - kv.kat);
    io.puts(STDOUT, " = ");
    slice(ob, kv.vat, kv.vend);
    cur := kv.next(ob, cur, ob_n);
  end;
  show("first of {} = ", kv.first(ob, 0, io.push(ob, 0, "{}")));
  show("first of junk = ", kv.first(ob, 0, io.push(ob, 0, "junk")));
  // find
  ob_n := io.push(ob, 0, "{\"n\":1,\"arr\":[1,2],\"a\\\"b\":true,\"\":null}");
  yn("find n ", kv.find(ob, 0, ob_n, "n"));
  if kv.find(ob, 0, ob_n, "arr") then begin io.puts(STDOUT, "find arr = "); slice(ob, kv.vat, kv.vend); end;
  yn("find escaped key ", kv.find(ob, 0, ob_n, "a\\\"b"));
  if kv.find(ob, 0, ob_n, "") then begin io.puts(STDOUT, "find empty key = "); slice(ob, kv.vat, kv.vend); end;
  yn("find zz ", kv.find(ob, 0, ob_n, "zz"));
  yn("find ar (prefix) ", kv.find(ob, 0, ob_n, "ar"));
  yn("find in malformed ", kv.find(ob, 0, io.push(ob, 0, "{\"n\":1,\"arr\""), "arr"));
  // same
  same("3", "3");
  same("3", "3.0");
  same("3", "3e0");
  same("3", "\"3\"");
  same("3", "3.5");
  same("-2", "-2.0");
  same("1.5", "1.50");
  same("10", "1e1");
  same("0.1", "0.10");
  same("\"a\"", "\"a\"");
  same("\"a\"", "\"b\"");
  same("\"a\\nb\"", "\"a\\nb\"");
  same("true", "true");
  same("true", "false");
  same("null", "null");
  same("null", "\"null\"");
  same("[1,2]", " [1,2] ");
  same("[1,2]", "[1, 2]");
  same("{\"k\":1}", "{\"k\":1}");
  same("", "");
  same("-", "-");
  // contains / haselem: the containment half on its own
  haselem("[1,2]", "1");
  haselem("[1,2]", "3");
  haselem("[1,2]", "2.0");
  haselem("[\"p\",\"q\"]", "\"q\"");
  haselem("[ 1 , 2 ]", "2");
  haselem("[[1,2],3]", "[1,2]");
  haselem("[]", "1");
  haselem("[1,2", "1");
  haselem("1", "1");
  haselem("", "1");
  contains("[1,2]", "1");
  contains("[1,2]", "3");
  contains("[1,2]", "[1,2]");
  contains("[1,2]", "[2,1]");
  contains("[1,2]", "[1]");
  contains("[1,2]", "[1,3]");
  contains("[1,2]", "[]");
  contains("[]", "[]");
  contains("[]", "[1]");
  contains("[1,2]", "[1,2");
  contains("[\"p\",\"q\"]", "[\"q\",\"p\"]");
  // match
  ob_n := io.push(ob, 0, "{\"a\":1,\"b\":\"x\",\"c\":[1,2],\"d\":{\"k\":1},\"e\":null}");
  match("{\"a\":1}");
  match("{\"a\":1.0}");
  match("{\"a\":2}");
  match("{\"a\":\"1\"}");
  match("{\"b\":[\"y\",\"x\"]}");
  match("{\"b\":[\"y\",\"z\"]}");
  match("{\"b\":[]}");
  match("{\"zz\":1}");
  match("{\"zz\":[1]}");
  match("{\"d\":{\"k\":1}}");
  match("{\"d\":{\"k\":2}}");
  match("{\"c\":[1,2]}");
  match("{\"c\":[[1,2]]}");
  // the containment branch: the stored value is a list
  match("{\"c\":1}");
  match("{\"c\":2}");
  match("{\"c\":3}");
  match("{\"c\":[2,1]}");
  match("{\"c\":[1]}");
  match("{\"c\":[1,3]}");
  match("{\"c\":[]}");
  match("{\"c\":1.0}");
  match("{\"c\":\"1\"}");
  match("{\"c\":1,\"a\":1}");
  match("{\"c\":3,\"a\":1}");
  match("{\"e\":null}");
  match("{\"a\":1,\"b\":\"x\"}");
  match("{\"a\":1,\"b\":\"q\"}");
  match("{}");
  match(" { } ");
  match("{\"a\":1");
  match("{\"a\":[1,2}");
  match("[]");
  match("");
  // a stored list of strings contains itself -- the case that was missing
  ob_n := io.push(ob, 0, "{\"tags\":[\"p\",\"q\"],\"one\":[\"p\"],\"none\":[]}");
  match("{\"tags\":[\"p\",\"q\"]}");
  match("{\"tags\":[\"q\",\"p\"]}");
  match("{\"tags\":\"p\"}");
  match("{\"tags\":\"r\"}");
  match("{\"tags\":[\"p\"]}");
  match("{\"tags\":[\"p\",\"r\"]}");
  match("{\"one\":[\"p\"]}");
  match("{\"none\":[]}");
  match("{\"none\":[\"p\"]}");
  match("{\"none\":\"p\"}");
  // whitespace inside a stored list, and a stored list of objects
  ob_n := io.push(ob, 0, "{\"s\":[ 1 , 2 ],\"o\":[{\"k\":1},{\"k\":2}]}");
  match("{\"s\":[2,1]}");
  match("{\"s\":2}");
  match("{\"o\":{\"k\":1}}");
  match("{\"o\":{\"k\":3}}");
  match("{\"o\":[{\"k\":2}]}");
  // merge
  merge("{\"a\":1,\"b\":\"x\",\"c\":true}", "{\"b\":\"y\",\"d\":[1, 2],\"c\":null,\"zz\":null}");
  merge("{\"a\":1}", "{}");
  merge("{}", "{\"a\":{\"k\":[1]}}");
  merge("{}", "{}");
  merge("", "{\"x\":1,\"y\":null}");
  merge("  ", "{}");
  merge("{\"a\":1,\"b\":2}", "{\"a\":null,\"b\":null}");
  merge(" { \"a\" : 1 , \"b\" : \"s\" } ", " { \"b\" : 2 } ");
  merge("{\"a\":1}", "{\"a\":null,\"a\":3}");
  merge("{\"a\":1", "{}");
  merge("{}", "{\"a\":}");
  merge("[1]", "{}");
  merge("{}", "[1]");
  // overflow: the result {"a":1} needs 7 bytes; tiny holds 4
  ob_n := io.push(ob, 0, "{\"a\":1}");
  fb_n := io.push(fb, 0, "{}");
  show("merge into tiny = ", kv.merge(ob, 0, ob_n, fb, 0, fb_n, tiny));
  show("merge {} into tiny = ", kv.merge(ob, 0, 0, fb, 0, fb_n, tiny));
  show("merge into empty slice = ", kv.merge(ob, 0, ob_n, fb, 0, fb_n, out[0..-1]));
  // merge at an offset through a slice
  out[0] := '#';
  res := kv.merge(ob, 0, ob_n, fb, 0, fb_n, out[1..len(out) - 1]);
  slice(out, 0, 1 + res);
  // count
  count("{}");
  count("{\"a\":1,\"b\":[1,{\"c\":2}],\"d\":{\"e\":1,\"f\":2}}");
  count("{\"a\":{\"b\":1,\"c\":2}}");
  count("{\"a\":1,");
  count("");
  count("{\"a\":1} tail");
  // A routine that only ANSWERS A QUESTION must leave the cursor alone.
  // kv.find positions kv.vat/kv.vend on the stored value; kv.isobject, kv.count and
  // kv.match used to move it, and the caller then read a different value without any
  // error -- two real application bugs came from that.  Each case prints the value
  // the cursor points at AFTER the question, so a regression shows the wrong text and
  // not merely a wrong number.
  ob_n := io.push(ob, 0, "{\"a\":{\"x\":1},\"target\":\"kept\",\"z\":[1,2]}");
  fb_n := io.push(fb, 0, "{\"z\":1}");
  yn("cursor: find target = ", kv.find(ob, 0, ob_n, "target"));
  slice(ob, kv.vat, kv.vend);
  yn("  isobject asked = ", kv.isobject(ob, 0, ob_n));
  slice(ob, kv.vat, kv.vend);
  show("  count asked = ", kv.count(ob, 0, ob_n));
  slice(ob, kv.vat, kv.vend);
  yn("  match asked = ", kv.match(ob, 0, ob_n, fb, 0, fb_n));
  slice(ob, kv.vat, kv.vend);
  // and the same after each question has FAILED: the early returns are the trap
  fb_n := io.push(fb, 0, "{\"nosuch\":1}");
  yn("  match failing = ", kv.match(ob, 0, ob_n, fb, 0, fb_n));
  slice(ob, kv.vat, kv.vend);
  fb_n := io.push(fb, 0, "{\"a\":");
  yn("  match malformed filter = ", kv.match(ob, 0, ob_n, fb, 0, fb_n));
  slice(ob, kv.vat, kv.vend);
  ab_n := io.push(ab, 0, "{\"a\":1");
  yn("  isobject malformed = ", kv.isobject(ab, 0, ab_n));
  slice(ob, kv.vat, kv.vend);
  show("  count malformed = ", kv.count(ab, 0, ab_n));
  slice(ob, kv.vat, kv.vend);
  // kv.text gives the DECODED text of a string value, and refuses anything
  // that is not a string instead of handing back the raw bytes.  Copying kv.vat..kv.vend
  // literally produced text with its quotes still on, which compared unequal to the same
  // word without them and did so silently.
  ob_n := io.push(ob, 0, "{\"s\":\"dryer\",\"esc\":\"a\\\"b\\nc\",\"num\":12,\"obj\":{\"k\":1},\"arr\":[1],\"nul\":null,\"empty\":\"\"}");
  text("s");
  text("esc");
  text("num");
  text("obj");
  text("arr");
  text("nul");
  text("empty");
  // and it refuses rather than overflowing: tiny holds 4 bytes, "dryer" needs 5
  yn("text into tiny found = ", kv.find(ob, 0, ob_n, "s"));
  show("text into tiny = ", kv.text(ob, tiny, 0));
end.
