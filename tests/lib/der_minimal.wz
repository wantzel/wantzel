// lib/der.wz writes DER, not BER: every length in a self-signed certificate and in a CSR is
// in its shortest form.
//
// TOETSGROEP: lib
// DEKT: lib/der.wz lib/csr.wz
//
// WHY THIS IS ITS OWN TEST. The writer used to leave every SEQUENCE with a fixed two-byte
// long-form length, 30 82 00 0A for ten bytes. DER allows one encoding per value, the
// shortest (X.690 §10.1). OpenSSL and curl read the longer form without complaint, so every
// check that used them as the arbiter passed -- while Chromium, whose BoringSSL parses the
// certificate strictly, refused it with a decode_error and showed only
// ERR_SSL_PROTOCOL_ERROR. This walks every element and counts the lengths that are longer
// than they need to be.
//
// THE ELEMENT COUNT IS PRINTED TOO, so a walker that stops early cannot pass by seeing
// nothing. OCTET STRINGs that hold a SEQUENCE (the extension values) are walked as well,
// because the subjectAltName inside one is built with the same writer.
include "io.wz";
include "csr.wz";

var
  d, qx, qy: array[0..P.N-1] of int;
  host: array[0..63] of char;
  hn, bad, seen: int;

// Walk b[at..upto) as a run of TLVs: count each element, and each length that is not minimal.
procedure walk(b: array of char; at: int; upto: int);
var tag, ln, nb, v, i: int;
begin
  while at < upto do
  begin
    if at + 2 > upto then begin bad := bad + 1; return; end;
    tag := ord(b[at]);
    ln := ord(b[at + 1]);
    at := at + 2;
    if ln < 128 then v := ln
    else
    begin
      nb := ln - 128;
      if (nb = 0) or (nb > 2) or (at + nb > upto) then begin bad := bad + 1; return; end;
      v := 0;
      i := 0;
      while i < nb do begin v := v * 256 + ord(b[at + i]); i := i + 1; end;
      at := at + nb;
      // The long form only from 128 up, and two length bytes only from 256 up.
      if v < 128 then bad := bad + 1;
      if (nb = 2) and (v < 256) then bad := bad + 1;
    end;
    seen := seen + 1;
    if at + v > upto then begin bad := bad + 1; return; end;
    if band(tag, 0x20) <> 0 then walk(b, at, at + v);
    if (tag = DER.OCTSTR) and (v > 0) then
    begin
      if b[at] = chr(DER.SEQ) then walk(b, at, at + v);
    end;
    at := at + v;
  end;
end;

procedure report(what: str);
begin
  io.puts(STDOUT, what);
  io.puts(STDOUT, ": ");
  io.putn(STDOUT, seen);
  io.puts(STDOUT, " elements, ");
  io.putn(STDOUT, bad);
  io.puts(STDOUT, " lengths not in the shortest form\n");
end;

begin
  p256.setup;
  hn := io.push(host, 0, "localhost");
  if not p256.genkey(d, qx, qy) then begin io.puts(STDOUT, "genkey failed\n"); halt(1); end;

  csr.setvalidity(1790000000, 10);
  if not csr.selfsign(host, hn, d, qx, qy) then begin io.puts(STDOUT, csr.err); halt(1); end;
  seen := 0;
  bad := 0;
  walk(csr.buf, 0, csr.n);
  report("self-signed certificate");

  if not csr.make(host, hn, d, qx, qy) then begin io.puts(STDOUT, csr.err); halt(1); end;
  seen := 0;
  bad := 0;
  walk(csr.buf, 0, csr.n);
  report("certificate signing request");
end.
