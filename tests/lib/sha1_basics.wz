// SHA-1 against the RFC 3174 test vectors, including the one- and two-block padding
// boundaries -- the padding is where a hand-written hash goes wrong, and it goes wrong
// only for SOME lengths (see lib/sha1.wz).
import io;
import sha1;

var
  digest: array[0..19] of char;
  hexbuf: array[0..39] of char;
  million: array[0..999999] of char;
  block64: array[0..63] of char;
  block55: array[0..54] of char;
  i: int;

procedure show(label: str);
var n: int;
begin
  io.puts(STDOUT, label);
  n := sha1.hex(digest, hexbuf, 0);
  io.out(STDOUT, addr(hexbuf[0]), n);
  io.puts(STDOUT, "\n");
end;

begin
  sha1.hash("", digest);
  show("sha1(\"\") = ");

  sha1.hash("abc", digest);
  show("sha1(\"abc\") = ");

  // 55 bytes: rem + 1 = 56, exactly the boundary where the length still fits in the
  // SAME 64-byte block as the 0x80 padding byte -- one call to sha1.block for the
  // padding, no second block.
  for i := 0 to len(block55) - 1 do block55[i] := 'a';
  sha1.hash(block55, digest);
  show("sha1(55 x 'a') one-block padding = ");

  // 56 bytes: rem + 1 = 57 > 56, so the length no longer fits and a SECOND padding
  // block is needed -- the boundary lib/sha1.wz's own comment calls out by name.
  for i := 0 to len(block64) - 1 do block64[i] := 'a';
  sha1.hash(block64[0..55], digest);
  show("sha1(56 x 'a') two-block padding = ");

  // Exactly one block (64 bytes): rem = 0, still needs its own padding block.
  sha1.hash(block64, digest);
  show("sha1(64 x 'a') exact block = ");

  sha1.hash("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", digest);
  show("sha1(two-block, RFC 3174) = ");

  for i := 0 to len(million) - 1 do million[i] := 'a';
  sha1.hash(million, digest);
  show("sha1(a x 1000000, RFC 3174) = ");
end.
