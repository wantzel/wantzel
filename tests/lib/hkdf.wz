// lib/hkdf.wz: HKDF-SHA256 against RFC 5869's own vectors, plus the TLS 1.3 label form.
//
// THE VECTORS ARE RFC 5869 APPENDIX A, cases 1 and 3. Case 1 has a salt and info; case 3
// has NEITHER -- both empty -- which is the case a careless implementation gets wrong,
// because an empty salt is not "no salt": RFC 5869 §2.2 says it becomes HashLen zero bytes.
//
// AND THE CHECKS NO VECTOR GIVES:
//   - output longer than one hash block, so the T(n-1) chaining is exercised at all
//   - the TLS 1.3 "tls13 " prefix is really in the input, checked by deriving the same
//     label through expandlabel and through a hand-built HkdfLabel
//   - a different label gives a different key (an expandlabel ignoring its label would
//     otherwise pass everything above)
include "io.wz";
include "hkdf.wz";

var
  ikm, salt, info, okm, want, tmp, empty: array[0..255] of char;
  k1, k2: array[0..255] of char;
  prk: array[0..31] of char;
  failures, i: int;
  blockdiff: bool;

procedure sethex(b: array of char; s: str);
var j, hi, lo, c: int;
begin
  j := 0;
  while j * 2 < slen(s) do
  begin
    c := ord(schar(s, j * 2));
    if c >= ord('a') then hi := c - ord('a') + 10 else hi := c - ord('0');
    c := ord(schar(s, j * 2 + 1));
    if c >= ord('a') then lo := c - ord('a') + 10 else lo := c - ord('0');
    b[j] := chr(hi * 16 + lo);
    j := j + 1;
  end;
end;

procedure expect(good: bool; what: str);
begin
  if good then io.puts(STDOUT, "ok   ")
  else begin io.puts(STDOUT, "FAIL "); failures := failures + 1; end;
  io.puts(STDOUT, what);
  io.puts(STDOUT, "\n");
end;

function same(a: array of char; b: array of char; n: int): bool;
var j: int;
begin
  j := 0;
  while j < n do
  begin
    if a[j] <> b[j] then return false;
    j := j + 1;
  end;
  return true;
end;

begin
  failures := 0;

  // ---- RFC 5869 A.1: basic case with salt and info ---------------------------------------
  sethex(ikm,  "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");   // 22 bytes
  sethex(salt, "000102030405060708090a0b0c");                      // 13 bytes
  sethex(info, "f0f1f2f3f4f5f6f7f8f9");                            // 10 bytes
  sethex(want, "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
  hkdf.extract(salt, 13, ikm, 22, prk);
  expect(same(prk, want, 32), "RFC 5869 A.1 the extracted PRK");

  sethex(want, "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");
  hkdf.expand(prk, info, 10, okm, 42);
  expect(same(okm, want, 42), "RFC 5869 A.1 the expanded output, 42 bytes");

  // ---- RFC 5869 A.3: zero-length salt AND info -------------------------------------------
  //
  // THE CASE THAT CATCHES THE COMMON MISTAKE. An empty salt must be treated as 32 zero
  // bytes, not as "skip the HMAC key". An implementation that special-cases it produces a
  // different PRK and every key after it is wrong.
  sethex(ikm,  "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
  sethex(want, "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04");
  i := 0;
  while i < 32 do begin empty[i] := chr(0); i := i + 1; end;
  hkdf.extract(empty, 0, ikm, 22, prk);
  expect(same(prk, want, 32), "RFC 5869 A.3 an empty salt is 32 zero bytes, not no salt");

  sethex(want, "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8");
  hkdf.expand(prk, empty, 0, okm, 42);
  expect(same(okm, want, 42), "RFC 5869 A.3 the expanded output with empty info");

  // ---- WHAT NO VECTOR GIVES --------------------------------------------------------------
  //
  // MORE THAN ONE BLOCK, so the chaining is actually exercised. Both vectors above are 42
  // bytes, which is two blocks -- but a bug in the chaining shows up much more clearly when
  // the first 32 bytes of a long output equal the first 32 of a short one and the rest
  // diverges. Here the same derivation at two lengths must agree on the common prefix.
  hkdf.expand(prk, info, 10, k1, 32);
  hkdf.expand(prk, info, 10, k2, 96);
  expect(same(k1, k2, 32), "a longer expansion starts with the shorter one");

  // AND THE BLOCKS ARE NOT ALL THE SAME. If T(n-1) were dropped from the message, every
  // block would be identical -- output that looks random and repeats every 32 bytes.
  // Compared byte by byte, because an earlier version of this line started with
  // `not same(k2, k2, 0)` -- a buffer against ITSELF over ZERO bytes, which is always
  // true, so the whole `or` chain was always true and the check could not fail. That is
  // the "assert that cannot fail" shape, and it is worth the four extra lines to avoid.
  i := 0;
  blockdiff := false;
  while i < 32 do
  begin
    if k2[i] <> k2[32 + i] then blockdiff := true;
    i := i + 1;
  end;
  expect(blockdiff, "and its second block differs from its first");

  // THE TLS 1.3 LABEL REALLY CARRIES "tls13 " AND THE LENGTHS. Built by hand here to the
  // structure in RFC 8446 §7.1; if expandlabel passed the bare label, or left out a length
  // byte, these two would differ.
  i := 0;
  while i < 32 do begin tmp[i] := chr(0); i := i + 1; end;
  tls.expandlabel(prk, "key", tmp, 0, k1, 16);
  //   uint16 length = 16, label "tls13 key" with its length byte, empty context
  sethex(info, "0010");
  info[2] := chr(9);
  info[3] := chr(ord('t')); info[4] := chr(ord('l')); info[5] := chr(ord('s'));
  info[6] := chr(ord('1')); info[7] := chr(ord('3')); info[8] := chr(ord(' '));
  info[9] := chr(ord('k')); info[10] := chr(ord('e')); info[11] := chr(ord('y'));
  info[12] := chr(0);
  hkdf.expand(prk, info, 13, k2, 16);
  expect(same(k1, k2, 16), "expandlabel builds the HkdfLabel of RFC 8446 7.1");

  // A DIFFERENT LABEL IS A DIFFERENT KEY. Without this, an expandlabel that ignored the
  // label entirely would satisfy every check above.
  tls.expandlabel(prk, "iv", tmp, 0, k2, 16);
  expect(not same(k1, k2, 16), "and a different label gives a different key");

  if failures > 0 then halt(1);
end.
