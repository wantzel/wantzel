push 16 into 8 = 8
  content = abcdefgh
push 8 into 8 = 8
push 3 at 6 = 8
  content = abcdefxy
chained past the end = 8
push at len(b) = 8
pushnum 7 digits into 4 = 4
  content = 1234
pushnum -1234567 into 4 = 4
  content = -123
pushnum roomy = 8
  content = -1234567
pushnum at len(b) = 4
putreal into 4 = 0
putreal into 8 = 0
putreal roomy = 3
  content = 1.5
putreal at 60 of 64 = 60
putreal at 32 of 64 = 35
putstr 16 into 8 = 2
  content = "a
putstr with an escape into 8 = 2
  content = "a
putstr at len(b) = 8
putstr roomy = 5
  content = "abc"
escslice 10 into 8 = 3
  content = abc
escslice a control byte into 4 = 0
push at -1 = -1
pushnum at -1 = -1
putreal at -1 = -1
putstr at -1 = -1
escslice at -1 = -1
putslice at -1 = -1
putb into 8 at 0 = 1
putb at len(b) = -1
putb at -1 = -1
