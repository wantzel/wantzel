// lib/math.wz against known values, printed as integers scaled by a power of ten.
import math;
var
  buf: array[0..63] of char;
  n, i: int;
  worst: real;
procedure show(s: str; v: int);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, v); io.puts(STDOUT, "\n");
end;
procedure showr(s: str; v: real; scale: real);
begin
  io.puts(STDOUT, s); io.putn(STDOUT, round(v * scale)); io.puts(STDOUT, "\n");
end;
procedure fixed(v: real; d: int);
begin
  n := math.fixed(buf, 0, v, d);
  io.out(STDOUT, addr(buf[0]), n); io.puts(STDOUT, "\n");
end;
procedure text(v: real);
begin
  n := math.text(buf, 0, v);
  io.out(STDOUT, addr(buf[0]), n); io.puts(STDOUT, "\n");
end;
begin
  showr("exp(1) x1e12 = ", math.exp(1.0), 1.0e12);                 // 2718281828459
  showr("exp(0) = ", math.exp(0.0), 1.0);
  showr("exp(-1) x1e12 = ", math.exp(-1.0), 1.0e12);               // 367879441171
  showr("exp(10) x1e6 = ", math.exp(10.0), 1.0e6);                 // 22026465794807
  showr("exp(-10) x1e16 = ", math.exp(-10.0), 1.0e16);             // 453999297625
  showr("log(e) x1e12 = ", math.log(MATH.E), 1.0e12);               // 1000000000000
  showr("log(1) = ", math.log(1.0), 1.0);
  showr("log(10) x1e12 = ", math.log(10.0), 1.0e12);               // 2302585092994
  showr("log(0.001) x1e9 = ", math.log(0.001), 1.0e9);             // -6907755279
  showr("log(1e300) x1e6 = ", math.log(1.0e300), 1.0e6);           // 690775527898
  showr("log10(1000) x1e9 = ", math.log10(1000.0), 1.0e9);         // 3000000000
  showr("log2(1024) x1e9 = ", math.log2(1024.0), 1.0e9);           // 10000000000
  showr("pow(2,10) = ", math.pow(2.0, 10.0), 1.0);                 // 1024
  showr("pow(2,-2) x100 = ", math.pow(2.0, -2.0), 100.0);          // 25
  showr("pow(9,0.5) x1e9 = ", math.pow(9.0, 0.5), 1.0e9);          // 3000000000
  showr("pow(1.03,25) x1e9 = ", math.pow(1.03, 25.0), 1.0e9);      // 2093777793
  showr("pow(0.9,0.67) x1e9 = ", math.pow(0.9, 0.67), 1.0e9);      // 931843955
  showr("sin(pi/6) x1e12 = ", math.sin(MATH.PI / 6.0), 1.0e12);    // 500000000000
  showr("cos(pi/3) x1e12 = ", math.cos(MATH.PI / 3.0), 1.0e12);    // 500000000000
  showr("sin(pi) x1e12 = ", math.sin(MATH.PI), 1.0e12);            // 0
  showr("cos(pi) = ", math.cos(MATH.PI), 1.0);                     // -1
  showr("sin(100) x1e12 = ", math.sin(100.0), 1.0e12);             // -506365641110
  showr("cos(-2.5) x1e12 = ", math.cos(-2.5), 1.0e12);             // -801143615547
  showr("tan(pi/4) x1e12 = ", math.tan(MATH.PI / 4.0), 1.0e12);    // 1000000000000
  showr("atan(1) x1e12 = ", math.atan(1.0), 1.0e12);               // 785398163397
  showr("atan(-3) x1e12 = ", math.atan(-3.0), 1.0e12);             // -1249045772398
  showr("atan2(1,-1) x1e12 = ", math.atan2(1.0, -1.0), 1.0e12);    // 2356194490192
  showr("asin(0.5) x1e12 = ", math.asin(0.5), 1.0e12);             // 523598775598
  showr("acos(0.5) x1e12 = ", math.acos(0.5), 1.0e12);             // 1047197551197
  showr("radians(180) x1e12 = ", math.radians(180.0), 1.0e12);     // 3141592653590
  show("floor(-2.5) = ", math.floor(-2.5));
  show("ceil(-2.5) = ", math.ceil(-2.5));
  show("floor(3) = ", math.floor(3.0));
  show("ceil(2.0001) = ", math.ceil(2.0001));
  // the identity exp(log(x)) = x over a range, worst relative error x1e15
  worst := 0.0;
  for i := 1 to 200 do
  begin
    n := round(math.abs(math.exp(math.log(real(i) * 0.37)) / (real(i) * 0.37) - 1.0) * 1.0e15);
    if real(n) > worst then worst := real(n);
  end;
  if worst < 20.0 then show("exp/log round trip within 2e-14 ", 1) else show("exp/log round trip within 2e-14 ", 0);
  worst := 0.0;
  for i := -100 to 100 do
  begin
    n := round(math.abs(math.sin(real(i) * 0.7) * math.sin(real(i) * 0.7) + math.cos(real(i) * 0.7) * math.cos(real(i) * 0.7) - 1.0) * 1.0e15);
    if real(n) > worst then worst := real(n);
  end;
  if worst < 10.0 then show("sin2+cos2 = 1 within 1e-14 ", 1) else show("sin2+cos2 = 1 within 1e-14 ", 0);
  fixed(1234.5, 2);
  fixed(-0.004, 2);
  fixed(2.675, 2);           // 2.68: half away from zero on the decimal value
  fixed(9.769444444, 3);
  fixed(0.0, 0);
  fixed(-7.5, 0);
  fixed(123456.789, 4);
  text(0.1);
  text(1.0e21);
  text(-273.15);
  text(math.pow(2.0, 60.0));
  n := 0;
  if math.parse("3.14159") > 3.14 then n := n + 1;
  if math.ok then n := n + 1;
  if math.parse("-2.5e3") = -2500.0 then n := n + 1;
  if math.parse("abc") = 0.0 then n := n + 1;
  if not math.ok then n := n + 1;
  if math.parse("12x") = 0.0 then n := n + 1;
  show("parse checks = ", n);                                       // 6
  if math.isnan(math.log(-1.0)) then show("log(-1) is nan ", 1) else show("log(-1) is nan ", 0);
  if math.exp(1000.0) > 1.0e308 then show("exp(1000) is inf ", 1) else show("exp(1000) is inf ", 0);
end.
