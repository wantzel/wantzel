// lib/fs.wz: fs.stat and fs.next used to conflate every reason for `false` into one
// bit, so a caller could not tell "this path does not exist" (the common, expected case)
// from a real failure (a component of the path is not a directory) or "the directory is
// exhausted" from a getdents error. fs.err/fs.errno now carry that difference: empty for
// the common case, filled for a real failure.
import io;
import fs;

var
  pad: array[0..511] of char;
  failures: int;

procedure setpath(s: str);
var k: int;
begin
  k := 0;
  while (k < slen(s)) and (k < len(pad) - 1) do begin pad[k] := schar(s, k); k := k + 1; end;
  pad[k] := chr(0);
end;

procedure expect(good: bool; what: str);
begin
  if good then io.puts(STDOUT, "ok   ") else begin io.puts(STDOUT, "FAIL "); failures := failures + 1; end;
  io.puts(STDOUT, what);
  io.puts(STDOUT, "\n");
end;

var fd, d: int;
    many: array[0..31] of int;
    j, opened: int;

begin
  failures := 0;

  // ---- fs.stat: the common case, a missing path, leaves fs.err empty ------------------
  setpath("fs_err_does_not_exist.wz");
  expect(not fs.stat(addr(pad[0])), "a missing path is refused");
  expect(slen(fs.err) = 0, "and fs.err stays empty for the common case");

  // ---- fs.stat: a real failure names the reason ----------------------------------------
  //
  // A component of the path that is not a directory (ENOTDIR) is a different failure from
  // "does not exist": create a plain file, then stat a path that walks THROUGH it.
  setpath("fs_err_plain_file.wz");
  fd := sys3(SYS.open, addr(pad[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot create the sample file\n"); halt(1); end;
  sys1(SYS.close, fd);
  setpath("fs_err_plain_file.wz/nested");
  expect(not fs.stat(addr(pad[0])), "a path through a plain file is refused");
  expect(slen(fs.err) > 0, "and fs.err names the reason this time");
  expect(fs.errno > 0, "with the raw errno beside it");

  // ---- fs.next: the common case, an exhausted directory, leaves fs.err empty -----------
  setpath(".");
  d := fs.opendir(addr(pad[0]));
  if d < 0 then begin io.puts(STDOUT, "FAIL cannot open .\n"); halt(1); end;
  while fs.next(d) do ;    // drain it
  expect(slen(fs.err) = 0, "an exhausted directory leaves fs.err empty");
  fs.close(d);

  // ---- fs.next: a real failure names the reason -----------------------------------------
  //
  // getdents on a descriptor that is not a directory (the plain file above, reopened) fails
  // with ENOTDIR rather than reporting zero entries -- that must not read as "exhausted".
  setpath("fs_err_plain_file.wz");
  fd := fs.open(addr(pad[0]));
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot reopen the sample file\n"); halt(1); end;
  expect(not fs.next(fd), "getdents on a plain file is refused");
  expect(slen(fs.err) > 0, "and fs.err names the reason, not silent exhaustion");
  fs.close(fd);

  setpath("fs_err_plain_file.wz");
  sys1(SYS.unlink, addr(pad[0]));

  // ---- fs.opendir: the table of open directories is small and bounded, and says so ----
  //
  // FS.MAXOPEN (16) directories at once is already generous for a recursive walk; one
  // more must fail cleanly -- not corrupt an existing handle's buffer, not crash -- with
  // FS.EMFILE, the same errno the kernel itself would give for "too many open files".
  setpath(".");
  opened := 0;
  for j := 0 to 19 do
  begin
    many[j] := fs.opendir(addr(pad[0]));
    if many[j] >= 0 then opened := opened + 1;
  end;
  expect(opened = 16, "exactly FS.MAXOPEN directories can be open at once");
  expect(many[16] < 0, "a 17th fs.opendir is refused");
  expect(fs.errno = 24, "with FS.EMFILE, the same errno the kernel would give");
  expect(slen(fs.err) > 0, "and fs.err names the reason");
  for j := 0 to 19 do if many[j] >= 0 then fs.close(many[j]);

  // Freeing a slot with fs.close makes room again -- the table is bounded, not exhausted
  // for the rest of the program.
  d := fs.opendir(addr(pad[0]));
  expect(d >= 0, "after closing them, a directory can be opened again");
  if d >= 0 then fs.close(d);

  // ---- fs.forget: a directory opened OUTSIDE fs.opendir, closed OUTSIDE fs.close -------
  //
  // A caller that opens a directory its own way (its own openat wrapper, say) still uses
  // fs.next to read it, and fs.next gives that fd a slot the same as fs.opendir would.
  // If that caller then closes the fd its OWN way (a raw sys1(SYS.close, ...), not
  // fs.close), the slot is never freed -- and fd NUMBERS GET REUSED.
  //
  // The hazard only shows with an UNFINISHED read: read one entry out of several (so the
  // slot's buffer still holds more, dpos < dlen -- an exhausted directory would leave
  // dpos = dlen and fs.next would call getdents again regardless, masking the bug), close
  // the fd raw, then open a DIFFERENT directory (the kernel very likely hands back the
  // same fd number). Without fs.forget in between, fs.next on the new fd finds the old
  // slot still claimed and returns the FIRST directory's leftover entries, not the
  // second's -- fs.forget, called between the raw close and the next use, is what a
  // caller in this position must do to avoid that.
  setpath("fs_err_forget_a");
  sys2(SYS.mkdir, addr(pad[0]), 493);
  setpath("fs_err_forget_a/a1.txt");
  fd := sys3(SYS.open, addr(pad[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot create a fixture file\n"); halt(1); end;
  sys1(SYS.close, fd);
  setpath("fs_err_forget_a/a2.txt");
  fd := sys3(SYS.open, addr(pad[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot create a fixture file\n"); halt(1); end;
  sys1(SYS.close, fd);
  setpath("fs_err_forget_a/a3.txt");
  fd := sys3(SYS.open, addr(pad[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot create a fixture file\n"); halt(1); end;
  sys1(SYS.close, fd);

  setpath("fs_err_forget_b");
  sys2(SYS.mkdir, addr(pad[0]), 493);
  setpath("fs_err_forget_b/b1.txt");
  fd := sys3(SYS.open, addr(pad[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot create a fixture file\n"); halt(1); end;
  sys1(SYS.close, fd);

  setpath("fs_err_forget_a");
  fd := sys3(SYS.open, addr(pad[0]), 65536, 0);           // O_RDONLY | O_DIRECTORY, no fs.opendir
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot open fs_err_forget_a\n"); halt(1); end;
  expect(fs.next(fd), "one of the three entries is read, two left unread in the slot's buffer");
  sys1(SYS.close, fd);                                    // raw close: fd's number is now free
  fs.forget(fd);                                           // the fix: release the slot too

  setpath("fs_err_forget_b");
  fd := sys3(SYS.open, addr(pad[0]), 65536, 0);           // likely reuses the same fd number
  if fd < 0 then begin io.puts(STDOUT, "FAIL cannot open fs_err_forget_b\n"); halt(1); end;
  j := 0;
  while fs.next(fd) do j := j + 1;
  expect(j = 1, "after fs.forget, the reused fd reads its OWN one entry, not directory a's leftovers");
  fs.close(fd);

  setpath("fs_err_forget_a/a1.txt"); sys1(SYS.unlink, addr(pad[0]));
  setpath("fs_err_forget_a/a2.txt"); sys1(SYS.unlink, addr(pad[0]));
  setpath("fs_err_forget_a/a3.txt"); sys1(SYS.unlink, addr(pad[0]));
  setpath("fs_err_forget_a"); sys1(SYS.rmdir, addr(pad[0]));
  setpath("fs_err_forget_b/b1.txt"); sys1(SYS.unlink, addr(pad[0]));
  setpath("fs_err_forget_b"); sys1(SYS.rmdir, addr(pad[0]));

  if failures > 0 then halt(1);
end.
