// lib/sha384.wz -- SHA-384 (FIPS 180-4).
//
// agent-permissions: read -- the standard library is not a scratchpad. Changing it
// changes every program that imports it, so it moves under a ticket rather than in
// passing. See docs/conventions.md §4.
//
// WHY THIS EXISTS: public certificate chains sign with ecdsa-with-SHA384. Measured
// 22-09-2026, the intermediates and roots of github.com, cloudflare.com and
// letsencrypt.org all use it. Without SHA-384 those chains cannot be closed.
//
// SHA-384 IS SHA-512 WITH A DIFFERENT START AND A SHORTER END. Same 64-bit rounds, same
// constants, same block size; only the initial state differs and the digest is the first
// 48 bytes instead of all 64. So this file is really a SHA-512 core, and exposing
// SHA-512 later costs one more entry point.
//
// THE ARITHMETIC IS 64-BIT AND THAT IS THE WHOLE DIFFICULTY HERE. sha256.wz does 32-bit
// work inside 64-bit ints and masks after every step, which leaves room to spare. Here the
// words ARE the full width of an int, so:
//   - there is no room to mask into; overflow wraps and that is exactly what is wanted
//   - RIGHT SHIFT MUST BE LOGICAL, and Wantzel's shr is ARITHMETIC -- it propagates the
//     sign bit. Every shift of a word whose top bit may be set goes through sha384.shr,
//     which clears what the sign propagation dragged in. Using a bare shr here is the
//     mistake that gives correct digests for short ASCII messages and wrong ones as soon
//     as a word goes above 2^63.

import io;

var
  sha384.k:     array[0..79] of int;    // round constants, filled by sha384.setup
  sha384.ready: bool;
  sha384.h:     array[0..7] of int;     // running hash state
  sha384.w:     array[0..79] of int;    // message schedule of the current block
  sha384.buf:   array[0..127] of char;  // partial block -- 128 bytes, not 64
  sha384.n:     int;                    // bytes in sha384.buf
  sha384.total: int;                    // bytes hashed so far

// LOGICAL right shift. Wantzel's shr is arithmetic: for a negative value (top bit set) it
// shifts ones in from the left. Masking afterwards is not enough -- the ones are already
// inside the result -- so the fix is to clear them explicitly.
//
// n is always 1..63 here; a shift of 64 is undefined and never occurs.
function sha384.shr(x: int; n: int): int;
begin
  if n = 0 then return x;
  return band(x shr n, bxor(band(0 - 1 shl (64 - n), 0 - 1), 0 - 1));
end;

// rotate right, 64-bit
function sha384.rotr(x: int; n: int): int;
begin
  return bor(sha384.shr(x, n), x shl (64 - n));
end;

procedure sha384.setup;
begin
  if sha384.ready then return;
  sha384.k[ 0] := 0x428a2f98d728ae22; sha384.k[ 1] := 0x7137449123ef65cd;
  sha384.k[ 2] := 0xb5c0fbcfec4d3b2f; sha384.k[ 3] := 0xe9b5dba58189dbbc;
  sha384.k[ 4] := 0x3956c25bf348b538; sha384.k[ 5] := 0x59f111f1b605d019;
  sha384.k[ 6] := 0x923f82a4af194f9b; sha384.k[ 7] := 0xab1c5ed5da6d8118;
  sha384.k[ 8] := 0xd807aa98a3030242; sha384.k[ 9] := 0x12835b0145706fbe;
  sha384.k[10] := 0x243185be4ee4b28c; sha384.k[11] := 0x550c7dc3d5ffb4e2;
  sha384.k[12] := 0x72be5d74f27b896f; sha384.k[13] := 0x80deb1fe3b1696b1;
  sha384.k[14] := 0x9bdc06a725c71235; sha384.k[15] := 0xc19bf174cf692694;
  sha384.k[16] := 0xe49b69c19ef14ad2; sha384.k[17] := 0xefbe4786384f25e3;
  sha384.k[18] := 0x0fc19dc68b8cd5b5; sha384.k[19] := 0x240ca1cc77ac9c65;
  sha384.k[20] := 0x2de92c6f592b0275; sha384.k[21] := 0x4a7484aa6ea6e483;
  sha384.k[22] := 0x5cb0a9dcbd41fbd4; sha384.k[23] := 0x76f988da831153b5;
  sha384.k[24] := 0x983e5152ee66dfab; sha384.k[25] := 0xa831c66d2db43210;
  sha384.k[26] := 0xb00327c898fb213f; sha384.k[27] := 0xbf597fc7beef0ee4;
  sha384.k[28] := 0xc6e00bf33da88fc2; sha384.k[29] := 0xd5a79147930aa725;
  sha384.k[30] := 0x06ca6351e003826f; sha384.k[31] := 0x142929670a0e6e70;
  sha384.k[32] := 0x27b70a8546d22ffc; sha384.k[33] := 0x2e1b21385c26c926;
  sha384.k[34] := 0x4d2c6dfc5ac42aed; sha384.k[35] := 0x53380d139d95b3df;
  sha384.k[36] := 0x650a73548baf63de; sha384.k[37] := 0x766a0abb3c77b2a8;
  sha384.k[38] := 0x81c2c92e47edaee6; sha384.k[39] := 0x92722c851482353b;
  sha384.k[40] := 0xa2bfe8a14cf10364; sha384.k[41] := 0xa81a664bbc423001;
  sha384.k[42] := 0xc24b8b70d0f89791; sha384.k[43] := 0xc76c51a30654be30;
  sha384.k[44] := 0xd192e819d6ef5218; sha384.k[45] := 0xd69906245565a910;
  sha384.k[46] := 0xf40e35855771202a; sha384.k[47] := 0x106aa07032bbd1b8;
  sha384.k[48] := 0x19a4c116b8d2d0c8; sha384.k[49] := 0x1e376c085141ab53;
  sha384.k[50] := 0x2748774cdf8eeb99; sha384.k[51] := 0x34b0bcb5e19b48a8;
  sha384.k[52] := 0x391c0cb3c5c95a63; sha384.k[53] := 0x4ed8aa4ae3418acb;
  sha384.k[54] := 0x5b9cca4f7763e373; sha384.k[55] := 0x682e6ff3d6b2b8a3;
  sha384.k[56] := 0x748f82ee5defb2fc; sha384.k[57] := 0x78a5636f43172f60;
  sha384.k[58] := 0x84c87814a1f0ab72; sha384.k[59] := 0x8cc702081a6439ec;
  sha384.k[60] := 0x90befffa23631e28; sha384.k[61] := 0xa4506cebde82bde9;
  sha384.k[62] := 0xbef9a3f7b2c67915; sha384.k[63] := 0xc67178f2e372532b;
  sha384.k[64] := 0xca273eceea26619c; sha384.k[65] := 0xd186b8c721c0c207;
  sha384.k[66] := 0xeada7dd6cde0eb1e; sha384.k[67] := 0xf57d4f7fee6ed178;
  sha384.k[68] := 0x06f067aa72176fba; sha384.k[69] := 0x0a637dc5a2c898a6;
  sha384.k[70] := 0x113f9804bef90dae; sha384.k[71] := 0x1b710b35131c471b;
  sha384.k[72] := 0x28db77f523047d84; sha384.k[73] := 0x32caab7b40c72493;
  sha384.k[74] := 0x3c9ebe0a15c9bebc; sha384.k[75] := 0x431d67c49c100d4c;
  sha384.k[76] := 0x4cc5d4becb3e42b6; sha384.k[77] := 0x597f299cfc657e2a;
  sha384.k[78] := 0x5fcb6fab3ad6faec; sha384.k[79] := 0x6c44198c4a475817;
  sha384.ready := true;
end;

procedure sha384.block;
var a, b, c, d, e, f, g, h, i, t1, t2, s0, s1, ch, maj: int;
begin
  i := 16;
  while i < 80 do
  begin
    s0 := bxor(bxor(sha384.rotr(sha384.w[i - 15], 1), sha384.rotr(sha384.w[i - 15], 8)), sha384.shr(sha384.w[i - 15], 7));
    s1 := bxor(bxor(sha384.rotr(sha384.w[i - 2], 19), sha384.rotr(sha384.w[i - 2], 61)), sha384.shr(sha384.w[i - 2], 6));
    sha384.w[i] := sha384.w[i - 16] + s0 + sha384.w[i - 7] + s1;
    i := i + 1;
  end;

  a := sha384.h[0]; b := sha384.h[1]; c := sha384.h[2]; d := sha384.h[3];
  e := sha384.h[4]; f := sha384.h[5]; g := sha384.h[6]; h := sha384.h[7];

  i := 0;
  while i < 80 do
  begin
    s1  := bxor(bxor(sha384.rotr(e, 14), sha384.rotr(e, 18)), sha384.rotr(e, 41));
    ch  := bxor(band(e, f), band(bxor(e, 0 - 1), g));
    t1  := h + s1 + ch + sha384.k[i] + sha384.w[i];
    s0  := bxor(bxor(sha384.rotr(a, 28), sha384.rotr(a, 34)), sha384.rotr(a, 39));
    maj := bxor(bxor(band(a, b), band(a, c)), band(b, c));
    t2  := s0 + maj;
    h := g; g := f; f := e;
    e := d + t1;
    d := c; c := b; b := a;
    a := t1 + t2;
    i := i + 1;
  end;

  sha384.h[0] := sha384.h[0] + a; sha384.h[1] := sha384.h[1] + b;
  sha384.h[2] := sha384.h[2] + c; sha384.h[3] := sha384.h[3] + d;
  sha384.h[4] := sha384.h[4] + e; sha384.h[5] := sha384.h[5] + f;
  sha384.h[6] := sha384.h[6] + g; sha384.h[7] := sha384.h[7] + h;
end;

procedure sha384.init;
begin
  sha384.setup;
  // The initial state: the first 64 bits of the fractional parts of the square roots of
  // the 9th through 16th primes. This is what makes it SHA-384 rather than SHA-512.
  sha384.h[0] := 0xcbbb9d5dc1059ed8; sha384.h[1] := 0x629a292a367cd507;
  sha384.h[2] := 0x9159015a3070dd17; sha384.h[3] := 0x152fecd8f70e5939;
  sha384.h[4] := 0x67332667ffc00b31; sha384.h[5] := 0x8eb44a8768581511;
  sha384.h[6] := 0xdb0c2e0d64f98fa7; sha384.h[7] := 0x47b5481dbefa4fa4;
  sha384.n := 0;
  sha384.total := 0;
end;

// Pack the 128-byte buffer into sixteen 64-bit words, big-endian, and run a block.
procedure sha384.runbuf;
var i, j, v: int;
begin
  i := 0;
  while i < 16 do
  begin
    v := 0;
    j := 0;
    while j < 8 do
    begin
      v := bor(v shl 8, ord(sha384.buf[i * 8 + j]));
      j := j + 1;
    end;
    sha384.w[i] := v;
    i := i + 1;
  end;
  sha384.block;
end;

procedure sha384.updateat(b: array of char; at: int; n: int);
var i: int;
begin
  for i := at to at + n - 1 do
  begin
    sha384.buf[sha384.n] := b[i];
    sha384.n := sha384.n + 1;
    if sha384.n = 128 then
    begin
      sha384.runbuf;
      sha384.n := 0;
    end;
  end;
  sha384.total := sha384.total + n;
end;

procedure sha384.update(b: array of char);
begin
  sha384.updateat(b, 0, len(b));
end;

// pad, run the last block(s) and write the 48-byte digest into digest[0..47]
//
// THE LENGTH FIELD IS 128 BITS in SHA-512 and its relatives, against 64 in SHA-256. The
// high half is written as zeroes: a message of 2^64 bits is not reachable here, and
// pretending otherwise would be code that can never be tested.
procedure sha384.final(digest: array of char);
var i, j, bits: int;
begin
  bits := sha384.total * 8;
  sha384.buf[sha384.n] := chr(0x80);
  sha384.n := sha384.n + 1;
  if sha384.n > 112 then
  begin
    while sha384.n < 128 do begin sha384.buf[sha384.n] := chr(0); sha384.n := sha384.n + 1; end;
    sha384.runbuf;
    sha384.n := 0;
  end;
  while sha384.n < 112 do begin sha384.buf[sha384.n] := chr(0); sha384.n := sha384.n + 1; end;
  // the top 64 bits of the length: always zero here
  i := 0;
  while i < 8 do begin sha384.buf[112 + i] := chr(0); i := i + 1; end;
  i := 0;
  while i < 8 do
  begin
    sha384.buf[120 + i] := chr(band(sha384.shr(bits, (7 - i) * 8), 0xFF));
    i := i + 1;
  end;
  sha384.runbuf;

  // SIX words of the eight, which is what makes the digest 48 bytes.
  i := 0;
  while i < 6 do
  begin
    j := 0;
    while j < 8 do
    begin
      digest[i * 8 + j] := chr(band(sha384.shr(sha384.h[i], (7 - j) * 8), 0xFF));
      j := j + 1;
    end;
    i := i + 1;
  end;
end;

procedure sha384.hash(b: array of char; digest: array of char);
begin
  sha384.init;
  sha384.update(b);
  sha384.final(digest);
end;
