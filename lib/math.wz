// lib/math.wz -- real arithmetic beyond the operators: exp, log, pow, the
// trigonometric functions, rounding, and fixed-decimal formatting.
//
// Everything is plain Wantzel on the `real` type: range reduction plus a short
// series, so the results are identical on Linux and Windows and there is
// no dependence on a C library.  Accuracy is a few units in the last place
// over the ranges an energy model needs; see the notes per function.

include "json.wz";

const
  MATH.PI  = 3.14159265358979323846;
  MATH.E   = 2.71828182845904523536;
  MATH.LN2 = 0.69314718055994530942;
  MATH.HALFPI = 1.57079632679489661923;
  MATH.TWOPI  = 6.28318530717958647692;

function math.abs(x: real): real;
begin
  if x < 0.0 then return -x;
  return x;
end;

function math.max(a: real; b: real): real;
begin
  if a > b then return a;
  return b;
end;

function math.min(a: real; b: real): real;
begin
  if a < b then return a;
  return b;
end;

// largest int <= x (x must fit in an int)
function math.floor(x: real): int;
var i: int;
begin
  i := trunc(x);
  if real(i) > x then return i - 1;
  return i;
end;

// smallest int >= x
function math.ceil(x: real): int;
var i: int;
begin
  i := trunc(x);
  if real(i) < x then return i + 1;
  return i;
end;

// is x a NaN?
function math.isnan(x: real): bool;
begin
  return not (x = x);
end;

// 2^k for an integer k (exact: only doublings)
function math.pow2i(k: int): real;
var r, b: real;
    neg: bool;
begin
  neg := k < 0;
  if neg then k := 0 - k;
  r := 1.0;
  b := 2.0;
  while k > 0 do
  begin
    if (k mod 2) = 1 then r := r * b;
    b := b * b;
    k := k div 2;
  end;
  if neg then return 1.0 / r;
  return r;
end;

// e^x.  x = k ln2 + r with |r| <= ln2/2, e^r by its series (12 terms give
// full double precision on that interval), then scaled by 2^k.
function math.exp(x: real): real;
var k, i: int;
    r, term, sum: real;
begin
  if math.isnan(x) then return x;
  if x > 709.7 then return 1.0e308 * 10.0;       { +inf }
  if x < -745.0 then return 0.0;
  k := round(x / MATH.LN2);
  r := x - real(k) * MATH.LN2;
  sum := 1.0;
  term := 1.0;
  for i := 1 to 14 do
  begin
    term := term * r / real(i);
    sum := sum + term;
  end;
  return sum * math.pow2i(k);
end;

// natural logarithm.  x = m 2^e with 1 <= m < 2, then
// ln m = 2 (s + s^3/3 + s^5/5 + ...) with s = (m-1)/(m+1) <= 1/3.
// NaN for x < 0, -inf for 0.
function math.log(x: real): real;
var e, i: int;
    m, s, s2, term, sum: real;
begin
  if math.isnan(x) then return x;
  if x < 0.0 then return 0.0 / 0.0;
  if x = 0.0 then return -1.0e308 * 10.0;
  m := x;
  e := 0;
  while m >= 2.0 do begin m := m * 0.5; e := e + 1; end;
  while m < 1.0 do begin m := m * 2.0; e := e - 1; end;
  if m > 1.4142135623730951 then begin m := m * 0.5; e := e + 1; end;   { m in [0.707, 1.414) }
  s := (m - 1.0) / (m + 1.0);
  s2 := s * s;
  term := s;
  sum := 0.0;
  for i := 0 to 20 do
  begin
    sum := sum + term / real(2 * i + 1);
    term := term * s2;
  end;
  return 2.0 * sum + real(e) * MATH.LN2;
end;

function math.log10(x: real): real;
begin
  return math.log(x) / 2.30258509299404568402;
end;

function math.log2(x: real): real;
begin
  return math.log(x) / MATH.LN2;
end;

// x^n for an integer n by repeated squaring (exact for small results)
function math.powi(x: real; n: int): real;
var r: real;
    neg: bool;
begin
  neg := n < 0;
  if neg then n := 0 - n;
  r := 1.0;
  while n > 0 do
  begin
    if (n mod 2) = 1 then r := r * x;
    x := x * x;
    n := n div 2;
  end;
  if neg then return 1.0 / r;
  return r;
end;

// x^y.  An integer y uses powi; otherwise exp(y ln x), which needs x > 0.
function math.pow(x: real; y: real): real;
var n: int;
begin
  if y = 0.0 then return 1.0;
  if x = 0.0 then
  begin
    if y > 0.0 then return 0.0;
    return 1.0e308 * 10.0;
  end;
  if (y > -1.0e15) and (y < 1.0e15) then
  begin
    n := trunc(y);
    if real(n) = y then return math.powi(x, n);
  end;
  if x < 0.0 then return 0.0 / 0.0;
  return math.exp(y * math.log(x));
end;

// sin and cos: reduce to r in [-pi/4, pi/4] with a quadrant, then a series
// (10 terms: r^21/21! is far below double precision).
var
  math.quad: int;
  math.red: real;

procedure math.reduce(x: real);
var k: int;
begin
  k := round(x / MATH.HALFPI);
  math.red := x - real(k) * MATH.HALFPI;
  math.quad := k mod 4;
  if math.quad < 0 then math.quad := math.quad + 4;
end;

function math.sinr(r: real): real;
var i: int;
    term, sum, r2: real;
begin
  r2 := r * r;
  term := r;
  sum := r;
  for i := 1 to 10 do
  begin
    term := -term * r2 / real((2 * i) * (2 * i + 1));
    sum := sum + term;
  end;
  return sum;
end;

function math.cosr(r: real): real;
var i: int;
    term, sum, r2: real;
begin
  r2 := r * r;
  term := 1.0;
  sum := 1.0;
  for i := 1 to 10 do
  begin
    term := -term * r2 / real((2 * i - 1) * (2 * i));
    sum := sum + term;
  end;
  return sum;
end;

function math.sin(x: real): real;
begin
  if math.isnan(x) then return x;
  math.reduce(x);
  case math.quad of
    0: return math.sinr(math.red);
    1: return math.cosr(math.red);
    2: return -math.sinr(math.red);
  else
    return -math.cosr(math.red);
  end;
end;

function math.cos(x: real): real;
begin
  if math.isnan(x) then return x;
  math.reduce(x);
  case math.quad of
    0: return math.cosr(math.red);
    1: return -math.sinr(math.red);
    2: return -math.cosr(math.red);
  else
    return math.sinr(math.red);
  end;
end;

function math.tan(x: real): real;
begin
  return math.sin(x) / math.cos(x);
end;

// arctangent: reduce |x| to [0, 1] (atan x = pi/2 - atan 1/x), then to
// [0, tan(pi/12)] with atan x = pi/6 + atan((x sqrt3 - 1)/(x + sqrt3)),
// then the series.
function math.atan(x: real): real;
var i, k: int;
    t, t2, term, sum, r: real;
    neg, inv: bool;
begin
  if math.isnan(x) then return x;
  neg := x < 0.0;
  if neg then x := -x;
  inv := x > 1.0;
  if inv then x := 1.0 / x;
  k := 0;
  if x > 0.2679491924311227 then
  begin
    x := (x * 1.7320508075688772 - 1.0) / (x + 1.7320508075688772);
    k := 1;
  end;
  t := x;
  t2 := x * x;
  term := x;
  sum := 0.0;
  for i := 0 to 24 do
  begin
    if (i mod 2) = 0 then sum := sum + term / real(2 * i + 1)
    else sum := sum - term / real(2 * i + 1);
    term := term * t2;
  end;
  r := sum;
  if k = 1 then r := r + MATH.PI / 6.0;
  if inv then r := MATH.HALFPI - r;
  if neg then return -r;
  return r;
end;

function math.atan2(y: real; x: real): real;
begin
  if x > 0.0 then return math.atan(y / x);
  if x < 0.0 then
  begin
    if y >= 0.0 then return math.atan(y / x) + MATH.PI;
    return math.atan(y / x) - MATH.PI;
  end;
  if y > 0.0 then return MATH.HALFPI;
  if y < 0.0 then return -MATH.HALFPI;
  return 0.0;
end;

function math.asin(x: real): real;
begin
  if (x > 1.0) or (x < -1.0) then return 0.0 / 0.0;
  if x = 1.0 then return MATH.HALFPI;
  if x = -1.0 then return -MATH.HALFPI;
  return math.atan(x / sqrt(1.0 - x * x));
end;

function math.acos(x: real): real;
begin
  return MATH.HALFPI - math.asin(x);
end;

function math.radians(deg: real): real;
begin
  return deg * MATH.PI / 180.0;
end;

function math.degrees(rad: real): real;
begin
  return rad * 180.0 / MATH.PI;
end;

// ------------------------------------------------------------- text

// x with exactly `decimals` digits after the point (0..15), rounded half
// away from zero; e.g. 1234.5 with 2 -> "1234.50", -0.004 with 2 -> "0.00".
// Values beyond ~9e15 fall back to the general form.
function math.fixed(dst: array of char; at: int; x: real; decimals: int): int;
var scale, i, ip, fp, n: int;
    a: real;
    neg: bool;
begin
  if math.isnan(x) then return io.push(dst, at, "nan");
  if decimals < 0 then decimals := 0;
  if decimals > 15 then decimals := 15;
  neg := x < 0.0;
  a := x;
  if neg then a := -a;
  if a >= 9.0e15 then return json.putreal(dst, at, x);
  scale := 1;
  for i := 1 to decimals do scale := scale * 10;
  n := math.floor(a * real(scale) + 0.5 + 1.0e-9);  { half away from zero; the epsilon lets 2.675 -> 2.68 }
  if n = 0 then neg := false;
  ip := n div scale;
  fp := n mod scale;
  if neg then begin dst[at] := '-'; at := at + 1; end;
  at := io.pushnum(dst, at, ip);
  if decimals > 0 then
  begin
    dst[at] := '.';
    at := at + 1;
    i := scale div 10;
    while i > 0 do
    begin
      dst[at] := chr(48 + (fp div i) mod 10);
      at := at + 1;
      i := i div 10;
    end;
  end;
  return at;
end;

// the shortest general form (up to 15 significant digits), see json.putreal
function math.text(dst: array of char; at: int; x: real): int;
begin
  return json.putreal(dst, at, x);
end;

var
  math.ok: bool;             // did the last math.parse succeed?

// parse a decimal number from s; math.ok tells whether all of s was a number
function math.parse(s: array of char): real;
var r: int;
begin
  math.ok := false;
  if len(s) = 0 then return 0.0;
  r := json.real(s, 0, len(s));
  if r <> len(s) then return 0.0;
  math.ok := true;
  return json.rval;
end;
