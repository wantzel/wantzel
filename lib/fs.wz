// lib/fs.wz -- directories, file metadata and reading, on raw syscalls.
//
// agent-permissions: read -- the standard library is not a scratchpad. Changing it
// changes every program that imports it, so it moves under a ticket rather than in
// passing. See docs/conventions.md §4.
//
// Read-only: nothing here creates, writes or deletes.

import io;

const
  DT_DIR  = 4;
  DT_REG  = 8;
  DT_LNK  = 10;

  S_IFMT  = 61440;      // 0xF000
  S_IFDIR = 16384;      // 0x4000
  S_IFREG = 32768;      // 0x8000

  FS.DIRBUF = 32768;

  // Directories open at once, process-wide: a handful is plenty for a recursive walk,
  // and a table beyond that is more likely a leak than real need.
  FS.MAXOPEN = 16;

const
  FS.ENOENT = 2;        // errno: no such file or directory
  FS.EMFILE = 24;        // errno: too many open files -- also "no free slot in fs.dslot"

var
  fs.st:   array[0..143] of char;      // struct stat
  fs.size, fs.mode, fs.mtime: int;
  fs.err:  str;                        // the reason of the last fs.stat/fs.next failure, "" for the common case
  fs.errno: int;                       // the raw -errno beside fs.err, 0 when there was none

  // One directory read buffer per OPEN fd, not one for the whole process -- opening a
  // subdirectory while its parent is still being walked must not touch the parent's
  // position. fs.dslot[i] is the fd that owns slot i, -1 when the slot is free; a fresh
  // fd is found by a linear scan of FS.MAXOPEN entries, cheap at this size.
  fs.dslot: array[0..FS.MAXOPEN - 1] of int;
  fs.dbuf:  array[0..FS.MAXOPEN * FS.DIRBUF - 1] of char;
  fs.dlen:  array[0..FS.MAXOPEN - 1] of int;
  fs.dpos:  array[0..FS.MAXOPEN - 1] of int;
  fs.dinited: bool;

  fs.name: array[0..255] of char;
  fs.namelen, fs.type: int;

// Set every slot free. Called lazily, once, by whichever of fs.opendir/fs.next runs
// first -- a global array starts zeroed, and 0 is a valid fd, so the table needs an
// explicit "empty" pass rather than relying on the zero value to mean free.
procedure fs.dinit;
var i: int;
begin
  if fs.dinited then return;
  fs.dinited := true;
  for i := 0 to FS.MAXOPEN - 1 do fs.dslot[i] := -1;
end;

// The slot already open for fd, or -1.
function fs.dfind(fd: int): int;
var i: int;
begin
  fs.dinit;
  for i := 0 to FS.MAXOPEN - 1 do if fs.dslot[i] = fd then return i;
  return -1;
end;

// A free slot for fd, allocating and clearing one if fd does not have one yet. -1 when
// the table is full. Used by both fs.opendir (a fresh handle) and fs.next (called on an
// fd nothing opened through fs.opendir, as tests/lib/fs_err.wz does on purpose to reach
// a getdents error) -- either way, a directory's read position starts at the beginning.
function fs.dslotfor(fd: int): int;
var i, s: int;
begin
  s := fs.dfind(fd);
  if s >= 0 then return s;
  fs.dinit;
  for i := 0 to FS.MAXOPEN - 1 do
  begin
    if fs.dslot[i] < 0 then
    begin
      fs.dslot[i] := fd;
      fs.dlen[i] := 0;
      fs.dpos[i] := 0;
      return i;
    end;
  end;
  return -1;
end;

// fill fs.size/mode/mtime for the NUL-terminated path at address a.  false either means the
// path does not exist (fs.err stays "", the common case a caller checks for) or a different
// failure (not a directory somewhere in the path, no permission, too many symlinks, ...):
// fs.err then says so and fs.errno carries the raw -errno, since this file has no per-errno
// name table and a wrong guess at the name would be worse than the number.
function fs.stat(a: int): bool;
var r: int;
begin
  fs.err := ""; fs.errno := 0;
  r := sys2(SYS.stat, a, addr(fs.st[0]));
  if r < 0 then
  begin
    if r <> 0 - FS.ENOENT then begin fs.err := "fs.stat failed"; fs.errno := 0 - r; end;
    return false;
  end;
  fs.mode  := io.get32(fs.st, 24);
  fs.size  := io.get64(fs.st, 48);
  fs.mtime := io.get64(fs.st, 88);
  return true;
end;

function fs.isdir: bool;
begin
  return band(fs.mode, S_IFMT) = S_IFDIR;
end;

function fs.isfile: bool;
begin
  return band(fs.mode, S_IFMT) = S_IFREG;
end;

// Frees fd's directory slot, if it has one, WITHOUT closing fd -- for a caller that
// opened the directory its own way (not through fs.opendir, so it owns the fd's whole
// lifecycle) and still wants to read it with fs.next. Harmless to call on an fd with no
// slot.
//
// CALL THIS BEFORE YOU CLOSE SUCH AN fd YOURSELF. fs.next keys its slot table by fd
// number alone, and fd numbers get REUSED: close a directory outside fs.close and the
// kernel can hand that same number to the next thing opened, directory or not. Without
// fs.forget first, fs.next on the new fd finds the OLD slot still claimed under that
// number and resumes reading from the old fd's position instead of starting fresh --
// the exact bug this file was fixed for, one level up. A caller that always goes
// through fs.opendir/fs.close never needs this.
procedure fs.forget(fd: int);
var s: int;
begin
  s := fs.dfind(fd);
  if s >= 0 then fs.dslot[s] := -1;
end;

// Closes fd, and frees its directory slot if fs.opendir or fs.next ever gave it one --
// harmless to call on a plain file, which never has a slot.
procedure fs.close(fd: int);
begin
  sys1(SYS.close, fd);
  fs.forget(fd);
end;

function fs.open(a: int): int;
begin
  return sys3(SYS.open, a, 0, 0);      // O_RDONLY
end;

// O_RDONLY | O_DIRECTORY (0x10000). Opens the directory and claims it a slot of its own
// in fs.dslot/fs.dbuf/fs.dlen/fs.dpos, so reading it later (fs.next) never disturbs any
// OTHER directory this process has open at the same time, so opening a child while a
// parent is mid-walk leaves the parent's place in its own listing untouched.
//
// -1 with fs.err/fs.errno set to FS.EMFILE means FS.MAXOPEN directories are already
// open; the fd this call itself opened is closed so it isn't leaked.
function fs.opendir(a: int): int;
var fd: int;
begin
  fs.err := ""; fs.errno := 0;
  fd := sys3(SYS.open, a, 65536, 0);
  if fd < 0 then return fd;
  if fs.dslotfor(fd) < 0 then
  begin
    sys1(SYS.close, fd);
    fs.err := "fs.opendir: too many directories open at once"; fs.errno := FS.EMFILE;
    return 0 - FS.EMFILE;
  end;
  return fd;
end;

// fs.map(a) -- map the whole NUL-terminated file at address a into memory, read-only.
//
// Returns the base address, or -1. On success fs.size holds the length, so the caller has
// both halves of what it needs from one call.
//
// WHY THIS IS A ROUTINE AND NOT FOUR LINES AT EACH CALLER. The four lines are a stat, an
// open, an mmap and a close, and what they SAY is "syscall 4, syscall 2, syscall 9, syscall
// 3". What they MEAN is "map this file". A reader has to recognise the sequence to know
// which of the two they are looking at, and every caller that writes it out again is a
// place the order can be wrong.
//
// THE CLOSE IS THE PART WORTH HAVING IN ONE PLACE. A mapping keeps its own reference to the
// file, so the descriptor is finished the moment mmap returns -- but a caller that does not
// know that leaks one per file, and that is invisible until a long-running program runs out.
//
// AN EMPTY FILE IS REFUSED rather than mapped: mmap with a length of zero fails anyway, and
// -1 with fs.size = 0 lets the caller say "that file is empty" instead of "cannot map".
function fs.map(a: int): int;
var fd, base: int;
begin
  if not fs.stat(a) then return 0 - 1;
  if fs.size <= 0 then return 0 - 1;
  fd := fs.open(a);
  if fd < 0 then return 0 - 1;
  base := sys6(SYS.mmap, 0, fs.size, PROT_READ, MAP_SHARED, fd, 0);
  fs.close(fd);
  if base < 0 then return 0 - 1;
  return base;
end;

// fs.unmap(base) -- give a mapping back. The length is the one fs.map reported.
procedure fs.unmap(base: int; n: int);
begin
  if base > 0 then sys2(SYS.munmap, base, n);
end;

// Step to the next directory entry; fills fs.name/fs.namelen/fs.type.  false either means
// the directory is exhausted (fs.err stays "", the common case) or a real failure -- getdents
// returned a negative -errno, or the buffer it filled holds a record with no length, which
// would otherwise loop forever: fs.err then says so and fs.errno carries the raw -errno (0
// when there was none to report, as with a corrupt record).
//
// Reads and positions live in fd's OWN slot (fs.dslotfor), so calling this on a second,
// nested fd -- opening a child directory while a parent's listing is half read -- cannot
// disturb the parent: each fd keeps its own buffer and its own place in it.
function fs.next(fd: int): bool;
var reclen, nameat, i, s, base: int;
    c: char;
begin
  fs.err := ""; fs.errno := 0;
  s := fs.dslotfor(fd);
  if s < 0 then begin fs.err := "fs.next: too many directories open at once"; fs.errno := FS.EMFILE; return false; end;
  base := s * FS.DIRBUF;
  while true do
  begin
    if fs.dpos[s] >= fs.dlen[s] then
    begin
      fs.dlen[s] := sys3(SYS.getdents, fd, addr(fs.dbuf[base]), FS.DIRBUF);
      fs.dpos[s] := 0;
      if fs.dlen[s] < 0 then begin fs.err := "fs.next: getdents failed"; fs.errno := 0 - fs.dlen[s]; return false; end;
      if fs.dlen[s] = 0 then return false;
    end;
    reclen := io.get16(fs.dbuf, base + fs.dpos[s] + 16);
    if reclen <= 0 then begin fs.err := "fs.next: corrupt directory record"; return false; end;
    fs.type := ord(fs.dbuf[base + fs.dpos[s] + 18]);
    nameat := base + fs.dpos[s] + 19;
    i := 0;
    while i < 255 do
    begin
      c := fs.dbuf[nameat + i];
      if c = chr(0) then break;
      fs.name[i] := c;
      i := i + 1;
    end;
    fs.name[i] := chr(0);
    fs.namelen := i;
    fs.dpos[s] := fs.dpos[s] + reclen;
    // skip "." and ".."
    if fs.namelen = 1 then
    begin
      if fs.name[0] <> '.' then return true;
    end
    else if fs.namelen = 2 then
    begin
      if (fs.name[0] <> '.') or (fs.name[1] <> '.') then return true;
    end
    else return true;
  end;
  return false;
end;

// Find the bytes n[0..nlen) inside h[from..upto).  The first byte is located
// with the SIMD scan, so this runs at memchr speed on the common case.
function fs.find(h: array of char; from: int; upto: int; n: array of char; nlen: int): int;
var at, i: int;
    ok: bool;
begin
  if nlen = 0 then return from;
  if nlen > upto - from then return -1;
  while true do
  begin
    at := scan(h, from, upto, n[0]);
    if at + nlen > upto then return -1;
    ok := true;
    i := 1;
    while i < nlen do
    begin
      if h[at + i] <> n[i] then
      begin
        ok := false;
        break;
      end;
      i := i + 1;
    end;
    if ok then return at;
    from := at + 1;
  end;
  return -1;
end;
