// lib/tls.wz -- TLS 1.3: a blocking client, and a server that runs inside an event loop.
//
// agent-permissions: read -- the standard library is not a scratchpad. Changing it
// changes every program that includes it, so it moves under a ticket rather than in
// passing. See docs/conventions.md §4.
//
// WHAT IT SPEAKS, and the narrowness is deliberate rather than provisional. TLS 1.3 only,
// one cipher suite (TLS_CHACHA20_POLY1305_SHA256), one group (X25519). No 1.2 fallback, no
// session resumption, no client certificates, no renegotiation. Every one of those is a
// separate state machine and most historical TLS vulnerabilities live in the seams between
// them -- a client that cannot be downgraded because it cannot speak the older thing at all
// is simpler AND safer than one that can and refuses.
//
// THE CLIENT, blocking, one connection at a time:
//
//   tls.connect(fd, "example.com")   the handshake, on an already-connected socket
//   tls.write(buf, n)                send application data
//   tls.read(buf, max)               receive application data
//   tls.close                        send close_notify
//
// Each of those finishes within tls.deadline milliseconds (30 s when 0) or fails with
// tls.err = -110. The socket is switched to non-blocking mode for that.
//
// THE SERVER, sans-IO: it never reads or writes a socket. The caller's event loop owns the
// connection, hands each session the bytes that arrived, and sends the bytes it gets back.
// Nothing here blocks, so one thread serves up to TLS.MAXSESS connections at once, and a
// slow or hostile client costs its own session and nothing else.
//
//   tls.setcert(chain, n, key)       install the certificate chain (DER, leaf first) and its
//                                    P-256 key; safe while sessions are open -- new
//                                    handshakes use the new chain, open sessions carry on
//   s := tls.open                    a session for a new connection; -1 when none is free
//   used := tls.feed(s, src, app, wire)
//                                    the bytes that arrived; afterwards app[0..tls.appn) is
//                                    decrypted data, wire[0..tls.wiren) must be sent. -1 =
//                                    the session failed (still send wire: it is the alert)
//   n := tls.seal(s, src, wire)      encrypt src into wire, n bytes to send; -1 if not open
//   n := tls.shut(s, wire)           our close_notify into wire
//   tls.free(s)                      give the session back, wiping its keys
//   tls.state(s)                     TLS.ST.HANDSHAKE, .OPEN, .CLOSED (peer closed), .FAILED
//   tls.code(s), tls.why             the alert that ended it, and a sentence saying why
//
// One loop step, for a readable socket:
//
//   n := net.recv(fd, addr(raw[0]), len(raw));
//   used := tls.feed(s, raw[0..n-1], inbuf[have..len(inbuf)-1], outbuf);
//   send outbuf[0..tls.wiren);  have := have + tls.appn;
//   if used < 0 then close;     if used < n then keep raw[used..n-1] for later
//
// feed takes everything it is given -- a record cut in half by a read waits inside the
// session -- except when app is too full for the next record's plaintext: then it stops at
// that record, and the caller feeds the rest once there is room. wire needs room for
// TLS.MAXREC bytes during the handshake, because the server flight carries the whole chain.
// tls.accept(fd) is the blocking form, for a program with one connection at a time.
//
// WHAT tls.verified MEANS, AND WHAT IT DOES NOT. After a handshake it is true when the
// server's certificate matched the hostname, was in date, and the server PROVED it holds
// the matching private key by signing the handshake transcript.
//
// IT DOES NOT MEAN THE CERTIFICATE IS TRUSTED. There is no root store yet, so nothing says
// the certificate was issued by anyone in particular -- a self-signed certificate for the
// right hostname sets this true. Chain validation against a root store is not built yet;
// until it is, verified is
// necessary and not sufficient, and this file says so rather than implying more.
//
// Set tls.now to the current time before connecting to have the dates checked; 0 skips
// that, which is a real case on a machine with no clock but has to be the CALLER's choice.
//
// THE RECORD LAYER IS WHERE THE NONCE LIVES, and it is the part that silently breaks: each
// record's nonce is the 12-byte IV XORed with the sequence number, and the sequence resets
// to zero on every key change. Get it wrong and the first record still decrypts -- because
// sequence 0 XOR anything is the IV itself -- and the second one does not.

include "io.wz";
include "net.wz";
include "rand.wz";
include "sha256.wz";
include "hkdf.wz";
include "x25519.wz";
include "aead.wz";
include "x509.wz";
include "chain.wz";
include "p256.wz";
include "p384.wz";

const
  // HOW MANY CERTIFICATES A CHAIN MAY HAVE. Real chains are two or three; eight is generous
  // and bounded, which matters because the list comes from the other end.
  TLS.MAXCHAIN = 8;

  // Record types, RFC 8446 §5.1.
  TLS.CHANGECIPHER = 20;
  TLS.ALERT        = 21;
  TLS.HANDSHAKE    = 22;
  TLS.APPDATA      = 23;

  // Handshake message types, §4.
  TLS.CLIENTHELLO  = 1;
  TLS.SERVERHELLO  = 2;
  TLS.NEWTICKET    = 4;
  TLS.ENCEXT       = 8;
  TLS.CERT         = 11;
  TLS.CERTVERIFY   = 15;
  TLS.FINISHED     = 20;

  TLS.MAXREC   = 18432;   // 16384 of payload plus room for the header, tag and padding
  TLS.MAXPLAIN = 16384;

var
  tls.fd:       int;
  tls.verified: bool;     // ALWAYS false for now: see the note at the top of this file
  tls.err:      int;      // 0 while healthy; an alert code or a negative errno otherwise
  tls.errmsg:   str;

  // keys and secrets
  tls.priv:    array[0..31] of char;   // our X25519 private key
  tls.pub:     array[0..31] of char;
  tls.shared:  array[0..31] of char;
  tls.early:   array[0..31] of char;
  tls.hsec:    array[0..31] of char;   // handshake secret
  tls.msec:    array[0..31] of char;   // master secret
  tls.chs:     array[0..31] of char;   // client handshake traffic secret
  tls.shs:     array[0..31] of char;   // server handshake traffic secret
  tls.cap:     array[0..31] of char;   // client application traffic secret
  tls.sap:     array[0..31] of char;   // server application traffic secret

  tls.ckey: array[0..31] of char;      // the key/iv pair currently used for WRITING
  tls.civ:  array[0..11] of char;
  tls.skey: array[0..31] of char;      // and for READING
  tls.siv:  array[0..11] of char;
  tls.cseq: int;
  tls.sseq: int;
  tls.encrypting: bool;                // are we writing encrypted records yet?
  tls.decrypting: bool;

  // the transcript hash, kept incrementally
  tls.th:   array[0..31] of char;      // hash of everything so far, recomputed on demand
  tls.tr:   array[0..16383] of char;   // the transcript itself
  tls.trn:  int;

  tls.rec:  array[0..TLS.MAXREC-1] of char;   // one record, in or out
  tls.recn: int;
  tls.plain: array[0..TLS.MAXPLAIN-1] of char; // decrypted payload of the current record
  tls.plainn: int;
  tls.plainat: int;                            // how much of it the caller has taken
  tls.plaintype: int;

  tls.nonce: array[0..11] of char;
  tls.aad:   array[0..4] of char;
  tls.tag:   array[0..15] of char;
  tls.tmp:   array[0..255] of char;
  tls.fin:   array[0..31] of char;
  tls.fkey:  array[0..31] of char;
  tls.rnd:   array[0..31] of char;

  // Where the peer's certificate chain sits inside tls.tr.
  tls.certat: int;
  tls.certn:  int;

  // WHERE EVERY CERTIFICATE IN THE CHAIN SITS, for lib/chain.wz to walk. Recorded as
  // offsets into the handshake buffer rather than copied: the bytes are already there and
  // the signature covers them exactly as they lie.
  tls.chainat:  array[0..TLS.MAXCHAIN-1] of int;
  tls.chainn:   array[0..TLS.MAXCHAIN-1] of int;
  tls.chaincnt: int;
  tls.chainerr: str;      // why the chain was refused, when it was

  // THE CHAIN IS COPIED, NOT POINTED AT, and that was a real bug: the offsets were taken
  // into the handshake message buffer, which by the time Finished arrives holds Finished.
  // The certificate had been overwritten and x509.parse read whatever was there -- it said
  // "not a SEQUENCE", which is the good outcome; the bad one would have been bytes that
  // parsed. Certificates are small and there are at most a handful, so a copy is cheap.
  tls.chainbuf: array[0..16383] of char;
  tls.chainlen: int;
  // The leaf certificate's public key, taken out while it is still in view.
  tls.qx: array[0..P.N-1] of int;
  // The leaf's key, in whichever form it came. keykind: 1 = RSA, 2 = P-256, 4 = P-384.
  tls.qx4, tls.qy4: array[0..Q.N-1] of int;
  tls.rsakey: array[0..1023] of char;
  tls.rsakeyn: int;
  tls.keykind: int;
  tls.qy: array[0..P.N-1] of int;
  tls.haskey: bool;
  tls.now: int;          // the caller's idea of the current time, 0 to skip the date check
  tls.host:  array[0..255] of char;
  tls.hostn: int;
  // The CertificateVerify signature, and the transcript hash it covers.
  tls.cvsig: array[0..255] of char;
  tls.cvsign: int;
  tls.cvalg: int;
  tls.cvth: array[0..31] of char;
  tls.sigbuf: array[0..255] of char;
  tls.connectraw: bool;              // the hostname was set by tls.connectb, keep it

procedure tls.fail(code: int; msg: str);
begin
  if tls.err = 0 then
  begin
    tls.err := code;
    tls.errmsg := msg;
  end;
end;

// ---- the transcript ---------------------------------------------------------------------
//
// EVERY HANDSHAKE MESSAGE GOES IN, in the order it appeared on the wire, and the record
// headers do NOT. The transcript is the concatenation of handshake MESSAGES -- type, length,
// body -- which is not the same as the bytes that crossed the wire, because one record can
// hold several messages and one message can span records.
procedure tls.tradd(b: array of char; at: int; n: int);
var i: int;
begin
  i := 0;
  while i < n do
  begin
    if tls.trn < len(tls.tr) then
    begin
      tls.tr[tls.trn] := b[at + i];
      tls.trn := tls.trn + 1;
    end
    else tls.fail(80, "handshake transcript too large");
    i := i + 1;
  end;
end;

// The hash of the transcript SO FAR. Recomputed from scratch each time rather than kept as
// running SHA-256 state, because the schedule needs the hash at several points while the
// transcript keeps growing -- and sha256's state is global, so one running context cannot be
// snapshotted. A handshake is a few kilobytes and this happens about five times.
procedure tls.trhash(out: array of char);
var i: int;
begin
  sha256.init;
  // hk.feed hashes a PREFIX of a buffer; sha256.update takes a whole array and sizes it
  // with len(), which cannot express "the first trn bytes of tls.tr".
  hk.feed(tls.tr, tls.trn);
  sha256.final(out);
end;

// Copy n bytes out of src at `at` into dst[0..n).
procedure tls.copyin(dst: array of char; src: array of char; at: int; n: int);
var i: int;
begin
  i := 0;
  while i < n do begin dst[i] := src[at + i]; i := i + 1; end;
end;

// Write an ECDSA signature as DER: SEQUENCE { INTEGER r, INTEGER s }. Returns the position
// after it.
//
// A DER INTEGER IS SIGNED, so a value whose top bit is set needs a leading zero byte --
// otherwise it reads as negative and the peer rejects the signature. And leading zeros are
// otherwise forbidden, so they have to be stripped first. Both halves of that rule matter.
function tls.derwrite(dst: array of char; at: int; r: array of int; sg: array of int): int;
var seqat, i, n: int;
    tmp: array[0..31] of char;
begin
  dst[at] := chr(0x30);
  seqat := at + 1;
  at := at + 2;
  i := 0;
  while i < 2 do
  begin
    if i = 0 then p256.tobytes(tmp, 0, r) else p256.tobytes(tmp, 0, sg);
    n := 0;
    while (n < 31) and (tmp[n] = chr(0)) do n := n + 1;   // strip leading zeros
    dst[at] := chr(0x02);
    if ord(tmp[n]) >= 128 then
    begin
      dst[at + 1] := chr(32 - n + 1);
      dst[at + 2] := chr(0);
      at := at + 3;
    end
    else
    begin
      dst[at + 1] := chr(32 - n);
      at := at + 2;
    end;
    while n < 32 do begin dst[at] := tmp[n]; at := at + 1; n := n + 1; end;
    i := i + 1;
  end;
  dst[seqat] := chr(at - seqat - 1);
  return at;
end;

// ---- byte helpers -------------------------------------------------------------------------

procedure tls.put8(b: array of char; at: int; v: int);
begin
  b[at] := chr(band(v, 255));
end;

procedure tls.put16(b: array of char; at: int; v: int);
begin
  b[at]     := chr(band(v shr 8, 255));
  b[at + 1] := chr(band(v, 255));
end;

procedure tls.put24(b: array of char; at: int; v: int);
begin
  b[at]     := chr(band(v shr 16, 255));
  b[at + 1] := chr(band(v shr 8, 255));
  b[at + 2] := chr(band(v, 255));
end;

function tls.get16(b: array of char; at: int): int;
begin
  return ord(b[at]) * 256 + ord(b[at + 1]);
end;

function tls.get24(b: array of char; at: int): int;
begin
  return ord(b[at]) * 65536 + ord(b[at + 1]) * 256 + ord(b[at + 2]);
end;

// ---- blocking send and receive, with a deadline ----------------------------------------------
//
// EVERY BLOCKING CALL HAS A WALL-CLOCK LIMIT: tls.connect, tls.accept, tls.read, tls.write
// and tls.close each finish within tls.deadline milliseconds (30 seconds when it is 0), or
// fail with tls.err = -110 and a message that says so. A peer that stalls in the middle of
// a handshake or a record then costs the caller the deadline, not the rest of its life.
//
// THE SOCKET IS PUT IN NON-BLOCKING MODE for this, and waited on with epoll for exactly the
// time that is left. A blocking read cannot be given a limit without a socket timeout
// per call, and a loop that retries EAGAIN without waiting burns a core and has no idea
// how long it has been at it.

var
  tls.deadline: int;                   // ms per call; 0 means 30000
  tls.until:    int;                   // when the current call must be done, monotonic ms
  tls.cep:      int;                   // the epoll set the client waits on
  tls.cepready: bool;
  tls.cevs:     array[0..11] of char;

procedure tls.startclock;
var ms: int;
begin
  ms := tls.deadline;
  if ms <= 0 then ms := 30000;
  tls.until := io.now div 1000000 + ms;
end;

// Make fd the socket the blocking calls use: non-blocking, and in the client's epoll set.
function tls.arm(fd: int): bool;
begin
  tls.fd := fd;
  if not net.nonblock(fd) then begin tls.fail(0 - 9, "the socket cannot be made non-blocking"); return false; end;
  if not tls.cepready then
  begin
    tls.cep := net.epoll;
    if tls.cep < 0 then begin tls.fail(0 - 24, "no epoll set for the TLS client"); return false; end;
    tls.cepready := true;
  end;
  // A DESCRIPTOR NUMBER IS REUSED: a new socket can have the number of one closed earlier,
  // still listed in the set. So it is taken out first -- that failing only means it was not
  // in -- and then added fresh.
  if net.watch(tls.cep, EPOLL_DEL, fd, 0) then tls.until := tls.until;
  if not net.watch(tls.cep, EPOLL_ADD, fd, EPOLLIN) then
  begin
    tls.fail(0 - 9, "the socket cannot be watched");
    return false;
  end;
  return true;
end;

// Wait until the socket is ready for `events`, or the deadline passes. False = too late.
function tls.waitfor(events: int): bool;
var left, r: int;
begin
  left := tls.until - io.now div 1000000;
  if left <= 0 then
  begin
    tls.fail(0 - 110, "the peer did not answer within tls.deadline");
    return false;
  end;
  if not net.watch(tls.cep, EPOLL_MOD, tls.fd, events) then
  begin
    tls.fail(0 - 9, "the socket cannot be watched");
    return false;
  end;
  r := net.wait(tls.cep, addr(tls.cevs[0]), 1, left);
  return true;
end;

// A short write is normal on a non-blocking socket and is continued, not treated as an error.
function tls.sendall(b: array of char; n: int): bool;
var sent, r: int;
begin
  sent := 0;
  while sent < n do
  begin
    r := net.send(tls.fd, addr(b[sent]), n - sent);
    if r > 0 then sent := sent + r
    else if r = EAGAIN then
    begin
      if not tls.waitfor(EPOLLOUT) then return false;
    end
    else if r <> 0 - 4 then          // EINTR is tried again
    begin
      tls.fail(0 - 1, "the connection closed while sending");
      return false;
    end;
  end;
  return true;
end;

function tls.recvall(b: array of char; at: int; n: int): bool;
var got, r: int;
begin
  got := 0;
  while got < n do
  begin
    r := net.recv(tls.fd, addr(b[at + got]), n - got);
    if r > 0 then got := got + r
    else if r = EAGAIN then
    begin
      if not tls.waitfor(EPOLLIN) then return false;
    end
    else if r <> 0 - 4 then
    begin
      tls.fail(0 - 1, "the connection closed while receiving");
      return false;
    end;
  end;
  return true;
end;

// ---- the record layer -----------------------------------------------------------------------
//
// THE NONCE IS THE IV XORED WITH THE SEQUENCE NUMBER, right-aligned in the 12 bytes
// (RFC 8446 §5.3). Sequence numbers start at zero and RESET on every key change -- which is
// why a bug here hides: record 0 uses nonce = IV, so the very first record after a key
// change works no matter what, and only the second one fails.
procedure tls.mknonce(iv: array of char; seq: int);
var i, s: int;
begin
  i := 0;
  while i < 12 do begin tls.nonce[i] := iv[i]; i := i + 1; end;
  s := seq;
  i := 11;
  while i >= 4 do
  begin
    tls.nonce[i] := chr(bxor(ord(tls.nonce[i]), band(s, 255)));
    s := s shr 8;
    i := i - 1;
  end;
end;

// Send one record. When encrypting, the real content type is appended to the plaintext and
// the outer header claims application_data -- that is TLS 1.3's way of hiding which records
// are handshake and which are data (§5.2).
function tls.sendrec(ctype: int; b: array of char; at: int; n: int): bool;
var i, total: int;
begin
  if not tls.encrypting then
  begin
    // COPIED BACKWARDS, because the caller's buffer IS tls.rec.
    //
    // tls.hello builds its message in tls.rec and then asks to send it from there, so this
    // copy has source and destination in the same array with the destination five bytes
    // HIGHER. Copying forwards overwrites each source byte before it is read: measured, the
    // ClientHello went out as its own 5-byte record header repeated 34 times. Going from the
    // top down, the source byte is always still untouched when it is read.
    i := n - 1;
    while i >= 0 do begin tls.rec[5 + i] := b[at + i]; i := i - 1; end;
    tls.rec[0] := chr(ctype);
    tls.put16(tls.rec, 1, 0x0303);
    tls.put16(tls.rec, 3, n);
    return tls.sendall(tls.rec, 5 + n);
  end;

  i := 0;
  while i < n do begin tls.plain[i] := b[at + i]; i := i + 1; end;
  tls.plain[n] := chr(ctype);          // the true type, inside the encryption
  total := n + 1 + 16;                 // plus the Poly1305 tag

  tls.rec[0] := chr(TLS.APPDATA);      // the outer type is always application_data
  tls.put16(tls.rec, 1, 0x0303);
  tls.put16(tls.rec, 3, total);

  // THE HEADER IS THE ADDITIONAL DATA, all five bytes of it, with the length of the
  // ENCRYPTED record. Using the plaintext length here is a classic mistake: it authenticates
  // a number the peer never sees.
  i := 0;
  while i < 5 do begin tls.aad[i] := tls.rec[i]; i := i + 1; end;

  tls.mknonce(tls.civ, tls.cseq);
  ae.setkey(tls.ckey);
  ae.setnonce(tls.nonce);
  ae.seal(tls.aad, 5, tls.plain, 0, n + 1, tls.tag);
  tls.cseq := tls.cseq + 1;

  i := 0;
  while i < n + 1 do begin tls.rec[5 + i] := tls.plain[i]; i := i + 1; end;
  i := 0;
  while i < 16 do begin tls.rec[5 + n + 1 + i] := tls.tag[i]; i := i + 1; end;
  return tls.sendall(tls.rec, 5 + total);
end;

// Read one record into tls.plain, decrypting when the keys are up. Returns false on error.
//
// PADDING IS STRIPPED FROM THE RIGHT. An encrypted record is content || type || zero or more
// zero bytes, so the real type is the LAST NON-ZERO byte -- not the last byte.
function tls.readrec: bool;
var n, i, ctype: int;
begin
  if not tls.recvall(tls.rec, 0, 5) then return false;
  ctype := ord(tls.rec[0]);
  n := tls.get16(tls.rec, 3);
  if (n < 0) or (n > TLS.MAXREC - 5) then
  begin
    tls.fail(22, "a record claims an impossible length");
    return false;
  end;
  if not tls.recvall(tls.rec, 5, n) then return false;

  if (not tls.decrypting) or (ctype = TLS.CHANGECIPHER) then
  begin
    // change_cipher_spec is ignored entirely: in TLS 1.3 it carries no meaning and exists
    // only so middleboxes believe they are watching a TLS 1.2 session (§5).
    i := 0;
    while i < n do begin tls.plain[i] := tls.rec[5 + i]; i := i + 1; end;
    tls.plainn := n;
    tls.plaintype := ctype;
    tls.plainat := 0;
    return true;
  end;

  if n < 17 then
  begin
    tls.fail(22, "an encrypted record is too short to hold a tag");
    return false;
  end;
  // THE PLAINTEXT MUST FIT, and this check was missing. A record may legitimately carry up
  // to 16384 bytes of plaintext plus a 16-byte tag, so a full-sized record overflowed
  // tls.plain by exactly the tag -- and the failure was a runtime bounds error partway
  // through the copy, on the first server whose certificate chain was large enough.
  // Measured 22-09-2026 against github.com, whose chain is three certificates.
  if n - 16 > TLS.MAXPLAIN then
  begin
    tls.fail(22, "a record carries more plaintext than TLS allows");
    return false;
  end;
  i := 0;
  while i < 5 do begin tls.aad[i] := tls.rec[i]; i := i + 1; end;
  i := 0;
  while i < 16 do begin tls.tag[i] := tls.rec[5 + n - 16 + i]; i := i + 1; end;
  i := 0;
  while i < n - 16 do begin tls.plain[i] := tls.rec[5 + i]; i := i + 1; end;

  tls.mknonce(tls.siv, tls.sseq);
  ae.setkey(tls.skey);
  ae.setnonce(tls.nonce);
  if not ae.open(tls.aad, 5, tls.plain, 0, n - 16, tls.tag) then
  begin
    tls.fail(20, "a record failed to authenticate");
    return false;
  end;
  tls.sseq := tls.sseq + 1;

  i := n - 16;
  while (i > 0) and (tls.plain[i - 1] = chr(0)) do i := i - 1;
  if i = 0 then
  begin
    tls.fail(22, "a decrypted record is all padding and has no content type");
    return false;
  end;
  tls.plaintype := ord(tls.plain[i - 1]);
  tls.plainn := i - 1;
  tls.plainat := 0;
  return true;
end;

// ---- the key schedule ---------------------------------------------------------------------
//
// RFC 8446 §7.1, and THE ORDER IS THE SPECIFICATION. Each secret is derived from the one
// before it, with a label and the transcript hash at that exact point. A label typo or a
// hash taken one message too late gives a valid key the server does not share, and the only
// symptom is that Finished does not match.
procedure tls.keys(secret: array of char; key: array of char; iv: array of char);
begin
  tls.expandlabel(secret, "key", tls.tmp, 0, key, 32);
  tls.expandlabel(secret, "iv", tls.tmp, 0, iv, 12);
end;

procedure tls.schedule;
var zeros: array[0..31] of char;
    i: int;
    derived: array[0..31] of char;
begin
  i := 0;
  while i < 32 do begin zeros[i] := chr(0); i := i + 1; end;

  // early secret = HKDF-Extract(salt = 0, ikm = 0) -- no PSK, so both are all zeros.
  hkdf.extract(zeros, 0, zeros, 32, tls.early);

  // handshake secret = Extract(Derive-Secret(early, "derived", ""), ECDHE)
  sha256.init;
  sha256.final(tls.th);                       // the hash of the EMPTY string
  tls.derivesecret(tls.early, "derived", tls.th, derived);
  hkdf.extract(derived, 32, tls.shared, 32, tls.hsec);

  // The traffic secrets use the transcript through ServerHello.
  tls.trhash(tls.th);
  tls.derivesecret(tls.hsec, "c hs traffic", tls.th, tls.chs);
  tls.derivesecret(tls.hsec, "s hs traffic", tls.th, tls.shs);

  // master secret = Extract(Derive-Secret(handshake, "derived", ""), 0)
  sha256.init;
  sha256.final(tls.th);
  tls.derivesecret(tls.hsec, "derived", tls.th, derived);
  hkdf.extract(derived, 32, zeros, 32, tls.msec);

  tls.keys(tls.chs, tls.ckey, tls.civ);
  tls.keys(tls.shs, tls.skey, tls.siv);
  tls.cseq := 0;
  tls.sseq := 0;
end;

// Finished = HMAC(finished_key, transcript_hash). This is what proves both sides saw the
// SAME handshake: an attacker who altered any message cannot produce it.
//
// The caller sets tls.fkey (from the right traffic secret) and tls.th (the transcript hash
// at the right point) first, because WHICH secret and WHICH point differ between the
// server's Finished and ours -- passing them in would hide that they are two decisions.
procedure tls.finishedmac(dst: array of char);
var i: int;
begin
  i := 0;
  while i < 32 do begin hk.msg[i] := tls.th[i]; i := i + 1; end;
  hk.msgn := 32;
  hk.mac(tls.fkey, 32, dst);
end;

// ---- ClientHello ----------------------------------------------------------------------------

function tls.hello(host: str): bool;
var n, extat, extlen, i, hn: int;
begin
  n := 0;
  tls.tmp[0] := chr(0);                       // unused; the message is built in tls.rec

  // The handshake message body starts at 4 (type + 3-byte length go in front).
  n := 4;
  tls.put16(tls.rec, n, 0x0303); n := n + 2;  // legacy_version: TLS 1.2, always
  // rand.bytes fills a WHOLE array, so the 32 bytes are drawn into a local buffer and
  // copied in. Writing into the middle of tls.rec directly is not expressible.
  rand.bytes(tls.rnd);
  i := 0;
  while i < 32 do begin tls.rec[n] := tls.rnd[i]; n := n + 1; i := i + 1; end;
  tls.rec[n] := chr(32); n := n + 1;          // a legacy session id, 32 random bytes
  rand.bytes(tls.rnd);
  i := 0;
  while i < 32 do begin tls.rec[n] := tls.rnd[i]; n := n + 1; i := i + 1; end;

  // cipher_suites: exactly one.
  tls.put16(tls.rec, n, 2); n := n + 2;
  tls.put16(tls.rec, n, 0x1303); n := n + 2;  // TLS_CHACHA20_POLY1305_SHA256
  tls.rec[n] := chr(1); n := n + 1;           // legacy_compression_methods: null only
  tls.rec[n] := chr(0); n := n + 1;

  extat := n; n := n + 2;                     // extensions length, filled in at the end

  // server_name (0), so a host serving several sites picks the right certificate.
  //
  // THE NAME COMES FROM tls.host, NOT FROM THE PARAMETER, and that was a real bug: a caller
  // using tls.connectb passes its hostname as BYTES (Wantzel cannot build a str from
  // characters), which connectb stored in tls.host and then called tls.connect with "".
  // So the SNI went out EMPTY. Measured 22-09-2026: github.com, cloudflare.com and
  // wantzel.com all answered alert 112, unrecognized_name -- which is exactly what a server
  // says when it cannot tell which site you want. tls.host is filled on both paths, so
  // reading it here covers the str caller and the byte caller with one piece of code.
  //
  // AN EMPTY NAME OMITS THE EXTENSION ENTIRELY rather than sending an empty one. RFC 6066
  // has no use for a zero-length host_name, and a server that sees one is entitled to the
  // same alert.
  hn := tls.hostn;
  if hn > 0 then
  begin
    tls.put16(tls.rec, n, 0); n := n + 2;
    tls.put16(tls.rec, n, hn + 5); n := n + 2;
    tls.put16(tls.rec, n, hn + 3); n := n + 2;
    tls.rec[n] := chr(0); n := n + 1;           // name_type: host_name
    tls.put16(tls.rec, n, hn); n := n + 2;
    i := 0;
    while i < hn do begin tls.rec[n] := tls.host[i]; n := n + 1; i := i + 1; end;
  end;

  // supported_versions (43): TLS 1.3 ONLY. This is what makes a downgrade impossible --
  // legacy_version above still says 1.2 and is ignored by any 1.3 server.
  tls.put16(tls.rec, n, 43); n := n + 2;
  tls.put16(tls.rec, n, 3); n := n + 2;
  tls.rec[n] := chr(2); n := n + 1;
  tls.put16(tls.rec, n, 0x0304); n := n + 2;

  // supported_groups (10): X25519 only.
  tls.put16(tls.rec, n, 10); n := n + 2;
  tls.put16(tls.rec, n, 4); n := n + 2;
  tls.put16(tls.rec, n, 2); n := n + 2;
  tls.put16(tls.rec, n, 29); n := n + 2;      // x25519

  // signature_algorithms (13): what we are willing to see on a certificate. Advertised now
  // even though verification comes later, because a server picks its certificate from this.
  // ADVERTISE ONLY WHAT WE CAN ACTUALLY CHECK. A scheme listed here and unsupported in
  // tls.checkcv gives a handshake that completes and a verification that fails -- the worst
  // of both, because the failure arrives after the connection looks established.
  //
  // rsa_pkcs1_sha256 stays in the list for the CERTIFICATE's own signature (a chain may be
  // signed with it), but TLS 1.3 forbids it for CertificateVerify, so a server will not
  // choose it there.
  tls.put16(tls.rec, n, 13); n := n + 2;
  tls.put16(tls.rec, n, 12); n := n + 2;
  tls.put16(tls.rec, n, 10); n := n + 2;
  tls.put16(tls.rec, n, 0x0403); n := n + 2;  // ecdsa_secp256r1_sha256
  tls.put16(tls.rec, n, 0x0503); n := n + 2;  // ecdsa_secp384r1_sha384
  tls.put16(tls.rec, n, 0x0804); n := n + 2;  // rsa_pss_rsae_sha256
  tls.put16(tls.rec, n, 0x0805); n := n + 2;  // rsa_pss_rsae_sha384
  tls.put16(tls.rec, n, 0x0401); n := n + 2;  // rsa_pkcs1_sha256

  // key_share (51): our X25519 public key, sent with the hello so one round trip is enough.
  tls.put16(tls.rec, n, 51); n := n + 2;
  tls.put16(tls.rec, n, 38); n := n + 2;
  tls.put16(tls.rec, n, 36); n := n + 2;
  tls.put16(tls.rec, n, 29); n := n + 2;
  tls.put16(tls.rec, n, 32); n := n + 2;
  i := 0;
  while i < 32 do begin tls.rec[n] := tls.pub[i]; n := n + 1; i := i + 1; end;

  extlen := n - extat - 2;
  tls.put16(tls.rec, extat, extlen);

  tls.rec[0] := chr(TLS.CLIENTHELLO);
  tls.put24(tls.rec, 1, n - 4);

  tls.tradd(tls.rec, 0, n);
  return tls.sendrec(TLS.HANDSHAKE, tls.rec, 0, n);
end;

// ---- ServerHello -----------------------------------------------------------------------------

// Pull the server's key_share out of a ServerHello body and multiply it with our private key.
//
// NAMED readsh AND NOT serverhello: identifiers are case-insensitive here, so tls.serverhello
// is the same name as the constant TLS.SERVERHELLO and the compiler refuses it.
function tls.readsh(b: array of char; at: int; n: int): bool;
var at2, endp, ext, extlen, exttype, sidlen, group, klen, i: int;
    peer: array[0..31] of char;
begin
  at2 := at + 2;                      // skip legacy_version
  at2 := at2 + 32;                      // skip random
  sidlen := ord(b[at2]); at2 := at2 + 1 + sidlen;
  if tls.get16(b, at2) <> 0x1303 then
  begin
    tls.fail(40, "the server chose a cipher suite we did not offer");
    return false;
  end;
  at2 := at2 + 2;
  at2 := at2 + 1;                       // legacy_compression_method
  extlen := tls.get16(b, at2); at2 := at2 + 2;
  endp := at2 + extlen;

  group := 0 - 1;
  while at2 + 4 <= endp do
  begin
    exttype := tls.get16(b, at2);
    ext := tls.get16(b, at2 + 2);
    at2 := at2 + 4;
    if exttype = 51 then
    begin
      group := tls.get16(b, at2);
      klen := tls.get16(b, at2 + 2);
      if (group <> 29) or (klen <> 32) then
      begin
        tls.fail(40, "the server picked a group we did not offer");
        return false;
      end;
      i := 0;
      while i < 32 do begin peer[i] := b[at2 + 4 + i]; i := i + 1; end;
    end;
    at2 := at2 + ext;
  end;
  if group <> 29 then
  begin
    tls.fail(40, "the server sent no usable key_share");
    return false;
  end;

  x.scalarmult(tls.shared, tls.priv, peer);
  return true;
end;

// ---- the server's certificate ----------------------------------------------------------------

// Certificate ::= { context [1 byte length], certificate_list }
// each entry ::= { cert_data [3-byte length], extensions [2-byte length] }
//
// THE LEAF DECIDES WHO THIS IS; THE REST DECIDES WHETHER TO BELIEVE IT. The leaf's key is
// what signs CertificateVerify and its names and dates say whether this is the right server,
// so that part is checked here. The remaining certificates are RECORDED, in the order sent,
// for lib/chain.wz to walk up to a trust anchor afterwards -- which is what turns "the
// server holds this key" into "and someone we trust issued it".
// tls.recordchain -- note where every certificate in the list begins and how long it is.
//
// The list is { 3-byte length, cert, 2-byte extensions } repeated. Extensions are skipped:
// nothing this client does depends on them, and a certificate's own bytes are what get
// verified.
procedure tls.recordchain(b: array of char; at: int; listend: int);
var clen, elen, i: int;
begin
  tls.chaincnt := 0;
  tls.chainlen := 0;
  while (at + 3 <= listend) and (tls.chaincnt < TLS.MAXCHAIN) do
  begin
    clen := tls.get24(b, at);
    at := at + 3;
    if at + clen > listend then return;
    if tls.chainlen + clen > len(tls.chainbuf) then return;
    i := 0;
    while i < clen do begin tls.chainbuf[tls.chainlen + i] := b[at + i]; i := i + 1; end;
    tls.chainat[tls.chaincnt] := tls.chainlen;
    tls.chainn[tls.chaincnt] := clen;
    tls.chainlen := tls.chainlen + clen;
    tls.chaincnt := tls.chaincnt + 1;
    at := at + clen;
    if at + 2 > listend then return;
    elen := ord(b[at]) * 256 + ord(b[at + 1]);
    at := at + 2 + elen;
  end;
end;

function tls.readcert(b: array of char; n: int): bool;
var at, listend, clen, i: int;
begin
  tls.haskey := false;
  tls.keykind := 0;
  tls.chaincnt := 0;
  at := 4;                                   // past the handshake header
  if at >= n then begin tls.fail(42, "an empty Certificate message"); return false; end;
  at := at + 1 + ord(b[at]);                 // skip the certificate_request_context
  if at + 3 > n then begin tls.fail(42, "a truncated certificate_list"); return false; end;
  listend := at + 3 + tls.get24(b, at);
  at := at + 3;
  if listend > n then begin tls.fail(42, "the certificate_list runs past the message"); return false; end;
  if at + 3 > listend then begin tls.fail(42, "no certificate in the list"); return false; end;

  clen := tls.get24(b, at);
  at := at + 3;
  if at + clen > listend then begin tls.fail(42, "a certificate runs past the list"); return false; end;

  // REMEMBER THE WHOLE LIST BEFORE LOOKING AT THE LEAF. The walk below consumes `at`, and
  // the chain has to be recorded from where each certificate actually starts -- an offset
  // taken after the leaf has been parsed points at the wrong place.
  tls.recordchain(b, at - 3, listend);

  if not x509.parse(b, at, at + clen) then
  begin
    tls.fail(42, "the server's certificate does not parse");
    return false;
  end;

  // THE NAME MUST MATCH. Without this any valid certificate for any domain works -- which
  // is the classic way to have TLS and no security at all.
  if tls.hostn > 0 then
  begin
    if not x509.matchesb(b, tls.host, tls.hostn) then
    begin
      tls.fail(42, "the certificate is not valid for this hostname");
      return false;
    end;
  end;

  // AND IT MUST BE IN DATE. Skipped when the caller passes 0, because a machine with no
  // clock is a real situation -- but then it must be the CALLER's decision, not a silent
  // default.
  if tls.now > 0 then
  begin
    if tls.now < x509.notbefore then
    begin
      tls.fail(45, "the certificate is not valid yet");
      return false;
    end;
    if tls.now > x509.notafter then
    begin
      tls.fail(45, "the certificate has expired");
      return false;
    end;
  end;

  if x509.keyalg = 2 then
  begin
    // An EC point: 0x04 then X then Y, uncompressed. A compressed point would need a square
    // root in the field, which is more machinery than this client needs today.
    if (x509.keyn <> 65) or (b[x509.keyat] <> chr(4)) then
    begin
      tls.fail(42, "the EC public key is not an uncompressed P-256 point");
      return false;
    end;
    p256.frombytes(tls.qx, b, x509.keyat + 1);
    p256.frombytes(tls.qy, b, x509.keyat + 33);
    p256.setup;
    if not p256.oncurve(tls.qx, tls.qy) then
    begin
      tls.fail(42, "the certificate's public key is not on the curve");
      return false;
    end;
    tls.keykind := 2;
    tls.haskey := true;
  end;
  if x509.keyalg = 4 then
  begin
    // A P-384 point: 0x04 then X then Y, 48 bytes each.
    if (x509.keyn <> 97) or (b[x509.keyat] <> chr(4)) then
    begin
      tls.fail(42, "the EC public key is not an uncompressed P-384 point");
      return false;
    end;
    p384.frombytes(tls.qx4, b, x509.keyat + 1);
    p384.frombytes(tls.qy4, b, x509.keyat + 49);
    p384.setup;
    if not p384.oncurve(tls.qx4, tls.qy4) then
    begin
      tls.fail(42, "the certificate's public key is not on the P-384 curve");
      return false;
    end;
    tls.keykind := 4;
    tls.haskey := true;
  end;

  if x509.keyalg = 1 then
  begin
    // AN RSA KEY, which the server signs CertificateVerify with -- in PKCS#1 v1.5 or, far
    // more often now, in PSS. The key is remembered as the SEQUENCE it is; rsa.setkey pulls
    // the modulus and exponent out of it at verification time, so nothing is parsed twice.
    if x509.keyn > len(tls.rsakey) then
    begin
      tls.fail(42, "the RSA public key is larger than this client holds");
      return false;
    end;
    i := 0;
    while i < x509.keyn do begin tls.rsakey[i] := b[x509.keyat + i]; i := i + 1; end;
    tls.rsakeyn := x509.keyn;
    tls.keykind := 1;
    tls.haskey := true;
  end;

  return true;
end;

// CertificateVerify ::= { algorithm [2 bytes], signature [2-byte length] }
function tls.readcv(b: array of char; n: int): bool;
var at, sn: int;
    i: int;
begin
  at := 4;
  if at + 4 > n then begin tls.fail(50, "a truncated CertificateVerify"); return false; end;
  tls.cvalg := tls.get16(b, at);
  at := at + 2;
  sn := tls.get16(b, at);
  at := at + 2;
  if (sn < 0) or (at + sn > n) or (sn > len(tls.cvsig)) then
  begin
    tls.fail(50, "the CertificateVerify signature has an impossible length");
    return false;
  end;
  i := 0;
  while i < sn do begin tls.cvsig[i] := b[at + i]; i := i + 1; end;
  tls.cvsign := sn;
  return true;
end;

// What CertificateVerify actually signs (RFC 8446 §4.4.3): 64 spaces, a context string, a
// zero byte, then the transcript hash. Leaves the digest in tls.th.
//
// THE 64 SPACES ARE NOT DECORATION. They make the signed blob impossible to confuse with a
// certificate's own signed bytes, which is what stopped a whole family of cross-protocol
// attacks in earlier TLS versions.
// THE CONTEXT STRING DIFFERS BY ONE WORD between the two directions: "server
// CertificateVerify" against "client CertificateVerify". That is deliberate in the RFC --
// it stops a signature made in one direction being replayed in the other -- and using the
// wrong one produces a signature the peer rejects with no error that points here.
procedure tls.cvdigestfor(server: bool);
var i, n: int;
    ctx: str;
begin
  if server then ctx := "TLS 1.3, server CertificateVerify"
  else ctx := "TLS 1.3, client CertificateVerify";
  sha256.init;
  i := 0;
  while i < 64 do begin tls.tmp[i] := chr(32); i := i + 1; end;
  hk.feed(tls.tmp, 64);
  n := slen(ctx);
  i := 0;
  while i < n do begin tls.tmp[i] := schar(ctx, i); i := i + 1; end;
  hk.feed(tls.tmp, n);
  tls.tmp[0] := chr(0);
  hk.feed(tls.tmp, 1);
  hk.feed(tls.cvth, 32);
  sha256.final(tls.th);
end;

procedure tls.cvdigest;
begin
  tls.cvdigestfor(true);
end;

// A DER INTEGER into eight limbs, right-aligned into 32 bytes.
function tls.derint(r: array of int; b: array of char; at: int; n: int): bool;
var i: int;
begin
  while (n > 0) and (b[at] = chr(0)) do begin at := at + 1; n := n - 1; end;
  if (n = 0) or (n > 32) then begin tls.fail(50, "a DER INTEGER in the CertificateVerify signature is empty or too wide"); return false; end;
  i := 0;
  while i < 32 do begin tls.sigbuf[i] := chr(0); i := i + 1; end;
  i := 0;
  while i < n do begin tls.sigbuf[32 - n + i] := b[at + i]; i := i + 1; end;
  p256.frombytes(r, tls.sigbuf, 0);
  return true;
end;

// Check the server's CertificateVerify against the leaf certificate's key.
//
// Returns true only when the signature was actually checked and passed. An algorithm or a
// key type this client cannot handle returns FALSE -- an unverified connection must never
// look like a verified one.
// tls.checkchain -- does the certificate chain the server sent reach a trusted root?
//
// SEPARATE FROM tls.checkcv ON PURPOSE. CertificateVerify proves possession of a key; this
// proves the key belongs to someone a root vouched for. They fail for different reasons and
// a caller debugging a refused connection needs to know which.
//
// THE TRUST STORE IS THE CALLER'S. lib/chain.wz holds it, the caller fills it, and an empty
// store refuses everything -- there is no system store to fall back on and no default to be
// surprised by. That is the price of zero dependencies and it is the right way round: what
// is trusted is stated, not inherited.
function tls.checkchain: bool;
var i: int;
begin
  if tls.chaincnt <= 0 then begin tls.fail(42, "the server sent no certificate chain"); return false; end;
  ch.reset;
  i := 0;
  while i < tls.chaincnt do
  begin
    if not ch.setcert(i, tls.chainat[i], tls.chainn[i]) then
      begin tls.fail(42, ch.err); return false; end;
    i := i + 1;
  end;
  // THE HOSTNAME AND THE CLOCK ARE CHECKED AGAIN HERE, and the repetition is deliberate:
  // tls.readcert checks the leaf as it arrives so a wrong certificate is refused early,
  // and chain.wz checks the whole chain so no certificate in it can be out of date.
  if not ch.verify(tls.chainbuf, tls.host, tls.hostn, tls.now) then
    begin tls.chainerr := ch.err; return false; end;
  return true;
end;

// Load the leaf's RSA key into lib/rsa.wz. The key is a SEQUENCE { modulus, exponent }.
function tls.rsakeyload: bool;
var inner, upto, nat, nn, eat, en: int;
begin
  if der.next(tls.rsakey, 0, tls.rsakeyn) < 0 then begin tls.fail(50, "the leaf key does not parse as DER"); return false; end;
  if der.tag <> DER.SEQ then begin tls.fail(50, "the leaf key is not a SEQUENCE"); return false; end;
  inner := der.vat; upto := der.vend;
  if der.next(tls.rsakey, inner, upto) < 0 then begin tls.fail(50, "no modulus in the leaf key"); return false; end;
  if der.tag <> DER.INT then begin tls.fail(50, "the modulus is not an INTEGER"); return false; end;
  nat := der.vat; nn := der.vend - der.vat;
  if der.next(tls.rsakey, der.vend, upto) < 0 then begin tls.fail(50, "no exponent in the leaf key"); return false; end;
  if der.tag <> DER.INT then begin tls.fail(50, "the exponent is not an INTEGER"); return false; end;
  eat := der.vat; en := der.vend - der.vat;
  if not rsa.setkey(tls.rsakey, nat, nn, tls.rsakey, eat, en) then begin tls.fail(50, rsa.err); return false; end;
  return true;
end;

// The same signed blob as tls.cvdigest, hashed with SHA-384 instead of SHA-256.
//
// THE TRANSCRIPT HASH INSIDE IT STAYS SHA-256, and that is not an oversight. RFC 8446 ties
// the transcript hash to the CIPHER SUITE, not to the signature scheme: with
// TLS_CHACHA20_POLY1305_SHA256 the transcript is SHA-256 whatever the server signs with.
// Hashing the transcript with SHA-384 because the signature says SHA-384 is the obvious
// wrong move here, and it fails in a way that looks like a bad signature.
//
// SEPARATE ROUTINE RATHER THAN A FLAG: the blob is assembled identically and only the outer
// hash differs, so a flag threaded through the assembly would be one more thing to get
// backwards.
procedure tls.cvdigest384;
var i, n: int;
    ctx: str;
begin
  ctx := "TLS 1.3, server CertificateVerify";
  sha384.init;
  i := 0;
  while i < 64 do begin tls.tmp[i] := chr(32); i := i + 1; end;
  sha384.updateat(tls.tmp, 0, 64);
  n := slen(ctx);
  i := 0;
  while i < n do begin tls.tmp[i] := schar(ctx, i); i := i + 1; end;
  sha384.updateat(tls.tmp, 0, n);
  tls.tmp[0] := chr(0);
  sha384.updateat(tls.tmp, 0, 1);
  sha384.updateat(tls.cvth, 0, 32);
  sha384.final(tls.th);
end;

// A DER INTEGER into a 384-bit value: strip DER's leading zero, then right-align.
function tls.derint384(r: array of int; b: array of char; at: int; n: int): bool;
var i: int;
begin
  while (n > 0) and (b[at] = chr(0)) do begin at := at + 1; n := n - 1; end;
  if (n = 0) or (n > 48) then begin tls.fail(50, "a DER INTEGER in the CertificateVerify signature is empty or too wide"); return false; end;
  i := 0;
  while i < 48 do begin tls.sigbuf[i] := chr(0); i := i + 1; end;
  i := 0;
  while i < n do begin tls.sigbuf[48 - n + i] := b[at + i]; i := i + 1; end;
  p384.frombytes(r, tls.sigbuf, 0);
  return true;
end;

// CertificateVerify signed with RSA-PSS. hid: 0 = SHA-256, 1 = SHA-384.
//
// THE TRANSCRIPT HASH IS TAKEN WITH THE SAME HASH the scheme names -- tls.cvdigest uses
// SHA-256, which is right for 0x0804 and wrong for 0x0805. The second case needs its own
// digest, and getting that wrong gives a value of the right shape that never matches.
function tls.checkcvpss(hid: int): bool;
begin
  if tls.keykind <> 1 then begin tls.fail(50, "an RSA-PSS CertificateVerify under a key that is not RSA"); return false; end;
  if tls.rsakeyn <= 0 then begin tls.fail(50, "no RSA key was loaded for this CertificateVerify"); return false; end;
  if not tls.rsakeyload then return false;   // tls.rsakeyload already called tls.fail
  if hid = 1 then tls.cvdigest384 else tls.cvdigest;
  // THE SIGNATURE ITSELF IS CHECKED HERE, and that result stays opaque on purpose: whether
  // it verified or not must look the same to anyone probing the connection.
  return rsa.verifypss(hid, tls.cvsig, 0, tls.cvsign, tls.th);
end;

// CertificateVerify signed with ECDSA over P-384.
function tls.checkcv384: bool;
var e, r, sg: array[0..Q.N-1] of int;
    at, rn, sn, rat, sat: int;
begin
  if tls.keykind <> 4 then begin tls.fail(50, "an ECDSA P-384 CertificateVerify under a key that is not P-384"); return false; end;
  tls.cvdigest384;
  p384.frombytes(e, tls.th, 0);
  if der.enter(tls.cvsig, 0, tls.cvsign) < 0 then begin tls.fail(50, "the CertificateVerify signature does not parse"); return false; end;
  at := der.vat;
  if der.next(tls.cvsig, at, tls.cvsign) < 0 then begin tls.fail(50, "no r in the CertificateVerify signature"); return false; end;
  if der.tag <> DER.INT then begin tls.fail(50, "r is not an INTEGER"); return false; end;
  rat := der.vat; rn := der.vend - der.vat;
  at := der.vend;
  if der.next(tls.cvsig, at, tls.cvsign) < 0 then begin tls.fail(50, "no s in the CertificateVerify signature"); return false; end;
  if der.tag <> DER.INT then begin tls.fail(50, "s is not an INTEGER"); return false; end;
  sat := der.vat; sn := der.vend - der.vat;
  if not tls.derint384(r, tls.cvsig, rat, rn) then return false;   // tls.derint384 already called tls.fail
  if not tls.derint384(sg, tls.cvsig, sat, sn) then return false;  // tls.derint384 already called tls.fail
  // THE SIGNATURE ITSELF IS CHECKED HERE, and that result stays opaque on purpose.
  return p384.verify(tls.qx4, tls.qy4, e, r, sg);
end;

function tls.checkcv: bool;
var e, r, sg: array[0..P.N-1] of int;
    at, rn, sn, rat, sat: int;
begin
  if not tls.haskey then begin tls.fail(50, "no key was loaded from the leaf certificate"); return false; end;

  // THE SIGNATURE SCHEME SAYS BOTH THE ALGORITHM AND THE HASH, and the key must match it.
  // A scheme the key cannot carry is not a mismatch to shrug at -- it is the shape of an
  // attack -- so each branch checks keykind explicitly rather than falling through.
  //
  //   0x0403  ecdsa_secp256r1_sha256    P-256 + SHA-256
  //   0x0503  ecdsa_secp384r1_sha384    P-384 + SHA-384
  //   0x0804  rsa_pss_rsae_sha256       RSA PSS + SHA-256
  //   0x0805  rsa_pss_rsae_sha384       RSA PSS + SHA-384
  //
  // PSS IS THE COMMON CASE NOW, not an exotic one: TLS 1.3 forbids PKCS#1 v1.5 for
  // CertificateVerify (RFC 8446 §4.2.3), so every RSA server signs with PSS. Measured
  // 22-09-2026: wantzel.com does.
  if tls.cvalg = 0x0804 then return tls.checkcvpss(0);
  if tls.cvalg = 0x0805 then return tls.checkcvpss(1);
  if tls.cvalg = 0x0503 then return tls.checkcv384;
  if tls.cvalg <> 0x0403 then begin tls.fail(50, "an unsupported CertificateVerify signature scheme"); return false; end;
  if tls.keykind <> 2 then begin tls.fail(50, "an ECDSA P-256 CertificateVerify under a key that is not P-256"); return false; end;

  tls.cvdigest;
  p256.frombytes(e, tls.th, 0);

  // The signature is DER: SEQUENCE { INTEGER r, INTEGER s }.
  if der.enter(tls.cvsig, 0, tls.cvsign) < 0 then begin tls.fail(50, "the CertificateVerify signature does not parse"); return false; end;
  at := der.vat;
  if der.next(tls.cvsig, at, tls.cvsign) < 0 then begin tls.fail(50, "no r in the CertificateVerify signature"); return false; end;
  if der.tag <> DER.INT then begin tls.fail(50, "r is not an INTEGER"); return false; end;
  rat := der.vat; rn := der.vend - der.vat;
  at := der.vend;
  if der.next(tls.cvsig, at, tls.cvsign) < 0 then begin tls.fail(50, "no s in the CertificateVerify signature"); return false; end;
  if der.tag <> DER.INT then begin tls.fail(50, "s is not an INTEGER"); return false; end;
  sat := der.vat; sn := der.vend - der.vat;

  // A DER INTEGER carries a leading zero when its top bit is set, and drops leading zeros
  // otherwise -- so r and s are 31, 32 or 33 bytes and have to be right-aligned into 32.
  if not tls.derint(r, tls.cvsig, rat, rn) then return false;   // tls.derint already called tls.fail
  if not tls.derint(sg, tls.cvsig, sat, sn) then return false;  // tls.derint already called tls.fail

  // THE SIGNATURE ITSELF IS CHECKED HERE, and that result stays opaque on purpose.
  return p256.verify(tls.qx, tls.qy, e, r, sg);
end;

// ---- the handshake ------------------------------------------------------------------------

// Read one handshake message into tls.rec, spanning records if it has to.
//
// A MESSAGE CAN CROSS A RECORD BOUNDARY and several can share one record. Assuming one
// message per record works against most servers and fails against some, which is the worst
// kind of bug to find later.
function tls.readhs(out: array of char): int;
var need, got, avail, i: int;
begin
  // The 4-byte header first.
  got := 0;
  while got < 4 do
  begin
    if tls.plainat >= tls.plainn then
    begin
      if not tls.readrec then return 0 - 1;
      if tls.plaintype = TLS.CHANGECIPHER then tls.plainat := tls.plainn;
      if tls.plaintype = TLS.ALERT then
      begin
        tls.fail(ord(tls.plain[1]), "the server sent an alert");
        return 0 - 1;
      end;
    end
    else
    begin
      out[got] := tls.plain[tls.plainat];
      tls.plainat := tls.plainat + 1;
      got := got + 1;
    end;
  end;
  need := tls.get24(out, 1);
  if need > len(out) - 4 then
  begin
    tls.fail(80, "a handshake message is larger than the buffer");
    return 0 - 1;
  end;
  while got < need + 4 do
  begin
    if tls.plainat >= tls.plainn then
    begin
      if not tls.readrec then return 0 - 1;
      if tls.plaintype = TLS.CHANGECIPHER then tls.plainat := tls.plainn;
    end
    else
    begin
      avail := tls.plainn - tls.plainat;
      if avail > need + 4 - got then avail := need + 4 - got;
      i := 0;
      while i < avail do
      begin
        out[got + i] := tls.plain[tls.plainat + i];
        i := i + 1;
      end;
      got := got + avail;
      tls.plainat := tls.plainat + avail;
    end;
  end;
  return need + 4;
end;

function tls.connect(fd: int; host: str): bool;
var n, mt, i: int;
    msg: array[0..16383] of char;
    want: array[0..31] of char;
    got:  array[0..31] of char;
begin
  tls.fd := fd;
  tls.err := 0;
  tls.errmsg := "";
  tls.verified := false;
  if not tls.connectraw then
  begin
    tls.hostn := 0;
    while (tls.hostn < slen(host)) and (tls.hostn < 255) do
    begin
      tls.host[tls.hostn] := schar(host, tls.hostn);
      tls.hostn := tls.hostn + 1;
    end;
  end;
  tls.connectraw := false;
  tls.startclock;
  if not tls.arm(fd) then return false;
  tls.haskey := false;
  tls.cvsign := 0;
  tls.encrypting := false;
  tls.decrypting := false;
  tls.trn := 0;
  tls.cseq := 0;
  tls.sseq := 0;
  tls.plainn := 0;
  tls.plainat := 0;
  tls.certat := 0;
  tls.certn := 0;

  rand.bytes(tls.priv);
  x.base(tls.pub, tls.priv);

  if not tls.hello(host) then return false;

  // ServerHello.
  n := tls.readhs(msg);
  if n < 0 then return false;
  if ord(msg[0]) <> TLS.SERVERHELLO then
  begin
    tls.fail(10, "the server did not answer with a ServerHello");
    return false;
  end;
  tls.tradd(msg, 0, n);
  if not tls.readsh(msg, 4, n - 4) then return false;

  tls.schedule;
  tls.decrypting := true;       // everything after ServerHello is encrypted

  // EncryptedExtensions, Certificate, CertificateVerify, Finished.
  while true do
  begin
    n := tls.readhs(msg);
    if n < 0 then return false;
    mt := ord(msg[0]);
    if mt = TLS.FINISHED then
    begin
      // CHECK IT BEFORE ADDING IT to the transcript: the server's Finished covers everything
      // up to but NOT including itself.
      tls.expandlabel(tls.shs, "finished", tls.tmp, 0, tls.fkey, 32);
      tls.trhash(tls.th);
      tls.finishedmac(want);
      i := 0;
      while i < 32 do begin got[i] := msg[4 + i]; i := i + 1; end;
      mt := 0;
      i := 0;
      while i < 32 do begin mt := bor(mt, bxor(ord(want[i]), ord(got[i]))); i := i + 1; end;
      if mt <> 0 then
      begin
        tls.fail(51, "the server's Finished does not match");
        return false;
      end;
      tls.tradd(msg, 0, n);
      i := 0;
      while i < 1 do i := i + 1;
      // Application keys come from the transcript through the server's Finished.
      tls.trhash(tls.th);
      tls.derivesecret(tls.msec, "c ap traffic", tls.th, tls.cap);
      tls.derivesecret(tls.msec, "s ap traffic", tls.th, tls.sap);
      // OUR Finished still goes out under the HANDSHAKE key, so send it before switching.
      tls.expandlabel(tls.chs, "finished", tls.tmp, 0, tls.fkey, 32);
      tls.trhash(tls.th);
      tls.finishedmac(tls.fin);
      msg[0] := chr(TLS.FINISHED);
      tls.put24(msg, 1, 32);
      i := 0;
      while i < 32 do begin msg[4 + i] := tls.fin[i]; i := i + 1; end;
      tls.keys(tls.chs, tls.ckey, tls.civ);
      tls.cseq := 0;
      tls.encrypting := true;
      if not tls.sendrec(TLS.HANDSHAKE, msg, 0, 36) then return false;
      // NOW switch both directions to the application keys.
      tls.keys(tls.cap, tls.ckey, tls.civ);
      tls.keys(tls.sap, tls.skey, tls.siv);
      tls.cseq := 0;
      tls.sseq := 0;
      // THE SIGNATURE IS CHECKED LAST, and its result is reported rather than enforced.
      //
      // tls.verified NOW MEANS BOTH HALVES, which it did not before:
      //   1. the server PROVED it holds the key in the certificate (CertificateVerify), and
      //   2. that certificate CHAINS to a root in the trust store (lib/chain.wz).
      //
      // Either half alone is worthless. Without 1, anyone can replay a certificate they
      // copied off a real server; without 2, anyone can make their own certificate for any
      // name. Both are required and both are checked here.
      //
      // AN EMPTY TRUST STORE MEANS verified = false, not "skip the check". A caller that
      // has not loaded roots gets an encrypted connection to an unauthenticated peer, and
      // it is told so rather than reassured.
      tls.verified := tls.checkcv and tls.checkchain;
      return true;
    end;
    if mt = TLS.CERT then
    begin
      tls.certat := tls.trn;
      tls.certn := n;
      if not tls.readcert(msg, n) then return false;
    end;
    if mt = TLS.CERTVERIFY then
    begin
      // THE HASH IS TAKEN BEFORE THIS MESSAGE GOES INTO THE TRANSCRIPT. CertificateVerify
      // signs everything up to but NOT including itself; adding it first and then hashing
      // gives a different value and the signature can never verify.
      tls.trhash(tls.cvth);
      if not tls.readcv(msg, n) then return false;
    end;
    tls.tradd(msg, 0, n);
  end;
  // Unreachable: the loop above only leaves through one of the returns inside it. Kept so
  // every path has a result, and set through tls.fail rather than a bare false in case that
  // ever stops being true.
  tls.fail(80, "the handshake loop ended without a Finished");
  return false;
end;

// The hostname as BYTES rather than a str, for a caller that got it from the command line:
// Wantzel cannot build a str from characters, so argch output can never reach tls.connect.
function tls.connectb(fd: int; hb: array of char; hn: int): bool;
var i: int;
begin
  tls.hostn := 0;
  while (tls.hostn < hn) and (tls.hostn < 255) do
  begin
    tls.host[tls.hostn] := hb[tls.hostn];
    tls.hostn := tls.hostn + 1;
  end;
  i := tls.hostn;
  tls.connectraw := true;
  return tls.connect(fd, "");
end;

// ---- application data -----------------------------------------------------------------------

function tls.write(b: array of char; n: int): bool;
var at, chunk: int;
begin
  tls.startclock;
  at := 0;
  while at < n do
  begin
    chunk := n - at;
    if chunk > TLS.MAXPLAIN - 64 then chunk := TLS.MAXPLAIN - 64;
    if not tls.sendrec(TLS.APPDATA, b, at, chunk) then return false;
    at := at + chunk;
  end;
  return true;
end;

// Read up to max bytes. Returns how many, 0 at a clean close, or -1 on error.
function tls.read(b: array of char; max: int): int;
var i, n: int;
begin
  tls.startclock;
  while tls.plainat >= tls.plainn do
  begin
    if not tls.readrec then return 0 - 1;
    if tls.plaintype = TLS.ALERT then
    begin
      // close_notify (0) is an orderly shutdown, not a failure.
      if ord(tls.plain[1]) = 0 then return 0;
      tls.fail(ord(tls.plain[1]), "the server sent an alert");
      return 0 - 1;
    end;
    // A session ticket after the handshake is normal and carries nothing we use.
    if tls.plaintype = TLS.HANDSHAKE then tls.plainat := tls.plainn;
  end;
  n := tls.plainn - tls.plainat;
  if n > max then n := max;
  i := 0;
  while i < n do
  begin
    b[i] := tls.plain[tls.plainat + i];
    i := i + 1;
  end;
  tls.plainat := tls.plainat + n;
  return n;
end;

procedure tls.close;
var a: array[0..1] of char;
begin
  a[0] := chr(1);      // warning
  a[1] := chr(0);      // close_notify
  tls.startclock;
  if tls.encrypting then
  begin
    if tls.sendrec(TLS.ALERT, a, 0, 2) then a[0] := a[0];
  end;
end;

// ---- the server side --------------------------------------------------------------------------
//
// THE SERVER NEVER TOUCHES A SOCKET. The caller owns the connection and its event loop; a
// session is a state machine that is handed the bytes that arrived and hands back the bytes
// to send. That is what lets ONE thread hold thousands of TLS connections: nothing here
// waits, so a client that sends half a ClientHello and goes quiet costs its session and
// nothing else. The API is listed at the top of this file.
//
// WHAT IT SERVES: one certificate chain, one P-256 key, TLS 1.3,
// TLS_CHACHA20_POLY1305_SHA256, X25519. No client certificates, no resumption, no session
// tickets, no early data, no HelloRetryRequest, no ALPN (a client then speaks HTTP/1.1).
//
// THE DIRECTIONS ARE MIRRORED. The server READS with the client's traffic secret and WRITES
// with its own. Getting that pair the wrong way round gives two sides that both encrypt
// happily and can decrypt nothing -- and the first symptom is a tag failure, which reads
// like a corrupted record rather than a swapped key.
//
// A SESSION IS SMALL BECAUSE THE HANDSHAKE RUNS TO COMPLETION INSIDE ONE CALL. The moment a
// whole ClientHello is in, the entire server flight -- ServerHello, EncryptedExtensions,
// Certificate, CertificateVerify, Finished -- is built, signed and encrypted in that same
// call. So the transcript, the ECDHE secret and the key schedule live in module scratch that
// is reused by every session; what a session keeps afterwards is the record layer (a key, an
// IV and a sequence number each way), the application secrets for a KeyUpdate, and the one
// value still to come: the Finished the client must send back.
//
// THE PRIVATE KEY NEVER LEAVES THIS PROCESS. It is set with tls.setcert and lives in module
// state; there is no accessor that hands it back.

const
  // HOW MANY SERVER SESSIONS CAN BE OPEN AT ONCE. A session costs its record in tls.ss
  // (256 bytes) and a slice of the reassembly region (TLS.SINBUF), which is mapped on the
  // first tls.open -- so a program that only uses the client pays for neither -- and whose
  // pages are only touched when a record arrives in pieces.
  TLS.MAXSESS   = 4096;
  // One record at its largest: the 5-byte header and 16384 + 256 bytes of ciphertext.
  TLS.MAXCIPHER = 16640;
  TLS.SINBUF    = 16645;
  // The largest ClientHello accepted. Real ones are 200 bytes to 2 KB.
  TLS.MAXHELLO  = 16384;

  // What tls.state answers.
  TLS.ST.UNUSED    = 0;     // not a session: never opened, or freed
  TLS.ST.HANDSHAKE = 1;     // the handshake is not done yet
  TLS.ST.OPEN      = 2;     // established: application data flows both ways
  TLS.ST.CLOSED    = 3;     // the peer sent close_notify; nothing more will arrive
  TLS.ST.FAILED    = 4;     // refused or broken; tls.code says which alert

  // Where a handshake is, inside TLS.ST.HANDSHAKE.
  TLS.PH.HELLO  = 1;        // waiting for the ClientHello
  TLS.PH.FINISH = 2;        // our flight is out; waiting for the client's Finished

type TlsSession = record
  state, phase, code: int;
  rseq, wseq: int;          // record sequence numbers, reading and writing
  bufn: int;                // bytes held in this session's slice of the reassembly region
  recat: int;               // where the record being assembled starts in that slice
  nextfree: int;            // the free list, while the session is not in use
  sawccs: bool;             // the compatibility change_cipher_spec has been seen
  wkeys: bool;              // there is a write key, so an alert goes out encrypted
  wshut: bool;              // we sent close_notify; nothing more is written
  rkey: array[0..31] of char;
  riv:  array[0..11] of char;
  wkey: array[0..31] of char;
  wiv:  array[0..11] of char;
  rsec: array[0..31] of char;   // the client's application traffic secret, for KeyUpdate
  wsec: array[0..31] of char;   // ours
  fin:  array[0..31] of char;   // the Finished the client must send
end;

var
  // The certificate chain, DER certificates one after another, leaf first; and where each
  // one starts, so the Certificate message can list them as separate entries.
  tls.mycert:  array[0..16383] of char;
  tls.mycertn: int;
  tls.mycat:   array[0..TLS.MAXCHAIN-1] of int;
  tls.mycn:    array[0..TLS.MAXCHAIN-1] of int;
  tls.mycnt:   int;
  tls.mykey:   array[0..P.N-1] of int;   // our ECDSA private key
  tls.mykeyx:  array[0..P.N-1] of int;
  tls.mykeyy:  array[0..P.N-1] of int;
  tls.haveserverkey: bool;

  // The session pool. A session id is an index into tls.ss.
  tls.ss:       array[0..TLS.MAXSESS-1] of TlsSession;
  tls.blank:    TlsSession;              // all zero, to reset a session with one assignment
  tls.sbase:    int;                     // the reassembly region, TLS.SINBUF per session
  tls.freehead: int;
  tls.poolready: bool;
  tls.live:     int;                     // sessions in use, for a caller that reports it

  // What the last tls.feed produced, and why the last session failed.
  tls.appn:  int;
  tls.wiren: int;
  tls.why:   str;

  // SCRATCH FOR ONE CALL, never kept between calls, and not shared with the client above --
  // a blocking client connection and any number of server sessions can be live together.
  tls.emsg:  array[0..TLS.MAXHELLO-1] of char;   // the ClientHello, reassembled
  tls.etr:   array[0..34815] of char;            // the transcript of one handshake
  tls.etrn:  int;
  tls.erec:  array[0..TLS.MAXCIPHER-1] of char;  // one record, being decrypted
  tls.etype: int;
  tls.eaad:  array[0..4] of char;
  tls.etag:  array[0..15] of char;
  tls.enonce: array[0..11] of char;
  tls.eth:   array[0..31] of char;
  tls.ekey:  array[0..31] of char;
  tls.edig:  array[0..31] of char;
  tls.ernd:  array[0..31] of char;
  tls.epriv, tls.epub, tls.epeer, tls.eshared: array[0..31] of char;
  tls.eearly, tls.ehs, tls.ems, tls.echs, tls.eshs: array[0..31] of char;
  tls.esid:  array[0..31] of char;
  tls.esidn: int;
  tls.ee:    array[0..P.N-1] of int;
  tls.ewire: array[0..TLS.MAXREC-1] of char;     // tls.accept's outgoing bytes

procedure tls.zero32(b: array of char);
var i: int;
begin
  i := 0;
  while i < len(b) do begin b[i] := chr(0); i := i + 1; end;
end;

// ---- the certificate ------------------------------------------------------------------------

// Install the certificate chain and the P-256 private key that belongs to its first
// certificate.
//
// cert[0..certn) is ONE OR MORE DER CERTIFICATES back to back, leaf first -- the leaf alone
// for a self-signed certificate, the leaf and its intermediate for one from an authority.
// Each goes into the Certificate message as its own entry. Sent as one entry, a chain
// parses as a leaf with trailing bytes, and a strict client refuses it.
//
// SAFE WHILE SESSIONS ARE OPEN, and that is by construction: a handshake reads the chain
// and the key only inside the one call that builds the server flight, and an established
// session never reads them at all. So a new certificate applies to the next ClientHello,
// and every connection already open carries on with the keys it has.
//
// NOTHING CHANGES UNLESS EVERYTHING CHECKS. The chain must split into certificates, the key
// must be in range, and the leaf must carry exactly the public key the private key gives.
// A renewal that half-arrived -- the new certificate beside the old key -- is refused, and
// the server keeps serving the pair it had, rather than installing a pair whose every
// handshake fails with a bad signature at the client.
function tls.setcert(cert: array of char; certn: int; d: array of int): bool;
var at, hl, n, cnt, i: int;
    cat, cn: array[0..TLS.MAXCHAIN-1] of int;
    qx, qy: array[0..P.N-1] of int;
    pub: array[0..63] of char;
begin
  tls.why := "";
  if (certn <= 0) or (certn > len(tls.mycert)) or (certn > len(cert)) then
  begin
    tls.why := "the certificate chain is empty or does not fit";
    tls.errmsg := tls.why;
    return false;
  end;
  // SPLIT THE CHAIN. Each certificate is a DER SEQUENCE whose length says where it ends.
  at := 0;
  cnt := 0;
  while at < certn do
  begin
    n := 0 - 1;
    hl := 0;
    if (ord(cert[at]) = 0x30) and (at + 2 <= certn) then
    begin
      if ord(cert[at + 1]) < 128 then begin hl := 2; n := ord(cert[at + 1]); end
      else if (ord(cert[at + 1]) = 0x81) and (at + 3 <= certn) then
        begin hl := 3; n := ord(cert[at + 2]); end
      else if (ord(cert[at + 1]) = 0x82) and (at + 4 <= certn) then
        begin hl := 4; n := tls.get16(cert, at + 2); end
      else if (ord(cert[at + 1]) = 0x83) and (at + 5 <= certn) then
        begin hl := 5; n := tls.get24(cert, at + 2); end;
    end;
    if (n < 0) or (at + hl + n > certn) or (cnt >= TLS.MAXCHAIN) then
    begin
      tls.why := "the certificate chain is not a series of DER certificates";
      tls.errmsg := tls.why;
      return false;
    end;
    cat[cnt] := at;
    cn[cnt] := hl + n;
    cnt := cnt + 1;
    at := at + hl + n;
  end;

  // THE PUBLIC KEY IS DERIVED, NOT SUPPLIED -- and then compared with the certificate's.
  p256.setup;
  if not p256.inrange(d) then
  begin
    tls.why := "the private key is out of range";
    tls.errmsg := tls.why;
    return false;
  end;
  p256.mulpoint(p256.gx, p256.gy, d);
  if p256.iszero(p256.az) then
  begin
    tls.why := "the private key is not usable";
    tls.errmsg := tls.why;
    return false;
  end;
  p256.affine;
  p256.copy(qx, p256.t0);
  p256.copy(qy, p256.t1);
  p256.tobytes(pub, 0, qx);
  p256.tobytes(pub, 32, qy);
  if not x509.parse(cert, 0, cn[0]) then
  begin
    tls.why := "the leaf certificate does not parse";
    tls.errmsg := tls.why;
    return false;
  end;
  if (x509.keyalg <> 2) or (x509.keyn <> 65) or (ord(cert[x509.keyat]) <> 4) then
  begin
    tls.why := "the leaf certificate does not carry a P-256 key";
    tls.errmsg := tls.why;
    return false;
  end;
  n := 0;
  i := 0;
  while i < 64 do begin n := bor(n, bxor(ord(pub[i]), ord(cert[x509.keyat + 1 + i]))); i := i + 1; end;
  if n <> 0 then
  begin
    tls.why := "the private key does not belong to the certificate";
    tls.errmsg := tls.why;
    return false;
  end;

  // Everything checked: now, and only now, the live chain and key change.
  i := 0;
  while i < certn do begin tls.mycert[i] := cert[i]; i := i + 1; end;
  tls.mycertn := certn;
  i := 0;
  while i < cnt do begin tls.mycat[i] := cat[i]; tls.mycn[i] := cn[i]; i := i + 1; end;
  tls.mycnt := cnt;
  p256.copy(tls.mykey, d);
  p256.copy(tls.mykeyx, qx);
  p256.copy(tls.mykeyy, qy);
  tls.haveserverkey := true;
  return true;
end;

// ---- the session pool ---------------------------------------------------------------------

// The pool, made ready on first use. The reassembly region is mapped here rather than
// declared, so it exists only in a program that serves.
function tls.pool: bool;
var i: int;
begin
  if tls.poolready then return true;
  tls.sbase := sys6(SYS.mmap, 0, TLS.MAXSESS * TLS.SINBUF, bor(PROT_READ, PROT_WRITE),
                    bor(MAP_PRIVATE, MAP_ANONYMOUS), 0 - 1, 0);
  if tls.sbase < 0 then begin tls.why := "cannot map memory for the sessions"; return false; end;
  i := 0;
  while i < TLS.MAXSESS do begin tls.ss[i].nextfree := i + 1; i := i + 1; end;
  tls.ss[TLS.MAXSESS - 1].nextfree := 0 - 1;
  tls.freehead := 0;
  tls.poolready := true;
  return true;
end;

function tls.valid(s: int): bool;
begin
  if (s < 0) or (s >= TLS.MAXSESS) then return false;
  return tls.ss[s].state <> TLS.ST.UNUSED;
end;

// A new server session for a connection just accepted, or -1 (tls.why says why): no
// certificate is installed, or all TLS.MAXSESS sessions are in use.
function tls.open: int;
var s: int;
begin
  if not tls.pool then return 0 - 1;
  if not tls.haveserverkey then begin tls.why := "no certificate installed"; return 0 - 1; end;
  s := tls.freehead;
  if s < 0 then begin tls.why := "every session is in use"; return 0 - 1; end;
  tls.freehead := tls.ss[s].nextfree;
  tls.ss[s] := tls.blank;
  tls.ss[s].nextfree := 0 - 1;
  tls.ss[s].state := TLS.ST.HANDSHAKE;
  tls.ss[s].phase := TLS.PH.HELLO;
  tls.live := tls.live + 1;
  return s;
end;

// Give the session back. Its keys are wiped with it. Freeing an id twice does nothing.
procedure tls.free(s: int);
begin
  if not tls.valid(s) then return;
  tls.ss[s] := tls.blank;
  tls.ss[s].nextfree := tls.freehead;
  tls.freehead := s;
  tls.live := tls.live - 1;
end;

function tls.state(s: int): int;
begin
  if not tls.valid(s) then return TLS.ST.UNUSED;
  return tls.ss[s].state;
end;

// The alert that ended a failed session -- the one we sent, or the one the peer sent.
function tls.code(s: int): int;
begin
  if not tls.valid(s) then return 0;
  return tls.ss[s].code;
end;

// ---- records -------------------------------------------------------------------------------

procedure tls.enoncefor(iv: array of char; seq: int);
var i, sq: int;
begin
  i := 0;
  while i < 12 do begin tls.enonce[i] := iv[i]; i := i + 1; end;
  sq := seq;
  i := 11;
  while i >= 4 do
  begin
    tls.enonce[i] := chr(bxor(ord(tls.enonce[i]), band(sq, 255)));
    sq := sq shr 8;
    i := i - 1;
  end;
end;

// A record in the clear at wire[w]: the ServerHello, the compatibility change_cipher_spec,
// an alert before any key exists. Returns the position after it.
function tls.putplain(ctype: int; b: array of char; from: int; n: int; wire: array of char; w: int): int;
var i: int;
begin
  wire[w] := chr(ctype);
  tls.put16(wire, w + 1, 0x0303);
  tls.put16(wire, w + 3, n);
  i := 0;
  while i < n do begin wire[w + 5 + i] := b[from + i]; i := i + 1; end;
  return w + 5 + n;
end;

// An encrypted record at wire[w] under the session's write key, carrying b[from..from+n)
// of content type ctype. Returns the position after it: w + n + 22.
//
// ENCRYPTED WHERE IT LIES. The plaintext is copied into place in wire and sealed there, so
// no second 16 KB buffer is needed and nothing is copied twice.
function tls.putsealed(s: int; ctype: int; b: array of char; from: int; n: int; wire: array of char; w: int): int;
var i, total: int;
begin
  total := n + 1 + 16;
  wire[w] := chr(TLS.APPDATA);        // the outer type is always application_data
  tls.put16(wire, w + 1, 0x0303);
  tls.put16(wire, w + 3, total);
  i := 0;
  while i < n do begin wire[w + 5 + i] := b[from + i]; i := i + 1; end;
  wire[w + 5 + n] := chr(ctype);      // the true type, inside the encryption
  i := 0;
  while i < 5 do begin tls.eaad[i] := wire[w + i]; i := i + 1; end;
  tls.enoncefor(tls.ss[s].wiv, tls.ss[s].wseq);
  ae.setkey(tls.ss[s].wkey);
  ae.setnonce(tls.enonce);
  ae.seal(tls.eaad, 5, wire, w + 5, n + 1, tls.etag);
  tls.ss[s].wseq := tls.ss[s].wseq + 1;
  i := 0;
  while i < 16 do begin wire[w + 5 + n + 1 + i] := tls.etag[i]; i := i + 1; end;
  return w + 5 + total;
end;

// Fail THIS session: remember why, send the alert if there is room, and wipe its keys.
// Nothing else is touched -- every other session carries on.
procedure tls.sfail(s: int; code: int; msg: str; wire: array of char);
var a: array[0..1] of char;
begin
  if tls.ss[s].state = TLS.ST.FAILED then return;
  a[0] := chr(2);                      // fatal
  a[1] := chr(code);
  if tls.ss[s].wkeys then
  begin
    if len(wire) - tls.wiren >= 24 then
      tls.wiren := tls.putsealed(s, TLS.ALERT, a, 0, 2, wire, tls.wiren);
  end
  else if len(wire) - tls.wiren >= 7 then
    tls.wiren := tls.putplain(TLS.ALERT, a, 0, 2, wire, tls.wiren);
  tls.ss[s] := tls.blank;
  tls.ss[s].nextfree := 0 - 1;
  tls.ss[s].state := TLS.ST.FAILED;
  tls.ss[s].code := code;
  tls.why := msg;
end;

// Is the 5-byte header at b[at] one this session can take now? Fails the session if not.
//
// THE LENGTH IS CHECKED BEFORE ANYTHING IS BUFFERED OR DECRYPTED. It comes from the other
// end, and a record claiming 60000 bytes must be refused here, not discovered as an index
// out of range halfway through a copy -- which would stop the whole process, not just this
// connection.
function tls.hdrok(s: int; b: array of char; at: int; wire: array of char): bool;
var t, n: int;
begin
  t := ord(b[at]);
  n := tls.get16(b, at + 3);
  if (t < TLS.CHANGECIPHER) or (t > TLS.APPDATA) or (ord(b[at + 1]) <> 3) then
  begin
    tls.sfail(s, 10, "not a TLS record", wire);
    return false;
  end;
  if (tls.ss[s].phase = TLS.PH.HELLO) and (t <> TLS.HANDSHAKE) then
  begin
    tls.sfail(s, 10, "the client did not open with a handshake record", wire);
    return false;
  end;
  if ((t = TLS.APPDATA) and (n > TLS.MAXCIPHER)) or ((t <> TLS.APPDATA) and (n > TLS.MAXPLAIN)) then
  begin
    tls.sfail(s, 22, "a record is longer than TLS allows", wire);
    return false;
  end;
  if (n = 0) and (t <> TLS.APPDATA) then
  begin
    tls.sfail(s, 50, "an empty record that may not be empty", wire);
    return false;
  end;
  return true;
end;

// Can the plaintext of an n-byte record go into app now? 1 yes, 0 not yet.
//
// A RECORD IS NOT OPENED UNTIL ITS PLAINTEXT HAS SOMEWHERE TO GO. Opening one advances the
// sequence number, and there is no putting it back; so a full application buffer stops
// tls.feed at a record boundary, and the caller hands over the rest once it has room.
function tls.fits(s: int; n: int; app: array of char): int;
var need: int;
begin
  if tls.ss[s].state <> TLS.ST.OPEN then return 1;
  need := n - 16;
  if need > TLS.MAXPLAIN then need := TLS.MAXPLAIN;
  if need < 0 then need := 0;
  if len(app) - tls.appn >= need then return 1;
  return 0;
end;

// Decrypt the record at b[at] into tls.erec. Returns the length of its content, with the
// inner content type in tls.etype; -1 when it fails (and the session with it).
//
// PADDING IS STRIPPED FROM THE RIGHT: the real type is the last NON-ZERO byte.
function tls.unseal(s: int; b: array of char; at: int; wire: array of char): int;
var n, i: int;
begin
  n := tls.get16(b, at + 3);
  if n < 17 then
  begin
    tls.sfail(s, 50, "an encrypted record is too short to hold a tag", wire);
    return 0 - 1;
  end;
  i := 0;
  while i < 5 do begin tls.eaad[i] := b[at + i]; i := i + 1; end;
  i := 0;
  while i < 16 do begin tls.etag[i] := b[at + 5 + n - 16 + i]; i := i + 1; end;
  i := 0;
  while i < n - 16 do begin tls.erec[i] := b[at + 5 + i]; i := i + 1; end;
  tls.enoncefor(tls.ss[s].riv, tls.ss[s].rseq);
  ae.setkey(tls.ss[s].rkey);
  ae.setnonce(tls.enonce);
  if not ae.open(tls.eaad, 5, tls.erec, 0, n - 16, tls.etag) then
  begin
    tls.sfail(s, 20, "a record failed to authenticate", wire);
    return 0 - 1;
  end;
  tls.ss[s].rseq := tls.ss[s].rseq + 1;
  i := n - 16;
  while (i > 0) and (tls.erec[i - 1] = chr(0)) do i := i - 1;
  if i = 0 then
  begin
    tls.sfail(s, 10, "a decrypted record has no content type", wire);
    return 0 - 1;
  end;
  if i - 1 > TLS.MAXPLAIN then
  begin
    tls.sfail(s, 22, "a record carries more plaintext than TLS allows", wire);
    return 0 - 1;
  end;
  tls.etype := ord(tls.erec[i - 1]);
  return i - 1;
end;

// An alert from the peer, b[at..at+n). close_notify closes; user_canceled is a warning that
// a close_notify follows; everything else in TLS 1.3 is fatal. No alert is sent back.
procedure tls.peeralert(s: int; b: array of char; at: int; n: int; wire: array of char);
var desc: int;
begin
  if n <> 2 then begin tls.sfail(s, 50, "a malformed alert", wire); return; end;
  desc := ord(b[at + 1]);
  if desc = 0 then
  begin
    tls.ss[s].state := TLS.ST.CLOSED;
    tls.why := "the peer closed the connection";
    return;
  end;
  if desc = 90 then return;
  tls.ss[s] := tls.blank;
  tls.ss[s].nextfree := 0 - 1;
  tls.ss[s].state := TLS.ST.FAILED;
  tls.ss[s].code := desc;
  tls.why := "the peer sent an alert";
end;

// Handshake messages after the handshake: only KeyUpdate is expected from a client.
//
// A KEYUPDATE TURNS THE READ KEY, and asks us to turn ours when its byte is 1. The answer
// goes out under the OLD write key -- it is the last record under it -- and only then does
// our side move to the next secret.
procedure tls.posthello(s: int; n: int; wire: array of char);
var at, t, m, req: int;
    msg: array[0..4] of char;
begin
  at := 0;
  while at < n do
  begin
    if at + 4 > n then begin tls.sfail(s, 10, "a handshake message split across records after the handshake", wire); return; end;
    t := ord(tls.erec[at]);
    m := tls.get24(tls.erec, at + 1);
    if at + 4 + m > n then begin tls.sfail(s, 10, "a handshake message split across records after the handshake", wire); return; end;
    if t <> 24 then begin tls.sfail(s, 10, "an unexpected handshake message after the handshake", wire); return; end;
    if m <> 1 then begin tls.sfail(s, 50, "a malformed KeyUpdate", wire); return; end;
    if at + 5 <> n then begin tls.sfail(s, 10, "a KeyUpdate that is not the last message in its record", wire); return; end;
    req := ord(tls.erec[at + 4]);
    if req > 1 then begin tls.sfail(s, 47, "a KeyUpdate with an unknown request", wire); return; end;
    tls.expandlabel(tls.ss[s].rsec, "traffic upd", tls.eth, 0, tls.ekey, 32);
    tls.copyin(tls.ss[s].rsec, tls.ekey, 0, 32);
    tls.keys(tls.ss[s].rsec, tls.ss[s].rkey, tls.ss[s].riv);
    tls.ss[s].rseq := 0;
    if (req = 1) and (not tls.ss[s].wshut) then
    begin
      if len(wire) - tls.wiren < 5 + 22 then begin tls.sfail(s, 80, "no room to answer a KeyUpdate", wire); return; end;
      msg[0] := chr(24);
      tls.put24(msg, 1, 1);
      msg[4] := chr(0);
      tls.wiren := tls.putsealed(s, TLS.HANDSHAKE, msg, 0, 5, wire, tls.wiren);
      tls.expandlabel(tls.ss[s].wsec, "traffic upd", tls.eth, 0, tls.ekey, 32);
      tls.copyin(tls.ss[s].wsec, tls.ekey, 0, 32);
      tls.keys(tls.ss[s].wsec, tls.ss[s].wkey, tls.ss[s].wiv);
      tls.ss[s].wseq := 0;
    end;
    tls.zero32(tls.ekey);
    at := at + 5;
  end;
end;

// One complete record at b[at], after the ClientHello. False when the session failed.
function tls.onerec(s: int; b: array of char; at: int; app: array of char; wire: array of char): bool;
var t, n, c, i, diff: int;
begin
  t := ord(b[at]);
  n := tls.get16(b, at + 3);

  if tls.ss[s].state = TLS.ST.OPEN then
  begin
    if t <> TLS.APPDATA then begin tls.sfail(s, 10, "a record in the clear after the handshake", wire); return false; end;
    c := tls.unseal(s, b, at, wire);
    if c < 0 then return false;
    if tls.etype = TLS.APPDATA then
    begin
      i := 0;
      while i < c do begin app[tls.appn + i] := tls.erec[i]; i := i + 1; end;
      tls.appn := tls.appn + c;
      return true;
    end;
    if tls.etype = TLS.ALERT then tls.peeralert(s, tls.erec, 0, c, wire)
    else if tls.etype = TLS.HANDSHAKE then tls.posthello(s, c, wire)
    else tls.sfail(s, 10, "an unexpected record type", wire);
    return tls.ss[s].state <> TLS.ST.FAILED;
  end;

  // Still in the handshake: our flight is out, the client's Finished is due.
  //
  // change_cipher_spec IS DROPPED, once. TLS 1.3 gives it no meaning; a client in
  // middlebox compatibility mode sends one so the connection looks like TLS 1.2 on the
  // wire (RFC 8446 §5 and D.4). Anything but the single byte 1, or a second one, is an error.
  if t = TLS.CHANGECIPHER then
  begin
    if (n <> 1) or (ord(b[at + 5]) <> 1) or tls.ss[s].sawccs then
    begin
      tls.sfail(s, 10, "an unexpected change_cipher_spec", wire);
      return false;
    end;
    tls.ss[s].sawccs := true;
    return true;
  end;
  if t = TLS.ALERT then
  begin
    tls.peeralert(s, b, at + 5, n, wire);
    return tls.ss[s].state <> TLS.ST.FAILED;
  end;
  if t <> TLS.APPDATA then begin tls.sfail(s, 10, "a handshake record in the clear after the ClientHello", wire); return false; end;
  c := tls.unseal(s, b, at, wire);
  if c < 0 then return false;
  if tls.etype = TLS.ALERT then
  begin
    tls.peeralert(s, tls.erec, 0, c, wire);
    return tls.ss[s].state <> TLS.ST.FAILED;
  end;
  if tls.etype <> TLS.HANDSHAKE then begin tls.sfail(s, 10, "application data before the handshake finished", wire); return false; end;
  if (c <> 36) or (ord(tls.erec[0]) <> TLS.FINISHED) or (tls.get24(tls.erec, 1) <> 32) then
  begin
    tls.sfail(s, 10, "the client did not send a Finished", wire);
    return false;
  end;
  // CONSTANT TIME: the whole difference is gathered before it is looked at.
  diff := 0;
  i := 0;
  while i < 32 do begin diff := bor(diff, bxor(ord(tls.erec[4 + i]), ord(tls.ss[s].fin[i]))); i := i + 1; end;
  if diff <> 0 then begin tls.sfail(s, 51, "the client's Finished does not match", wire); return false; end;
  // READING moves to the client's application key only now: its Finished was the last
  // record under the handshake key.
  tls.keys(tls.ss[s].rsec, tls.ss[s].rkey, tls.ss[s].riv);
  tls.ss[s].rseq := 0;
  tls.zero32(tls.ss[s].fin);
  tls.ss[s].state := TLS.ST.OPEN;
  tls.ss[s].phase := 0;
  return true;
end;

// ---- the ClientHello and the server flight ---------------------------------------------------

// Take what we need out of the ClientHello in tls.emsg[0..m): the session id to echo, and
// the client's X25519 share into tls.epeer.
//
// EVERY LENGTH IS CHECKED AGAINST m BEFORE IT IS FOLLOWED. The message comes from anyone
// who can open a connection; a length that points past the end must fail this session, and
// never reach an index check that stops the whole process.
function tls.parsech(s: int; m: int; wire: array of char): bool;
var at, n, i, t, elen, e, sub, subend, g, kl: int;
    sv, ks, sig, suite: bool;
begin
  at := 4 + 2 + 32;                        // header, legacy_version, random
  if at + 1 > m then begin tls.sfail(s, 50, "a truncated ClientHello", wire); return false; end;
  tls.esidn := ord(tls.emsg[at]);
  at := at + 1;
  if (tls.esidn > 32) or (at + tls.esidn > m) then begin tls.sfail(s, 50, "the session id does not fit", wire); return false; end;
  tls.copyin(tls.esid, tls.emsg, at, tls.esidn);
  at := at + tls.esidn;

  if at + 2 > m then begin tls.sfail(s, 50, "a truncated ClientHello", wire); return false; end;
  n := tls.get16(tls.emsg, at);
  at := at + 2;
  if (n < 2) or (band(n, 1) <> 0) or (at + n > m) then begin tls.sfail(s, 50, "malformed cipher suites", wire); return false; end;
  i := 0;
  while i < n do
  begin
    if tls.get16(tls.emsg, at + i) = 0x1303 then suite := true;
    i := i + 2;
  end;
  at := at + n;

  // legacy_compression_methods: in TLS 1.3 exactly one byte, "none".
  if at + 1 > m then begin tls.sfail(s, 50, "a truncated ClientHello", wire); return false; end;
  n := ord(tls.emsg[at]);
  at := at + 1;
  if (n <> 1) or (at + 1 > m) then begin tls.sfail(s, 47, "a compression method other than none", wire); return false; end;
  if ord(tls.emsg[at]) <> 0 then begin tls.sfail(s, 47, "a compression method other than none", wire); return false; end;
  at := at + 1;

  if at + 2 > m then begin tls.sfail(s, 50, "a ClientHello without extensions", wire); return false; end;
  n := tls.get16(tls.emsg, at);
  at := at + 2;
  if at + n <> m then begin tls.sfail(s, 50, "the extensions do not end where the ClientHello does", wire); return false; end;

  while at < m do
  begin
    if at + 4 > m then begin tls.sfail(s, 50, "a truncated extension", wire); return false; end;
    t := tls.get16(tls.emsg, at);
    elen := tls.get16(tls.emsg, at + 2);
    at := at + 4;
    e := at + elen;
    if e > m then begin tls.sfail(s, 50, "an extension runs past the ClientHello", wire); return false; end;
    if t = 43 then
    begin
      // supported_versions: a one-byte length, then two-byte versions.
      if elen < 1 then begin tls.sfail(s, 50, "malformed supported_versions", wire); return false; end;
      sub := ord(tls.emsg[at]);
      if (1 + sub > elen) or (band(sub, 1) <> 0) then begin tls.sfail(s, 50, "malformed supported_versions", wire); return false; end;
      i := at + 1;
      while i + 1 < at + 1 + sub do
      begin
        if tls.get16(tls.emsg, i) = 0x0304 then sv := true;
        i := i + 2;
      end;
    end;
    if t = 13 then
    begin
      // signature_algorithms: a two-byte length, then two-byte schemes.
      if elen < 2 then begin tls.sfail(s, 50, "malformed signature_algorithms", wire); return false; end;
      sub := tls.get16(tls.emsg, at);
      if (2 + sub > elen) or (band(sub, 1) <> 0) then begin tls.sfail(s, 50, "malformed signature_algorithms", wire); return false; end;
      i := at + 2;
      while i + 1 < at + 2 + sub do
      begin
        if tls.get16(tls.emsg, i) = 0x0403 then sig := true;
        i := i + 2;
      end;
    end;
    if t = 51 then
    begin
      // key_share: a LIST of shares, and we take the X25519 one. A client commonly offers
      // several; picking the first without checking its group is how a server ends up
      // doing X25519 arithmetic on some other group's key.
      if elen < 2 then begin tls.sfail(s, 50, "malformed key_share", wire); return false; end;
      sub := tls.get16(tls.emsg, at);
      subend := at + 2 + sub;
      if subend > e then begin tls.sfail(s, 50, "malformed key_share", wire); return false; end;
      i := at + 2;
      while i < subend do
      begin
        if i + 4 > subend then begin tls.sfail(s, 50, "malformed key_share", wire); return false; end;
        g := tls.get16(tls.emsg, i);
        kl := tls.get16(tls.emsg, i + 2);
        if i + 4 + kl > subend then begin tls.sfail(s, 50, "malformed key_share", wire); return false; end;
        if (g = 29) and (kl = 32) and (not ks) then
        begin
          tls.copyin(tls.epeer, tls.emsg, i + 4, 32);
          ks := true;
        end;
        i := i + 4 + kl;
      end;
    end;
    at := e;
  end;

  if not sv then begin tls.sfail(s, 70, "the client does not offer TLS 1.3", wire); return false; end;
  if not suite then begin tls.sfail(s, 40, "the client does not offer TLS_CHACHA20_POLY1305_SHA256", wire); return false; end;
  if not sig then begin tls.sfail(s, 40, "the client does not accept ecdsa_secp256r1_sha256", wire); return false; end;
  if not ks then begin tls.sfail(s, 40, "the client sent no X25519 key share", wire); return false; end;
  return true;
end;

// The hash of b[0..n).
procedure tls.ehash(b: array of char; n: int; out: array of char);
begin
  sha256.init;
  if n > 0 then sha256.updateat(b, 0, n);
  sha256.final(out);
end;

// HMAC(key, th): a Finished value.
procedure tls.emac(key: array of char; th: array of char; out: array of char);
var i: int;
begin
  i := 0;
  while i < 32 do begin hk.msg[i] := th[i]; i := i + 1; end;
  hk.msgn := 32;
  hk.mac(key, 32, out);
end;

// What the server's CertificateVerify signs (RFC 8446 §4.4.3): 64 spaces, the context
// string, a zero byte, then the transcript hash -- hashed.
procedure tls.ecvdigest(th: array of char; out: array of char);
var i, n: int;
    tmp: array[0..63] of char;
    ctx: str;
begin
  ctx := "TLS 1.3, server CertificateVerify";
  sha256.init;
  i := 0;
  while i < 64 do begin tmp[i] := chr(32); i := i + 1; end;
  sha256.updateat(tmp, 0, 64);
  n := slen(ctx);
  i := 0;
  while i < n do begin tmp[i] := schar(ctx, i); i := i + 1; end;
  tmp[n] := chr(0);
  sha256.updateat(tmp, 0, n + 1);
  sha256.updateat(th, 0, 32);
  sha256.final(out);
end;

// The whole server flight, from a ClientHello of m bytes in tls.emsg, written to wire.
//
// ONE CALL, START TO FINISH. The transcript is built in tls.etr as the messages are
// written -- the ClientHello as received, then each message of ours in place -- so every
// hash the key schedule needs is taken over a prefix of one buffer, at exactly the point
// the RFC names. What survives the call goes into the session; the rest is wiped.
function tls.flight(s: int; m: int; wire: array of char): bool;
var sh, n, i, k, extat, listat, enc, chunk, w: int;
    zeros, derived: array[0..31] of char;
    one: array[0..0] of char;
begin
  if not tls.haveserverkey then begin tls.sfail(s, 80, "no certificate installed", wire); return false; end;
  if len(wire) - tls.wiren < TLS.MAXREC then
  begin
    tls.sfail(s, 80, "the wire buffer cannot hold the handshake", wire);
    return false;
  end;
  if not tls.parsech(s, m, wire) then return false;

  // ECDHE. An all-zero result means the client sent a point of small order, and RFC 8446
  // §7.4.2 says to abort rather than derive keys an attacker can predict.
  rand.bytes(tls.epriv);
  x.base(tls.epub, tls.epriv);
  x.scalarmult(tls.eshared, tls.epriv, tls.epeer);
  n := 0;
  i := 0;
  while i < 32 do begin n := bor(n, ord(tls.eshared[i])); i := i + 1; end;
  if n = 0 then begin tls.sfail(s, 47, "the client's key share gives an all-zero secret", wire); return false; end;

  // The transcript starts with the ClientHello exactly as received.
  tls.copyin(tls.etr, tls.emsg, 0, m);
  tls.etrn := m;

  // ---- ServerHello, built in place in the transcript ----
  sh := tls.etrn;
  n := sh + 4;
  tls.put16(tls.etr, n, 0x0303); n := n + 2;         // legacy_version, always 1.2 on the wire
  rand.bytes(tls.ernd);
  i := 0;
  while i < 32 do begin tls.etr[n] := tls.ernd[i]; n := n + 1; i := i + 1; end;
  // ECHO THE CLIENT'S session id, byte for byte: a client that sent one expects it back.
  tls.etr[n] := chr(tls.esidn); n := n + 1;
  i := 0;
  while i < tls.esidn do begin tls.etr[n] := tls.esid[i]; n := n + 1; i := i + 1; end;
  tls.put16(tls.etr, n, 0x1303); n := n + 2;         // the one suite we speak
  tls.etr[n] := chr(0); n := n + 1;                  // legacy_compression_method
  extat := n; n := n + 2;
  tls.put16(tls.etr, n, 43); n := n + 2;             // supported_versions: exactly 1.3
  tls.put16(tls.etr, n, 2); n := n + 2;
  tls.put16(tls.etr, n, 0x0304); n := n + 2;
  tls.put16(tls.etr, n, 51); n := n + 2;             // key_share: ours
  tls.put16(tls.etr, n, 36); n := n + 2;
  tls.put16(tls.etr, n, 29); n := n + 2;
  tls.put16(tls.etr, n, 32); n := n + 2;
  i := 0;
  while i < 32 do begin tls.etr[n] := tls.epub[i]; n := n + 1; i := i + 1; end;
  tls.put16(tls.etr, extat, n - extat - 2);
  tls.etr[sh] := chr(TLS.SERVERHELLO);
  tls.put24(tls.etr, sh + 1, n - sh - 4);
  tls.etrn := n;
  w := tls.putplain(TLS.HANDSHAKE, tls.etr, sh, n - sh, wire, tls.wiren);
  // A CLIENT IN COMPATIBILITY MODE (it sent a session id) gets the dummy
  // change_cipher_spec it expects after the ServerHello (RFC 8446 D.4).
  if tls.esidn > 0 then
  begin
    one[0] := chr(1);
    w := tls.putplain(TLS.CHANGECIPHER, one, 0, 1, wire, w);
  end;
  tls.wiren := w;

  // ---- the key schedule, RFC 8446 §7.1: the order is the specification ----
  hkdf.extract(zeros, 0, zeros, 32, tls.eearly);     // no PSK: both inputs zero
  tls.ehash(tls.etr, 0, tls.eth);                     // the hash of the empty string
  tls.derivesecret(tls.eearly, "derived", tls.eth, derived);
  hkdf.extract(derived, 32, tls.eshared, 32, tls.ehs);
  tls.ehash(tls.etr, tls.etrn, tls.eth);              // through ServerHello
  tls.derivesecret(tls.ehs, "c hs traffic", tls.eth, tls.echs);
  tls.derivesecret(tls.ehs, "s hs traffic", tls.eth, tls.eshs);
  tls.ehash(tls.etr, 0, tls.eth);
  tls.derivesecret(tls.ehs, "derived", tls.eth, derived);
  hkdf.extract(derived, 32, zeros, 32, tls.ems);
  // MIRRORED: we write with the server secret and read with the client's.
  tls.keys(tls.eshs, tls.ss[s].wkey, tls.ss[s].wiv);
  tls.keys(tls.echs, tls.ss[s].rkey, tls.ss[s].riv);
  tls.ss[s].wseq := 0;
  tls.ss[s].rseq := 0;
  tls.ss[s].wkeys := true;

  enc := tls.etrn;
  // ---- EncryptedExtensions: empty, but not optional ----
  n := tls.etrn;
  tls.etr[n] := chr(TLS.ENCEXT);
  tls.put24(tls.etr, n + 1, 2);
  tls.put16(tls.etr, n + 4, 0);
  tls.etrn := n + 6;

  // ---- Certificate: every certificate of the chain as its own entry ----
  n := tls.etrn;
  tls.etr[n] := chr(TLS.CERT);
  i := n + 4;
  tls.etr[i] := chr(0); i := i + 1;                  // empty certificate_request_context
  listat := i; i := i + 3;
  k := 0;
  while k < tls.mycnt do
  begin
    tls.put24(tls.etr, i, tls.mycn[k]); i := i + 3;
    tls.copyin(tls.etr[i..i + tls.mycn[k] - 1], tls.mycert, tls.mycat[k], tls.mycn[k]);
    i := i + tls.mycn[k];
    tls.put16(tls.etr, i, 0); i := i + 2;            // no per-certificate extensions
    k := k + 1;
  end;
  tls.put24(tls.etr, listat, i - listat - 3);
  tls.put24(tls.etr, n + 1, i - n - 4);
  tls.etrn := i;

  // ---- CertificateVerify: the transcript so far, signed with the certificate's key ----
  tls.ehash(tls.etr, tls.etrn, tls.eth);
  tls.ecvdigest(tls.eth, tls.edig);
  p256.frombytes(tls.ee, tls.edig, 0);
  if not p256.sign(tls.mykey, tls.ee) then begin tls.sfail(s, 80, "could not sign the handshake", wire); return false; end;
  n := tls.etrn;
  tls.etr[n] := chr(TLS.CERTVERIFY);
  tls.put16(tls.etr, n + 4, 0x0403);                 // ecdsa_secp256r1_sha256
  i := tls.derwrite(tls.etr, n + 8, p256.sigr, p256.sigs);
  tls.put16(tls.etr, n + 6, i - n - 8);
  tls.put24(tls.etr, n + 1, i - n - 4);
  tls.etrn := i;

  // ---- our Finished ----
  tls.expandlabel(tls.eshs, "finished", tls.eth, 0, tls.ekey, 32);
  tls.ehash(tls.etr, tls.etrn, tls.eth);
  tls.emac(tls.ekey, tls.eth, tls.edig);
  n := tls.etrn;
  tls.etr[n] := chr(TLS.FINISHED);
  tls.put24(tls.etr, n + 1, 32);
  tls.copyin(tls.etr[n + 4..n + 35], tls.edig, 0, 32);
  tls.etrn := n + 36;

  // ---- what the rest of the connection needs, all from the transcript through our
  // Finished: the application secrets, and the Finished the client must send back ----
  tls.ehash(tls.etr, tls.etrn, tls.eth);
  tls.derivesecret(tls.ems, "c ap traffic", tls.eth, tls.ss[s].rsec);
  tls.derivesecret(tls.ems, "s ap traffic", tls.eth, tls.ss[s].wsec);
  tls.expandlabel(tls.echs, "finished", tls.eth, 0, tls.ekey, 32);
  tls.emac(tls.ekey, tls.eth, tls.ss[s].fin);

  // ---- the encrypted half of the flight, in records of at most 16384 bytes ----
  i := enc;
  w := tls.wiren;
  while i < tls.etrn do
  begin
    chunk := tls.etrn - i;
    if chunk > TLS.MAXPLAIN then chunk := TLS.MAXPLAIN;
    w := tls.putsealed(s, TLS.HANDSHAKE, tls.etr, i, chunk, wire, w);
    i := i + chunk;
  end;
  tls.wiren := w;

  // WRITING moves to the application key now; reading waits for the client's Finished.
  tls.keys(tls.ss[s].wsec, tls.ss[s].wkey, tls.ss[s].wiv);
  tls.ss[s].wseq := 0;
  tls.ss[s].phase := TLS.PH.FINISH;

  tls.zero32(tls.epriv);
  tls.zero32(tls.eshared);
  tls.zero32(tls.ehs);
  tls.zero32(tls.ems);
  tls.zero32(tls.echs);
  tls.zero32(tls.eshs);
  tls.zero32(tls.ekey);
  return true;
end;

// The ClientHello, from the records held in the session's buffer -- one record, or several
// if the client split it. 1 = done and answered, 0 = more is needed, -1 = the session failed.
function tls.hello1(s: int; wire: array of char; buf: array of char): int;
var at, upto, n, m, hl: int;
begin
  at := 0;
  upto := tls.ss[s].bufn;
  m := 0;
  while at < upto do
  begin
    n := tls.get16(buf, at + 3);
    if m + n > TLS.MAXHELLO then begin tls.sfail(s, 22, "the ClientHello is too large", wire); return 0 - 1; end;
    tls.copyin(tls.emsg[m..m + n - 1], buf, at + 5, n);
    m := m + n;
    at := at + 5 + n;
  end;
  if ord(tls.emsg[0]) <> TLS.CLIENTHELLO then
  begin
    tls.sfail(s, 10, "the client did not open with a ClientHello", wire);
    return 0 - 1;
  end;
  if m >= 4 then
  begin
    hl := tls.get24(tls.emsg, 1);
    if 4 + hl > TLS.MAXHELLO then begin tls.sfail(s, 22, "the ClientHello is too large", wire); return 0 - 1; end;
    if m > 4 + hl then begin tls.sfail(s, 10, "more than a ClientHello before the ServerHello", wire); return 0 - 1; end;
    if m = 4 + hl then
    begin
      tls.ss[s].bufn := 0;
      tls.ss[s].recat := 0;
      if not tls.flight(s, m, wire) then return 0 - 1;
      return 1;
    end;
  end;
  // Keep these records; the next one is assembled after them.
  tls.ss[s].recat := tls.ss[s].bufn;
  return 0;
end;

procedure tls.hold(s: int; src: array of char; from: int; n: int; buf: array of char);
var i, at: int;
begin
  at := tls.ss[s].bufn;
  i := 0;
  while i < n do begin buf[at + i] := src[from + i]; i := i + 1; end;
  tls.ss[s].bufn := tls.ss[s].bufn + n;
end;

// ---- the server API ---------------------------------------------------------------------------

// The body of tls.feed, below.
// EACH SESSION SEES ONLY ITS OWN SLICE of the reassembly region, as buf: whatever a
// malformed record makes it do, the index checks keep it inside that slice.
function tls.feedin(s: int; src: array of char; app: array of char; wire: array of char; buf: array of char): int;
var used, avail, held, at, n, k, r, st: int;
begin
  used := 0;
  while true do
  begin
    st := tls.ss[s].state;
    if st = TLS.ST.FAILED then return 0 - 1;
    if st = TLS.ST.CLOSED then return len(src);       // after close_notify, nothing counts
    avail := len(src) - used;
    held := tls.ss[s].bufn - tls.ss[s].recat;

    // THE COMMON CASE: nothing held and a whole record in src -- processed where it lies,
    // without being copied into the session at all.
    if (held = 0) and (tls.ss[s].phase <> TLS.PH.HELLO) and (avail >= 5) then
    begin
      if not tls.hdrok(s, src, used, wire) then return 0 - 1;
      n := tls.get16(src, used + 3);
      if avail >= 5 + n then
      begin
        if tls.fits(s, n, app) = 0 then return used;
        if not tls.onerec(s, src, used, app, wire) then return 0 - 1;
        used := used + 5 + n;
        continue;
      end;
    end;
    if avail = 0 then return used;

    // Otherwise the record is assembled in the session's own slice.
    at := tls.ss[s].recat;
    if held < 5 then
    begin
      k := 5 - held;
      if k > avail then k := avail;
      tls.hold(s, src, used, k, buf);
      used := used + k;
      avail := avail - k;
      held := held + k;
      // A CLIENT THAT DOES NOT SPEAK TLS IS REFUSED ON ITS FIRST BYTE -- plain HTTP sent to
      // the TLS port, a scanner, noise -- rather than after it has sent five.
      if (tls.ss[s].phase = TLS.PH.HELLO) and (ord(buf[at]) <> TLS.HANDSHAKE) then
      begin
        tls.sfail(s, 10, "the client does not speak TLS", wire);
        return 0 - 1;
      end;
      if held < 5 then return used;
      if not tls.hdrok(s, buf, at, wire) then return 0 - 1;
    end;
    n := tls.get16(buf, at + 3);
    if tls.ss[s].recat + 5 + n > TLS.SINBUF then
    begin
      tls.sfail(s, 22, "the ClientHello does not fit", wire);
      return 0 - 1;
    end;
    if tls.fits(s, n, app) = 0 then return used;
    k := 5 + n - held;
    if k > avail then k := avail;
    tls.hold(s, src, used, k, buf);
    used := used + k;
    held := held + k;
    if held < 5 + n then return used;

    // A whole record.
    if tls.ss[s].phase = TLS.PH.HELLO then
    begin
      r := tls.hello1(s, wire, buf);
      if r < 0 then return 0 - 1;
    end
    else
    begin
      tls.ss[s].bufn := 0;
      tls.ss[s].recat := 0;
      if not tls.onerec(s, buf, at, app, wire) then return 0 - 1;
    end;
  end;
  return used;
end;

// Hand session s the bytes that arrived, src (all of it: len(src) is the amount). Returns
// how many of them were taken, or -1 when the session has failed.
//
// Afterwards app[0..tls.appn) is decrypted application data and wire[0..tls.wiren) is what
// must be sent -- the handshake flight, a KeyUpdate answer, or on failure the alert. SEND
// wire EVEN WHEN THE RESULT IS -1: that is how the peer learns why.
//
// A RECORD IN PIECES IS HELD HERE, not by the caller: a ClientHello split across TCP
// segments, a record cut in half by a read. So everything is taken, with one exception: a
// record is not opened until its plaintext fits in app, and then feed stops at that record
// and returns less than len(src). Keep src[result..] and feed it again when app has room;
// an app of TLS.MAXPLAIN bytes always has room for one record.
//
// wire needs room for TLS.MAXREC bytes while the handshake is running (the flight carries
// the whole certificate chain); after it, for the rare KeyUpdate answer and an alert.
function tls.feed(s: int; src: array of char; app: array of char; wire: array of char): int;
begin
  tls.appn := 0;
  tls.wiren := 0;
  if not tls.valid(s) then begin tls.why := "not a session in use"; return 0 - 1; end;
  return tls.feedin(s, src, app, wire, view(tls.sbase + s * TLS.SINBUF, TLS.SINBUF));
end;

// Encrypt src (all of it) as application data into wire. Returns the number of bytes
// written, or -1 when the session is not established, has been shut, or wire is too small:
// it needs len(src) plus 22 bytes for every 16384 of it. Nothing is written on -1.
function tls.seal(s: int; src: array of char; wire: array of char): int;
var n, chunks, at, chunk, w: int;
begin
  if not tls.valid(s) then begin tls.why := "not a session in use"; return 0 - 1; end;
  if (tls.ss[s].state <> TLS.ST.OPEN) and (tls.ss[s].state <> TLS.ST.CLOSED) then
  begin
    tls.why := "the session is not established";
    return 0 - 1;
  end;
  if tls.ss[s].wshut then begin tls.why := "the session has been shut"; return 0 - 1; end;
  n := len(src);
  if n = 0 then return 0;
  chunks := (n + TLS.MAXPLAIN - 1) div TLS.MAXPLAIN;
  if len(wire) < n + 22 * chunks then begin tls.why := "the wire buffer is too small"; return 0 - 1; end;
  at := 0;
  w := 0;
  while at < n do
  begin
    chunk := n - at;
    if chunk > TLS.MAXPLAIN then chunk := TLS.MAXPLAIN;
    w := tls.putsealed(s, TLS.APPDATA, src, at, chunk, wire, w);
    at := at + chunk;
  end;
  return w;
end;

// Our close_notify, into wire. Returns its length (24), or 0 when there is nothing to send:
// no keys yet, already shut, or less than 24 bytes of room. Nothing is sealed after it.
// The session stays in use until tls.free.
function tls.shut(s: int; wire: array of char): int;
var a: array[0..1] of char;
begin
  if not tls.valid(s) then return 0;
  if (not tls.ss[s].wkeys) or tls.ss[s].wshut or (tls.ss[s].state = TLS.ST.FAILED) then return 0;
  if len(wire) < 24 then return 0;
  a[0] := chr(1);      // warning
  a[1] := chr(0);      // close_notify
  tls.ss[s].wshut := true;
  return tls.putsealed(s, TLS.ALERT, a, 0, 2, wire, 0);
end;

// ---- the blocking server, on top of the same machine -------------------------------------------

// The whole server handshake on an accepted socket, waiting for each record; afterwards
// tls.read, tls.write and tls.close serve the connection. For a program that handles one
// connection at a time -- a local tool, a test. A server with more than one client uses
// tls.open and tls.feed from its event loop instead.
//
// ONE RECORD AT A TIME. The header is read, then exactly its body, then that record is fed:
// so nothing past the client's Finished is taken off the socket, and whatever the client
// sends next is still there for tls.read.
function tls.accept(fd: int): bool;
var s, n, used, i: int;
begin
  tls.fd := fd;
  tls.err := 0;
  tls.errmsg := "";
  tls.verified := false;
  tls.encrypting := false;
  tls.decrypting := false;
  tls.cseq := 0;
  tls.sseq := 0;
  tls.plainn := 0;
  tls.plainat := 0;
  tls.startclock;
  if not tls.arm(fd) then return false;
  s := tls.open;
  if s < 0 then begin tls.fail(80, tls.why); return false; end;
  while tls.ss[s].state = TLS.ST.HANDSHAKE do
  begin
    if not tls.recvall(tls.rec, 0, 5) then begin tls.free(s); return false; end;
    n := tls.get16(tls.rec, 3);
    if n > TLS.MAXREC - 5 then
    begin
      tls.fail(22, "a record claims an impossible length");
      tls.free(s);
      return false;
    end;
    if n > 0 then
    begin
      if not tls.recvall(tls.rec, 5, n) then begin tls.free(s); return false; end;
    end;
    used := tls.feed(s, tls.rec[0..4 + n], tls.plain, tls.ewire);
    if tls.wiren > 0 then
    begin
      if not tls.sendall(tls.ewire, tls.wiren) then begin tls.free(s); return false; end;
    end;
    if used < 0 then
    begin
      if tls.code(s) > 0 then tls.fail(tls.code(s), tls.why) else tls.fail(80, tls.why);
      tls.free(s);
      return false;
    end;
  end;
  if tls.ss[s].state <> TLS.ST.OPEN then
  begin
    tls.fail(0 - 1, "the client closed the connection during the handshake");
    tls.free(s);
    return false;
  end;
  // THE SESSION'S RECORD LAYER BECOMES THE BLOCKING ONE: tls.ckey is what this side
  // writes with and tls.skey what it reads with.
  i := 0;
  while i < 32 do
  begin
    tls.ckey[i] := tls.ss[s].wkey[i];
    tls.skey[i] := tls.ss[s].rkey[i];
    i := i + 1;
  end;
  i := 0;
  while i < 12 do
  begin
    tls.civ[i] := tls.ss[s].wiv[i];
    tls.siv[i] := tls.ss[s].riv[i];
    i := i + 1;
  end;
  tls.cseq := tls.ss[s].wseq;
  tls.sseq := tls.ss[s].rseq;
  tls.encrypting := true;
  tls.decrypting := true;
  tls.free(s);
  return true;
end;
