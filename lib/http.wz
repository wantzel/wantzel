// lib/http.wz -- a non-blocking HTTP/1.1 server on epoll.
//
// agent-permissions: read -- the standard library is not a scratchpad. Changing it
// changes every program that includes it, so it moves under a ticket rather than in
// passing. See docs/conventions.md §4.
//
// One process, one event loop, no threads and no allocation: every
// connection owns a fixed slice of two static buffers, indexed by its file
// descriptor.  The application supplies app.request, which is called once
// per complete request.

include "net.wz";
include "json.wz";

const
  MAXCONN = 256;
  INBUF   = 262144;         // largest request (headers + body) per connection
  OUTBUF  = 524288;         // largest reply per connection
  HDRROOM = 2048;           // space reserved in front of the body for the status line and headers
  MAXEV   = 256;

  // http.method values
  HTTP.GET = 1;  HTTP.POST = 2;  HTTP.PUT = 3;  HTTP.DELETE = 4;
  HTTP.PATCH = 5;  HTTP.OPTIONS = 6;  HTTP.HEAD = 7;

var
  http.inbuf:  array[0..MAXCONN * INBUF - 1] of char;
  http.outbuf: array[0..MAXCONN * OUTBUF - 1] of char;
  http.inlen:  array[0..MAXCONN - 1] of int;
  http.osend:  array[0..MAXCONN - 1] of int;   // first byte still to send
  http.oend:   array[0..MAXCONN - 1] of int;   // one past the last byte
  http.open:   array[0..MAXCONN - 1] of bool;
  http.evs:    array[0..MAXEV * 12 - 1] of char;
  http.hdr:    array[0..HDRROOM - 1] of char;

  http.ep, http.lfd: int;
  http.fd, http.ibase, http.obase: int;        // the connection being served
  http.method: int;                            // HTTP.GET .. HTTP.HEAD, 0 = other
  http.pathat, http.pathlen: int;              // the path without the query string
  http.queryat, http.querylen: int;            // the query string after '?', may be empty
  http.hdrat, http.hdrend: int;                // the header lines (after the request line)
  http.bodyat, http.bodylen: int;
  http.keep: bool;
  http.ignored: bool;                          // a result that is deliberately not acted on
  http.wpos: int;                              // write cursor for the reply body
  http.requests: int;
  http.xhdr: array[0..HDRROOM - 1] of char;    // extra response headers for the current reply
  http.xlen: int;
  http.hvat, http.hvend: int;                  // the value found by http.header
  http.pval: array[0..4095] of char;           // the decoded value found by http.param/http.form
  http.pvlen: int;
  http.paramerr: bool;                         // true when http.param/http.form/http.lookup
                                                // returned false because the key WAS found but
                                                // its value had bad percent-encoding or did not
                                                // fit http.pval -- as opposed to the key being
                                                // absent.  Set at the start of every call to
                                                // http.lookup, so a stale true from an earlier,
                                                // unrelated key never leaks into this answer.
  http.started: int;                           // io.now at the start of the request
  http.logging: bool;                          // one JSON line per request on stderr
  http.hdrseen: bool;                          // http.parse found the end of the headers
  http.clen: int;                              // the Content-Length it read there, 0 if absent

  // ------------------------------------------------------------ handing a connection off
  //
  // http.detach lets app.request give fd to another module (lib/websocket.wz, on a
  // WebSocket upgrade) WITHOUT this file knowing that module exists. Set it to true
  // and return from app.request without writing a reply; http.wz then removes fd
  // from ITS OWN bookkeeping (out of http.open, out of http.ep) and closes nothing,
  // so the fd is still a live, connected socket that the caller (app.request, or
  // whatever it called before returning) now owns outright. See lib/websocket.wz's
  // file header for why this is a plain variable and not a second forward hook: a
  // program that never sets it sees no change at all in this file's behaviour.
  http.detach: bool;

  // ------------------------------------------------------------ the big-body path
  //
  // A request whose Content-Length is larger than fits in INBUF is not, by itself, a bad
  // request -- a year of minute values is about 2.1 MB of JSON.  Before this the request
  // was silently dropped once its bytes filled INBUF: no 413, no message, a bare
  // 'connection reset' at the client.  http.maxbody(cap), called once before http.serve,
  // reserves ONE extra region of `cap` bytes with mmap for the body of the ONE connection
  // that is currently reading past INBUF -- not `cap * MAXCONN`.  A second connection that
  // also overflows while the region is in use gets the 413 instead: there is one slot, not
  // one per connection, which is the whole point of asking for it explicitly rather than
  // raising INBUF itself.
  http.bigbase: int;                           // address of the overflow region, -1 = none requested
  http.bigcap:  int;                           // its size in bytes, 0 = the feature is off
  http.bigowner: int;                          // fd currently using it, -1 = free
  http.biglen:  int;                           // bytes of the body copied into it so far
  http.bigtotal: int;                          // the Content-Length the owner is reading towards
  http.bodyinbig: bool;                        // true while app.request runs: the body is in
                                                // http.bigbase[0..http.bodylen), not http.inbuf
  http.overflowed: bool;                       // the current reply did not fit in OUTBUF

// the application must define this; it is called with a parsed request
procedure app.request; forward;

// Reserve a shared overflow region for request bodies larger than INBUF (256 kB).  Call
// this once, before http.serve -- after fork, so each worker gets its own mapping rather
// than one worker's writes racing another's through a shared page.  Only one connection at
// a time can be reading into it; a second oversized request while it is in use is answered
// with 413, the same as when this is never called at all.
procedure http.maxbody(cap: int);
begin
  if cap <= 0 then io.fatal("http.maxbody needs a positive size");
  http.bigbase := sys6(SYS.mmap, 0, cap, bor(PROT_READ, PROT_WRITE), bor(MAP_PRIVATE, MAP_ANONYMOUS), -1, 0);
  if http.bigbase < 0 then io.fatal("http.maxbody: cannot map memory");
  http.bigcap := cap;
  http.bigowner := -1;
end;

// copy n bytes of the body read so far, out of this connection's ordinary slot in
// http.inbuf, into the front of the shared overflow region -- so the bytes already read
// before the switch are not re-requested from the client
procedure http.copytobig(from: int; n: int; dst: array of char);
var i: int;
begin
  i := 0;
  while i < n do
  begin
    dst[i] := http.inbuf[from + i];
    i := i + 1;
  end;
end;

// ---------------------------------------------------------------- replies

procedure http.start;
begin
  http.wpos := http.obase + HDRROOM;
  http.xlen := 0;
  http.overflowed := false;
  http.detach := false;
end;

// add a response header to the current reply: http.hdradd("Cache-Control: no-store")
procedure http.hdradd(s: str);
begin
  if http.xlen + slen(s) + 2 > HDRROOM - 256 then return;      // silently dropped: no room
  http.xlen := io.push(http.xhdr, http.xlen, s);
  http.xlen := io.push(http.xhdr, http.xlen, "\r\n");
end;

// the same, with a value taken from a buffer (for values copied from the request)
procedure http.hdraddslice(name: str; b: array of char; from: int; upto: int);
begin
  if http.xlen + slen(name) + (upto - from) + 4 > HDRROOM - 256 then return;
  http.xlen := io.push(http.xhdr, http.xlen, name);
  http.xlen := io.push(http.xhdr, http.xlen, ": ");
  while from < upto do
  begin
    http.xhdr[http.xlen] := b[from];
    http.xlen := http.xlen + 1;
    from := from + 1;
  end;
  http.xlen := io.push(http.xhdr, http.xlen, "\r\n");
end;

// one JSON line per request on stderr:
// {"t":<epoch ms>,"method":"POST","path":"/x","status":200,"us":123,"bytes":45}
var
  http.logbuf: array[0..1023] of char;

procedure http.log(status: int; blen: int);
var at: int;
    n: int;
begin
  n := io.push(http.logbuf, 0, "{\"t\":");
  n := io.pushnum(http.logbuf, n, io.realtime div 1000000);
  n := io.push(http.logbuf, n, ",\"method\":\"");
  if http.method = HTTP.GET then n := io.push(http.logbuf, n, "GET")
  else if http.method = HTTP.POST then n := io.push(http.logbuf, n, "POST")
  else if http.method = HTTP.PUT then n := io.push(http.logbuf, n, "PUT")
  else if http.method = HTTP.DELETE then n := io.push(http.logbuf, n, "DELETE")
  else if http.method = HTTP.PATCH then n := io.push(http.logbuf, n, "PATCH")
  else if http.method = HTTP.OPTIONS then n := io.push(http.logbuf, n, "OPTIONS")
  else if http.method = HTTP.HEAD then n := io.push(http.logbuf, n, "HEAD")
  else n := io.push(http.logbuf, n, "?");
  n := io.push(http.logbuf, n, "\",\"path\":");
  // json.putslice returns -1 when it does not fit.  A log line is not an answer:
  // better an empty path value than a truncated line or a negative position.
  if http.pathlen > 200 then at := json.putslice(http.logbuf, n, http.inbuf, http.pathat, http.pathat + 200)
  else at := json.putslice(http.logbuf, n, http.inbuf, http.pathat, http.pathat + http.pathlen);
  if at < 0 then n := io.push(http.logbuf, n, "\"\"") else n := at;
  n := io.push(http.logbuf, n, ",\"status\":");
  n := io.pushnum(http.logbuf, n, status);
  n := io.push(http.logbuf, n, ",\"us\":");
  n := io.pushnum(http.logbuf, n, (io.now - http.started) div 1000);
  n := io.push(http.logbuf, n, ",\"bytes\":");
  n := io.pushnum(http.logbuf, n, blen);
  n := io.push(http.logbuf, n, "}\n");
  io.out(STDERR, addr(http.logbuf[0]), n);
end;

// io.push and io.pushnum already stop at len(http.outbuf) rather than trap, but a reply
// that stopped mid-write is wrong in a way nothing downstream can see -- so a short push
// (the position did not advance by the full amount) is treated the same as the checked
// writers below: http.overflowed, and http.finish turns that into a clean 500.
procedure http.add(s: str);
var want: int;
begin
  want := http.wpos + slen(s);
  http.wpos := io.push(http.outbuf, http.wpos, s);
  if http.wpos < want then http.overflowed := true;
end;

procedure http.addn(v: int);
var want: int;
begin
  want := http.wpos + io.digits(v);
  http.wpos := io.pushnum(http.outbuf, http.wpos, v);
  if http.wpos < want then http.overflowed := true;
end;

// http.outbuf[http.wpos] := c without a check used to be a runtime array-bounds trap the
// moment a reply ran past OUTBUF (512 kB) -- the whole worker process died on one large
// reply, taking every OTHER connection it was serving down with it.  These two are the
// only writers here that touch http.outbuf directly instead of going through io.push,
// which already bounds-checks; http.finish turns http.overflowed into a clean 500 instead
// of the truncated, wrong-Content-Length body that silently dropping the write would leave
// behind.
procedure http.addc(c: char);
begin
  if http.wpos >= http.obase + OUTBUF then begin http.overflowed := true; return; end;
  http.outbuf[http.wpos] := c;
  http.wpos := http.wpos + 1;
end;

procedure http.addb(b: array of char; at: int; n: int);
var i: int;
begin
  i := 0;
  while i < n do
  begin
    if http.wpos >= http.obase + OUTBUF then begin http.overflowed := true; return; end;
    http.outbuf[http.wpos] := b[at + i];
    http.wpos := http.wpos + 1;
    i := i + 1;
  end;
end;

// write the status line and headers directly in front of the body, so the
// whole reply goes out in one write
procedure http.finish(status: int; ctype: str);
var n, blen, i, start: int;
begin
  // A reply that ran past OUTBUF (512 kB) got here anyway before this: http.wpos still
  // pointed past the true end of what was written, so Content-Length promised bytes that
  // were never there and the client hung waiting for them.  Replace whatever partial body
  // exists with a short, honest one instead of shipping a lie with the right status code
  // on it.  This is deliberately not "raise OUTBUF": that buffer is declared per
  // connection and multiplied by MAXCONN, so doubling it doubles that much static memory
  // whether or not any connection ever needs it.
  if http.overflowed then
  begin
    http.wpos := http.obase + HDRROOM;
    http.wpos := io.push(http.outbuf, http.wpos, "the reply did not fit\n");
    status := 500;
    http.keep := false;
    ctype := "text/plain";
  end;
  blen := http.wpos - (http.obase + HDRROOM);
  n := 0;
  n := io.push(http.hdr, n, "HTTP/1.1 ");
  n := io.pushnum(http.hdr, n, status);
  if status = 200 then n := io.push(http.hdr, n, " OK\r\n")
  else if status = 201 then n := io.push(http.hdr, n, " Created\r\n")
  else if status = 202 then n := io.push(http.hdr, n, " Accepted\r\n")
  else if status = 204 then n := io.push(http.hdr, n, " No Content\r\n")
  else if status = 301 then n := io.push(http.hdr, n, " Moved Permanently\r\n")
  else if status = 302 then n := io.push(http.hdr, n, " Found\r\n")
  else if status = 304 then n := io.push(http.hdr, n, " Not Modified\r\n")
  else if status = 400 then n := io.push(http.hdr, n, " Bad Request\r\n")
  else if status = 401 then n := io.push(http.hdr, n, " Unauthorized\r\n")
  else if status = 403 then n := io.push(http.hdr, n, " Forbidden\r\n")
  else if status = 404 then n := io.push(http.hdr, n, " Not Found\r\n")
  else if status = 405 then n := io.push(http.hdr, n, " Method Not Allowed\r\n")
  else if status = 409 then n := io.push(http.hdr, n, " Conflict\r\n")
  else if status = 413 then n := io.push(http.hdr, n, " Payload Too Large\r\n")
  else if status = 415 then n := io.push(http.hdr, n, " Unsupported Media Type\r\n")
  else if status = 422 then n := io.push(http.hdr, n, " Unprocessable Entity\r\n")
  else if status = 429 then n := io.push(http.hdr, n, " Too Many Requests\r\n")
  else if status = 500 then n := io.push(http.hdr, n, " Internal Server Error\r\n")
  else if status = 501 then n := io.push(http.hdr, n, " Not Implemented\r\n")
  else if status = 503 then n := io.push(http.hdr, n, " Service Unavailable\r\n")
  else n := io.push(http.hdr, n, " Status\r\n");
  n := io.push(http.hdr, n, "Content-Type: ");
  n := io.push(http.hdr, n, ctype);
  n := io.push(http.hdr, n, "\r\nContent-Length: ");
  n := io.pushnum(http.hdr, n, blen);
  n := io.push(http.hdr, n, "\r\n");
  i := 0;
  while i < http.xlen do
  begin
    http.hdr[n] := http.xhdr[i];
    n := n + 1;
    i := i + 1;
  end;
  if http.keep then n := io.push(http.hdr, n, "Connection: keep-alive\r\n\r\n")
  else n := io.push(http.hdr, n, "Connection: close\r\n\r\n");
  start := http.obase + HDRROOM - n;
  i := 0;
  while i < n do
  begin
    http.outbuf[start + i] := http.hdr[i];
    i := i + 1;
  end;
  http.osend[http.fd] := start;
  if http.method = HTTP.HEAD then http.oend[http.fd] := http.obase + HDRROOM   // headers only
  else http.oend[http.fd] := http.wpos;
  if http.logging then http.log(status, blen);
end;

// ---------------------------------------------------------------- parsing

// Compare the header name at position at, case-insensitive on BOTH sides.
//
// It used to lower-case only the bytes from the buffer and compare them with the literal
// as written, so http.header("Accept") never matched anything and simply answered false
// -- no error, and the caller concluded the header was absent.  A header
// name is case-insensitive in HTTP, so the caller may write it either way.
function http.hdreq(at: int; last: int; s: str): bool;
var i, n: int;
    c, w: char;
begin
  n := slen(s);
  if at + n > last then return false;
  i := 0;
  while i < n do
  begin
    c := http.inbuf[at + i];
    if (c >= 'A') and (c <= 'Z') then c := chr(ord(c) + 32);
    w := schar(s, i);
    if (w >= 'A') and (w <= 'Z') then w := chr(ord(w) + 32);
    if c <> w then return false;
    i := i + 1;
  end;
  return true;
end;

// Returns the total length of the request once it is complete, 0 while more
// data is needed, or -1 when the request is malformed.
//
// Even on a 0 (need more), http.hdrseen and http.clen are set as soon as the header block
// itself is complete -- before this, that information only existed inside this function,
// so a caller whose body will never fit in INBUF had nothing to decide with.
function http.parse(base: int; n: int): int;
var at, eoh, sp1, sp2, lineend, clen, v: int;
    c: char;
begin
  eoh := -1;
  at := base;
  while true do
  begin
    at := scan(http.inbuf, at, base + n, chr(13));
    if at + 3 >= base + n then break;
    if (http.inbuf[at + 1] = chr(10)) and (http.inbuf[at + 2] = chr(13))
       and (http.inbuf[at + 3] = chr(10)) then
    begin
      eoh := at + 4;
      break;
    end;
    at := at + 1;
  end;
  if eoh < 0 then
  begin
    http.hdrseen := false;
    return 0;
  end;

  sp1 := scan(http.inbuf, base, eoh, ' ');
  if sp1 >= eoh then return -1;
  sp2 := scan(http.inbuf, sp1 + 1, eoh, ' ');
  if sp2 >= eoh then return -1;
  http.method := 0;
  if http.hdreq(base, sp1, "get") and (sp1 - base = 3) then http.method := HTTP.GET
  else if http.hdreq(base, sp1, "post") and (sp1 - base = 4) then http.method := HTTP.POST
  else if http.hdreq(base, sp1, "put") and (sp1 - base = 3) then http.method := HTTP.PUT
  else if http.hdreq(base, sp1, "delete") and (sp1 - base = 6) then http.method := HTTP.DELETE
  else if http.hdreq(base, sp1, "patch") and (sp1 - base = 5) then http.method := HTTP.PATCH
  else if http.hdreq(base, sp1, "options") and (sp1 - base = 7) then http.method := HTTP.OPTIONS
  else if http.hdreq(base, sp1, "head") and (sp1 - base = 4) then http.method := HTTP.HEAD;
  http.pathat := sp1 + 1;
  http.pathlen := sp2 - sp1 - 1;
  http.queryat := scan(http.inbuf, http.pathat, sp2, '?');
  if http.queryat < sp2 then
  begin
    http.querylen := sp2 - http.queryat - 1;
    http.pathlen := http.queryat - http.pathat;
    http.queryat := http.queryat + 1;
  end
  else http.querylen := 0;

  http.keep := true;
  clen := 0;
  at := scan(http.inbuf, base, eoh, chr(10));
  at := at + 1;
  http.hdrat := at;
  http.hdrend := eoh - 2;
  while at < eoh - 2 do
  begin
    lineend := scan(http.inbuf, at, eoh, chr(13));
    if http.hdreq(at, eoh, "content-length:") then
    begin
      v := at + 15;
      while (v < lineend) and (http.inbuf[v] = ' ') do v := v + 1;
      clen := 0;
      while (v < lineend) and (http.inbuf[v] >= '0') and (http.inbuf[v] <= '9') do
      begin
        clen := clen * 10 + (ord(http.inbuf[v]) - 48);
        v := v + 1;
      end;
    end
    else if http.hdreq(at, eoh, "connection:") then
    begin
      v := at + 11;
      while (v < lineend) and (http.inbuf[v] = ' ') do v := v + 1;
      if http.hdreq(v, eoh, "close") then http.keep := false;
    end;
    at := lineend + 2;
  end;

  if clen < 0 then return -1;
  http.hdrseen := true;
  http.clen := clen;
  if eoh - base + clen > n then return 0;
  http.bodyat := eoh;
  http.bodylen := clen;
  return eoh - base + clen;
end;

// ---------------------------------------------------------------- request access

// find a request header (case-insensitive name); its trimmed value is
// http.inbuf[http.hvat..http.hvend)
function http.header(name: str): bool;
var at, lineend, v: int;
begin
  at := http.hdrat;
  while at < http.hdrend do
  begin
    lineend := scan(http.inbuf, at, http.hdrend, chr(13));
    if http.hdreq(at, lineend, name) then
    begin
      v := at + slen(name);
      if (v < lineend) and (http.inbuf[v] = ':') then
      begin
        v := v + 1;
        while (v < lineend) and ((http.inbuf[v] = ' ') or (http.inbuf[v] = chr(9))) do v := v + 1;
        http.hvat := v;
        http.hvend := lineend;
        while (http.hvend > http.hvat) and (http.inbuf[http.hvend - 1] = ' ') do http.hvend := http.hvend - 1;
        return true;
      end;
    end;
    at := lineend + 2;
  end;
  return false;
end;

// the bearer token of an Authorization header, as the slice http.inbuf[http.hvat..http.hvend)
function http.bearer: bool;
begin
  if not http.header("authorization") then return false;
  if http.hvend - http.hvat < 8 then return false;
  if not http.hdreq(http.hvat, http.hvend, "bearer ") then return false;
  http.hvat := http.hvat + 7;
  while (http.hvat < http.hvend) and (http.inbuf[http.hvat] = ' ') do http.hvat := http.hvat + 1;
  return http.hvat < http.hvend;
end;

function http.hexval(c: char): int;
begin
  if (c >= '0') and (c <= '9') then return ord(c) - 48;
  if (c >= 'a') and (c <= 'f') then return ord(c) - 87;
  if (c >= 'A') and (c <= 'F') then return ord(c) - 55;
  return -1;
end;

// percent-decode src[from..upto) into dst ('+' becomes a space); -1 when malformed or too long
function http.urldecode(src: array of char; from: int; upto: int; dst: array of char): int;
var n, h, l: int;
begin
  n := 0;
  while from < upto do
  begin
    if n >= len(dst) then return -1;
    if src[from] = '+' then dst[n] := ' '
    else if src[from] = '%' then
    begin
      if from + 2 >= upto then return -1;
      h := http.hexval(src[from + 1]);
      l := http.hexval(src[from + 2]);
      if (h < 0) or (l < 0) then return -1;
      dst[n] := chr(h * 16 + l);
      from := from + 2;
    end
    else dst[n] := src[from];
    n := n + 1;
    from := from + 1;
  end;
  return n;
end;

// look up key in a urlencoded string b[from..upto); the decoded value lands in http.pval/http.pvlen.
// http.paramerr distinguishes "key not found" (false, http.paramerr false) from "key found but its
// value has bad percent-encoding or is too long for http.pval" (false, http.paramerr true) --
// before this both cases returned a bare false and were indistinguishable to the caller.
function http.lookup(b: array of char; from: int; upto: int; key: str): bool;
var eq, amp, k: int;
    same: bool;
begin
  http.paramerr := false;
  while from < upto do
  begin
    amp := scan(b, from, upto, '&');
    eq := scan(b, from, amp, '=');
    same := (eq - from = slen(key));
    k := 0;
    while same and (k < slen(key)) do
    begin
      if b[from + k] <> schar(key, k) then same := false;
      k := k + 1;
    end;
    if same then
    begin
      if eq < amp then http.pvlen := http.urldecode(b, eq + 1, amp, http.pval)
      else http.pvlen := 0;
      if http.pvlen < 0 then http.paramerr := true;
      return http.pvlen >= 0;
    end;
    from := amp + 1;
  end;
  return false;
end;

// a query-string parameter: GET /x?a=1&name=hello%20world
function http.param(key: str): bool;
begin
  return http.lookup(http.inbuf, http.queryat, http.queryat + http.querylen, key);
end;

// a field of an application/x-www-form-urlencoded body
function http.form(key: str): bool;
begin
  return http.lookup(http.inbuf, http.bodyat, http.bodyat + http.bodylen, key);
end;

// does the path equal s?
function http.pathis(s: str): bool;
var i: int;
begin
  if http.pathlen <> slen(s) then return false;
  for i := 0 to http.pathlen - 1 do if http.inbuf[http.pathat + i] <> schar(s, i) then return false;
  return true;
end;

// does the path start with prefix?  The rest is http.inbuf[http.restat..http.restend)
var
  http.restat, http.restend: int;

function http.pathstarts(prefix: str): bool;
var i: int;
begin
  if http.pathlen < slen(prefix) then return false;
  for i := 0 to slen(prefix) - 1 do if http.inbuf[http.pathat + i] <> schar(prefix, i) then return false;
  http.restat := http.pathat + slen(prefix);
  http.restend := http.pathat + http.pathlen;
  return true;
end;

// ---------------------------------------------------------------- the loop

procedure http.drop(fd: int);
begin
  // A failing DEL is deliberately ignored: it means the fd is already out of the
  // set (ENOENT), which is the state this routine is trying to reach.  Closing the
  // fd removes it from the set anyway.  The result goes into http.ignored because
  // the language refuses a discarded function result -- so "I am ignoring this on
  // purpose" has to be written down rather than left to the reader.
  http.ignored := net.watch(http.ep, EPOLL_DEL, fd, 0);
  net.close(fd);
  http.open[fd] := false;
  // The event loop can drop a connection directly on EPOLLERR/EPOLLHUP without ever
  // calling http.readbig again -- if that connection owned the overflow region, nothing
  // else would ever free it, and the region would answer every later oversized request
  // with 413 for the rest of the process's life.
  if http.bigowner = fd then http.bigowner := -1;
end;

// http.dropdetach(fd) -- let go of fd after app.request set http.detach, WITHOUT
// closing it: the opposite of http.drop, which always closes. fd comes out of
// http.ep and http.open so this file's own loop never touches it again; the socket
// itself, and everything still buffered in the kernel for it, is untouched.
//
// A failing DEL is ignored the same way http.drop ignores one (see there): it means
// fd is already out of the set, which is the state this routine wants to reach.
procedure http.dropdetach(fd: int);
begin
  http.ignored := net.watch(http.ep, EPOLL_DEL, fd, 0);
  http.open[fd] := false;
  if http.bigowner = fd then http.bigowner := -1;
end;

// push whatever is pending; ask for EPOLLOUT if the socket is full
procedure http.flush(fd: int);
var n, r: int;
begin
  while http.osend[fd] < http.oend[fd] do
  begin
    n := http.oend[fd] - http.osend[fd];
    r := net.send(fd, addr(http.outbuf[http.osend[fd]]), n);
    if r > 0 then http.osend[fd] := http.osend[fd] + r
    else if r = EAGAIN then
    begin
      // Without EPOLLOUT this connection is never woken to finish writing, so a
      // failed MOD is a stall.  It costs this one client, not the server: drop it.
      if not net.watch(http.ep, EPOLL_MOD, fd, bor(EPOLLIN, EPOLLOUT)) then
        http.drop(fd);
      return;
    end
    else if r <> EINTR then
    begin
      http.drop(fd);
      return;
    end;
  end;
  // Back to read-only.  A failed MOD would leave EPOLLOUT armed on an idle socket,
  // spinning the loop on a writable fd with nothing to write: drop it instead.
  if not net.watch(http.ep, EPOLL_MOD, fd, EPOLLIN) then
  begin
    http.drop(fd);
    return;
  end;
  if not http.keep then http.drop(fd);
end;

// Send a clean 413 and close: a request whose body will never fit is answered rather than
// reset.  Called once headers are known complete (http.hdrseen), so http.method, the path
// and the headers themselves are already valid -- only the body is the problem.
procedure http.reply413(fd: int);
begin
  http.fd := fd;
  http.obase := fd * OUTBUF;
  http.requests := http.requests + 1;
  http.started := io.now;
  http.start;
  http.keep := false;
  http.add("request body too large\n");
  http.finish(413, "text/plain");
  http.inlen[fd] := 0;
  http.flush(fd);
end;

// Continue a request whose body is being read into the shared overflow region rather than
// http.inbuf: called instead of the normal read once http.bigowner = fd.  Everything about
// the request except the body (method, path, headers) was already parsed into http.inbuf
// while the region was still empty, and stays valid there -- only the body bytes move.
//
// http.bigbase is a raw address from mmap, not an index into any Wantzel array -- net.recv
// takes a plain address (see net.wz), so it is used directly rather than through addr().
// The body is NOT in http.inbuf, so http.bodyat/http.bodylen here are an offset and a
// length into http.bigbase, not into http.inbuf: an application must check
// http.bodyinbig and read view(http.bigbase, http.bodylen) instead of http.inbuf when it
// is set. See docs/library.md.
procedure http.readbig(fd: int);
var r, room: int;
begin
  while true do
  begin
    room := http.bigtotal - http.biglen;
    if room <= 0 then break;
    r := net.recv(fd, http.bigbase + http.biglen, room);
    if r > 0 then http.biglen := http.biglen + r
    else if r = EAGAIN then return
    else if r <> EINTR then
    begin
      http.bigowner := -1;
      http.drop(fd);
      return;
    end;
    // r = EINTR falls through to the top of the loop and retries the same recv, the same
    // way http.readable and http.flush already do.
  end;
  // Reaching here (rather than one of the returns above) means the loop left through
  // "room <= 0", i.e. http.biglen = http.bigtotal: the body is complete.
  http.fd := fd;
  http.obase := fd * OUTBUF;
  http.requests := http.requests + 1;
  http.started := io.now;
  http.bodyinbig := true;
  http.bodyat := 0;
  http.bodylen := http.bigtotal;
  http.start;
  app.request;
  http.bodyinbig := false;
  // Same detach path as http.readable's ordinary case: see the comment there. A
  // detach after a big-body request is not a real scenario (a WebSocket upgrade is
  // a GET with no body) but is covered the same way rather than left unguarded.
  if http.detach then begin http.dropdetach(fd); return; end;
  http.bigowner := -1;
  http.inlen[fd] := 0;
  http.flush(fd);
end;

procedure http.readable(fd: int);
var r, used, total, base: int;
begin
  if http.bigowner = fd then begin http.readbig(fd); return; end;
  base := fd * INBUF;
  while true do
  begin
    used := http.inlen[fd];
    if used >= INBUF then
    begin
      // The buffer is full and http.parse never returned a complete request (that path
      // returns above, in the r > 0 branch).  Before this was always a bare http.drop --
      // a reset with no status code, indistinguishable from a crash at the client.  What
      // to do now depends on what http.parse already learned about the headers:
      if not http.hdrseen then
      begin
        // The headers themselves do not fit in INBUF (256 kB).  That is not a legitimate
        // large body, so treat it like any other malformed request.
        http.drop(fd);
        return;
      end;
      if (http.bigcap > 0) and (http.bigowner < 0) and (http.clen <= http.bigcap) then
      begin
        // Move the body bytes read so far into the shared region and keep reading there.
        // The request line and headers stay put in http.inbuf -- http.pathat and friends
        // still point at this connection's ordinary slot, which nothing here overwrites
        // until http.inlen[fd] is reset for the NEXT request.
        //
        // used - (http.bodyat - base) <= http.clen always holds here: this branch is only
        // reached with used = INBUF (the slot is completely full) while http.parse still
        // called the request incomplete, which means the WHOLE request (headers + body)
        // is already known to be bigger than INBUF -- so there is no room left in this
        // buffer for bytes belonging to any request after this one.
        http.biglen := used - (http.bodyat - base);
        http.copytobig(http.bodyat, http.biglen, view(http.bigbase, http.bigcap));
        http.bigowner := fd;
        http.bigtotal := http.clen;
        http.readbig(fd);
        return;
      end;
      // No overflow region configured, too small for this body, or already busy with
      // another connection's big body: answer honestly instead of resetting.
      http.reply413(fd);
      return;
    end;
    r := net.recv(fd, addr(http.inbuf[base + used]), INBUF - used);
    if r > 0 then
    begin
      http.inlen[fd] := used + r;
      total := http.parse(base, http.inlen[fd]);
      if total < 0 then
      begin
        http.drop(fd);
        return;
      end;
      if total > 0 then
      begin
        http.fd := fd;
        http.ibase := base;
        http.obase := fd * OUTBUF;
        http.requests := http.requests + 1;
        http.started := io.now;
        http.start;
        app.request;
        // http.detach means app.request handed fd to another module (a WebSocket
        // upgrade) instead of writing a reply through http.add/http.finish -- there
        // is nothing here to flush, and calling http.flush would write whatever
        // garbage happens to sit in this connection's http.outbuf onto a socket the
        // new owner is about to start reading frames from. Just let go of it.
        if http.detach then begin http.dropdetach(fd); return; end;
        http.inlen[fd] := 0;
        http.flush(fd);
        if not http.open[fd] then return;
      end;
    end
    else if r = EAGAIN then return
    else if r <> EINTR then
    begin
      http.drop(fd);
      return;
    end;
  end;
end;

procedure http.accept;
var fd: int;
begin
  while true do
  begin
    fd := net.accept(http.lfd);
    if fd < 0 then return;
    if fd >= MAXCONN then
    begin
      net.close(fd);
      return;
    end;
    http.inlen[fd] := 0;
    http.osend[fd] := 0;
    http.oend[fd] := 0;
    http.open[fd] := true;
    // A missed ADD means this connection is never served: the client waits forever
    // and the fd leaks.  That is one client, not the server, so close it here
    // rather than stopping a process that is serving others.
    if not net.watch(http.ep, EPOLL_ADD, fd, EPOLLIN) then http.drop(fd);
  end;
end;

// Run the event loop in `workers` independent processes.  Each opens its own
// listening socket with SO_REUSEPORT, so the kernel spreads incoming
// connections across them: all cores, no threads, no locks, nothing shared.
procedure http.serve(port: int; workers: int);
var n, i, fd, ev, pid: int;
begin
  // Global arrays and ints start zeroed, and fd 0 is a real descriptor -- so without this,
  // http.bigowner would read 0 and every check against it would treat stdin as the owner
  // of a region that was never even mapped.  Set unconditionally: a program that never
  // calls http.maxbody still needs http.bigowner to read as "free" and http.bigcap as "off".
  if http.bigcap = 0 then
  begin
    http.bigbase := -1;
    http.bigowner := -1;
  end;
  i := 1;
  while i < workers do
  begin
    pid := sys1(SYS.fork, 0);
    if pid < 0 then io.fatal("cannot fork a worker");
    if pid = 0 then break;
    i := i + 1;
  end;
  http.lfd := net.listen(port, 1024, workers > 1);   // SO_REUSEPORT only when workers share the port
  if http.lfd < 0 then io.fatal("cannot bind the port");
  http.ep := net.epoll;
  if http.ep < 0 then io.fatal("cannot create the epoll set");
  // The listening socket is the one the whole loop depends on: without it in the set
  // the server accepts nothing at all and would sit silently in epoll_wait forever.
  // Same treatment as net.listen and net.epoll above.
  if not net.watch(http.ep, EPOLL_ADD, http.lfd, EPOLLIN) then
    io.fatal("cannot watch the listening socket");
  while true do
  begin
    n := net.wait(http.ep, addr(http.evs[0]), MAXEV, -1);
    if n < 0 then
    begin
      if n <> EINTR then io.fatal("epoll_wait failed");
      n := 0;
    end;
    i := 0;
    while i < n do
    begin
      ev := io.get32(http.evs, i * 12);
      fd := io.get32(http.evs, i * 12 + 4);
      if fd = http.lfd then http.accept
      else if (fd >= 0) and (fd < MAXCONN) then
      begin
        if http.open[fd] then
        begin
          if band(ev, bor(EPOLLERR, EPOLLHUP)) <> 0 then http.drop(fd)
          else
          begin
            if band(ev, EPOLLOUT) <> 0 then http.flush(fd);
            if http.open[fd] and (band(ev, EPOLLIN) <> 0) then http.readable(fd);
          end;
        end;
      end;
      i := i + 1;
    end;
  end;
end;
