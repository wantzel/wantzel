// lib/mcp.wz -- Model Context Protocol over JSON-RPC 2.0.
//
// agent-permissions: read -- the standard library is not a scratchpad. Changing it
// changes every program that includes it, so it moves under a ticket rather than in
// passing. See docs/conventions.md §4.
//
// The envelope and the tools/call parameters are described as schemas, so
// the compiler generates their parsers: no dynamic objects, no allocation,
// and method names arrive as integers rather than strings.
//
// The application supplies two routines:
//   procedure app.tools;   -- writes the entries of the "tools" array
//   procedure app.call;    -- handles one tool call
// and uses the mcp.* helpers to write its replies.  Transports: mcp.stdio
// (below) and mcp.http in lib/mcphttp.wz (one call from app.request).
//
// LARGE MESSAGES.  A request or a reply that fits the two static 4 MB buffers (mcp.in,
// mcp.buf) is handled there without a system call.  One that does not moves, once, into an
// anonymous mapping as large as its limit, and that mapping is given back as soon as the
// message has been answered.  The limits are variables an application may set before it
// starts a transport:
//
//   mcp.maxin   largest request message, in bytes   0 = MCP.MAXIN_DEFAULT  (64 MB)
//   mcp.maxout  largest reply message, in bytes     0 = MCP.MAXOUT_DEFAULT (160 MB)
//
// A reply carries a tool's result twice (once escaped, as text) so the reply limit is
// larger than the result limit (tool.maxout, lib/toolsmcp.wz).  Past a limit the peer gets
// a JSON-RPC error that names it -- never a cut-off message, never a dead server.
//
// THE REPLY IS AT view(mcp.obase, n), not always in mcp.buf.  mcp.handle returns its length
// n; it is in mcp.buf exactly when it fits there (n < MCPBUF), which is every reply a
// program written before these limits could produce.  A transport of its own reads
// view(mcp.obase, n) and calls mcp.done once the bytes have been sent.

include "json.wz";

const
  // BIG ENOUGH FOR THE WORST CASE AND NOT FOR THE TYPICAL ONE. A reply carries text as a
  // JSON string, and escaping can multiply a byte by SIX (\u00XX for a control byte). So a
  // 256 kB file answered verbatim needs 1.5 MB of room, and the old 1 MB overflowed on
  // input that is unusual but entirely legal. 4 MB covers 256 kB at the worst rate with
  // the envelope to spare; it is a static array, so it costs address space and not work.
  MCPBUF = 4194304;

  // The defaults of mcp.maxin and mcp.maxout.  A request of a year of minute values is
  // 2-5 MB of JSON; 64 MB leaves an order of magnitude to spare.  The reply limit is two
  // and a half times the largest tool result (lib/toolsmcp.wz), because a result travels
  // twice -- as structuredContent and escaped inside a text block -- and escaping grows a
  // quote to two bytes.
  MCP.MAXIN_DEFAULT  = 67108864;
  MCP.MAXOUT_DEFAULT = 167772160;

  // MAP_NORESERVE: the mapping takes address space, and a page of memory only when it is
  // written.  The Windows runtime ignores the flags of an anonymous mapping.
  MCP.NORESERVE = 16384;
  MCP.EINTR     = 0 - 4;

  // why mcp.over replaced the reply with an error
  MCP.OVER_REQUEST = 1;           // the request is larger than mcp.maxin
  MCP.OVER_REPLY   = 2;           // the reply grew past mcp.maxout
  MCP.OVER_RESULT  = 3;           // a tool result is larger than tool.maxout
  MCP.OVER_NOMEM   = 4;           // the operating system refused the mapping

  RPC.parse_error      = 0 - 32700;
  RPC.invalid_request  = 0 - 32600;
  RPC.method_not_found = 0 - 32601;
  RPC.invalid_params   = 0 - 32602;
  RPC.internal_error   = 0 - 32603;

type Rpc = schema
  jsonrpc: text;
  id:      json?;                 // a number or a string; echoed verbatim
  method:  text of ("initialize", "notifications/initialized", "tools/list",
                    "tools/call", "ping", "resources/list", "prompts/list",
                    "notifications/cancelled", "logging/setLevel",
                    "notifications/progress", "notifications/roots/list_changed",
                    "resources/read", "prompts/get", "resources/templates/list");
  params:  json?;
end;

// enough of the initialize parameters to echo the client's protocol version.
//
// capabilities and clientInfo are declared although nothing here reads them, because an
// undeclared key is REFUSED and every real client sends both. Leaving
// them out made Init.parse return -1 for every genuine handshake, after which the version
// the client asked for was silently ignored and the server answered with the oldest one
// -- a wrong answer that refused nothing, which is the failure this language exists to
// prevent. A protocol envelope has to declare what the protocol actually carries.
type Init = schema
  protocolVersion: text?;
  capabilities:    json?;
  clientInfo:      json?;
end;

// tools/call parameters.  _meta is part of the MCP request shape (progress tokens live
// there), so it is declared for the same reason as the Init fields above.
type Call = schema
  name:      text;
  arguments: json?;
  _meta:     json?;
end;

var
  mcp.req:  Rpc;                  // the request being handled
  mcp.init: Init;
  mcp.callp: Call;
  mcp.buf: array[0..MCPBUF - 1] of char;
  mcp.wp:  int;                   // write cursor
  mcp.idat, mcp.idend: int;       // the id of the request being answered
  mcp.hasid: bool;
  mcp.failed: bool;               // a tool reported an error
  mcp.name: str;
  mcp.version: str;
  mcp.pv: str;                    // the protocol version negotiated by initialize
  mcp.pvcode: int;                // the same as a number: 0 = 2024-11-05, 1 = 2025-03-26, 2 = 2025-06-18
  mcp.inited: bool;               // an initialize has been answered (before that, assume 2025-06-18)

  // the limits; 0 means the default (MCP.MAXIN_DEFAULT, MCP.MAXOUT_DEFAULT)
  mcp.maxin, mcp.maxout: int;
  // where the reply is being written: mcp.buf, or a mapping once it outgrew mcp.buf
  mcp.obase: int;                 // address of the reply; 0 before the first one
  mcp.ocap: int;                  // bytes usable there
  mcp.omap: int;                  // the mapping, 0 when the reply is in mcp.buf
  mcp.omapn: int;                 // its size
  mcp.over: int;                  // MCP.OVER_*, 0 while the reply is within its limits
  mcp.overlimit: int;             // the limit that was hit, for the error message
  // mappings held by lib/mcp.wz and lib/toolsmcp.wz right now, and their bytes: a program
  // (or a test) can read them to see that a large message left nothing behind
  mcp.mapped, mcp.mappedbytes: int;

// ------------------------------------------------------------- memory

// Map n bytes of zeroed memory: the address, or -1 when the system refused.
function mcp.map(n: int): int;
var p: int;
begin
  p := sys6(SYS.mmap, 0, n, bor(PROT_READ, PROT_WRITE),
            bor(bor(MAP_PRIVATE, MAP_ANONYMOUS), MCP.NORESERVE), 0 - 1, 0);
  if p <= 0 then return 0 - 1;
  mcp.mapped := mcp.mapped + 1;
  mcp.mappedbytes := mcp.mappedbytes + n;
  return p;
end;

procedure mcp.unmap(p: int; n: int);
begin
  if p <= 0 then return;
  sys2(SYS.munmap, p, n);
  mcp.mapped := mcp.mapped - 1;
  mcp.mappedbytes := mcp.mappedbytes - n;
end;

procedure mcp.movew(d: array of int; s: array of int; n: int);
var i: int;
begin
  i := 0;
  while i < n do
  begin
    d[i] := s[i];
    i := i + 1;
  end;
end;

procedure mcp.moveb(d: array of char; s: array of char; n: int);
var i: int;
begin
  i := 0;
  while i < n do
  begin
    d[i] := s[i];
    i := i + 1;
  end;
end;

// Copy n bytes from address src to address dst, eight at a time, front to back: safe when
// the two do not overlap and when dst lies before src (moving leftover input down).
procedure mcp.move(dst: int; src: int; n: int);
var w: int;
begin
  if n <= 0 then return;
  w := n div 8;
  if w > 0 then mcp.movew(view(dst, w), view(src, w), w);
  if n - w * 8 > 0 then mcp.moveb(view(dst + w * 8, n - w * 8), view(src + w * 8, n - w * 8), n - w * 8);
end;

function mcp.inlimit: int;
begin
  if mcp.maxin > 0 then return mcp.maxin;
  return MCP.MAXIN_DEFAULT;
end;

function mcp.outlimit: int;
begin
  if mcp.maxout > 0 then return mcp.maxout;
  return MCP.MAXOUT_DEFAULT;
end;

// Give back the mapping a reply outgrew mcp.buf into, and write the next reply in mcp.buf
// again.  A transport calls this once the reply has been sent; mcp.handle calls it too,
// so a transport that does not still holds at most one mapping.
procedure mcp.done;
var m: int;
begin
  if mcp.omap <> 0 then
  begin
    mcp.unmap(mcp.omap, mcp.omapn);
    mcp.omap := 0;
    mcp.omapn := 0;
  end;
  mcp.obase := addr(mcp.buf[0]);
  m := mcp.outlimit + 1;            // + 1: stdio ends the reply with a newline
  if m > MCPBUF then m := MCPBUF;
  mcp.ocap := m;
end;

// Make room for n more bytes of reply.  False when the reply would pass mcp.maxout (or
// memory for it cannot be had); mcp.over then says which, every later write is dropped,
// and mcp.handle answers with an error instead of the half-written reply.
//
// THE FIRST TIME A REPLY OUTGROWS mcp.buf IT MOVES ONCE, into a mapping of the whole
// limit, rather than doubling: nothing is copied more than once, and on Linux a page of it
// costs memory only when it is written.  One byte stays free behind the reply for the
// newline mcp.stdio adds.
function mcp.room(n: int): bool;
var m, p: int;
begin
  if mcp.over <> 0 then return false;
  if mcp.obase = 0 then mcp.done;
  if mcp.wp + n + 1 <= mcp.ocap then return true;
  m := mcp.outlimit;
  if (mcp.wp + n > m) or (mcp.omap <> 0) then
  begin
    mcp.over := MCP.OVER_REPLY;
    mcp.overlimit := m;
    return false;
  end;
  p := mcp.map(m + 1);
  if p < 0 then
  begin
    mcp.over := MCP.OVER_NOMEM;
    mcp.overlimit := m + 1;
    return false;
  end;
  mcp.move(p, mcp.obase, mcp.wp);
  mcp.omap := p;
  mcp.omapn := m + 1;
  mcp.obase := p;
  mcp.ocap := m + 1;
  return true;
end;

// The length of b[from..upto) escaped as json.putslice/json.escslice write it, without
// the quotes -- so a large value asks for the room it needs and not six times that.
function mcp.esclen(b: array of char; from: int; upto: int): int;
var n: int;
    c: char;
begin
  n := 0;
  while from < upto do
  begin
    c := b[from];
    if (c = '"') or (c = '\\') or (c = chr(10)) or (c = chr(9)) or (c = chr(13)) then n := n + 2
    else if ord(c) < 32 then n := n + 6
    else n := n + 1;
    from := from + 1;
  end;
  return n;
end;

// ------------------------------------------------------------- writing

// Every writer asks mcp.room first, so none of them can cut a reply short: a value either
// goes in whole, or the reply becomes an error that says why.

procedure mcp.add(s: str);
begin
  if mcp.room(slen(s)) then mcp.wp := io.push(view(mcp.obase, mcp.ocap), mcp.wp, s);
end;

procedure mcp.addn(v: int);
begin
  if mcp.room(21) then mcp.wp := io.pushnum(view(mcp.obase, mcp.ocap), mcp.wp, v);
end;

procedure mcp.addq(s: str);
begin
  if mcp.room(6 * slen(s) + 8) then mcp.wp := json.putstr(view(mcp.obase, mcp.ocap), mcp.wp, s);
end;

procedure mcp.copyin(s: array of char);
begin
  mcp.move(mcp.obase + mcp.wp, addr(s[0]), len(s));
  mcp.wp := mcp.wp + len(s);
end;

procedure mcp.addslice(b: array of char; from: int; upto: int);
begin
  if upto <= from then return;
  // the slice is bounds-checked where it is made, so a range outside b still traps here
  // rather than copying whatever lies behind it
  if mcp.room(upto - from) then mcp.copyin(b[from..upto - 1]);
end;

// A quoted, escaped JSON string.  The escaped length is counted first, so the room asked
// for is what the value needs: a 40 MB value asks for 40 MB and a bit, not 240.  The six
// bytes on top are json.putslice's own margin, which tests for its heaviest case (\u00XX)
// before every byte.
procedure mcp.addqslice(b: array of char; from: int; upto: int);
var n, at: int;
begin
  n := mcp.esclen(b, from, upto);
  if not mcp.room(n + 2 + 6) then return;
  at := json.putslice(view(mcp.obase, mcp.ocap), mcp.wp, b, from, upto);
  if at <> mcp.wp + n + 2 then
  begin
    mcp.over := MCP.OVER_REPLY;
    mcp.overlimit := mcp.outlimit;
    return;
  end;
  mcp.wp := at;
end;

// escaped, but without quotes: for building one long text value in pieces
procedure mcp.addesc(b: array of char; from: int; upto: int);
var n, at: int;
begin
  n := mcp.esclen(b, from, upto);
  if not mcp.room(n + 6) then return;
  at := json.escslice(view(mcp.obase, mcp.ocap), mcp.wp, b, from, upto);
  if at <> mcp.wp + n then
  begin
    mcp.over := MCP.OVER_REPLY;
    mcp.overlimit := mcp.outlimit;
    return;
  end;
  mcp.wp := at;
end;

// ------------------------------------------------------- reply envelopes

procedure mcp.startreply;
begin
  mcp.wp := 0;
  mcp.add("{\"jsonrpc\":\"2.0\",\"id\":");
  if mcp.hasid then mcp.addslice(mcp.buf, 0, 0);
end;

// the id lives in the request buffer, so it is copied in by the caller
procedure mcp.begin_result(b: array of char);
begin
  mcp.wp := 0;
  mcp.add("{\"jsonrpc\":\"2.0\",\"id\":");
  if mcp.hasid then mcp.addslice(b, mcp.idat, mcp.idend)
  else mcp.add("null");
  mcp.add(",\"result\":");
end;

procedure mcp.end_result;
begin
  mcp.add("}");
end;

procedure mcp.error(b: array of char; code: int; msg: str);
begin
  mcp.wp := 0;
  mcp.add("{\"jsonrpc\":\"2.0\",\"id\":");
  if mcp.hasid then mcp.addslice(b, mcp.idat, mcp.idend)
  else mcp.add("null");
  mcp.add(",\"error\":{\"code\":");
  mcp.addn(code);
  mcp.add(",\"message\":");
  mcp.addq(msg);
  mcp.add("}}");
end;

// ------------------------------------------------ tool result helpers

procedure mcp.text(s: str);
begin
  mcp.add("{\"content\":[{\"type\":\"text\",\"text\":");
  mcp.addq(s);
  mcp.add("}]");
  if mcp.failed then mcp.add(",\"isError\":true");
  mcp.add("}");
end;

// The slice comes from a JSON string, so it is already escaped: copying it
// verbatim is both correct and free.  Use mcp.textbytes for raw bytes.
procedure mcp.textslice(b: array of char; from: int; upto: int);
begin
  mcp.add("{\"content\":[{\"type\":\"text\",\"text\":\"");
  mcp.addslice(b, from, upto);
  mcp.add("\"}]");
  if mcp.failed then mcp.add(",\"isError\":true");
  mcp.add("}");
end;

procedure mcp.textbytes(b: array of char; from: int; upto: int);
begin
  mcp.add("{\"content\":[{\"type\":\"text\",\"text\":");
  mcp.addqslice(b, from, upto);
  mcp.add("}]");
  if mcp.failed then mcp.add(",\"isError\":true");
  mcp.add("}");
end;

procedure mcp.textnum(v: int);
begin
  mcp.add("{\"content\":[{\"type\":\"text\",\"text\":\"");
  mcp.addn(v);
  mcp.add("\"}]");
  if mcp.failed then mcp.add(",\"isError\":true");
  mcp.add("}");
end;

// the application implements these
procedure app.tools; forward;
procedure app.call(b: array of char; last: int); forward;

// ---------------------------------------------------------- dispatch

// Answer one JSON-RPC message in b[at..last); mcp.handle below is the entry point.
function mcp.dispatch(b: array of char; at: int; last: int): int;
var r, p0, p1: int;
begin
  r := Rpc.parse(b, at, last, mcp.req);
  if r < 0 then
  begin
    mcp.error(b, RPC.parse_error, "invalid JSON-RPC request");
    return mcp.wp;
  end;
  if mcp.req.id_ok then
  begin
    mcp.hasid := true;
    mcp.idat := mcp.req.id_at;
    mcp.idend := mcp.req.id_end;
  end;

  if mcp.req.method = Rpc.method.notifications_initialized then return 0;
  if mcp.req.method = Rpc.method.notifications_cancelled then return 0;
  if mcp.req.method = Rpc.method.notifications_progress then return 0;
  if mcp.req.method = Rpc.method.notifications_roots_list_changed then return 0;

  // Answer the lists a client may ask for even though we do not advertise
  // them, rather than making it deal with an error; reading one is an error
  // in the parameters, since no such resource or prompt exists.
  if mcp.req.method = Rpc.method.resources_list then
  begin
    mcp.begin_result(b);
    mcp.add("{\"resources\":[]}");
    mcp.end_result;
    return mcp.wp;
  end;
  if mcp.req.method = Rpc.method.resources_templates_list then
  begin
    mcp.begin_result(b);
    mcp.add("{\"resourceTemplates\":[]}");
    mcp.end_result;
    return mcp.wp;
  end;
  if mcp.req.method = Rpc.method.prompts_list then
  begin
    mcp.begin_result(b);
    mcp.add("{\"prompts\":[]}");
    mcp.end_result;
    return mcp.wp;
  end;
  if mcp.req.method = Rpc.method.resources_read then
  begin
    mcp.error(b, RPC.invalid_params, "no such resource");
    return mcp.wp;
  end;
  if mcp.req.method = Rpc.method.prompts_get then
  begin
    mcp.error(b, RPC.invalid_params, "no such prompt");
    return mcp.wp;
  end;
  if mcp.req.method = Rpc.method.logging_setlevel then
  begin
    mcp.begin_result(b);
    mcp.add("{}");
    mcp.end_result;
    return mcp.wp;
  end;

  if mcp.req.method = Rpc.method.initialize then
  begin
    // Answer in the version the client asked for when we know it, in the
    // newest we support when we do not, and in the oldest when it named none.
    mcp.pv := "2024-11-05";
    mcp.pvcode := 0;
    if mcp.req.params_ok then
    begin
      if Init.parse(b, mcp.req.params_at, mcp.req.params_end, mcp.init) >= 0 then
      begin
        if mcp.init.protocolVersion_ok and not mcp.init.protocolVersion_null then
        begin
          if json.eq(b, mcp.init.protocolVersion_at, mcp.init.protocolVersion_end, "2025-03-26") then
          begin
            mcp.pv := "2025-03-26";
            mcp.pvcode := 1;
          end
          else if not json.eq(b, mcp.init.protocolVersion_at, mcp.init.protocolVersion_end, "2024-11-05") then
          begin
            mcp.pv := "2025-06-18";
            mcp.pvcode := 2;
          end;
        end;
      end;
    end;
    mcp.inited := true;
    mcp.begin_result(b);
    mcp.add("{\"protocolVersion\":");
    mcp.addq(mcp.pv);
    mcp.add(",\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":");
    // A server that never set these still has to answer something: an empty name in the
    // handshake is a reply a client cannot use, and an unset one used to be a
    // segfault on the FIRST request. The application overrides both; these are what it
    // gets for free.
    if slen(mcp.name) = 0 then mcp.addq("wantzel-mcp") else mcp.addq(mcp.name);
    mcp.add(",\"version\":");
    if slen(mcp.version) = 0 then mcp.addq("0") else mcp.addq(mcp.version);
    mcp.add("}}");
    mcp.end_result;
    return mcp.wp;
  end;

  if mcp.req.method = Rpc.method.ping then
  begin
    mcp.begin_result(b);
    mcp.add("{}");
    mcp.end_result;
    return mcp.wp;
  end;

  // tools/list: the whole list always fits in one reply, so a cursor in the
  // params is ignored and no nextCursor is ever sent
  if mcp.req.method = Rpc.method.tools_list then
  begin
    mcp.begin_result(b);
    mcp.add("{\"tools\":[");
    app.tools;
    mcp.add("]}");
    mcp.end_result;
    return mcp.wp;
  end;

  if mcp.req.method = Rpc.method.tools_call then
  begin
    if not mcp.req.params_ok then
    begin
      mcp.error(b, RPC.invalid_params, "tools/call needs params");
      return mcp.wp;
    end;
    p0 := mcp.req.params_at;
    p1 := mcp.req.params_end;
    if Call.parse(b, p0, p1, mcp.callp) < 0 then
    begin
      mcp.error(b, RPC.invalid_params, "tools/call needs a tool name");
      return mcp.wp;
    end;
    mcp.begin_result(b);
    app.call(b, p1);
    mcp.end_result;
    return mcp.wp;
  end;

  mcp.error(b, RPC.method_not_found, "no such method");
  return mcp.wp;
end;

// Replace the reply with the error for mcp.over: code, a message that names the limit in
// bytes, and the limit again as data.limit for a program to read.  It is written in
// mcp.buf, which always has room for it.  An id longer than 1 kB is answered as null
// rather than risk the error not fitting either -- a real client sends a number or a
// short string.
function mcp.limiterror(b: array of char): int;
var why, lim: int;
begin
  why := mcp.over;
  lim := mcp.overlimit;
  mcp.done;
  mcp.ocap := MCPBUF;             // the error fits whatever mcp.maxout says
  mcp.over := 0;
  mcp.wp := 0;
  mcp.add("{\"jsonrpc\":\"2.0\",\"id\":");
  if mcp.hasid and (mcp.idend - mcp.idat <= 1024) then mcp.addslice(b, mcp.idat, mcp.idend)
  else mcp.add("null");
  mcp.add(",\"error\":{\"code\":");
  if why = MCP.OVER_REQUEST then
  begin
    mcp.addn(RPC.invalid_request);
    mcp.add(",\"message\":\"the request is larger than the maximum of ");
  end
  else if why = MCP.OVER_RESULT then
  begin
    mcp.addn(RPC.internal_error);
    mcp.add(",\"message\":\"the tool result is larger than the maximum of ");
  end
  else if why = MCP.OVER_NOMEM then
  begin
    mcp.addn(RPC.internal_error);
    mcp.add(",\"message\":\"the server could not get memory for a message of ");
  end
  else
  begin
    mcp.addn(RPC.internal_error);
    mcp.add(",\"message\":\"the reply is larger than the maximum of ");
  end;
  mcp.addn(lim);
  mcp.add(" bytes\",\"data\":{\"limit\":");
  mcp.addn(lim);
  mcp.add("}}}");
  return mcp.wp;
end;

// Handle one JSON-RPC message in b[at..last).  Returns the number of bytes of reply at
// view(mcp.obase, n) -- in mcp.buf unless it outgrew it -- or 0 when the message is a
// notification.  A message or reply past its limit is answered with a JSON-RPC error.
function mcp.handle(b: array of char; at: int; last: int): int;
var n: int;
begin
  mcp.done;
  mcp.wp := 0;
  mcp.over := 0;
  mcp.hasid := false;
  mcp.failed := false;
  if last - at > mcp.inlimit then
  begin
    // the id is still worth finding: a client matches the error to its call by it
    if Rpc.parse(b, at, last, mcp.req) >= 0 then
    begin
      if mcp.req.id_ok then
      begin
        mcp.hasid := true;
        mcp.idat := mcp.req.id_at;
        mcp.idend := mcp.req.id_end;
      end;
    end;
    mcp.over := MCP.OVER_REQUEST;
    mcp.overlimit := mcp.inlimit;
    return mcp.limiterror(b);
  end;
  n := mcp.dispatch(b, at, last);
  if mcp.over <> 0 then n := mcp.limiterror(b);
  return n;
end;

// ------------------------------------------------------ stdio transport

var
  mcp.in: array[0..MCPBUF - 1] of char;   // the input while no line outgrows it
  mcp.inlen: int;
  mcp.ibase: int;                 // where the input is: mcp.in, or a mapping
  mcp.icap: int;                  // bytes usable there
  mcp.imap: int;                  // the mapping, 0 when the input is in mcp.in
  mcp.imapn: int;                 // its size
  mcp.iscan: int;                 // input before this has been searched for a newline
  mcp.iskip: bool;                // dropping the rest of a line that passed mcp.maxin

// Write the reply and its newline, all of it: a pipe can take a large write in pieces.
procedure mcp.sendline(fd: int; n: int);
var sent, r: int;
begin
  mcp.moveb(view(mcp.obase + n, 1), "\n", 1);
  sent := 0;
  while sent < n + 1 do
  begin
    r := io.write(fd, mcp.obase + sent, n + 1 - sent);
    if r = MCP.EINTR then continue;
    if r <= 0 then return;
    sent := sent + r;
  end;
end;

procedure mcp.istatic;
var m: int;
begin
  mcp.ibase := addr(mcp.in[0]);
  m := mcp.inlimit + 1;             // + 1: the newline that ends the largest message
  if m > MCPBUF then m := MCPBUF;
  mcp.icap := m;
end;

// The input is full and holds no newline.  Move it, once, into a mapping as large as the
// limit; when it already is that large the line is over the limit: answer so, and drop
// the line up to its newline -- the rest of it would otherwise arrive as a second,
// broken message and earn a second error for one request.
procedure mcp.igrow;
var p, m: int;
begin
  m := mcp.inlimit + 1;
  if (mcp.imap = 0) and (m > mcp.icap) then
  begin
    p := mcp.map(m);
    if p > 0 then
    begin
      mcp.move(p, mcp.ibase, mcp.inlen);
      mcp.imap := p;
      mcp.imapn := m;
      mcp.ibase := p;
      mcp.icap := m;
      return;
    end;
    mcp.over := MCP.OVER_NOMEM;
    mcp.overlimit := m;
  end
  else
  begin
    mcp.over := MCP.OVER_REQUEST;
    mcp.overlimit := mcp.inlimit;
  end;
  mcp.done;
  mcp.wp := 0;
  mcp.hasid := false;
  mcp.sendline(STDOUT, mcp.limiterror(mcp.in));
  mcp.done;
  mcp.iskip := true;
  mcp.inlen := 0;
  mcp.iscan := 0;
end;

// Answer the complete lines in b[0..mcp.inlen), then move what is left to the front.
// True when it stopped with a line still waiting: while the input is in a mapping it
// answers ONE line and returns, so the caller can move the rest back into mcp.in before
// the next -- otherwise a large line followed by thousands of small ones (a read from a
// file returns them all at once) would keep the mapping for all of them.
function mcp.lines(b: array of char): bool;
var at, nl, n: int;
    more: bool;
begin
  at := 0;
  more := false;
  while true do
  begin
    nl := scan(b, mcp.iscan, mcp.inlen, chr(10));
    if nl >= mcp.inlen then break;
    if mcp.iskip then mcp.iskip := false
    else if nl > at then
    begin
      n := mcp.handle(b, at, nl);
      if n > 0 then mcp.sendline(STDOUT, n);
      mcp.done;
    end;
    at := nl + 1;
    mcp.iscan := at;
    if mcp.imap <> 0 then
    begin
      more := at < mcp.inlen;
      break;
    end;
  end;
  // no newline yet: while dropping a line, everything read so far belongs to it
  if mcp.iskip then at := mcp.inlen;
  if at > 0 then
  begin
    mcp.move(mcp.ibase, mcp.ibase + at, mcp.inlen - at);
    mcp.inlen := mcp.inlen - at;
  end;
  if more then mcp.iscan := 0 else mcp.iscan := mcp.inlen;
  return more;
end;

// After a large line: when what is left fits in mcp.in again, move it there and give the
// mapping back.
procedure mcp.ishrink;
var p, n: int;
begin
  if mcp.imap = 0 then return;
  if mcp.inlen >= MCPBUF then return;
  p := mcp.imap;
  n := mcp.imapn;
  mcp.istatic;
  if mcp.inlen >= mcp.icap then
  begin
    mcp.ibase := p;               // the limit is below MCPBUF; keep the mapping
    mcp.icap := n;
    return;
  end;
  mcp.move(mcp.ibase, p, mcp.inlen);
  mcp.unmap(p, n);
  mcp.imap := 0;
  mcp.imapn := 0;
end;

// Read newline-delimited JSON-RPC messages from standard input and write
// the replies to standard output.  This is how editors start an MCP server.
//
// A line that does not fit in mcp.in moves into a mapping of mcp.maxin bytes and moves
// back once it has been answered; a line longer than mcp.maxin is answered with an error
// and dropped, and the server reads on.  Only the part read since the last search is
// searched for a newline, so a 40 MB line costs one pass and not one per read.
procedure mcp.stdio;
var r: int;
begin
  mcp.inlen := 0;
  mcp.iscan := 0;
  mcp.iskip := false;
  mcp.imap := 0;
  mcp.istatic;
  while true do
  begin
    if mcp.inlen >= mcp.icap then mcp.igrow;
    r := io.read(STDIN, mcp.ibase + mcp.inlen, mcp.icap - mcp.inlen);
    if r = MCP.EINTR then continue;
    if r <= 0 then
    begin
      if mcp.imap <> 0 then mcp.unmap(mcp.imap, mcp.imapn);
      mcp.imap := 0;
      mcp.istatic;
      return;
    end;
    mcp.inlen := mcp.inlen + r;
    while mcp.lines(view(mcp.ibase, mcp.icap)) do mcp.ishrink;
    mcp.ishrink;
  end;
end;
