// chain.wz -- does this certificate chain up to something we trust?
//
// WHAT WAS MISSING BEFORE THIS FILE, and it is the whole reason it exists. x509.wz could
// READ a certificate -- issuer, subject, validity, public key, signature, and which
// algorithm made it -- and p256.wz and rsa.wz could CHECK a signature. Nothing joined them
// up. x509.sigalg was set in three places and read in none: the parser did its work and the
// answer was thrown away.
//
// The visible consequence was in lib/tls.wz: tls.verified could only ever say "the server
// proved it holds the key in this certificate", never "and that certificate was issued by
// someone we trust". Necessary, and not sufficient.
//
// WHAT A CHAIN IS. The server sends its own certificate first, then the ones that vouch for
// it, up to but usually NOT including the root. Each certificate is signed by the next; the
// last one must be signed by a root we already hold. So verification walks the list, and at
// every step asks the same question: does the NEXT certificate's public key verify THIS
// certificate's signature over its tbsCertificate bytes?
//
// WHAT THIS FILE DOES NOT DO, listed because a half-checked chain is worse than an
// unchecked one -- it looks like safety:
//   - NO name constraints, no policy constraints, no path-length enforcement beyond basic
//     constraints CA:TRUE
//   - NO revocation: neither CRL nor OCSP. A revoked certificate still verifies here.
//   - NO RSA-PSS (x509.sigalg = 3). Only PKCS#1 v1.5 and ECDSA P-256.
//   - NO cross-signing search: the chain is checked in the order it was sent.
// Each of these is a real gap and each is reported rather than silently tolerated: a
// certificate this file cannot check is REFUSED, never waved through.

import io;
import sha256;
import x509;
import p256;
import p384;
import sha384;
import rsa;
import der;

const
  CH.MAXCERTS = 8;        // a chain longer than this is not a chain, it is a loop

var
  ch.err: str;
  ch.bad: bool;
  ch.digest: array[0..127] of char;  // 0..47 the digest (48 for SHA-384); 64..111 scratch for a DER INTEGER

  // the certificates, as slices of one buffer
  ch.at:  array[0..CH.MAXCERTS-1] of int;
  ch.n:   array[0..CH.MAXCERTS-1] of int;
  ch.cnt: int;

  // the issuer's key, kept across the two parses of one step
  ch.keyalg: int;
  ch.keyat:  int;
  ch.keyn:   int;
  ch.keybuf: array[0..1023] of char;   // the issuer's key, copied out of whatever buffer it was in

  // scratch for ECDSA
  ch.qx, ch.qy, ch.e, ch.sr, ch.ss: array[0..P.N-1] of int;
  // The same five, at P-384 width. Separate arrays rather than one wide pair, because
  // p256.* and p384.* each expect their own limb count and mixing them silently reads
  // garbage from beyond the end.
  ch.qx4, ch.qy4, ch.e4, ch.sr4, ch.ss4: array[0..Q.N-1] of int;

procedure ch.fail(m: str);
begin
  ch.err := m;
  ch.bad := true;
end;

// ---- the trust store ---------------------------------------------------------------------
//
// ROOTS ARE HELD AS DER, one after another in a single buffer, because that is how they
// arrive from disk and because parsing them at startup would mean keeping a parsed form of
// every root in memory for the one that gets used.
//
// THE STORE IS DELIBERATELY SMALL AND EXPLICIT. A caller adds the roots it wants; there is
// no system store to inherit, no directory scanned behind the caller's back, and therefore
// no question about what is trusted -- which is exactly the property that makes a
// zero-dependency binary worth having.
// SIZED FOR A REAL SYSTEM BUNDLE. Debian's ca-certificates.crt holds 121 roots in 182 kB of
// PEM, which is about 135 kB of DER. 65536 fitted 32 of them and silently stopped -- the
// store said "full", the caller ignored it, and 89 roots were missing. A connection to a
// site under one of those would have been refused with a message about an untrusted root,
// which is the hardest kind of fault to trace: everything works except some of the time.
const CH.ROOTBUF = 262144;
var
  ch.roots:   array[0..CH.ROOTBUF-1] of char;
  // 256 slots: a system bundle has about 120 and a caller may add its own.
  ch.rootat:  array[0..255] of int;
  ch.rootn:   array[0..255] of int;
  ch.rootcnt: int;
  ch.rootlen: int;

procedure ch.clearroots;
begin
  ch.rootcnt := 0;
  ch.rootlen := 0;
end;

// Add one root, as DER. False when the store is full -- and it says so rather than
// silently dropping it, because a root that is quietly missing turns into a rejected
// connection somewhere far away.
function ch.addroot(b: array of char; at: int; n: int): bool;
var i: int;
begin
  if ch.rootcnt >= len(ch.rootat) then begin ch.fail("the trust store is full"); return false; end;
  if ch.rootlen + n > CH.ROOTBUF then begin ch.fail("the trust store has no room for this root"); return false; end;
  i := 0;
  while i < n do begin ch.roots[ch.rootlen + i] := b[at + i]; i := i + 1; end;
  ch.rootat[ch.rootcnt] := ch.rootlen;
  ch.rootn[ch.rootcnt] := n;
  ch.rootlen := ch.rootlen + n;
  ch.rootcnt := ch.rootcnt + 1;
  return true;
end;

// ---- one link: does `key` verify the signature on `cert`? --------------------------------
//
// THE SIGNATURE IS OVER THE tbsCertificate BYTES AS THEY LIE, tag and length included. That
// is why x509.tbsat/tbsn point into the original buffer instead of a re-encoded copy: two
// different byte sequences can decode to the same certificate, and only one of them is what
// was signed.
//
// THE PARSE HAPPENS TWICE PER LINK and that is deliberate. x509.wz keeps ONE certificate's
// fields in module variables, so checking "does cert B's key verify cert A's signature"
// means parsing A (for its tbs and signature), remembering what is needed, then parsing B
// (for its key). Keeping two parsed certificates would mean two of every field; copying the
// three numbers that matter is cheaper and harder to get wrong.

// Remember the public key of the certificate x509 has just parsed.
//
// THE BYTES ARE COPIED, not pointed at, and that is not caution but necessity: the issuer's
// key often lives in a DIFFERENT BUFFER from the certificate being checked. A root comes
// out of ch.roots while the chain sits in the caller's buffer, so an offset alone is
// meaningless -- it would be read from the wrong array.
//
// That was a real bug here: ch.checksig took the key offset from the root and read it out of
// the chain buffer, which is a stretch of some other certificate's bytes. It failed with "an
// RSA key that does not parse", which is the good outcome; the bad one would have been
// bytes that happened to parse.
procedure ch.takekey;
var i: int;
begin
  ch.keyalg := x509.keyalg;
  ch.keyn   := x509.keyn;
  ch.keyat  := 0;
  if x509.keyn > len(ch.keybuf) then begin ch.fail("a public key larger than the buffer"); ch.keyn := 0; end;
end;

// The same, naming the buffer the key is to be copied out of.
procedure ch.takekeyfrom(b: array of char);
var i: int;
begin
  ch.takekey;
  i := 0;
  while i < ch.keyn do begin ch.keybuf[i] := b[x509.keyat + i]; i := i + 1; end;
end;

// An EC public key inside a certificate is the uncompressed point: 04 || X || Y.
//
// THE WIDTH FOLLOWS THE CURVE: 65 bytes for P-256 (1 + 32 + 32), 97 for P-384 (1 + 48 + 48).
// Checking it is not pedantry -- a key of the wrong length under the right OID means the
// certificate is malformed or lying, and reading it anyway would take bytes from beyond the
// key.
function ch.ecpoint(b: array of char; at: int; n: int): bool;
begin
  if n <> 65 then begin ch.fail("a P-256 key that is not 65 bytes"); return false; end;
  if b[at] <> chr(4) then begin ch.fail("a compressed EC point, which this does not decode"); return false; end;
  p256.frombytes(ch.qx, b, at + 1);
  p256.frombytes(ch.qy, b, at + 33);
  return true;
end;

function ch.ecpoint384(b: array of char; at: int; n: int): bool;
begin
  if n <> 97 then begin ch.fail("a P-384 key that is not 97 bytes"); return false; end;
  if b[at] <> chr(4) then begin ch.fail("a compressed EC point, which this does not decode"); return false; end;
  p384.frombytes(ch.qx4, b, at + 1);
  p384.frombytes(ch.qy4, b, at + 49);
  return true;
end;

// An RSA public key is SEQUENCE { INTEGER modulus, INTEGER exponent }.
function ch.rsakey(b: array of char; at: int; n: int): bool;
var inner, nat, nn, eat, en, upto: int;
begin
  if der.next(b, at, at + n) < 0 then begin ch.fail("an RSA key that does not parse"); return false; end;
  if der.tag <> 0x30 then begin ch.fail("an RSA key that is not a SEQUENCE"); return false; end;
  inner := der.vat;
  upto := der.vend;
  if der.next(b, inner, upto) < 0 then begin ch.fail("no modulus in the RSA key"); return false; end;
  if der.tag <> 0x02 then begin ch.fail("the modulus is not an INTEGER"); return false; end;
  nat := der.vat; nn := der.vend - der.vat;
  if der.next(b, der.vend, upto) < 0 then begin ch.fail("no exponent in the RSA key"); return false; end;
  if der.tag <> 0x02 then begin ch.fail("the exponent is not an INTEGER"); return false; end;
  eat := der.vat; en := der.vend - der.vat;
  if not rsa.setkey(b, nat, nn, b, eat, en) then begin ch.fail(rsa.err); return false; end;
  return true;
end;

// A DER INTEGER into a 256-bit value: strip the leading zero DER adds for a positive number
// whose top bit is set, then right-align the bytes.
function ch.derint(r: array of int; b: array of char; at: int; n: int): bool;
var i: int;
begin
  while (n > 0) and (b[at] = chr(0)) do begin at := at + 1; n := n - 1; end;
  if (n = 0) or (n > 32) then return false;
  i := 0;
  // THE SCRATCH STARTS AT 64, not 32. A SHA-384 digest occupies 0..47, so the old offset
  // overlapped it -- and the overlap only shows on a P-384 chain, where the digest is long
  // enough to reach into the scratch.
  while i < 32 do begin ch.digest[64 + i] := chr(0); i := i + 1; end;
  i := 0;
  while i < n do begin ch.digest[64 + 32 - n + i] := b[at + i]; i := i + 1; end;
  p256.frombytes(r, ch.digest, 64);
  return true;
end;

// The same, at P-384 width: 48 bytes instead of 32.
function ch.derint384(r: array of int; b: array of char; at: int; n: int): bool;
var i: int;
begin
  while (n > 0) and (b[at] = chr(0)) do begin at := at + 1; n := n - 1; end;
  if (n = 0) or (n > 48) then return false;
  i := 0;
  while i < 48 do begin ch.digest[64 + i] := chr(0); i := i + 1; end;
  i := 0;
  while i < n do begin ch.digest[64 + 48 - n + i] := b[at + i]; i := i + 1; end;
  p384.frombytes(r, ch.digest, 64);
  return true;
end;

// ch.checksig -- verify the signature on the certificate at b[cat..cat+cn), using the key
// remembered by ch.takekey.
//
// THE ALGORITHM COMES FROM THE CERTIFICATE AND THE KEY MUST AGREE WITH IT. An RSA signature
// verified with an EC key, or the other way round, is not a mismatch to shrug at -- it is
// the shape of an attack, so it is refused explicitly rather than falling through.
function ch.checksig(b: array of char; cat: int; cn: int): bool;
var sat, sn, rat, rn, sgat, sgn, inner2, end2: int;
begin
  if not x509.parse(b, cat, cat + cn) then begin ch.fail(x509.err); return false; end;

  // HASH THE SIGNED REGION, with the hash the ALGORITHM names -- not a fixed one. Using
  // SHA-256 for an ecdsa-with-SHA384 signature gives a digest of the right shape and the
  // wrong value, so every such certificate would be refused with no hint why.
  if x509.sigalg = 4 then
  begin
    sha384.init;
    sha384.updateat(b, x509.tbsat, x509.tbsn);
    sha384.final(ch.digest);
  end
  else
  begin
    sha256.init;
    sha256.updateat(b, x509.tbsat, x509.tbsn);
    sha256.final(ch.digest);
  end;

  sat := x509.sigat;
  sn  := x509.sign;

  if x509.sigalg = 1 then
  begin
    if ch.keyalg <> 1 then begin ch.fail("an RSA signature under a key that is not RSA"); return false; end;
    if not ch.rsakey(ch.keybuf, 0, ch.keyn) then return false;
    if not rsa.verify(b, sat, sn, ch.digest) then begin ch.fail(rsa.err); return false; end;
    return true;
  end;

  if x509.sigalg = 2 then
  begin
    if ch.keyalg <> 2 then begin ch.fail("an ECDSA signature under a key that is not EC"); return false; end;
    if not ch.ecpoint(ch.keybuf, 0, ch.keyn) then return false;
    // the signature is SEQUENCE { INTEGER r, INTEGER s }
    if der.next(b, sat, sat + sn) < 0 then begin ch.fail("the ECDSA signature does not parse"); return false; end;
    if der.tag <> 0x30 then begin ch.fail("the ECDSA signature is not a SEQUENCE"); return false; end;
    inner2 := der.vat; end2 := der.vend;
    if der.next(b, inner2, end2) < 0 then begin ch.fail("no r in the ECDSA signature"); return false; end;
    if der.tag <> 0x02 then begin ch.fail("r is not an INTEGER"); return false; end;
    rat := der.vat; rn := der.vend - der.vat;
    sgat := der.vend;
    if der.next(b, sgat, end2) < 0 then begin ch.fail("no s in the ECDSA signature"); return false; end;
    if der.tag <> 0x02 then begin ch.fail("s is not an INTEGER"); return false; end;
    sgat := der.vat; sgn := der.vend - der.vat;
    if not ch.derint(ch.sr, b, rat, rn) then begin ch.fail("r is out of range"); return false; end;
    if not ch.derint(ch.ss, b, sgat, sgn) then begin ch.fail("s is out of range"); return false; end;
    p256.frombytes(ch.e, ch.digest, 0);
    if not p256.verify(ch.qx, ch.qy, ch.e, ch.sr, ch.ss) then begin ch.fail("the ECDSA signature does not verify"); return false; end;
    return true;
  end;

  if x509.sigalg = 4 then
  begin
    if ch.keyalg <> 4 then begin ch.fail("an ECDSA P-384 signature under a key that is not P-384"); return false; end;
    if not ch.ecpoint384(ch.keybuf, 0, ch.keyn) then return false;
    if der.next(b, sat, sat + sn) < 0 then begin ch.fail("the ECDSA signature does not parse"); return false; end;
    if der.tag <> 0x30 then begin ch.fail("the ECDSA signature is not a SEQUENCE"); return false; end;
    inner2 := der.vat; end2 := der.vend;
    if der.next(b, inner2, end2) < 0 then begin ch.fail("no r in the ECDSA signature"); return false; end;
    if der.tag <> 0x02 then begin ch.fail("r is not an INTEGER"); return false; end;
    rat := der.vat; rn := der.vend - der.vat;
    sgat := der.vend;
    if der.next(b, sgat, end2) < 0 then begin ch.fail("no s in the ECDSA signature"); return false; end;
    if der.tag <> 0x02 then begin ch.fail("s is not an INTEGER"); return false; end;
    sgat := der.vat; sgn := der.vend - der.vat;
    if not ch.derint384(ch.sr4, b, rat, rn) then begin ch.fail("r is out of range"); return false; end;
    if not ch.derint384(ch.ss4, b, sgat, sgn) then begin ch.fail("s is out of range"); return false; end;
    p384.frombytes(ch.e4, ch.digest, 0);
    if not p384.verify(ch.qx4, ch.qy4, ch.e4, ch.sr4, ch.ss4) then begin ch.fail("the ECDSA P-384 signature does not verify"); return false; end;
    return true;
  end;

  if x509.sigalg = 3 then begin ch.fail("RSA-PSS signatures are not supported yet"); return false; end;
  ch.fail("an unrecognised signature algorithm");
  return false;
end;

// ---- the walk ----------------------------------------------------------------------------
//
// ch.verify -- is the chain in b[] trustworthy for `host` at time `now`?
//
// The caller has already split the chain into ch.cnt slices with ch.setcert; that split is
// the caller's job because it differs per protocol (TLS frames them one way, a PEM file
// another).
//
// WHAT IS CHECKED, in this order, and the order matters:
//   1. every certificate parses
//   2. the leaf's name matches the host
//   3. every certificate is inside its validity window
//   4. each certificate is signed by the next one's key
//   5. the last one is signed by a ROOT we hold, and that root is a CA
//
// STEP 5 IS THE ONE THAT MAKES THE REST MEAN ANYTHING. Steps 1-4 are satisfied perfectly by
// a chain an attacker made up from scratch: anyone can generate a key, sign a certificate
// for any name with it, and sign that with another key they also made. Only the root check
// distinguishes that from the real thing.
function ch.setcert(i: int; at: int; n: int): bool;
begin
  if (i < 0) or (i >= CH.MAXCERTS) then begin ch.fail("too many certificates in the chain"); return false; end;
  ch.at[i] := at;
  ch.n[i] := n;
  if i + 1 > ch.cnt then ch.cnt := i + 1;
  return true;
end;

procedure ch.reset;
begin
  ch.cnt := 0;
  ch.err := "";
  ch.bad := false;
end;

// Is the certificate that x509 has just parsed a CA?
function ch.isca: bool;
begin
  return x509.isca;
end;

// Is the certificate at b[bat..] byte for byte the root at ch.roots[rat..]?
//
// COMPARED AS BYTES, not by subject name. Two certificates with the same subject are not
// the same certificate -- that is precisely the substitution a trust store exists to
// prevent.
function ch.samebytes(b: array of char; bat: int; bn: int; rat: int; rn: int): bool;
var i: int;
begin
  if bn <> rn then return false;
  i := 0;
  while i < bn do
  begin
    if b[bat + i] <> ch.roots[rat + i] then return false;
    i := i + 1;
  end;
  return true;
end;

// The issuer name of the certificate being placed, kept while the roots are parsed one by one.
var
  ch.iss:  array[0..1023] of char;
  ch.issn: int;

// Is the subject of the certificate x509 has just parsed (out of b) the name in ch.iss?
function ch.issuedas(b: array of char): bool;
var i: int;
begin
  if x509.subn <> ch.issn then return false;
  i := 0;
  while i < ch.issn do
  begin
    if b[x509.subat + i] <> ch.iss[i] then return false;
    i := i + 1;
  end;
  return true;
end;

function ch.verify(b: array of char; hostb: array of char; hostn: int; now: int): bool;
var i, j, ok: int;
begin
  ch.err := ""; ch.bad := false;
  if ch.cnt <= 0 then begin ch.fail("an empty chain"); return false; end;

  // ---- 2 and 3: the leaf's name and everyone's validity
  if not x509.parse(b, ch.at[0], ch.at[0] + ch.n[0]) then begin ch.fail(x509.err); return false; end;
  if not x509.matchesb(b, hostb, hostn) then begin ch.fail("the certificate is not valid for this host"); return false; end;

  i := 0;
  while i < ch.cnt do
  begin
    if not x509.parse(b, ch.at[i], ch.at[i] + ch.n[i]) then begin ch.fail(x509.err); return false; end;
    // THE CLOCK IS THE CALLER'S. Passing 0 means "do not check", which is for a test with a
    // fixed certificate; anything else must be a real time or the window means nothing.
    if now <> 0 then
    begin
      if now < x509.notbefore then begin ch.fail("a certificate in the chain is not valid yet"); return false; end;
      if now > x509.notafter then begin ch.fail("a certificate in the chain has expired"); return false; end;
    end;
    i := i + 1;
  end;

  // ---- 4: each certificate is signed by the next
  i := 0;
  while i + 1 < ch.cnt do
  begin
    if not x509.parse(b, ch.at[i + 1], ch.at[i + 1] + ch.n[i + 1]) then begin ch.fail(x509.err); return false; end;
    // THE ISSUER MUST BE A CA. Without this, a leaf certificate for any domain -- which
    // anyone can buy -- could sign a certificate for any other domain.
    if not x509.isca then begin ch.fail("a certificate in the chain signs but is not a CA"); return false; end;
    ch.takekeyfrom(b);
    if not ch.checksig(b, ch.at[i], ch.n[i]) then return false;
    i := i + 1;
  end;

  // ---- 5: the top of the chain must be signed by a root we hold
  //
  // TRIED IN TURN, and a failure to verify against one root is not an error -- it just means
  // this is not the right root. Only running out of roots is an error.
  // TRY EVERY CERTIFICATE IN THE CHAIN AS THE LAST LINK, not only the final one.
  //
  // A server may send MORE than the path that matters. cloudflare.com sends four: leaf,
  // intermediate, GTS Root R4, and a cross-signature saying who vouched for R4 in turn.
  // Our store holds the SELF-SIGNED R4, which is a different certificate from the
  // cross-signed one -- same key, different issuer, different bytes. So asking "does a root
  // sign the LAST certificate" answers the wrong question, and comparing bytes does not
  // find it either.
  //
  // WHAT DOES WORK is to try each certificate in turn: for certificate i, is there a root
  // whose key verifies it? The first one that succeeds ends the walk, because everything
  // below i was already verified by the loop above. That also handles the ordinary
  // three-certificate case, where i is simply the last.
  //
  // ONLY THE ROOTS WHOSE SUBJECT IS THE CERTIFICATE'S ISSUER, byte for byte -- and no
  // exhaustive walk when none matches. That is how a path is built (a certificate names its
  // issuer, RFC 5280), and it is what keeps the cost bounded: a system bundle holds well
  // over a hundred roots, and trying every one of them with a full signature check cost
  // seconds of CPU per handshake -- measured 28 s for one self-signed RSA certificate that
  // no root had issued, all of it in the caller's thread. For a server that is a way to
  // be stalled by anyone who connects. The name decides nothing on its own -- the signature
  // is still checked -- it only picks which roots are worth checking. The price: a root
  // whose subject is the same name in a different string encoding than the issuer field
  // is not found. Authorities copy the bytes of their subject into what they issue, so
  // that is not seen in practice.
  i := 0;
  while (i < ch.cnt) and (ok = 0) do
  begin
    if x509.parse(b, ch.at[i], ch.at[i] + ch.n[i]) and (x509.issn <= len(ch.iss)) then
    begin
      ch.issn := x509.issn;
      j := 0;
      while j < ch.issn do begin ch.iss[j] := b[x509.issat + j]; j := j + 1; end;
      j := 0;
      while (j < ch.rootcnt) and (ok = 0) do
      begin
        if x509.parse(ch.roots, ch.rootat[j], ch.rootat[j] + ch.rootn[j]) then
        begin
          if x509.isca and ch.issuedas(ch.roots) then
          begin
            ch.takekeyfrom(ch.roots);
            if ch.checksig(b, ch.at[i], ch.n[i]) then ok := 1;
          end;
        end;
        j := j + 1;
      end;
    end;
    i := i + 1;
  end;
  if ok <> 0 then return true;

  // OR: IS ANY CERTIFICATE IN THE CHAIN ITSELF A ROOT WE HOLD?
  //
  // A server may send the cross-signed root along with the rest -- cloudflare.com does:
  // four certificates, where the third IS a root in the store and the fourth only says who
  // cross-signed it. Walking to the last one and demanding that a root signed IT asks the
  // wrong question, and the answer was "no trusted root signs this chain" for a chain that
  // ends at a trusted root.
  //
  // So a certificate that IS a root ends the walk. Everything below it has already been
  // verified by the loop above; anything above it is decoration.
  i := 0;
  while (i < ch.cnt) and (ok = 0) do
  begin
    j := 0;
    while (j < ch.rootcnt) and (ok = 0) do
    begin
      if ch.samebytes(b, ch.at[i], ch.n[i], ch.rootat[j], ch.rootn[j]) then ok := 1;
      j := j + 1;
    end;
    i := i + 1;
  end;
  if ok <> 0 then return true;

  ch.fail("no trusted root signs this chain");
  return false;
end;

// ---- loading roots from a PEM bundle ------------------------------------------------------
//
// WHY PEM AND NOT DER HERE. Every system keeps its roots as one PEM file --
// /etc/ssl/certs/ca-certificates.crt on Debian and its relatives -- and a tool that cannot
// read it has to ship its own roots, which is worse: they go stale, and the user cannot see
// what is trusted.
//
// THIS IS STILL NOT A SYSTEM STORE BY DEFAULT. The caller names the file. Nothing is
// inherited behind its back; what is trusted is what was asked for.

const
  CH.B64BAD = 0 - 1;

var
  ch.pembuf: array[0..8191] of char;      // one decoded certificate

function ch.b64val(c: char): int;
begin
  if (c >= 'A') and (c <= 'Z') then return ord(c) - ord('A');
  if (c >= 'a') and (c <= 'z') then return ord(c) - ord('a') + 26;
  if (c >= '0') and (c <= '9') then return ord(c) - ord('0') + 52;
  if c = '+' then return 62;
  if c = '/' then return 63;
  if c = '=' then return 0 - 2;            // padding, not a value
  return CH.B64BAD;                        // whitespace and everything else
end;

// Decode base64 from b[at..upto) into ch.pembuf. Returns the length, or -1.
//
// WHITESPACE IS SKIPPED RATHER THAN REFUSED, because PEM is line-wrapped by definition and
// the wrapping is not part of the data.
function ch.b64(b: array of char; at: int; upto: int): int;
var acc, bits, n, v: int;
begin
  acc := 0; bits := 0; n := 0;
  while at < upto do
  begin
    v := ch.b64val(b[at]);
    at := at + 1;
    if v = 0 - 2 then return n;            // '=' ends the data
    if v <> CH.B64BAD then
    begin
      acc := band(acc * 64 + v, 0xFFFFFF);
      bits := bits + 6;
      if bits >= 8 then
      begin
        bits := bits - 8;
        if n >= len(ch.pembuf) then return 0 - 1;
        ch.pembuf[n] := chr(band(acc shr bits, 0xFF));
        n := n + 1;
      end;
    end;
  end;
  return n;
end;

// Does b[at..] start with s?
function ch.starts(b: array of char; at: int; upto: int; s: str): bool;
var i, n: int;
begin
  n := slen(s);
  if at + n > upto then return false;
  i := 0;
  while i < n do
  begin
    if b[at + i] <> schar(s, i) then return false;
    i := i + 1;
  end;
  return true;
end;

// ch.addpem -- add every CERTIFICATE block in a PEM buffer to the trust store.
//
// Returns how many were added. A block that does not decode is SKIPPED rather than fatal:
// a system bundle can contain comments, headers and the occasional oddity, and refusing the
// whole file because of one entry would mean trusting nothing.
function ch.addpem(b: array of char; at: int; upto: int): int;
var added, bodyat, endat: int;
begin
  added := 0;
  while at < upto do
  begin
    if ch.starts(b, at, upto, "-----BEGIN CERTIFICATE-----") then
    begin
      bodyat := at + 27;
      // find the END line
      endat := bodyat;
      while (endat < upto) and (not ch.starts(b, endat, upto, "-----END CERTIFICATE-----")) do
        endat := endat + 1;
      if endat >= upto then return added;       // unterminated: stop, keep what we have
      if ch.b64(b, bodyat, endat) > 0 then
        if ch.addroot(ch.pembuf, 0, ch.b64(b, bodyat, endat)) then added := added + 1;
      at := endat + 25;
    end
    else at := at + 1;
  end;
  return added;
end;

// ---- the roots that ship with the binary --------------------------------------------------
//
// WHY ANY ROOT IS BAKED IN AT ALL, when the whole point of this library is that nothing is
// trusted unless the caller says so. Because a program that fetches its own certificate has
// to trust Let's Encrypt BEFORE it has a certificate, and on a scratch container or a fresh
// VPS there is no system bundle to read. Without these two, "just give it a domain name"
// fails on exactly the machines it is meant for.
//
// SO THE ORDER IS: the system bundle if there is one, these if there is not. That way a
// machine with its own trust decisions keeps them, and a machine with none still works.
// ch.addsystem does that; these are its fallback, not its default.
//
// TWO ROOTS, because Let's Encrypt signs under either: X1 is RSA, X2 is ECDSA. Shipping
// only X1 would work today and fail on a certificate chained to X2, which is the kind of
// intermittent failure nobody traces.
