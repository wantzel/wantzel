  n := io.push(ch.baked, n, "\x0e\x04\x16\x04\x14\x7c\x42\x96\xae\xde\x4b\x48\x3b\xfa\x92\xf8\x9e\x8c\xcf\x6d\x8b\xa9\x72\x37\x95\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x03\x03\x68\x00");
  n := io.push(ch.baked, n, "\x30\x65\x02\x30\x7b\x79\x4e\x46\x50\x84\xc2\x44\x87\x46\x1b\x45\x70\xff\x58\x99\xde\xf4\xfd\xa4\xd2\x55\xa6\x20\x2d\x74\xd6\x34\xbc\x41\xa3\x50\x5f\x01\x27\x56");
  n := io.push(ch.baked, n, "\xb4\xbe\x27\x75\x06\xaf\x12\x2e\x75\x98\x8d\xfc\x02\x31\x00\x8b\xf5\x77\x6c\xd4\xc8\x65\xaa\xe0\x0b\x2c\xee\x14\x9d\x27\x37\xa4\xf9\x53\xa5\x51\xe4\x29\x83\xd7");
  n := io.push(ch.baked, n, "\xf8\x90\x31\x5b\x42\x9f\x0a\xf5\xfe\xae\x00\x68\xe7\x8c\x49\x0f\xb6\x6f\x5b\x5b\x15\xf2\xe7");
  ch.bakedat[1] := ch.bakedn[0];
  ch.bakedready := true;
end;

// ch.addbaked -- put the built-in roots into the store. Returns how many went in.
function ch.addbaked: int;
var i, added: int;
begin
  ch.setupbaked;
  added := 0;
  i := 0;
  while i < 2 do
  begin
    if ch.addroot(ch.baked, ch.bakedat[i], ch.bakedn[i]) then added := added + 1;
    i := i + 1;
  end;
  return added;
end;

// ---- one call that does the right thing ---------------------------------------------------
//
// ch.addsystem -- fill the trust store the way a TOOL should: the machine's own bundle when
// there is one, the built-in roots when there is not.
//
// THE ORDER IS THE POINT. A machine that has made its own trust decisions keeps them -- a
// corporate CA, a removed root, a pinned set. A machine with nothing (a scratch container,
// a fresh VPS, an initramfs) still works instead of failing with "no trusted root", which
// is a message that sends the reader looking at the certificate rather than at the store.
//
// A LIBRARY DOES NOT CALL THIS BY ITSELF. It is here for programs; lib/tls.wz never calls
// it, so including tls.wz does not quietly trust anything. That distinction is the whole
// reason the store starts empty.
//
// Returns how many roots went in, or 0 -- which the caller should treat as fatal rather
// than continue with an empty store.
const CH.BUNDLE = "/etc/ssl/certs/ca-certificates.crt";

var
  ch.bundlebuf: array[0..262143] of char;
  ch.bundlepath: array[0..127] of char;

function ch.addfile(path: str): int;
var fd, n, got: int;
begin
  n := io.push(ch.bundlepath, 0, path);
  ch.bundlepath[n] := chr(0);
  fd := sys3(SYS.open, addr(ch.bundlepath[0]), O_RDONLY, 0);
  if fd < 0 then return 0;
  n := 0;
  while true do
  begin
    got := sys3(SYS.read, fd, addr(ch.bundlebuf[n]), len(ch.bundlebuf) - n);
    if got <= 0 then break;
    n := n + got;
    if n >= len(ch.bundlebuf) then break;
  end;
  sys1(SYS.close, fd);
  if n <= 0 then return 0;
  return ch.addpem(ch.bundlebuf, 0, n);
end;

function ch.addsystem: int;
var n: int;
begin
  n := ch.addfile(CH.BUNDLE);
  // NOT "IF THE FILE IS MISSING" BUT "IF NOTHING CAME OUT OF IT". A bundle that exists and
  // holds nothing we can parse is the same situation as no bundle at all, and it should
  // have the same answer.
  if n <= 0 then n := ch.addbaked;
  return n;
end;
