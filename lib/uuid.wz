// lib/uuid.wz -- UUID version 4 (RFC 9562): 16 random bytes with a version
// and variant stamp, and the canonical 8-4-4-4-12 text form.
//
// A UUID is an array of 16 char; the text form is 36 lowercase characters.

include "rand.wz";

const
  UUID.HEX = "0123456789abcdef";

// fill u[0..15] with a random v4 UUID
procedure uuid.v4(u: array of char);
begin
  if len(u) < 16 then io.fatal("uuid.v4: need 16 bytes");
  rand.bytes(u[0..15]);
  u[6] := chr(bor(band(ord(u[6]), 15), 64));      // version nibble 0100
  u[8] := chr(bor(band(ord(u[8]), 63), 128));     // variant bits 10xx
end;

// write u as xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx at dst[at]; returns the new position
function uuid.text(u: array of char; dst: array of char; at: int): int;
var i, v: int;
begin
  for i := 0 to 15 do
  begin
    if (i = 4) or (i = 6) or (i = 8) or (i = 10) then
    begin
      dst[at] := '-';
      at := at + 1;
    end;
    v := ord(u[i]);
    dst[at]     := schar(UUID.HEX, v shr 4);
    dst[at + 1] := schar(UUID.HEX, band(v, 15));
    at := at + 2;
  end;
  return at;
end;

// value of a hex digit in either case, or -1
function uuid.hexval(c: char): int;
begin
  if (c >= '0') and (c <= '9') then return ord(c) - 48;
  if (c >= 'a') and (c <= 'f') then return ord(c) - 97 + 10;
  if (c >= 'A') and (c <= 'F') then return ord(c) - 65 + 10;
  return -1;
end;

// parse the 36-character form into u[0..15]; false if s is not a UUID
function uuid.parse(s: array of char; u: array of char): bool;
var i, at, hi, lo: int;
begin
  if (len(s) <> 36) or (len(u) < 16) then return false;
  if (s[8] <> '-') or (s[13] <> '-') or (s[18] <> '-') or (s[23] <> '-') then return false;
  at := 0;
  for i := 0 to 15 do
  begin
    if (i = 4) or (i = 6) or (i = 8) or (i = 10) then at := at + 1;
    hi := uuid.hexval(s[at]);
    lo := uuid.hexval(s[at + 1]);
    if (hi < 0) or (lo < 0) then return false;
    u[i] := chr(bor(hi shl 4, lo));
    at := at + 2;
  end;
  return true;
end;
