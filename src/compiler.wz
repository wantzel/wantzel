// compiler.wz -- the whole compiler, WITHOUT a main program.
//
// THIS FILE EXISTS SO THE COMPILER CAN BE A COMPONENT. A source file ending in `end.` is a
// PROGRAM, and the parser allows exactly one of those per compilation -- so including a
// program from another one gives "text after the end of the program". That made the
// compiler usable only as a separate executable, which is where every path problem of
// 16/17-09-2026 came from: finding it on PATH, finding lib/ beside it, and execve
// receiving an empty environment.
//
// Here there is no `begin ... end.`, so anything may include this and add its own. The
// command-line program is src/wantzel.wz, which includes this file and calls wzmain.
//
// WHAT A HOST GETS: compile, which returns 0 or 1 and does NOT exit. What it must know is
// that an ERROR still calls halt() -- from 234 places across 45 mutually recursive
// routines. Threading a return value through all of those is a rewrite of the parser's
// control flow, not a refactor, and the bootstrap fixed point is what would quietly break.
// A host that must survive a failed compile calls compile in a FORK: the child may halt,
// the parent reads its exit code and whatever went to stderr. fork, shared descriptors and
// waiting are measured -- see docs/internals/what-the-system-can-already-do.md.
// wantzel.wz -- the Wantzel compiler, written in Wantzel.
//
// It reads a Wantzel source file and writes a static x86-64 Linux ELF
// executable, using nothing but raw system calls: no assembler, no
// linker, no C library, no external tool of any kind.
//
// Bootstrap:   cc -o bin/wantzel0 bootstrap/boot.c
//              ./bin/wantzel0 src/wantzel.wz bin/wantzel.stage1
//              ./bin/wantzel.stage1 src/wantzel.wz bin/wantzel.stage2   (byte-identical)
//
// This program is a line-by-line counterpart of bootstrap/boot.c; the two must
// keep producing identical output.


const
  // The release this compiler was built from.  It is reported by --version, and
  // tests/toolchain/release_assets.sh checks it against the git tag: a binary that
  // cannot say which version it is cannot be matched to a published checksum.
  // bootstrap/boot.c carries the same string.
  VERSION = "0.2.1";
  SRCMAX  = 67108864;
  CODEMAX = 67108864;
  DATMAX  = 33554432;
  NAMEMAX = 8388608;
  FNPMAX  = 524000;   // the pool of source file names; fnpool holds 524288
  MAXG    = 16384;
  MAXF    = 8192;
  // Buckets for the name index over globals and routines.  A power of two so the
  // modulo is a mask, and four times MAXG so a full table still averages well under
  // one name per bucket.  The index is what keeps a lookup from walking every name:
  // without it, compiling 16,384 globals costs four times what 8,192 cost.
  NHASH   = 65536;
  HMASK   = 65535;
  MAXL    = 2048;
  MAXP    = 10;
  MAXFIX  = 4194304;
  MAXFLD  = 128;
  MAXENUM = 1024;
  MAXS    = 512;
  JSMAX   = 4194304;
  SF_INT   = 1;
  SF_BOOL  = 2;
  SF_TEXT  = 3;     // a view into the parsed buffer
  SF_JSON  = 4;     // any value, as a view
  SF_ENUM  = 5;     // text of (...) -> int
  SF_REAL  = 6;
  SF_TEXTN = 7;     // text[N]: an unescaped copy
  SF_SUB   = 8;     // a nested schema
  TBMAX   = 4096;

  // types
  T_VOID = 0;
  T_INT  = 1;
  T_CHAR = 2;
  T_BOOL = 3;
  T_STR  = 4;
  T_REAL = 5;
  T_REC  = 16;        // record type k has type code T_REC + k
  MAXR   = 1024;
  MAXRF  = 32768;

  // tokens: printable ASCII stands for itself
  TK_EOF    = 0;
  TK_INT    = 1;
  TK_CHR    = 2;
  TK_STR    = 3;
  TK_ID     = 4;
  TK_ASSIGN = 5;
  TK_NE     = 6;
  TK_LE     = 7;
  TK_GE     = 8;
  TK_RANGE  = 9;
  TK_REAL   = 10;

  KW_CONST     = 101;
  KW_VAR       = 102;
  KW_ARRAY     = 103;
  KW_OF        = 104;
  KW_FUNCTION  = 105;
  KW_PROCEDURE = 106;
  KW_FORWARD   = 107;
  KW_BEGIN     = 108;
  KW_END       = 109;
  KW_IF        = 110;
  KW_THEN      = 111;
  KW_ELSE      = 112;
  KW_WHILE     = 113;
  KW_DO        = 114;
  KW_RETURN    = 117;
  KW_BREAK     = 118;
  KW_CONTINUE  = 119;
  KW_DIV       = 120;
  KW_MOD       = 121;
  KW_AND       = 122;
  KW_OR        = 123;
  KW_NOT       = 124;
  KW_SHL       = 125;
  KW_SHR       = 126;
  KW_TRUE      = 127;
  KW_FALSE     = 128;
  KW_INT       = 129;
  KW_CHAR      = 130;
  KW_BOOL      = 131;
  KW_STR       = 132;
  KW_INCLUDE   = 133;
  KW_SCHEMA    = 134;
  KW_RECORD    = 135;
  KW_REAL      = 136;
  KW_TYPE      = 137;
  KW_FOR       = 138;
  KW_TO        = 139;
  KW_DOWNTO    = 140;
  KW_LOCAL     = 141;
  KW_TOOLS     = 142;
  MAXT         = 1024;

  SK_VAR   = 0;
  SK_CONST = 1;

  FX_DATA = 0;
  FX_CALL = 1;
  FX_BSS  = 2;
  FX_BSS32 = 3;
  FX_WSYS  = 4;       // call __wsys, the Windows system call emulation
  FX_WINIT = 5;       // call __winit, builds argv from the command line
  FX_IAT   = 6;       // rip-relative reference to an import table slot
  FX_FADR  = 7;       // the ABSOLUTE address of a routine, as a 64-bit value
  FX_SHIM  = 8;       // the ABSOLUTE address of a code offset (a callback shim)
  FX_SLOT  = 9;       // an import's IAT slot, resolved after every import is known

  VBASE  = 4194304;   // 0x400000
  HDRLEN = 120;       // ELF header; a PE header uses the whole buffer
  HDRMAX = 512;
  // imported DLL functions.  The IAT holds KCOUNT kernel32 thunks, a null,
  // then WCOUNT ws2_32 thunks, a null.  winapi(slot) indexes slot*8 into the
  // IAT, so ws2_32 slots start at KCOUNT+1: the runtime numbers them that way.
  KCOUNT = 27;        // kernel32 functions, IAT slots 0..26
  WCOUNT = 11;        // ws2_32 functions, IAT slots 28..38
  ACOUNT = 1;         // advapi32 functions, IAT slot 40
  UCOUNT = 9;         // user32 functions, IAT slots 42..50
  NIMP   = 48;        // KCOUNT + WCOUNT + ACOUNT + UCOUNT, total names in impname
  // Imports the SOURCE asks for, by name, on top of the built-in ones above. This is what
  // makes a DLL function data instead of a compiler change: winapi("user32.dll",
  // "MessageBoxA", ...) records the pair here and the PE writer emits it like any other.
  MAXEXT  = 256;      // extra (dll, function) pairs a program may name
  MAXEXTD = 16;       // extra DLLs it may name

var
  src:     array[0..SRCMAX-1] of char;   srclen:  int;
  code:    array[0..CODEMAX-1] of char;  codelen: int;
  dat:     array[0..DATMAX-1] of char;   datlen:  int;
  names:   array[0..NAMEMAX-1] of char;  namelen: int;
  tbuf:    array[0..TBMAX-1] of char;
  obuf:    array[0..TBMAX-1] of char;
  nearbuf: array[0..TBMAX-1] of char;   // the nearest declared name, for a typo hint
  nearbufn: int;
  mbuf:    array[0..511] of char;
  nbuf:    array[0..31] of char;
  hdr:     array[0..HDRMAX-1] of char;   hlen:    int;
  outname: array[0..255] of char;        outnamelen: int;
  fnpool:  array[0..524287] of char;     fnplen: int;
  filenam, filelen: array[0..1023] of int;
  nfiles, curfile: int;
  incpos, incend, incline, incfile: array[0..15] of int;
  incdepth, srcend, datmark: int;
  pathbuf: array[0..1023] of char;
  // the name of the type being declared, before it is known whether it is a record or a
  // schema -- see decltypes, which reads it out of tbuf before interning
  tnamebuf: array[0..63] of char;
  // the lib/ path that was tried for a bare include name, kept because the fallback
  // overwrites pathbuf with the relative name -- see failinclude
  triedlib: array[0..1023] of char;
  triedlibn: int;
  libdir:  array[0..1023] of char;      // where the compiler looks for its library
  libdirlen: int;
  // the compiler's own path, read from /proc/self/exe -- see setlibdir, which needs a
  // buffer because readlink does not null-terminate and returns the length instead
  selfbuf: array[0..1023] of char;

  // THE LIBRARY, CARRIED INSIDE THE COMPILER.
  //
  // A compiler that was downloaded rather than built has no lib/ beside it, so
  // include "io.wz" had nowhere to read from and the binary was useless for anything
  // but a program that includes nothing.  The sources now travel with it.
  //
  // The IDENTITY of every file read in: st_dev and st_ino from stat(2).  That makes
  // "lib/io.wz" the same file as "../../elsewhere/lib/io.wz" -- and makes a TEST called
  // kv.wz something DIFFERENT from the library kv.wz, because the inode differs.
  // Comparing on the path string could do neither.
  stbuf:  array[0..143] of char;
  fdev:   array[0..1023] of int;
  fino:   array[0..1023] of int;

  gnam, gkind, gtyp, gval: array[0..MAXG-1] of int;
  // extra imports, filled while translating; see MAXEXT
  extdll:  array[0..MAXEXT-1] of int;    // which extra DLL this function belongs to
  extfn:   array[0..MAXEXT-1] of int;    // offset into extnam of the function name
  extdnam: array[0..MAXEXTD-1] of int;   // offset into extnam of the DLL name
  extnam:  array[0..16383] of char;      // the names themselves, each NUL-terminated
  next_, nextd, extnamlen: int;
  extlast: int;                 // the import index extslot last used, or -1 for a built-in
  garr, glo, ghi:          array[0..MAXG-1] of int;
  ngl, bsslen: int;

  // The name index: for each bucket the newest entry in it, and for each entry the
  // one before it in the same bucket.  -1 ends a chain.  Globals and routines have
  // their own index because they are looked up separately.  Entries are only ever
  // added -- ngl and nfn never shrink -- so a chain never has to be unlinked.
  ghead: array[0..NHASH-1] of int;
  gnext: array[0..MAXG-1] of int;
  // ---- VISIBILITY PER FILE ------------------------------------------------------------
  //
  // -1 means PUBLIC and that is the default, so all existing source keeps working without
  // a single edit. A file index means the name is visible only in THAT file -- written as
  // `local var x: int;`.
  //
  // WHY A FILE INDEX AND NOT A BOOLEAN: a boolean would say "this is local" but not local
  // to WHAT, so a second file could still see it. The number is the answer.
  gfile: array[0..MAXG-1] of int;
  // Is there a `local` in front of the declaration being read?
  declloc: int;
  fhead: array[0..NHASH-1] of int;
  fnext: array[0..MAXF-1] of int;
  hashed: bool;                    // are the buckets initialised to -1 yet?

  fnam, frtyp, fnpar, fadr, fdef, fline, fnreg: array[0..MAXF-1] of int;
  ffile: array[0..MAXF-1] of int;      // the file a forward declaration stood in
  // Visibility, separate from ffile: -1 is public and that is the default.
  fvis:  array[0..MAXF-1] of int;
  fptyp, fparr: array[0..MAXF*MAXP-1] of int;
  nfn: int;

  // record types and their fields
  rtnam, rtsize, rtf0, rtnf: array[0..MAXR-1] of int;
  nrt: int;
  fdnam, fdtyp, fdoff, fdarr, fdlo, fdhi: array[0..MAXRF-1] of int;
  nfd: int;
  // the field path split off a dotted name, and what a designator resolved to
  fpath: array[0..TBMAX-1] of char;
  fplen: int;
  refisarr, refet, reflo, refhi, refdyn, refidx, spli, spgi, allowslice: int;

  lnam, ltyp, loff, larr, llo, lhi, lkind: array[0..MAXL-1] of int;
  nloc, frame, curfn, curret: int;

  fxoff, fxkind, fxval: array[0..MAXFIX-1] of int;
  nfx: int;

  brkfix, cntfix: array[0..255] of int;
  nbrk, brkbase, ncnt, cntbase: int;

  schname: array[0..63] of char;
  sfld:    array[0..MAXFLD * 64 - 1] of char;
  sfjson:  array[0..MAXFLD * 64 - 1] of char;
  sftype, sfopt, sfe0, sfen: array[0..MAXFLD - 1] of int;
  sfarr, sfcount, sftlen, sfsub, sfdesc: array[0..MAXFLD - 1] of int;
  nfld: int;
  senum: array[0..MAXENUM * 64 - 1] of char;
  nenum: int;
  scnam: array[0..MAXS * 64 - 1] of char;     // declared schemas, for nesting
  scjs:  array[0..MAXS - 1] of int;           // data offset of each schema's JSON Schema text
  nsc: int;
  jsbuf: array[0..JSMAX - 1] of char;
  jslen: int;
  tlnam: array[0..MAXT * 64 - 1] of char;
  tlin, tlout, tldesc, tlro, tlid, tldes: array[0..MAXT - 1] of int;
  // Where the tool was DECLARED, in the real source.  The forward declarations come out
  // of the generated <tools> text, so without this an undefined handler is reported at a
  // line of a file the writer cannot open.
  tlline, tlfile: array[0..MAXT - 1] of int;
  ntl, tlseen: int;
  tlfwdfile: int;                     // the pseudo-file id of the generated <tools> text
  tlfwdn: int;                        // forwards seen in it, in the order gentools emits

  tmpnam: array[0..63] of int;
  ptarr, ptlo, pthi: int;

  tok, tval, line, pos, mlen: int;
  // Every runtime check used to carry its own complete sentence, so "runtime error: array
  // index out of range" was stored once per check rather than once. In a GUI program that
  // came to a quarter of the binary. The fixed part is now stored once per KIND of check and
  // the trap routine writes it before the part that differs.
  tphoff: array[0..15] of int;       // data offset of each fixed heading
  tphlen: array[0..15] of int;
  tphtxt: array[0..15] of str;       // the message text that heading belongs to
  ntph: int;
  trapaddr, argaddr, scanaddr, mainaddr, mainpatch, framepatch: int;
  winmode, sysrawaddr, entryoff: int;
  tgiven: bool;                       // was --target= given? the output name never decides
  mi: int;
  lvkind, lvimm, lvoff, lvtype, lvpos, lvfx: int;
  elkind, eloff, eltype: int;
  rlit: array[0..0] of real;            // scratch for the bits of a real literal

// ------------------------------------------------------------------
// byte access and system calls
// ------------------------------------------------------------------

function sch(s: str; i: int): int;
begin
  if i >= slen(s) then return 0;
  return ord(schar(s, i));
end;

function srcb(i: int): int;
begin
  return ord(src[i]);
end;

function tbufb(i: int): int;
begin
  return ord(tbuf[i]);
end;

function namesb(i: int): int;
begin
  return ord(names[i]);
end;

procedure wrbuf(fd: int; a: int; n: int);
begin
  sys3(1, fd, a, n);
end;

procedure wrs(fd: int; s: str);
begin
  sys3(1, fd, sadr(s), slen(s));
end;

function rdbuf(fd: int; a: int; n: int): int;
begin
  return sys3(0, fd, a, n);
end;

// stat(2): fills stbuf.  Offset 0 is st_dev, offset 8 st_ino -- together they identify
// a file UNIQUELY, whichever path you reach it by.  See lib/fs.wz, which reads the same
// struct.
function stt(a: int): int;
begin
  return sys2(4, a, addr(stbuf[0]));
end;

function opn(a: int; fl: int; mode: int): int;
begin
  return sys3(2, a, fl, mode);
end;

procedure cls(fd: int);
begin
  sys1(3, fd);
end;

procedure chm(a: int; m: int);
begin
  sys2(90, a, m);
end;

procedure wrname(fd: int);
begin
  wrbuf(fd, addr(fnpool[filenam[curfile]]), filelen[curfile]);
end;

// the name of file fi, which is not necessarily the one being read now
procedure wrfile(fd: int; fi: int);
begin
  wrbuf(fd, addr(fnpool[filenam[fi]]), filelen[fi]);
end;

// an interned name, from the pool; they are NUL-terminated
procedure wrnam(fd: int; off: int);
var n: int;
begin
  n := 0;
  while namesb(off + n) <> 0 do n := n + 1;
  wrbuf(fd, addr(names[off]), n);
end;

function numstr(v: int): int;
var n, i, j: int;
    c: char;
begin
  n := 0;
  if v = 0 then
  begin
    nbuf[0] := '0';
    return 1;
  end;
  if v < 0 then
  begin
    nbuf[0] := '-';
    v := 0 - v;
    n := 1;
  end;
  i := n;
  while v > 0 do
  begin
    nbuf[n] := chr(48 + (v mod 10));
    v := v div 10;
    n := n + 1;
  end;
  j := n - 1;
  while i < j do
  begin
    c := nbuf[i]; nbuf[i] := nbuf[j]; nbuf[j] := c;
    i := i + 1; j := j - 1;
  end;
  return n;
end;

procedure wrnum(fd: int; v: int);
var n: int;
begin
  n := numstr(v);
  wrbuf(fd, addr(nbuf[0]), n);
end;

procedure fail(m: str);
begin
  wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
  wrs(2, ": "); wrs(2, m); wrs(2, "\n");
  halt(1);
end;

// failinclude -- an include that could not be opened, NAMING THE PATH IT TRIED.
//
// "cannot open the included file" on its own is the same class of unhelpfulness as the
// bare "undeclared identifier": the reader has the line, but a line can hold one include
// and the path that was actually attempted is not what is written there -- a bare library
// name is resolved against <compiler dir>/lib/ first.
//
// This matters most for exactly the case that shipped broken in 0.1.0: someone who
// unpacked only the binary, without lib/ beside it. Without the path in the message they
// go looking in their own directory for a file the compiler was expecting somewhere else.
procedure failinclude;
var n: int;
begin
  wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
  wrs(2, ": cannot open the included file: ");
  n := 0;
  while pathbuf[n] <> chr(0) do n := n + 1;
  wrbuf(2, addr(pathbuf[0]), n);
  // A BARE LIBRARY NAME WAS LOOKED FOR IN lib/ FIRST, and that is the path worth naming:
  // for the case this message exists for -- a binary unpacked without lib/ beside it --
  // the relative name above is what the source already says and tells the reader nothing.
  if triedlibn > 0 then
  begin
    wrs(2, "\n  looked in the library first: ");
    wrbuf(2, addr(triedlib[0]), triedlibn);
  end;
  wrs(2, "\n");
  halt(1);
end;

// Does the name just read contain a capital?  Then the collision the caller is about to
// report is very probably about CASE and not about the name itself.
function hascap: bool;
var i: int;
begin
  i := 0;
  while obuf[i] <> chr(0) do
  begin
    if (ord(obuf[i]) >= 65) and (ord(obuf[i]) <= 90) then return true;
    i := i + 1;
  end;
  return false;
end;

// "name already used ...", and when the name carries capitals, say that names are
// case-insensitive and show BOTH spellings.
//
// Without that second half the message reads as though the name itself were taken, so
// the writer picks a different name instead of understanding that STORE.SET and
// store.set ARE the same name. The result is in the sources: STORE.OPSET and
// CURVE.NDAYS exist only to dodge a collision nobody explained. Ten of the fifteen
// namespace errors in the error log are this case.
procedure failtaken(m: str);
var i: int;
begin
  wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
  wrs(2, ": "); wrs(2, m);
  if hascap then
  begin
    wrs(2, "; names are case-insensitive, so ");
    i := 0;
    while obuf[i] <> chr(0) do i := i + 1;
    wrbuf(2, addr(obuf[0]), i);
    wrs(2, " is the same name as ");
    i := 0;
    while tbuf[i] <> chr(0) do i := i + 1;
    wrbuf(2, addr(tbuf[0]), i);
  end;
  wrs(2, "\n");
  halt(1);
end;

// ------------------------------------------------------------------
// lexer
// ------------------------------------------------------------------

function isal(c: int): bool;
begin
  return ((c >= 97) and (c <= 122)) or ((c >= 65) and (c <= 90)) or (c = 95);
end;

function isdg(c: int): bool;
begin
  return (c >= 48) and (c <= 57);
end;

function ishx(c: int): bool;
begin
  return isdg(c) or ((c >= 97) and (c <= 102)) or ((c >= 65) and (c <= 70));
end;

function lower(c: int): int;
begin
  if (c >= 65) and (c <= 90) then return c + 32;
  return c;
end;

function eqt(s: str): bool;
var i: int;
begin
  i := 0;
  while true do
  begin
    if tbufb(i) <> sch(s, i) then return false;
    if tbufb(i) = 0 then return true;
    i := i + 1;
  end;
  return false;
end;

function keyword: int;
var c: int;
begin
  // Dispatch on the first character before comparing.  Every identifier used to be
  // compared against all 43 keywords in turn, so a name that is not a keyword -- which
  // is nearly all of them -- paid for the whole list.  One comparison on the first byte
  // cuts that to the handful of keywords that can still match.
  c := tbufb(0);
  if c = 97 then
  begin
    if eqt("array")     then return KW_ARRAY;
    if eqt("and")       then return KW_AND;
  end;
  if c = 98 then
  begin
    if eqt("begin")     then return KW_BEGIN;
    if eqt("break")     then return KW_BREAK;
    if eqt("bool")      then return KW_BOOL;
  end;
  if c = 99 then
  begin
    if eqt("const")     then return KW_CONST;
    if eqt("continue")  then return KW_CONTINUE;
    if eqt("char")      then return KW_CHAR;
  end;
  if c = 100 then
  begin
    if eqt("do")        then return KW_DO;
    if eqt("div")       then return KW_DIV;
    if eqt("downto")    then return KW_DOWNTO;
  end;
  if c = 101 then
  begin
    if eqt("end")       then return KW_END;
    if eqt("else")      then return KW_ELSE;
  end;
  if c = 102 then
  begin
    if eqt("function")  then return KW_FUNCTION;
    if eqt("forward")   then return KW_FORWARD;
    if eqt("false")     then return KW_FALSE;
    if eqt("for")       then return KW_FOR;
  end;
  if c = 105 then
  begin
    if eqt("if")        then return KW_IF;
    if eqt("int")       then return KW_INT;
    if eqt("include")   then return KW_INCLUDE;
  end;
  if c = 108 then
  begin
    if eqt("local")     then return KW_LOCAL;
  end;
  if c = 109 then
  begin
    if eqt("mod")       then return KW_MOD;
  end;
  if c = 110 then
  begin
    if eqt("not")       then return KW_NOT;
  end;
  if c = 111 then
  begin
    if eqt("of")        then return KW_OF;
    if eqt("or")        then return KW_OR;
  end;
  if c = 112 then
  begin
    if eqt("procedure") then return KW_PROCEDURE;
  end;
  if c = 114 then
  begin
    if eqt("return")    then return KW_RETURN;
    if eqt("record")    then return KW_RECORD;
    if eqt("real")      then return KW_REAL;
  end;
  if c = 115 then
  begin
    if eqt("shl")       then return KW_SHL;
    if eqt("shr")       then return KW_SHR;
    if eqt("str")       then return KW_STR;
    if eqt("schema")    then return KW_SCHEMA;
  end;
  if c = 116 then
  begin
    if eqt("then")      then return KW_THEN;
    if eqt("true")      then return KW_TRUE;
    if eqt("type")      then return KW_TYPE;
    if eqt("to")        then return KW_TO;
    if eqt("tools")     then return KW_TOOLS;
  end;
  if c = 117 then
  begin
  end;
  if c = 118 then
  begin
    if eqt("var")       then return KW_VAR;
  end;
  if c = 119 then
  begin
    if eqt("while")     then return KW_WHILE;
  end;
  return TK_ID;
end;

// The value of one hex digit, or -1.
function hexdig(c: int): int;
begin
  if (c >= 48) and (c <= 57) then return c - 48;
  if (c >= 97) and (c <= 102) then return c - 87;
  if (c >= 65) and (c <= 70) then return c - 55;
  return -1;
end;

// The byte an escape stands for.  `pos` is on the character AFTER the backslash and the
// caller advances past it; \xHH reads two more here and advances past those itself.
//
// EXACTLY TWO HEX DIGITS, never a variable number.  That is where C put its own trap:
// "\x41BC" is one character there, not three, because the escape keeps eating digits.
// A generator writing bytes cannot then place a literal hex character after an escaped
// byte without changing what it wrote.  Two digits always means one byte.
function escape(c: int): int;
var h, l: int;
begin
  if c = 110 then return 10;
  if c = 116 then return 9;
  if c = 114 then return 13;
  if c = 48  then return 0;
  if c = 92  then return 92;
  if c = 39  then return 39;
  if c = 34  then return 34;
  if (c = 120) or (c = 88) then
  begin
    if pos + 2 >= srcend then fail("a hex escape needs two digits");
    h := hexdig(srcb(pos + 1));
    l := hexdig(srcb(pos + 2));
    if (h < 0) or (l < 0) then fail("a hex escape needs exactly two hex digits, as in x41 or xff after a backslash");
    pos := pos + 2;
    return h * 16 + l;
  end;
  fail("unknown escape sequence");
  return 0;
end;

// One byte into the data segment, with the room checked BEFORE the write.
//
// The order matters: checking afterwards means the byte that does not fit has
// already been stored, so a source that fills the segment stops with a bounds
// trap naming this compiler instead of a compile error naming the source.  Every
// write into dat goes through here for that reason.
procedure dput(b: int);
begin
  if datlen >= DATMAX then fail("data segment overflow: the source is too large");
  dat[datlen] := chr(band(b, 255));
  datlen := datlen + 1;
end;

function datstr(usem: int; n: int): int;
var o, i: int;
begin
  datmark := datlen;
  while (datlen mod 8) <> 0 do dput(0);
  i := 0;
  while i < 8 do
  begin
    dput(band(n shr (i * 8), 255));
    i := i + 1;
  end;
  o := datlen;
  i := 0;
  while i < n do
  begin
    if usem <> 0 then dput(ord(mbuf[i])) else dput(ord(tbuf[i]));
    i := i + 1;
  end;
  dput(0);
  return o;
end;

// The IEEE-754 bits of m * 10^ex.  Powers of ten up to 1e22 are exact in a
// double, so a literal with at most 18 significant digits rounds once.
function realbits(m: int; ex: int): int;
var p, ten, d: real;
    k, i, v: int;
begin
  p := real(1);
  ten := real(10);
  k := ex;
  if k < 0 then k := 0 - k;
  while k > 0 do
  begin
    p := p * ten;
    k := k - 1;
  end;
  d := real(m);
  if ex < 0 then d := d / p else d := d * p;
  rlit[0] := d;
  v := 0;
  i := 7;
  while i >= 0 do
  begin
    v := bor(v shl 8, peek(addr(rlit[0]) + i));
    i := i - 1;
  end;
  return v;
end;

procedure next;
var c, d, n, m, nd, ex, isreal, esign, ev: int;
begin
  while true do
  begin
    if pos >= srcend then
    begin
      if incdepth = 0 then
      begin
        tok := TK_EOF;
        return;
      end;
      incdepth := incdepth - 1;
      pos := incpos[incdepth]; srcend := incend[incdepth];
      line := incline[incdepth]; curfile := incfile[incdepth];
      continue;
    end;
    c := srcb(pos);
    if c = 10 then
    begin
      line := line + 1;
      pos := pos + 1;
    end
    else if (c = 32) or (c = 9) or (c = 13) then pos := pos + 1
    // A brace is not a comment.  { } used to open one and it ended at the FIRST
    // closing brace, so a brace inside the text -- a JSON example, an f-string,
    // the words "default {}" -- ended the comment early and the rest of the
    // sentence was read as code.  The error then landed far from its cause, on a
    // line that looked correct.  The message says what to write instead, because
    // the source that hits this is usually older than the change.
    else if c = 123 then fail("{ } is not a comment; use // to the end of the line")
    else if (c = 47) and (pos + 1 < srcend) and (srcb(pos + 1) = 47) then
    begin
      while (pos < srcend) and (srcb(pos) <> 10) do pos := pos + 1;
    end
    else break;
  end;
  c := srcb(pos);
  if isal(c) then
  begin
    n := 0;
    while (pos < srcend) and (isal(srcb(pos)) or isdg(srcb(pos))) do
    begin
      if n >= TBMAX - 1 then fail("identifier too long");
      obuf[n] := chr(srcb(pos));
      tbuf[n] := chr(lower(srcb(pos)));
      n := n + 1;
      pos := pos + 1;
    end;
    tbuf[n] := chr(0);
    obuf[n] := chr(0);
    tok := keyword;
    // a dotted name is one identifier: net.socket, Rpc.method
    if tok = TK_ID then
    begin
      while (pos + 1 < srcend) and (srcb(pos) = 46) and (isal(srcb(pos + 1)) or isdg(srcb(pos + 1))) do
      begin
        if n >= TBMAX - 2 then fail("identifier too long");
        tbuf[n] := '.'; obuf[n] := '.'; n := n + 1; pos := pos + 1;
        while (pos < srcend) and (isal(srcb(pos)) or isdg(srcb(pos))) do
        begin
          if n >= TBMAX - 1 then fail("identifier too long");
          obuf[n] := chr(srcb(pos));
          tbuf[n] := chr(lower(srcb(pos)));
          n := n + 1; pos := pos + 1;
        end;
      end;
      tbuf[n] := chr(0);
      obuf[n] := chr(0);
    end;
    return;
  end;
  if isdg(c) then
  begin
    tval := 0;
    if (c = 48) and (pos + 1 < srcend) and (lower(srcb(pos + 1)) = 120) then
    begin
      pos := pos + 2;
      if not ishx(srcb(pos)) then fail("malformed hex literal");
      while (pos < srcend) and ishx(srcb(pos)) do
      begin
        d := lower(srcb(pos));
        if d >= 97 then d := d - 87 else d := d - 48;
        tval := tval * 16 + d;
        pos := pos + 1;
      end;
    end
    else
    begin
      m := 0; nd := 0; ex := 0;
      while (pos < srcend) and isdg(srcb(pos)) do
      begin
        d := srcb(pos) - 48;
        tval := tval * 10 + d;
        if nd < 18 then
        begin
          m := m * 10 + d;
          if m <> 0 then nd := nd + 1;
        end
        else ex := ex + 1;
        pos := pos + 1;
      end;
      isreal := 0;
      if (pos + 1 < srcend) and (srcb(pos) = 46) and isdg(srcb(pos + 1)) then
      begin
        isreal := 1;
        pos := pos + 1;
        while (pos < srcend) and isdg(srcb(pos)) do
        begin
          d := srcb(pos) - 48;
          if nd < 18 then
          begin
            m := m * 10 + d;
            if m <> 0 then nd := nd + 1;
            ex := ex - 1;
          end;
          pos := pos + 1;
        end;
      end;
      if (pos + 1 < srcend) and (lower(srcb(pos)) = 101)
         and (isdg(srcb(pos + 1)) or (((srcb(pos + 1) = 43) or (srcb(pos + 1) = 45)) and (pos + 2 < srcend) and isdg(srcb(pos + 2)))) then
      begin
        isreal := 1;
        pos := pos + 1;
        esign := 1;
        if srcb(pos) = 45 then
        begin
          esign := 0 - 1;
          pos := pos + 1;
        end
        else if srcb(pos) = 43 then pos := pos + 1;
        ev := 0;
        while (pos < srcend) and isdg(srcb(pos)) do
        begin
          if ev < 100000 then ev := ev * 10 + (srcb(pos) - 48);
          pos := pos + 1;
        end;
        ex := ex + esign * ev;
      end;
      if isreal <> 0 then
      begin
        tval := realbits(m, ex);
        tok := TK_REAL;
        return;
      end;
    end;
    tok := TK_INT;
    return;
  end;
  if c = 39 then
  begin
    pos := pos + 1;
    if pos >= srcend then fail("unterminated char literal");
    d := srcb(pos);
    pos := pos + 1;
    if d = 92 then
    begin
      d := escape(srcb(pos));
      pos := pos + 1;
    end;
    if (pos >= srcend) or (srcb(pos) <> 39) then fail("unterminated char literal");
    pos := pos + 1;
    tval := d;
    tok := TK_CHR;
    return;
  end;
  if c = 34 then
  begin
    pos := pos + 1;
    n := 0;
    while true do
    begin
      if pos >= srcend then fail("unterminated string literal");
      d := srcb(pos);
      if d = 34 then
      begin
        pos := pos + 1;
        break;
      end;
      if d = 10 then fail("newline in string literal");
      if d = 92 then
      begin
        pos := pos + 1;
        d := escape(srcb(pos));
      end;
      if n >= TBMAX - 1 then fail("string literal too long");
      tbuf[n] := chr(d);
      n := n + 1;
      pos := pos + 1;
    end;
    tval := datstr(0, n);
    tok := TK_STR;
    return;
  end;
  pos := pos + 1;
  if (c = 58) and (pos < srcend) and (srcb(pos) = 61) then
  begin
    pos := pos + 1; tok := TK_ASSIGN; return;
  end;
  if (c = 60) and (pos < srcend) and (srcb(pos) = 62) then
  begin
    pos := pos + 1; tok := TK_NE; return;
  end;
  if (c = 60) and (pos < srcend) and (srcb(pos) = 61) then
  begin
    pos := pos + 1; tok := TK_LE; return;
  end;
  if (c = 62) and (pos < srcend) and (srcb(pos) = 61) then
  begin
    pos := pos + 1; tok := TK_GE; return;
  end;
  if (c = 46) and (pos < srcend) and (srcb(pos) = 46) then
  begin
    pos := pos + 1; tok := TK_RANGE; return;
  end;
  if (c = 40) or (c = 41) or (c = 91) or (c = 93) or (c = 44) or (c = 59)
     or (c = 58) or (c = 46) or (c = 43) or (c = 45) or (c = 42) or (c = 47) or (c = 61)
     or (c = 60) or (c = 62) or (c = 63) then
  begin
    tok := c;
    return;
  end;
  fail("illegal character");
end;

procedure expect(t: int; what: str);
begin
  if tok <> t then fail(what);
  next;
end;

// ------------------------------------------------------------------
// source files and includes
// ------------------------------------------------------------------

// eight bytes little-endian from stbuf -- st_dev at 0, st_ino at 8
function stfield(at: int): int;
var i, v: int;
begin
  v := 0;
  i := 7;
  while i >= 0 do
  begin
    v := v * 256 + ord(stbuf[at + i]);
    i := i - 1;
  end;
  return v;
end;

function addfile: int;
var i: int;
begin
  if nfiles >= 1024 then fail("too many source files");
  filenam[nfiles] := fnplen;
  i := 0;
  while pathbuf[i] <> chr(0) do
  begin
    if fnplen >= FNPMAX then fail("source file name pool overflow: too many or too long source paths");
    fnpool[fnplen] := pathbuf[i];
    fnplen := fnplen + 1;
    i := i + 1;
  end;
  filelen[nfiles] := i;
  // keep this file's identity, so samefile can compare it
  fdev[nfiles] := 0; fino[nfiles] := 0;
  if stt(addr(pathbuf[0])) >= 0 then
  begin
    fdev[nfiles] := stfield(0);
    fino[nfiles] := stfield(8);
  end;
  if fnplen >= FNPMAX then fail("source file name pool overflow: too many or too long source paths");
  fnpool[fnplen] := chr(0);
  fnplen := fnplen + 1;
  nfiles := nfiles + 1;
  return nfiles - 1;
end;

// Clean up pathbuf: "a/./b" becomes "a/b" and "a/x/../b" becomes "a/b".
//
// Why this is REQUIRED and not merely tidy: the de-duplication below compares PATH
// STRINGS.  Without cleaning, "lib/io.wz" is a different file from
// "tests/lib/../../lib/io.wz", and then io.wz comes in twice -- with "duplicate
// declaration" on a line in a THIRD file, which leads nobody to the real cause.  Since
// there is a search path this happens by itself: the same library comes in through a
// bare name and through a relative path.
procedure normpath;
var i, n, w, seg: int;
begin
  n := 0;
  while pathbuf[n] <> chr(0) do n := n + 1;
  w := 0;
  i := 0;
  while i < n do
  begin
    // skip "./"
    if (pathbuf[i] = '.') and (i + 1 < n) and (pathbuf[i + 1] = '/')
       and ((w = 0) or (pathbuf[w - 1] = '/')) then
    begin
      i := i + 2;
    end
    else if (pathbuf[i] = '.') and (i + 2 < n) and (pathbuf[i + 1] = '.')
            and (pathbuf[i + 2] = '/') and ((w = 0) or (pathbuf[w - 1] = '/')) then
    begin
      // "..": drop the previous segment, but only if there is one and it is not ".."
      seg := 0;
      if w >= 2 then
      begin
        seg := w - 1;
        while (seg > 0) and (pathbuf[seg - 1] <> '/') do seg := seg - 1;
        if (w - seg = 3) and (pathbuf[seg] = '.') and (pathbuf[seg + 1] = '.') then seg := 0;
      end;
      if seg > 0 then begin w := seg; i := i + 3; end
      else
      begin
        pathbuf[w] := pathbuf[i]; w := w + 1; i := i + 1;
      end;
    end
    else
    begin
      pathbuf[w] := pathbuf[i]; w := w + 1; i := i + 1;
    end;
  end;
  pathbuf[w] := chr(0);
end;

// The same FILE NAME as file fi, but through a different path?
//
// This is not a correctness check but a BETTER ERROR MESSAGE.  If lib/io.wz comes in as
// "lib/io.wz" and as "../../elsewhere/lib/io.wz", those are two files as far as the
// de-duplication is concerned, and you get "duplicate declaration" on a line in io.wz
// itself -- a place that has nothing to do with the cause and where nobody finds the real
// error.  With this check the compiler says what is actually going on.
function samebase(fi: int): bool;
var a, b, na, nb: int;
begin
  // find the last '/' in both names, and compare from there
  na := 0; a := 0;
  while fnpool[filenam[fi] + a] <> chr(0) do
  begin
    if fnpool[filenam[fi] + a] = '/' then na := a + 1;
    a := a + 1;
  end;
  nb := 0; b := 0;
  while pathbuf[b] <> chr(0) do
  begin
    if pathbuf[b] = '/' then nb := b + 1;
    b := b + 1;
  end;
  a := na; b := nb;
  while true do
  begin
    if fnpool[filenam[fi] + a] <> pathbuf[b] then return false;
    if pathbuf[b] = chr(0) then return true;
    a := a + 1; b := b + 1;
  end;
  return false;
end;

// Is pathbuf THE SAME FILE as file fi?
//
// On IDENTITY (st_dev + st_ino from stat(2)) and not on the path string.  That is the
// whole difference: "lib/io.wz" and "../../elsewhere/lib/io.wz" are then the same file,
// while a test called kv.wz is something DIFFERENT from the library kv.wz.  With a string
// comparison the first was a double include ("duplicate declaration" in a third file) and
// the second a file that includes itself -- both errors that point nowhere.
//
// If the file cannot be stat'ed it falls back to the path string; the behaviour is then
// the same as before and no worse.
function samefile(fi: int): bool;
var i: int;
begin
  if stt(addr(pathbuf[0])) >= 0 then
    if (fdev[fi] <> 0) or (fino[fi] <> 0) then
      return (fdev[fi] = stfield(0)) and (fino[fi] = stfield(8));
  i := 0;
  while true do
  begin
    if fnpool[filenam[fi] + i] <> pathbuf[i] then return false;
    if pathbuf[i] = chr(0) then return true;
    i := i + 1;
  end;
  return false;
end;

function fileexists: bool;
var fd: int;
begin
  fd := opn(addr(pathbuf[0]), 0, 0);
  if fd < 0 then return false;
  cls(fd);
  return true;
end;

function readfile: int;
var fd, n, start: int;
begin
  fd := opn(addr(pathbuf[0]), 0, 0);
  if fd < 0 then return -1;
  start := srclen;
  while true do
  begin
    if srclen + 65536 > SRCMAX then begin cls(fd); fail("source is too large"); end;
    n := rdbuf(fd, addr(src[srclen]), 65536);
    if n <= 0 then break;
    srclen := srclen + n;
  end;
  cls(fd);
  return srclen - start;
end;

// The DIRECTORY THE COMPILER ITSELF IS IN, plus "/lib/" -- the search path for includes
// that are not found relatively.
//
// Why this exists: without a search path every source has to spell out the exact relative
// path to the library ("../../lib/io.wz"), and that breaks as soon as a file moves or the
// library sits somewhere else.  Worse: the de-duplication below works on the PATH STRING,
// so the same file along two spellings comes in TWICE and gives "duplicate declaration"
// in a third file.  C solves this with -I plus a system path; this is the same solution,
// with the compiler itself as the anchor.
//
// THE ANCHOR IS THE EXECUTABLE ITSELF, read from /proc/self/exe -- not argv[0].
//
// argv[0] is what the CALLER chose to say, and that is not always a path.  Invoked through
// PATH the way an editor or an agent starts it, argv[0] is the bare word "wantzel" with no
// '/' in it at all: cut stays 0, the search path collapses to a RELATIVE "lib/", and
// include "io.wz" then depends on the working directory.  Measured on 17-09-2026 in a
// perfectly good installation: the same compile succeeded by absolute path and failed
// through PATH with "cannot open the included file: io.wz".
//
// readlink("/proc/self/exe") answers where this process actually came from, whatever it was
// called, and it needs no cooperation from the caller.  argv[0] stays as the fallback for
// the case readlink cannot answer (no /proc), because a wrong-but-usual answer beats none.
//
// If wantzel sits in /x/y/wantzel the search path is /x/y/lib/; that works for a compiler
// built next to its lib and just as well for an installed binary.
procedure setlibdir;
var i, cut, n: int;
begin
  libdirlen := 0;
  i := 0;
  cut := 0;
  // /proc/self/exe first; on success selfbuf holds an absolute path with no trailing null
  n := sys3(89, sadr("/proc/self/exe"), addr(selfbuf[0]), 1023);
  if n > 0 then
  begin
    i := 0;
    while i < n do
    begin
      if selfbuf[i] = '/' then cut := i + 1;
      i := i + 1;
    end;
    i := 0;
    while i < cut do
    begin
      libdir[i] := selfbuf[i];
      i := i + 1;
    end;
  end
  else
  begin
    while (argch(0, i) <> chr(0)) and (i < 900) do
    begin
      if argch(0, i) = '/' then cut := i + 1;
      i := i + 1;
    end;
    i := 0;
    while i < cut do
    begin
      libdir[i] := argch(0, i);
      i := i + 1;
    end;
  end;
  libdirlen := cut;
  // If the compiler sits in .../bin/, its library belongs in .../lib/ beside it and not
  // in .../bin/lib/.  That is the usual layout (prefix/bin next to prefix/lib), and it is
  // also what happens here now that build.sh writes to bin/.  Recognised by the last
  // directory name: if the path ends in "bin/", take that off.
  if libdirlen >= 4 then
    if (libdir[libdirlen - 4] = 'b') and (libdir[libdirlen - 3] = 'i')
       and (libdir[libdirlen - 2] = 'n') and (libdir[libdirlen - 1] = '/') then
      libdirlen := libdirlen - 4;
  libdir[libdirlen] := 'l'; libdir[libdirlen + 1] := 'i';
  libdir[libdirlen + 2] := 'b'; libdir[libdirlen + 3] := '/';
  libdirlen := libdirlen + 4;
end;

// Not in any library: still say WHICH name. The bare message meant reading the whole
// routine to find the one identifier that was wrong -- three build rounds, three times in
// one session, for what is one line of output.
// laterinclude is defined below, after kwhere, which it uses. The forward is what lets the
// message live here while the scan lives next to the helper it needs.
function laterinclude: int; forward;

// failname -- "undeclared identifier: X".
//
// AND WHEN THERE IS AN INCLUDE BELOW, SAY SO. Measured over the error log: of nine logged
// "undeclared identifier" cases, SIX were the include order -- the name exists, it just
// comes later -- and NONE was a misspelling of an existing name. The bare message is true
// and sends the reader looking for a typo that is not there.
//
// THE COMPILER CANNOT NAME THE FILE, because at this point the later includes have not been
// read. Claiming "declared in model.wz" would be a guess, and a wrong guess in an error
// message costs more than no guess at all. So it states what it knows: there is an include
// further down, and that is where to look first.
procedure failname;
var j: int;
begin
  wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
  wrs(2, ": undeclared identifier: ");
  j := 0;
  while obuf[j] <> chr(0) do j := j + 1;
  wrbuf(2, addr(obuf[0]), j);
  wrs(2, "\n");
  if laterinclude >= 0 then
    wrs(2, "  there is an include further down this file; a name is only visible after the include that declares it\n");
  halt(1);
end;

// kwhere(at, upto, w) -- does the word w start exactly at `at`?
function kwhere(at: int; upto: int; w: str): bool;
var i, n: int;
begin
  n := slen(w);
  if at + n > upto then return false;
  i := 0;
  while i < n do
  begin
    if src[at + i] <> schar(w, i) then return false;
    i := i + 1;
  end;
  return true;
end;

// laterinclude -- is there still an `include` ahead of us in what has been read?
//
// A CHEAP LOOK, NOT A SECOND PASS. Everything read so far sits in one buffer, so scanning
// from the failure point to the end of the current file is a walk over bytes that are
// already there -- no file is opened and nothing is parsed.
//
// It does not prove the name is in that include; the compiler cannot know, because the file
// has not been read. It proves the SHAPE of the problem is possible, and that is the whole
// value: it sends the reader to the include order instead of to a spelling mistake.
function laterinclude: int;
var i: int;
begin
  i := pos;
  while i < srcend do
  begin
    if kwhere(i, srcend, "include") then return i;
    i := i + 1;
  end;
  return 0 - 1;
end;


// namehere(at, upto, want, wantn) -- is exactly `want` at `at`, and nothing more?
//
// THE END MATTERS: without it io.put would match io.putn, and the compiler would keep quiet
// about a name that really is missing.
function namehere(at: int; upto: int; want: array of char; wantn: int): bool;
var i: int;
    c: char;
begin
  if at + wantn > upto then return false;
  i := 0;
  while i < wantn do
  begin
    if src[at + i] <> want[i] then return false;
    i := i + 1;
  end;
  c := src[at + wantn];
  if (c >= 'a') and (c <= 'z') then return false;
  if (c >= 'A') and (c <= 'Z') then return false;
  if (c >= '0') and (c <= '9') then return false;
  return (c <> '_') and (c <> '.');
end;

// isnamech(c) -- part of a name? Letters, digits, '_' and the dot that qualifies it.
function isnamech(c: char): bool;
begin
  if (c >= 'a') and (c <= 'z') then return true;
  if (c >= 'A') and (c <= 'Z') then return true;
  if (c >= '0') and (c <= '9') then return true;
  return (c = '_') or (c = '.');
end;

// onetypo(a, an, at, bn) -- do `a` (an chars) and src[at..at+bn] differ by at most ONE
// insertion, deletion or substitution?
//
// DISTANCE ONE, AND DELIBERATELY NOT MORE. Measured against the 144 real errors in the
// error log: every name a writer actually invented -- print, writeln, say, js.obj -- has its
// nearest real neighbour 3 to 5 edits away, and suggesting "Init" for "print" or "a" for
// "say" is worse than saying nothing. At distance one the suggestion is nearly always the
// name that was meant (io.pushnum for io.push_num, io.putn for io.putc) and never one of
// those. So the threshold is not a tuning knob, it is the measurement.
//
// NO EDIT MATRIX. At distance one the three cases are each a single walk: equal lengths is
// at most one mismatch, and a length difference of one is a prefix, a skip, and the rest.
function onetypo(a: array of char; an: int; at: int; bn: int): bool;
var i, j, diff: int;
begin
  if an = bn then
  begin
    diff := 0;
    i := 0;
    while i < an do
    begin
      if a[i] <> src[at + i] then diff := diff + 1;
      if diff > 1 then return false;
      i := i + 1;
    end;
    return diff = 1;
  end;
  // A LENGTH DIFFERENCE OF ONE: walk both until they part, then skip the character on the
  // longer side and require the tails to match.
  if an = bn + 1 then
  begin
    i := 0;
    while (i < bn) and (a[i] = src[at + i]) do i := i + 1;
    j := i;
    while j < bn do
    begin
      if a[j + 1] <> src[at + j] then return false;
      j := j + 1;
    end;
    return true;
  end;
  if bn = an + 1 then
  begin
    i := 0;
    while (i < an) and (a[i] = src[at + i]) do i := i + 1;
    j := i;
    while j < an do
    begin
      if a[j] <> src[at + j + 1] then return false;
      j := j + 1;
    end;
    return true;
  end;
  return false;
end;

// nearname(at, n, want, wantn) -- the declared name in this library that is ONE typo away,
// or 0 if there is none. Fills nearbuf.
//
// ONLY WITHIN THIS MODULE, which is what the compiler knows at this point anyway: the name
// before the dot picked the file. That filter is doing real work -- it is the reason `print`
// and `writeln` get no suggestion at all rather than a wrong one.
function nearname(at: int; n: int; want: array of char; wantn: int): int;
var i, j, k, e, nl: int;
begin
  e := at + n;
  i := at;
  while i < e do
  begin
    while (i < e) and ((src[i] = ' ') or (src[i] = chr(9))) do i := i + 1;
    j := i;
    while (j < e) and (src[j] <> chr(10)) do j := j + 1;
    k := i;
    if kwhere(k, j, "procedure ") then k := k + 10
    else if kwhere(k, j, "function ") then k := k + 9
    else if kwhere(k, j, "const ") then k := k + 6
    else if kwhere(k, j, "var ") then k := k + 4
    else if kwhere(k, j, "type ") then k := k + 5
    else k := -1;
    if k >= 0 then
    begin
      while (k < j) and ((src[k] = ' ') or (src[k] = chr(9))) do k := k + 1;
      nl := 0;
      while (k + nl < j) and isnamech(src[k + nl]) do nl := nl + 1;
      if nl > 0 then
        if onetypo(want, wantn, k, nl) then
        begin
          if nl >= TBMAX then return 0;
          nearbufn := 0;
          while nearbufn < nl do
          begin nearbuf[nearbufn] := src[k + nearbufn]; nearbufn := nearbufn + 1; end;
          return nearbufn;
        end;
    end;
    i := j + 1;
  end;
  return 0;
end;

// libdeclares(at, n, want, wantn) -- is `want` declared in the library text at src[at..at+n]?
//
// A DECLARATION POSITION, NOT ANY OCCURRENCE. The name has to follow `procedure`,
// `function`, `const`, `var` or `type` -- otherwise io.puts would "declare" itself in every
// file that CALLS it, and the answer would be yes everywhere.
//
// THIS IS NOT THE SEARCH THAT WAS REMOVED. That one scanned EVERY library to work out which
// file declares a name, and needed a preference rule because store.table also occurs in
// oauth.wz. This reads ONE file whose name the convention already gave us, and asks a
// yes/no question about it. No search, no preference rule, and it runs on a path that ends
// in halt(1) -- so its cost is a file read we were about to exit after anyway.
function libdeclares(at: int; n: int; want: array of char; wantn: int): bool;
var i, j, k, e: int;
begin
  e := at + n;
  i := at;
  while i < e do
  begin
    // THE START OF A LINE, skipping the indent: a declaration keyword is at the left in
    // every file in lib/, and requiring that keeps this to one pass.
    while (i < e) and ((src[i] = ' ') or (src[i] = chr(9))) do i := i + 1;
    j := i;
    while (j < e) and (src[j] <> chr(10)) do j := j + 1;
    k := i;
    if kwhere(k, j, "procedure ") then k := k + 10
    else if kwhere(k, j, "function ") then k := k + 9
    else if kwhere(k, j, "const ") then k := k + 6
    else if kwhere(k, j, "var ") then k := k + 4
    else if kwhere(k, j, "type ") then k := k + 5
    else k := -1;
    if k >= 0 then
    begin
      while (k < j) and ((src[k] = ' ') or (src[k] = chr(9))) do k := k + 1;
      if namehere(k, j, want, wantn) then return true;
    end;
    i := j + 1;
  end;
  return false;
end;

// failnear(n) -- "undeclared identifier: X -- did you mean Y?"
//
// THE NAME FIRST, THE SUGGESTION AFTER A DASH. The fact the reader needs is that X does not
// exist; the nearest name is help, not the finding, and the sentence is ordered to say so.
procedure failnear(n: int);
var j: int;
begin
  wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
  wrs(2, ": undeclared identifier: ");
  j := 0;
  while obuf[j] <> chr(0) do j := j + 1;
  wrbuf(2, addr(obuf[0]), j);
  wrs(2, " -- did you mean ");
  wrbuf(2, addr(nearbuf[0]), n);
  wrs(2, "?\n");
  halt(1);
end;

// failundeclared -- "undeclared identifier", and WHICH library declares it when the name
// looks like one of ours.
//
// io.puts -> is there a lib/io.wz? Then say so and give the include line to add. It is a
// HINT: the worst case is that it stays quiet, and it never changes whether the program
// compiles.
//
// ONE stat(2), NOT A SEARCH. This used to scan the library the compiler CARRIED for the
// identifier at a declaration position -- about 110 lines, plus a preference rule because
// store.table also occurs in oauth.wz (which includes store.wz and uses it). Once the
// library lives on disk the naming convention does that work for free: store.* lives in
// store.wz, so the name before the first dot IS the file name, and asking the filesystem
// whether that file exists is the whole check.
//
// It is now the counterpart of the routine in boot.c line for line, which it never was
// while one side had an embedded copy and the other did not.
procedure failundeclared;
var i, j, n, fd, mark, n2, olen, near: int;
    erin: bool;
begin
  n := 0;
  while (tbuf[n] <> chr(0)) and (tbuf[n] <> '.') do n := n + 1;
  if (tbuf[n] <> '.') or (n = 0) then failname;
  // pathbuf := <libdir><prefix>.wz
  i := 0;
  while i < libdirlen do begin pathbuf[i] := libdir[i]; i := i + 1; end;
  if i + n + 4 >= 1022 then failname;
  j := 0;
  while j < n do begin pathbuf[i + j] := tbuf[j]; j := j + 1; end;
  i := i + n;
  pathbuf[i] := '.'; pathbuf[i + 1] := 'w'; pathbuf[i + 2] := 'z'; pathbuf[i + 3] := chr(0);
  fd := opn(addr(pathbuf[0]), 0, 0);
  if fd < 0 then failname;
  cls(fd);
  // THE FILE EXISTS -- BUT IS THE NAME IN IT? That is the question the old code never
  // asked, and it is the whole bug.
  //
  // MEASURED 18-09-2026: io.putc does not exist, io.wz was included three lines above, and
  // the compiler answered "io.putc is declared in io.wz; add: include "io.wz";". Wrong
  // twice over. A human sees the include sitting there and distrusts the message. An agent
  // adds the include it already has, recompiles, gets the identical error, and loops -- the
  // message has taken away the one fact it needed, which is that the name does not exist.
  //
  // ASKING ABOUT THE NAME ANSWERS BOTH HALVES AT ONCE, whether or not the file is already
  // included, so there is no second check on the include list: if the name is not declared
  // there, naming that library is wrong either way. (A check on "is it already included"
  // was written first and then removed -- it could only fire where this one already had,
  // and by exiting earlier it robbed the reader of the better message below.)
  //
  // THE TEXT IS READ AND THEN DROPPED: srclen goes back to where it was, so this library
  // does not end up in the source being compiled. We are on our way to halt(1) either way,
  // so the read costs nothing that matters.
  olen := 0;
  while obuf[olen] <> chr(0) do olen := olen + 1;
  mark := srclen;
  n2 := readfile;
  if n2 > 0 then
  begin
    erin := libdeclares(mark, n2, obuf, olen);
    if not erin then
    begin
      // NOT IN THERE -- BUT IS SOMETHING ONE TYPO AWAY? io.putc for io.putn is the whole
      // point: the writer is one character from the name they wanted, and being told only
      // "undeclared" leaves them to find it by reading the library.
      near := nearname(mark, n2, obuf, olen);
      srclen := mark;
      if near > 0 then failnear(near);
      failname;
    end;
    srclen := mark;
  end
  else srclen := mark;
  wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
  wrs(2, ": undeclared identifier: ");
  j := 0;
  while obuf[j] <> chr(0) do j := j + 1;
  wrbuf(2, addr(obuf[0]), j);
  wrs(2, " is declared in ");
  wrbuf(2, addr(tbuf[0]), n); wrs(2, ".wz; add: include \"");
  wrbuf(2, addr(tbuf[0]), n); wrs(2, ".wz\";\n");
  halt(1);
end;

// pathbuf := <search path>/<name from the include>, for the second attempt
// does the name from the include contain a '/'? then it is a path, not a library name
function haspath(doff: int): bool;
var i: int;
begin
  i := 0;
  while dat[doff + i] <> chr(0) do
  begin
    if dat[doff + i] = '/' then return true;
    i := i + 1;
  end;
  return false;
end;

procedure makelibpath(doff: int);
var i, n: int;
begin
  n := 0;
  while n < libdirlen do
  begin
    pathbuf[n] := libdir[n];
    n := n + 1;
  end;
  i := 0;
  while dat[doff + i] <> chr(0) do
  begin
    if n >= 1022 then fail("include path too long");
    pathbuf[n] := dat[doff + i];
    n := n + 1;
    i := i + 1;
  end;
  pathbuf[n] := chr(0);
end;

procedure makepath(doff: int);
var i, cut, n, base: int;
begin
  base := filenam[curfile];
  n := filelen[curfile];
  cut := 0;
  i := 0;
  while i < n do
  begin
    if fnpool[base + i] = '/' then cut := i + 1;
    i := i + 1;
  end;
  if dat[doff] = '/' then cut := 0;      // an absolute path stands alone
  i := 0;
  while i < cut do
  begin
    pathbuf[i] := fnpool[base + i];
    i := i + 1;
  end;
  n := cut;
  i := 0;
  while dat[doff + i] <> chr(0) do
  begin
    if n >= 1022 then fail("include path too long");
    pathbuf[n] := dat[doff + i];
    n := n + 1;
    i := i + 1;
  end;
  pathbuf[n] := chr(0);
end;

procedure doinclude;
var doff, i, fi, n, start: int;
begin
  next;
  if tok <> TK_STR then fail("include needs a file name in quotes");
  doff := tval;
  next;
  if tok <> 59 then fail("missing ; after include");
  // RELATIVE FIRST (next to the including file), THEN THE SEARCH PATH -- like C with
  // "mine.h" and <stdio.h>, but without two spellings: if the file exists next to the
  // includer, that wins; otherwise it is looked for in the compiler's library.  That way
  // a source can write "io.wz" and not "../../lib/io.wz".
  // A BARE NAME IS A LIBRARY NAME, a name with a '/' is a path.
  //
  // That distinction replaces three rules a newcomer would otherwise have to learn by
  // heart.  include "io.wz" always means THE library -- even in a test file that is
  // itself called io.wz, because that is not a path.  include "../src/foo.wz" always
  // means a file next to the includer.  No precedence rule to remember, no file that
  // finds itself, and no two spellings like C's <> against "".
  //
  // If the library name does not exist it falls back to relative: that way files lying
  // next to each other and naming each other by name keep working.
  //
  // THE LIBRARY IS ON DISK AND NOWHERE ELSE, since 16-09-2026. There used to be a third
  // step here: a copy of lib/ compiled into this binary, consulted when neither path held
  // the file. It bought a single-file installation and charged for it in four places --
  // a 238KB generated source in the repository, a permanent difference between this
  // compiler and its C counterpart (which never had one), no way to tell from outside
  // which copy had answered, and no source on disk for an editor or a debugger to show.
  // Every one of those cost real work. The library ships beside the binary instead.
  triedlibn := 0;
  if haspath(doff) then makepath(doff)
  else
  begin
    makelibpath(doff);
    // KEEP THE LIBRARY PATH BEFORE THE FALLBACK OVERWRITES IT. makepath writes the
    // relative name over pathbuf, so without this copy the error below can only name
    // "io.wz" -- which is what the source already says, and not where we looked.
    if not fileexists then
    begin
      while (pathbuf[triedlibn] <> chr(0)) and (triedlibn < 1023) do
      begin
        triedlib[triedlibn] := pathbuf[triedlibn];
        triedlibn := triedlibn + 1;
      end;
      triedlib[triedlibn] := chr(0);
      makepath(doff);
    end;
  end;
  normpath;
  datlen := datmark;
  i := 0;
  while i < nfiles do
  begin
    if samefile(i) then break;
    i := i + 1;
  end;

  if i < nfiles then
  begin
    next;
    return;
  end;
  if incdepth >= 16 then fail("includes nested too deeply");
  fi := addfile;
  incpos[incdepth] := pos; incend[incdepth] := srcend;
  incline[incdepth] := line; incfile[incdepth] := curfile;
  incdepth := incdepth + 1;
  start := srclen;
  n := readfile;
  if n < 0 then failinclude;
  pos := start; srcend := start + n; line := 1; curfile := fi;
  next;
end;

// ------------------------------------------------------------------
// symbol tables
// ------------------------------------------------------------------

function intern: int;
var o, i: int;
begin
  o := namelen;
  i := 0;
  while tbufb(i) <> 0 do
  begin
    if namelen >= NAMEMAX then fail("name pool overflow: the source is too large");
    names[namelen] := tbuf[i];
    namelen := namelen + 1;
    i := i + 1;
  end;
  if namelen >= NAMEMAX then fail("name pool overflow: the source is too large");
  names[namelen] := chr(0);
  namelen := namelen + 1;
  return o;
end;

function nameq(off: int): bool;
var i: int;
begin
  i := 0;
  while true do
  begin
    if namesb(off + i) <> tbufb(i) then return false;
    if tbufb(i) = 0 then return true;
    i := i + 1;
  end;
  return false;
end;

// The hash of the identifier now in tbuf.  Identifiers are lowercased on the way into
// tbuf (see the lexer), so this hashes the same bytes nameq compares and the index
// inherits the case-insensitivity instead of having to repeat it.
//
// FNV-1a, which is a multiply and an xor per byte and needs no table.  The result is
// masked into a bucket, never used as an identity: every hit is still confirmed with
// nameq, so a collision costs a comparison and never a wrong answer.
function tokhash: int;
var h, i, c: int;
begin
  h := 2166136261;
  i := 0;
  while true do
  begin
    c := tbufb(i);
    if c = 0 then return band(h, HMASK);
    h := bxor(h, c);
    h := band(h * 16777619, 4294967295);
    i := i + 1;
  end;
  return band(h, HMASK);
end;

// The same hash, over a name already in the pool rather than the token in tbuf.  Two
// entry points because a name is sometimes added straight from the token and sometimes
// from an offset interned earlier; they must agree byte for byte or a name would be
// filed in one bucket and sought in another.
function namehash(off: int): int;
var h, i, c: int;
begin
  h := 2166136261;
  i := 0;
  while true do
  begin
    c := namesb(off + i);
    if c = 0 then return band(h, HMASK);
    h := bxor(h, c);
    h := band(h * 16777619, 4294967295);
    i := i + 1;
  end;
  return band(h, HMASK);
end;

// Fill the buckets with -1 the first time anything is looked up or added.  Doing it
// here rather than in an init routine keeps the change to the lookup path only.
procedure hashinit;
var i: int;
begin
  if hashed then return;
  i := 0;
  while i < NHASH do
  begin
    ghead[i] := -1;
    fhead[i] := -1;
    i := i + 1;
  end;
  hashed := true;
end;

// File global g, whose name is already in gnam[g], in its bucket.  Called right after
// the entry is filled in and before ngl moves on.
procedure gindex(g: int);
var b: int;
begin
  hashinit;
  b := namehash(gnam[g]);
  gnext[g] := ghead[b];
  ghead[b] := g;
end;

// The same for routine f.
procedure findex(f: int);
var b: int;
begin
  hashinit;
  b := namehash(fnam[f]);
  fnext[f] := fhead[b];
  fhead[b] := f;
end;

function findloc: int;
var i: int;
begin
  i := nloc - 1;
  while i >= 0 do
  begin
    if nameq(lnam[i]) then return i;
    i := i - 1;
  end;
  return -1;
end;

// Walk only the names that hash to the same bucket, newest first.  That order is the
// one the old linear scan had (it counted down from ngl - 1), and it is kept although
// nothing depends on it any more: a duplicate global is refused at declaration, so a
// name is in here at most once.
function findglob: int;
var i: int;
begin
  hashinit;
  i := ghead[tokhash];
  while i >= 0 do
  begin
    // A LOCAL NAME FROM ANOTHER FILE DOES NOT EXIST HERE. gfile is -1 for everything
    // public, so nothing changes for existing source.
    if nameq(gnam[i]) and ((gfile[i] < 0) or (gfile[i] = curfile)) then return i;
    i := gnext[i];
  end;
  return -1;
end;

function findfn: int;
var i: int;
begin
  hashinit;
  i := fhead[tokhash];
  while i >= 0 do
  begin
    // A local routine from ANOTHER file does not exist here.
    if nameq(fnam[i]) and ((fvis[i] < 0) or (fvis[i] = curfile)) then return i;
    i := fnext[i];
  end;
  return -1;
end;

function fnbyname(s: str): int;
var i, j: int;
begin
  i := 0;
  while i < nfn do
  begin
    j := 0;
    while namesb(fnam[i] + j) = sch(s, j) do
    begin
      if sch(s, j) = 0 then return i;
      j := j + 1;
    end;
    i := i + 1;
  end;
  fail("the Windows runtime is incomplete");
  return -1;
end;

function tsize(t: int): int;
begin
  if (t = T_CHAR) or (t = T_BOOL) then return 1;
  if t >= T_REC then return rtsize[t - T_REC];
  return 8;
end;

function findtype: int;
var i: int;
begin
  i := nrt - 1;
  while i >= 0 do
  begin
    if nameq(rtnam[i]) then return i;
    i := i - 1;
  end;
  return -1;
end;

// Split the dotted identifier in tbuf into the longest prefix that names a
// variable and a residual field path, which lands in fpath.  Sets spli/spgi.
function splitname: bool;
var k, i: int;
begin
  fplen := 0;
  k := 0;
  while tbuf[k] <> chr(0) do k := k + 1;
  k := k - 1;
  while k > 0 do
  begin
    if tbuf[k] = '.' then
    begin
      tbuf[k] := chr(0);
      spli := findloc; spgi := -1;
      if spli < 0 then spgi := findglob;
      if (spli >= 0) or (spgi >= 0) then
      begin
        i := k + 1;
        while tbuf[i] <> chr(0) do
        begin
          fpath[fplen] := tbuf[i];
          fplen := fplen + 1;
          i := i + 1;
        end;
        fpath[fplen] := chr(0);
        tbuf[k] := '.';
        return true;
      end;
      tbuf[k] := '.';
    end;
    k := k - 1;
  end;
  return false;
end;

// the field of record type t whose name is fpath[a..b)
function findfield(t: int; a: int; b: int): int;
var r, f, i: int;
    ok: bool;
begin
  r := t - T_REC;
  f := rtf0[r];
  while f < rtf0[r] + rtnf[r] do
  begin
    ok := true;
    i := 0;
    while i < b - a do
    begin
      if namesb(fdnam[f] + i) <> ord(fpath[a + i]) then
      begin
        ok := false;
        break;
      end;
      i := i + 1;
    end;
    if ok and (namesb(fdnam[f] + (b - a)) = 0) then return f;
    f := f + 1;
  end;
  fail("no such field in this record");
  return -1;
end;

function tname(t: int): str;
begin
  if t >= T_REC then return "record";
  if t = T_INT  then return "int";
  if t = T_CHAR then return "char";
  if t = T_BOOL then return "bool";
  if t = T_STR  then return "str";
  if t = T_REAL then return "real";
  return "void";
end;

procedure want(got: int; need: int; ctx: str);
begin
  if got <> need then
  begin
    wrs(2, "wantzel: "); wrname(2); wrs(2, ":"); wrnum(2, line);
    wrs(2, ": type error in "); wrs(2, ctx);
    wrs(2, ": expected "); wrs(2, tname(need));
    wrs(2, ", found "); wrs(2, tname(got)); wrs(2, "\n");
    halt(1);
  end;
end;

// ------------------------------------------------------------------
// code emission
// ------------------------------------------------------------------

procedure e(b: int);
begin
  if codelen >= CODEMAX then fail("code segment overflow");
  code[codelen] := chr(band(b, 255));
  codelen := codelen + 1;
end;

procedure e32at(o: int; v: int);
begin
  code[o]     := chr(band(v, 255));
  code[o + 1] := chr(band(v shr 8, 255));
  code[o + 2] := chr(band(v shr 16, 255));
  code[o + 3] := chr(band(v shr 24, 255));
end;

procedure e32(v: int);
begin
  e(v); e(v shr 8); e(v shr 16); e(v shr 24);
end;

procedure e64(v: int);
begin
  e32(v); e32(v shr 32);
end;

procedure fixup(kind: int; val: int);
begin
  if nfx >= MAXFIX then fail("too many relocations");
  fxoff[nfx] := codelen;
  fxkind[nfx] := kind;
  fxval[nfx] := val;
  nfx := nfx + 1;
end;

procedure imm(v: int);
begin
  if v = 0 then
  begin
    e(0x31); e(0xC0);
    return;
  end;
  if (v > 0) and (v < 2147483648) then
  begin
    e(0xB8); e32(v);
    return;
  end;
  if (v < 0) and (v >= 0 - 2147483648) then
  begin
    e(0x48); e(0xC7); e(0xC0); e32(v);
    return;
  end;
  e(0x48); e(0xB8); e64(v);
end;

procedure immdata(o: int);
begin
  e(0x48); e(0xB8); fixup(FX_DATA, o); e64(0);
end;

procedure immbss(o: int);
begin
  e(0x48); e(0xB8); fixup(FX_BSS, o); e64(0);
end;

procedure push;
begin
  e(0x50);
end;

procedure popc;
begin
  e(0x59);
end;

procedure xchgac;
begin
  e(0x48); e(0x89); e(0xC1); e(0x58);
end;

function jfwd(op1: int; op2: int): int;
var o: int;
begin
  if op1 <> 0 then e(op1);
  e(op2);
  o := codelen;
  e32(0);
  return o;
end;

procedure patch(o: int);
begin
  e32at(o, codelen - (o + 4));
end;

procedure jmpto(op1: int; op2: int; target: int);
begin
  if op1 <> 0 then e(op1);
  e(op2);
  e32(target - (codelen + 4));
end;

procedure loadlocal(off: int; t: int);
begin
  if tsize(t) = 1 then
  begin
    e(0x48); e(0x0F); e(0xB6); e(0x85);
  end
  else
  begin
    e(0x48); e(0x8B); e(0x85);
  end;
  e32(off);
end;

procedure loadglobal(off: int; t: int);
begin
  if tsize(t) = 1 then
  begin
    e(0x48); e(0x0F); e(0xB6); e(0x04); e(0x25);
  end
  else
  begin
    e(0x48); e(0x8B); e(0x04); e(0x25);
  end;
  fixup(FX_BSS32, off); e32(0);
end;

procedure storelocal(off: int; t: int);
begin
  if tsize(t) = 1 then
  begin
    e(0x88); e(0x85);
  end
  else
  begin
    e(0x48); e(0x89); e(0x85);
  end;
  e32(off);
end;

procedure storeglobal(off: int; t: int);
begin
  if tsize(t) = 1 then
  begin
    e(0x88); e(0x04); e(0x25);
  end
  else
  begin
    e(0x48); e(0x89); e(0x04); e(0x25);
  end;
  fixup(FX_BSS32, off); e32(0);
end;

procedure lea_local(off: int);
begin
  e(0x48); e(0x8D); e(0x85); e32(off);
end;

procedure loadind(t: int);
begin
  if tsize(t) = 1 then
  begin
    e(0x48); e(0x0F); e(0xB6); e(0x00);
  end
  else
  begin
    e(0x48); e(0x8B); e(0x00);
  end;
end;

procedure storeind(t: int);
begin
  if tsize(t) = 1 then
  begin
    e(0x88); e(0x01);
  end
  else
  begin
    e(0x48); e(0x89); e(0x01);
  end;
end;

// --- real arithmetic ------------------------------------------------
// A real travels in rax as its 64-bit pattern, so every path that moves
// an int (stack, registers, memory, calls) moves a real unchanged.  Only
// the operations themselves go through xmm0/xmm1.
procedure xmm0rax;
begin
  e(0x66); e(0x48); e(0x0F); e(0x6E); e(0xC0);
end;

procedure xmm1rcx;
begin
  e(0x66); e(0x48); e(0x0F); e(0x6E); e(0xC9);
end;

procedure raxxmm0;
begin
  e(0x66); e(0x48); e(0x0F); e(0x7E); e(0xC0);
end;

procedure realop(op: int);
begin
  xmm0rax; xmm1rcx;
  e(0xF2); e(0x0F); e(op); e(0xC1);
  raxxmm0;
end;

// A system call: rax holds the Linux number, rdi..r9 the arguments.  A Linux
// executable executes the instruction; a Windows executable calls the shim
// that hands the same registers to __wsys, the emulation in Wantzel.
procedure syscallinsn;
begin
  if winmode <> 0 then
  begin
    e(0xE8); e32(sysrawaddr - (codelen + 4));
  end
  else
  begin
    e(0x0F); e(0x05);
  end;
end;

procedure emittrap;
begin
  // Two writes to stderr and then exit(1). The caller passes the shared heading in rdi/rsi
  // and the file-and-line in rdx/rcx -- splitting the sentence is what keeps one copy of
  // "runtime error: array index out of range" instead of one per check.
  trapaddr := codelen;
  // keep the second half, which the first write would otherwise destroy
  e(0x52);                                     // push rdx
  e(0x51);                                     // push rcx
  // write(2, rdi, rsi)
  e(0x48); e(0x89); e(0xF2);                   // mov rdx, rsi   -- length
  e(0x48); e(0x89); e(0xFE);                   // mov rsi, rdi   -- text
  imm(2); e(0x48); e(0x89); e(0xC7);           // mov rdi, 2     -- stderr
  imm(1);
  syscallinsn;
  // write(2, place, placelen)
  e(0x59);                                     // pop rcx
  e(0x5A);                                     // pop rdx
  e(0x48); e(0x89); e(0xD6);                   // mov rsi, rdx   -- text
  e(0x48); e(0x89); e(0xCA);                   // mov rdx, rcx   -- length
  imm(2); e(0x48); e(0x89); e(0xC7);
  imm(1);
  syscallinsn;
  imm(1); e(0x48); e(0x89); e(0xC7);
  imm(231);
  syscallinsn;
end;

procedure mcat(s: str);
var i: int;
begin
  i := 0;
  while i < slen(s) do
  begin
    mbuf[mlen] := schar(s, i);
    mlen := mlen + 1;
    i := i + 1;
  end;
end;

function eqstr(a: str; b: str): bool;
var i: int;
begin
  if slen(a) <> slen(b) then return false;
  i := 0;
  while i < slen(a) do
  begin
    if schar(a, i) <> schar(b, i) then return false;
    i := i + 1;
  end;
  return true;
end;

// The fixed heading for a kind of check -- "runtime error: array index out of range at " --
// stored once and reused. Returns its index in the table.
function trapheading(msg: str): int;
var i, o: int;
begin
  i := 0;
  while i < ntph do
  begin
    if eqstr(tphtxt[i], msg) then return i;
    i := i + 1;
  end;
  if ntph >= len(tphoff) then return 0 - 1;
  mlen := 0;
  mcat("runtime error: "); mcat(msg); mcat(" at ");
  o := datstr(1, mlen);
  tphoff[ntph] := o; tphlen[ntph] := mlen; tphtxt[ntph] := msg;
  ntph := ntph + 1;
  return ntph - 1;
end;

// trapskip(fi) -- where the name of file fi starts, for a message stored IN THE BINARY.
//
// THE PROBLEM THIS SOLVES. trap embeds "<file>:<line>" as a string in the output, and the
// file name used to be whatever the compiler had resolved. So the same source compiled to
// two different binaries:
//
//     wantzel src/main.wz out.exe                  ->  "src/main.wz:101"
//     wantzel /abs/path/to/src/main.wz out.exe     ->  "/abs/path/to/src/main.wz:101"
//
// Measured on 16-09-2026 in a GUI program with 1288 checks: 513024 bytes against 581632,
// a 68KB difference out of identical source. Two things are wrong with that. A build is
// supposed to be reproducible, and it was not -- a build server naming its sources
// absolutely cannot produce the artifact a developer verified. And the second is worse:
// the build machine's directory layout, including a user's home directory, ends up inside
// every executable anyone ships. The embedded LIBRARY files leaked it either way, because
// they are named <libdir>/<name> and libdir is found from /proc/self/exe.
//
// THE RULE IS THE LAST TWO SEGMENTS OF THE DIRECTORY, AT MOST. A diagnostic has to say
// which file and which line; what it does not have to say is where the tree was checked
// out. "src/win32/main.wz:412" and "lib/io.wz:88" point a reader at the right file in the
// project, and carry nothing about the machine that built it.
//
// WHY SEGMENTS AND NOT A COMMON PREFIX, which is what I tried first: the main file can sit
// DEEPER than its includes (src/win32/main.wz including src/agent.wz), so stripping the
// main file's directory strips nothing from the ones that matter. Counting from the END is
// independent of which file is the entry point, which is the property that was missing.
function trapskip(fi: int): int;
var i, n, seg: int;
begin
  n := filelen[fi];
  // Count directory separators backwards, and stop after two. A name with fewer is
  // already short enough to embed whole.
  seg := 0;
  i := n - 1;
  while i >= 0 do
  begin
    if fnpool[filenam[fi] + i] = '/' then
    begin
      seg := seg + 1;
      if seg >= 3 then return i + 1;
    end;
    i := i - 1;
  end;
  return 0;
end;

procedure trap(msg: str);
var i, o, k, h, sk: int;
begin
  // Two writes rather than one: the heading, which every check of this kind shares, and the
  // place, which is different for each. Storing the whole sentence per check made the
  // messages a quarter of a GUI binary.
  h := trapheading(msg);

  mlen := 0;
  sk := trapskip(curfile);
  i := sk;
  while i < filelen[curfile] do
  begin
    mbuf[mlen] := fnpool[filenam[curfile] + i]; mlen := mlen + 1; i := i + 1;
  end;
  mbuf[mlen] := ':'; mlen := mlen + 1;
  k := numstr(line);
  i := 0;
  while i < k do
  begin
    mbuf[mlen] := nbuf[i]; mlen := mlen + 1; i := i + 1;
  end;
  mbuf[mlen] := '\n'; mlen := mlen + 1;
  o := datstr(1, mlen);

  if h < 0 then
  begin
    // the table is full, which needs more kinds of check than exist; fall back to the
    // complete sentence so a message is never lost
    e(0x48); e(0xBF); fixup(FX_DATA, o); e64(0);
    e(0x48); e(0xBE); e64(mlen);
    e(0xE8); e32(trapaddr - (codelen + 4));
    return;
  end;

  // rdi/rsi carry the heading, rdx/rcx the place
  e(0x48); e(0xBF); fixup(FX_DATA, tphoff[h]); e64(0);
  e(0x48); e(0xBE); e64(tphlen[h]);
  e(0x48); e(0xBA); fixup(FX_DATA, o); e64(0);
  e(0x48); e(0xB9); e64(mlen);
  e(0xE8); e32(trapaddr - (codelen + 4));
end;

// ------------------------------------------------------------------
// expressions
// ------------------------------------------------------------------

function expr: int; forward;
function factor: int; forward;

// The pending simple operand: factor() records whether the value it just
// produced was a constant or a scalar variable, so that the next operator can
// roll that code back and use an immediate or memory operand instead.

procedure memop(opc: int);
begin
  e(0x48); e(opc);
  if lvkind = 2 then
  begin
    e(0x85); e32(lvoff);
  end
  else
  begin
    e(0x04); e(0x25); fixup(FX_BSS32, lvoff); e32(0);
  end;
end;

procedure opintocx;
begin
  if lvkind = 1 then
  begin
    e(0x48); e(0xC7); e(0xC1); e32(lvimm);
    return;
  end;
  e(0x48); e(0x8B);
  if lvkind = 2 then
  begin
    e(0x8D); e32(lvoff);
  end
  else
  begin
    e(0x0C); e(0x25); fixup(FX_BSS32, lvoff); e32(0);
  end;
end;

procedure divcode(op: int);
begin
  e(0x48); e(0x99);
  e(0x48); e(0xF7); e(0xF9);
  if op = KW_MOD then
  begin
    e(0x48); e(0x89); e(0xD0);
  end;
end;

function fold(op: int): bool;
var lab: int;
begin
  if lvkind = 1 then
  begin
    if (lvimm < 0 - 2147483648) or (lvimm > 2147483647) then return false;
    if op = 43 then begin e(0x48); e(0x05); e32(lvimm); return true; end;
    if op = 45 then begin e(0x48); e(0x2D); e32(lvimm); return true; end;
    if op = 42 then begin e(0x48); e(0x69); e(0xC0); e32(lvimm); return true; end;
    if op = 0 then begin e(0x48); e(0x3D); e32(lvimm); return true; end;
    if (op = KW_SHL) or (op = KW_SHR) then
    begin
      if (lvimm < 0) or (lvimm > 63) then return false;
      e(0x48); e(0xC1);
      if op = KW_SHL then e(0xE0) else e(0xF8);
      e(lvimm);
      return true;
    end;
    if (op = KW_DIV) or (op = KW_MOD) then
    begin
      if lvimm = 0 then fail("division by zero");
      opintocx;
      divcode(op);
      return true;
    end;
    return false;
  end;
  if lvtype <> T_INT then return false;
  if op = 43 then begin memop(0x03); return true; end;
  if op = 45 then begin memop(0x2B); return true; end;
  if op = 0 then begin memop(0x3B); return true; end;
  if op = 42 then
  begin
    e(0x48); e(0x0F); e(0xAF);
    if lvkind = 2 then
    begin
      e(0x85); e32(lvoff);
    end
    else
    begin
      e(0x04); e(0x25); fixup(FX_BSS32, lvoff); e32(0);
    end;
    return true;
  end;
  if (op = KW_SHL) or (op = KW_SHR) then
  begin
    opintocx;
    e(0x48); e(0xD3);
    if op = KW_SHL then e(0xE0) else e(0xF8);
    return true;
  end;
  if (op = KW_DIV) or (op = KW_MOD) then
  begin
    opintocx;
    e(0x48); e(0x85); e(0xC9);
    lab := jfwd(0x0F, 0x85);
    trap("division by zero");
    patch(lab);
    divcode(op);
    return true;
  end;
  return false;
end;

function fold2(op: int; pp: int; pf: int): bool;
var sp, sf: int;
begin
  sp := codelen; sf := nfx;
  codelen := pp; nfx := pf;
  if fold(op) then return true;
  codelen := sp; nfx := sf;
  return false;
end;

// Element access: the checked, zero-based index is left in rax and the
// element is then reached with a single instruction.

function elemsetup(li: int; gi: int): int;
var isarr, lo, hi, ok, t, k, o, et: int;
begin
  if li >= 0 then
  begin
    if lkind[li] = SK_CONST then fail("a constant has no elements");
    isarr := larr[li]; lo := llo[li]; hi := lhi[li]; et := ltyp[li]; o := loff[li];
    k := 0;
    if isarr = 2 then k := 2;
  end
  else
  begin
    if gkind[gi] = SK_CONST then fail("a constant has no elements");
    isarr := garr[gi]; lo := glo[gi]; hi := ghi[gi]; et := gtyp[gi]; o := gval[gi];
    k := 1;
  end;
  if isarr = 0 then fail("subscript applied to a variable that is not an array");
  next;
  t := expr;
  want(t, T_INT, "array index");
  if tok = TK_RANGE then fail("a slice can only be passed as an array argument");
  if tok <> 93 then fail("missing ] after array index");

  // A CONSTANT INDEX OUTSIDE THE BOUNDS IS REFUSED HERE, not at run time.
  //
  // The runtime check below is correct and stays; what was wrong is that it was the ONLY
  // check. `a[9]` on a four-element array compiled clean and failed when it ran -- and the
  // compiler knew the bound and the index while it was reading the line. For a language
  // built so that an agent can fix its own mistake from the message, that is a second too
  // late: a build alone could have said it, without a run.
  //
  // lvkind = 1 means the expression just parsed was an immediate, with the value in lvimm.
  // That covers a literal AND a named constant, which is the case worth having -- a bad
  // literal is a typo, a bad constant is usually a table and a loop that disagree.
  //
  // A SLICE IS NOT CHECKED HERE: k = 2 is an `array of T` parameter, whose length is only
  // known to the caller, so the runtime check is the only one possible for it. That is the
  // honest limit of this, and it is why the runtime check cannot go away.
  //
  // The test is on k and not on elkind: elkind is assigned below, so reading it here would
  // be reading the PREVIOUS subscript's kind -- which is right often enough to look like it
  // works and wrong exactly when two subscripts of different kinds appear in one expression.
  if (k <> 2) and (lvkind = 1) then
    if (lvimm < lo) or (lvimm > hi) then
      fail("array index out of range at compile time");

  next;
  elkind := k; eloff := o; eltype := et;
  if elkind = 2 then
  begin
    e(0x48); e(0x3B); e(0x85); e32(eloff - 8);
    ok := jfwd(0x0F, 0x82);
  end
  else
  begin
    if lo <> 0 then
    begin
      e(0x48); e(0x2D); e32(lo);
    end;
    e(0x48); e(0x3D); e32(hi - lo);
    ok := jfwd(0x0F, 0x86);
  end;
  trap("array index out of range");
  patch(ok);
  elkind := k; eloff := o; eltype := et;
  return et;
end;

procedure elemload;
begin
  if elkind = 0 then
  begin
    if tsize(eltype) = 1 then
    begin
      e(0x48); e(0x0F); e(0xB6); e(0x84); e(0x05);
    end
    else
    begin
      e(0x48); e(0x8B); e(0x84); e(0xC5);
    end;
    e32(eloff);
  end
  else if elkind = 1 then
  begin
    if tsize(eltype) = 1 then
    begin
      e(0x48); e(0x0F); e(0xB6); e(0x80);
    end
    else
    begin
      e(0x48); e(0x8B); e(0x04); e(0xC5);
    end;
    fixup(FX_BSS32, eloff); e32(0);
  end
  else
  begin
    e(0x48); e(0x8B); e(0x8D); e32(eloff);
    if tsize(eltype) = 1 then
    begin
      e(0x48); e(0x0F); e(0xB6); e(0x04); e(0x01);
    end
    else
    begin
      e(0x48); e(0x8B); e(0x04); e(0xC1);
    end;
  end;
end;

procedure elemstore;
begin
  if elkind = 0 then
  begin
    if tsize(eltype) = 1 then
    begin
      e(0x88); e(0x84); e(0x0D);
    end
    else
    begin
      e(0x48); e(0x89); e(0x84); e(0xCD);
    end;
    e32(eloff);
  end
  else if elkind = 1 then
  begin
    if tsize(eltype) = 1 then
    begin
      e(0x88); e(0x81);
    end
    else
    begin
      e(0x48); e(0x89); e(0x04); e(0xCD);
    end;
    fixup(FX_BSS32, eloff); e32(0);
  end
  else
  begin
    e(0x48); e(0x8B); e(0x95); e32(eloff);
    if tsize(eltype) = 1 then
    begin
      e(0x88); e(0x04); e(0x0A);
    end
    else
    begin
      e(0x48); e(0x89); e(0x04); e(0xCA);
    end;
  end;
end;

// The first six argument registers follow the System V order, which the
// syscall builtins share; r12..r15 extend it for our own calls.
procedure popreg(i: int);
begin
  if i = 0 then e(0x5F)
  else if i = 1 then e(0x5E)
  else if i = 2 then e(0x5A)
  else if i = 3 then e(0x59)
  else if i = 4 then begin e(0x41); e(0x58); end
  else if i = 5 then begin e(0x41); e(0x59); end
  else if i = 6 then begin e(0x41); e(0x5C); end
  else if i = 7 then begin e(0x41); e(0x5D); end
  else if i = 8 then begin e(0x41); e(0x5E); end
  else begin e(0x41); e(0x5F); end;
end;

procedure popsys(i: int);
begin
  if i = 0 then e(0x5F)
  else if i = 1 then e(0x5E)
  else if i = 2 then e(0x5A)
  else if i = 3 then begin e(0x41); e(0x5A); end
  else if i = 4 then begin e(0x41); e(0x58); end
  else begin e(0x41); e(0x59); end;
end;

// The Windows x64 convention: rcx, rdx, r8, r9, then the stack.  Arguments
// five to seven wait in r10, r11 and rdi until the call frame exists.
procedure popwin(i: int);
begin
  if i = 0 then e(0x59)
  else if i = 1 then e(0x5A)
  else if i = 2 then begin e(0x41); e(0x58); end
  else if i = 3 then begin e(0x41); e(0x59); end
  else if i = 4 then begin e(0x41); e(0x5A); end
  else if i = 5 then begin e(0x41); e(0x5B); end
  else e(0x5F);
end;

function bicode: int;
begin
  if eqt("ord")   then return 1;
  if eqt("chr")   then return 2;
  if eqt("band")  then return 3;
  if eqt("bor")   then return 4;
  if eqt("bxor")  then return 5;
  if eqt("bnot")  then return 6;
  if eqt("len")   then return 7;
  if eqt("addr")  then return 8;
  if eqt("slen")  then return 9;
  if eqt("schar") then return 10;
  if eqt("halt")  then return 11;
  if eqt("argc")  then return 12;
  if eqt("argch") then return 13;
  if eqt("sadr")  then return 14;
  if eqt("scan")  then return 15;
  if eqt("winapi") then return 16;
  if eqt("winproc") then return 19;
  if eqt("poke")  then return 17;
  if eqt("peek")  then return 18;
  if eqt("trunc") then return 28;
  if eqt("round") then return 29;
  if eqt("sqrt")  then return 30;
  if eqt("pack32") then return 31;
  if eqt("unpack32") then return 32;
  if eqt("view")  then return 33;
  if eqt("sys1")  then return 21;
  if eqt("sys2")  then return 22;
  if eqt("sys3")  then return 23;
  if eqt("sys4")  then return 24;
  if eqt("sys5")  then return 25;
  if eqt("sys6")  then return 26;
  return 0;
end;

// Emit in rax the address a designator denotes.  The head variable is
// li/gi (already scanned, with the token after it read); fpath holds the
// field path that was split off its dotted name.  Consumes any further
// "[index]" and ".field" steps.  Returns the type reached; refisarr, refet,
// reflo, refhi and refdyn describe it (an array is 1 = static, 2 = an
// array parameter whose length lives at [rbp+refdyn]).
function pathaddr(li: int; gi: int): int;
var isarr, lo, hi, et, dyn, pend, t, ok, sz, a, b, f, b1, b2, b3: int;
begin
  if (li < 0) and (gi < 0) then fail("undeclared identifier");
  dyn := 0;
  if li >= 0 then
  begin
    if lkind[li] = SK_CONST then fail("cannot assign to or take the address of a constant");
    isarr := larr[li]; lo := llo[li]; hi := lhi[li]; et := ltyp[li]; dyn := loff[li] - 8;
    if isarr = 2 then
    begin
      e(0x48); e(0x8B); e(0x85); e32(loff[li]);
    end
    else lea_local(loff[li]);
  end
  else
  begin
    if gkind[gi] = SK_CONST then fail("cannot assign to or take the address of a constant");
    isarr := garr[gi]; lo := glo[gi]; hi := ghi[gi]; et := gtyp[gi];
    immbss(gval[gi]);
  end;
  pend := 0; a := 0; refidx := 0;
  while true do
  begin
    if a < fplen then
    begin
      b := a;
      while (b < fplen) and (fpath[b] <> '.') do b := b + 1;
      if (isarr <> 0) or (et < T_REC) then fail("only a record has fields");
      f := findfield(et, a, b);
      pend := pend + fdoff[f];
      isarr := fdarr[f]; lo := fdlo[f]; hi := fdhi[f]; et := fdtyp[f];
      a := b + 1;
      continue;
    end;
    if tok = 46 then
    begin
      next;
      if tok <> TK_ID then fail("field name expected after .");
      fplen := 0;
      while tbuf[fplen] <> chr(0) do
      begin
        fpath[fplen] := tbuf[fplen];
        fplen := fplen + 1;
      end;
      fpath[fplen] := chr(0);
      a := 0;
      next;
      continue;
    end;
    if tok = 91 then
    begin
      if isarr = 0 then fail("subscript applied to a variable that is not an array");
      if pend <> 0 then
      begin
        e(0x48); e(0x05); e32(pend);
        pend := 0;
      end;
      push;
      next;
      t := expr;
      want(t, T_INT, "array index");
      if tok = TK_RANGE then
      begin
        // a slice: [lo..hi], inclusive like a declaration
        if allowslice = 0 then fail("a slice can only be passed as an array argument");
        next;
        push;
        t := expr;
        want(t, T_INT, "slice bound");
        if tok <> 93 then fail("missing ] after the slice");
        next;
        if (isarr <> 2) and (lo <> 0) then
        begin
          e(0x48); e(0x2D); e32(lo);
        end;
        e(0x48); e(0x89); e(0xC1);
        e(0x58);
        if (isarr <> 2) and (lo <> 0) then
        begin
          e(0x48); e(0x2D); e32(lo);
        end;
        e(0x4C); e(0x8D); e(0x59); e(0x01);
        if isarr = 2 then
        begin
          e(0x48); e(0x3B); e(0x85); e32(dyn);
        end
        else
        begin
          e(0x48); e(0x3D); e32(hi - lo + 1);
        end;
        b1 := jfwd(0x0F, 0x87);
        if isarr = 2 then
        begin
          e(0x4C); e(0x3B); e(0x9D); e32(dyn);
        end
        else
        begin
          e(0x49); e(0x81); e(0xFB); e32(hi - lo + 1);
        end;
        b2 := jfwd(0x0F, 0x87);
        e(0x49); e(0x39); e(0xC3);
        b3 := jfwd(0x0F, 0x8C);
        ok := jfwd(0, 0xE9);
        patch(b1); patch(b2); patch(b3);
        trap("slice lies outside the array");
        patch(ok);
        e(0x49); e(0x29); e(0xC3);
        sz := tsize(et);
        if sz = 8 then
        begin
          e(0x48); e(0xC1); e(0xE0); e(3);
        end
        else if sz <> 1 then
        begin
          e(0x48); e(0x69); e(0xC0); e32(sz);
        end;
        popc; e(0x48); e(0x01); e(0xC8);
        refisarr := 3; refet := et; reflo := lo; refhi := hi; refdyn := dyn;
        fplen := 0;
        return et;
      end;
      if tok <> 93 then fail("missing ] after array index");

      // THE SAME COMPILE-TIME CHECK AS IN elemsetup, at the second place an index is
      // parsed -- this one is the path expression (a.b[i]). Both sites need it or the
      // refusal depends on which shape the subscript appeared in, which is exactly the
      // sort of inconsistency that makes a rule feel arbitrary.
      //
      // isarr = 2 is an `array of T` parameter, whose length only the caller knows.
      if (isarr <> 2) and (lvkind = 1) then
        if (lvimm < lo) or (lvimm > hi) then
          fail("array index out of range at compile time");

      next;
      if isarr = 2 then
      begin
        e(0x48); e(0x3B); e(0x85); e32(dyn);
        ok := jfwd(0x0F, 0x82);
      end
      else
      begin
        if lo <> 0 then
        begin
          e(0x48); e(0x2D); e32(lo);
        end;
        e(0x48); e(0x3D); e32(hi - lo);
        ok := jfwd(0x0F, 0x86);
      end;
      trap("array index out of range");
      patch(ok);
      sz := tsize(et);
      if sz = 8 then
      begin
        e(0x48); e(0xC1); e(0xE0); e(3);
      end
      else if sz <> 1 then
      begin
        e(0x48); e(0x69); e(0xC0); e32(sz);
      end;
      popc; e(0x48); e(0x01); e(0xC8);
      isarr := 0; refidx := refidx + 1;
      continue;
    end;
    break;
  end;
  if pend <> 0 then
  begin
    e(0x48); e(0x05); e32(pend);
  end;
  refisarr := isarr; refet := et; reflo := lo; refhi := hi; refdyn := dyn;
  fplen := 0;
  return et;
end;

// Scan the name in tbuf as a designator head: sets spli/spgi and fpath.
function resolvevar: bool;
begin
  fplen := 0;
  spli := findloc; spgi := -1;
  if spli < 0 then spgi := findglob;
  if (spli >= 0) or (spgi >= 0) then return true;
  return splitname;
end;

// rax := the element count of the array a designator reached
procedure reflen;
begin
  if refisarr = 2 then
  begin
    e(0x48); e(0x8B); e(0x85); e32(refdyn);
  end
  else imm(refhi - reflo + 1);
end;

function zlen(a: array of char; at: int): int; forward;
function impname(i: int): str; forward;
function extcount(e: int): int; forward;
function dllname(d: int): str; forward;
function dllfirst(d: int): int; forward;
function ndll: int; forward;
// The IAT slot of extra import i. Every DLL before it contributed its functions plus one
// null terminator, which is why the slot runs ahead of the name index.
// Case-insensitive compare of a name in extnam against a literal: DLL names differ in
// case between sources ("user32.dll") and the import table ("USER32.dll").
function eqname(at: int; n: int; lit: str): bool;
var i, a, b: int;
begin
  if n <> slen(lit) then return false;
  i := 0;
  while i < n do
  begin
    a := ord(extnam[at + i]); b := ord(schar(lit, i));
    if (a >= 65) and (a <= 90) then a := a + 32;
    if (b >= 65) and (b <= 90) then b := b + 32;
    if a <> b then return false;
    i := i + 1;
  end;
  return true;
end;

// The slot of a function in a built-in DLL, when the source named it instead of using the
// number. -1 when that DLL does not export it here; the caller then reports it.
function builtinslot(d: int; fn: int; fl: int): int;
var i: int;
begin
  i := dllfirst(d);
  while i < dllfirst(d + 1) do
  begin
    if eqname(fn, fl, impname(i)) then return i + d;
    i := i + 1;
  end;
  return 0 - 1;
end;

function extiat(i: int): int;
var k, pos: int;
begin
  // The name table is written GROUPED BY DLL while imports are recorded in the order the
  // source names them, so the position is not i: it is how many imports of earlier DLLs
  // come first, plus how many of its own came before it. Using i directly handed out a
  // slot the loader never fills as soon as a source named a user32 function before a
  // gdi32 one -- a call to address zero, far from the call that caused it.
  pos := 0; k := 0;
  while k < next_ do
  begin
    if extdll[k] < extdll[i] then pos := pos + 1
    else if (extdll[k] = extdll[i]) and (k < i) then pos := pos + 1;
    k := k + 1;
  end;
  return NIMP + pos + 4 + extdll[i];
end;

function extslot(dl: int; dn: int; fn: int; fl: int): int; forward;
procedure argint; forward;
procedure lparen; forward;
procedure rparen; forward;
procedure comma; forward;

procedure arrayarg(et: int);
var t, n, i: int;
begin
  if tok = TK_STR then
  begin
    // a literal is an array of char
    if et <> T_CHAR then fail("a string literal can only be passed as an array of char");
    immdata(tval); push;
    n := 0; i := 7;
    while i >= 0 do
    begin
      n := bor(n shl 8, ord(dat[tval - 8 + i]));
      i := i - 1;
    end;
    imm(n); push;
    next;
    return;
  end;
  if tok <> TK_ID then fail("this parameter needs an array");
  if eqt("view") then
  begin
    // view(addr, count): any memory as an array
    next; lparen; argint; push; comma; argint; push; rparen;
    return;
  end;
  if not resolvevar then failundeclared;
  next;
  allowslice := 1;
  t := pathaddr(spli, spgi);
  allowslice := 0;
  if (refisarr = 0) and (t >= T_REC) and (t = et) then
  begin
    // a record passes as a one-element view
    push; imm(1); push;
    return;
  end;
  // A `str` here is worth its own message: a string LITERAL does convert to
  // `array of char` (see above), a str VARIABLE does not, and "this parameter needs an
  // array" says nothing about that difference. Four errors in the log came from exactly
  // this, and the way out is always the same.
  if (refisarr = 0) and (t = T_STR) then
    fail("a str variable is not an array of char; only a string literal converts. Copy it first: n := io.push(buf, 0, s); and pass buf[0..n - 1]");
  if refisarr = 0 then fail("this parameter needs an array");
  if t <> et then want(t, et, "array argument");
  push;
  if refisarr = 3 then
  begin
    e(0x41); e(0x53);
  end
  else
  begin
    reflen; push;
  end;
end;

function callfn(fi: int): int;
var n, t, i, nr: int;
begin
  n := 0;
  nr := 0;
  if tok = 40 then
  begin
    next;
    if tok <> 41 then
    begin
      while true do
      begin
        if n >= fnpar[fi] then fail("too many arguments in call");
        if fparr[fi * MAXP + n] <> 0 then
        begin
          arrayarg(fptyp[fi * MAXP + n]);
          nr := nr + 2;
        end
        else
        begin
          t := expr;
          want(t, fptyp[fi * MAXP + n], "argument");
          push;
          nr := nr + 1;
        end;
        n := n + 1;
        if tok <> 44 then break;
        next;
      end;
    end;
    if tok <> 41 then fail("missing ) in call");
    next;
  end;
  if n <> fnpar[fi] then fail("wrong number of arguments in call");
  i := nr - 1;
  while i >= 0 do
  begin
    popreg(i);
    i := i - 1;
  end;
  e(0xE8); fixup(FX_CALL, fi); e32(0);
  return frtyp[fi];
end;

procedure argint;
var t: int;
begin
  t := expr;
  want(t, T_INT, "builtin argument");
end;

procedure lparen;
begin
  if tok <> 40 then fail("missing ( after builtin");
  next;
end;

procedure rparen;
begin
  if tok <> 41 then fail("missing ) after arguments");
  next;
end;

procedure comma;
begin
  if tok <> 44 then fail("missing , between arguments");
  next;
end;

// winapi(slot, args...): call an imported Windows function through the
// import address table.  The stack is aligned to sixteen bytes and given
// the 32-byte shadow space the convention demands; rsi keeps the old rsp,
// which every Windows function preserves.
// Copy a string literal into extnam, NUL-terminated, and return its offset there. The
// literal pool is rewound between routines, so a name that has to survive until the PE is
// written needs its own copy.
// Does the name in extnam end in ".dll"? Case-insensitive, like everything about DLL names.
function endsdll(at: int; n: int): bool;
var c: int;
begin
  if n < 5 then return false;                 // "x.dll" is the shortest that can be right
  if extnam[at + n - 4] <> '.' then return false;
  c := ord(extnam[at + n - 3]); if (c >= 65) and (c <= 90) then c := c + 32;
  if c <> 100 then return false;              // d
  c := ord(extnam[at + n - 2]); if (c >= 65) and (c <= 90) then c := c + 32;
  if c <> 108 then return false;              // l
  c := ord(extnam[at + n - 1]); if (c >= 65) and (c <= 90) then c := c + 32;
  return c = 108;                             // l
end;

function extput(at: int; n: int): int;
var o, i: int;
begin
  if extnamlen + n + 1 > len(extnam) then return 0 - 1;
  o := extnamlen; i := 0;
  while i < n do begin extnam[o + i] := dat[at + i]; i := i + 1; end;
  extnam[o + n] := chr(0);
  extnamlen := extnamlen + n + 1;
  return o;
end;

// The length of a string literal: it sits in the eight bytes before the text.
function datlen0(at: int): int;
var n, i: int;
begin
  n := 0; i := 7;
  while i >= 0 do begin n := bor(n shl 8, ord(dat[at - 8 + i])); i := i - 1; end;
  return n;
end;

// The call itself: arguments into the Windows registers, stack aligned, then an indirect
// call through the import address table. Shared by both winapi() forms.
function winemit(n: int): int;
var i, frame: int;
begin
  e(0x48); e(0x89); e(0xE6);                   // mov rsi, rsp   -- our arguments live here
  e(0x48); e(0x8B); e(0x86); e32(8 * n);       // mov rax, [rsi + 8n]  -- the IAT slot
  // Space for the call: 32 bytes of shadow the callee may spill into, plus a slot for
  // every argument beyond the fourth, rounded up so rsp stays 16-aligned.
  frame := 32;
  if n > 4 then frame := frame + 8 * (n - 4);
  if (frame mod 16) <> 0 then frame := frame + 8;
  e(0x48); e(0x83); e(0xE4); e(0xF0);          // and rsp, -16
  e(0x48); e(0x81); e(0xEC); e32(frame);       // sub rsp, frame
  // the first four, in registers
  if n > 0 then begin e(0x48); e(0x8B); e(0x8E); e32(8 * (n - 1)); end;   // mov rcx,[rsi+..]
  if n > 1 then begin e(0x48); e(0x8B); e(0x96); e32(8 * (n - 2)); end;   // mov rdx,[rsi+..]
  if n > 2 then begin e(0x4C); e(0x8B); e(0x86); e32(8 * (n - 3)); end;   // mov r8 ,[rsi+..]
  if n > 3 then begin e(0x4C); e(0x8B); e(0x8E); e32(8 * (n - 4)); end;   // mov r9 ,[rsi+..]
  // and the rest, onto the stack where the convention expects them
  i := 4;
  while i < n do
  begin
    e(0x4C); e(0x8B); e(0x96); e32(8 * (n - 1 - i));      // mov r10, [rsi + 8*(n-1-i)]
    e(0x4C); e(0x89); e(0x54); e(0x24); e(8 * i);         // mov [rsp + 8i], r10
    i := i + 1;
  end;
  e(0x48); e(0x8D); e(0x3D); fixup(FX_IAT, 0); e32(0);    // lea rdi, [rip + iat]
  e(0xFF); e(0x14); e(0xC7);                              // call [rdi + rax*8]
  e(0x48); e(0x89); e(0xF4);                              // mov rsp, rsi
  // drop the arguments and the slot we pushed
  e(0x48); e(0x81); e(0xC4); e32(8 * (n + 1));            // add rsp, 8*(n+1)
  return T_INT;
end;

// The routine whose name is the token we are looking at, or -1.
function fnbyname2: int;
var i, j: int;
begin
  i := 0;
  while i < nfn do
  begin
    j := 0;
    while (namesb(fnam[i] + j) = ord(tbuf[j])) and (ord(tbuf[j]) <> 0) do j := j + 1;
    if (namesb(fnam[i] + j) = 0) and (ord(tbuf[j]) = 0) then return i;
    i := i + 1;
  end;
  return 0 - 1;
end;

function dowinapi: int;
var n, i, dn, dl, fn, fl, sl: int;
begin
  if winmode = 0 then fail("winapi() is only available in a Windows executable");
  lparen;
  // winapi("user32.dll", "MessageBoxA", ...) -- the source names the import and the
  // compiler records it, so reaching a new DLL function is data rather than a change
  // here. The slot form below stays: every call in the generated runtime uses it.
  if tok = TK_STR then
  begin
    dl := datlen0(tval); dn := extput(tval, dl);
    next;
    if tok <> 44 then fail("winapi(): after a DLL name comes the function name");
    next;
    if tok <> TK_STR then fail("winapi(): the function name must be a string literal");
    fl := datlen0(tval); fn := extput(tval, fl);
    next;
    if (dn < 0) or (fn < 0) then fail("winapi(): too many imported names");
    // What can be judged here IS judged here. Whether the DLL exists and whether it
    // exports this function are the target machine's business -- the loader answers the
    // first, and the second only shows up when the call is reached. But an empty name or
    // a DLL without its extension is wrong on any machine, and saying so costs nothing.
    if dl = 0 then fail("winapi(): the DLL name is empty");
    if fl = 0 then fail("winapi(): the function name is empty");
    if not endsdll(dn, dl) then
      fail("winapi(): a DLL name ends in .dll, for example \"user32.dll\"");
    sl := extslot(dl, dn, fn, fl);
    if sl < 0 then fail("winapi(): too many imported functions or DLLs");
    // The slot cannot be known yet. extiat counts how many imports of the same DLL come
    // BEFORE this one, and a later winapi() call naming that same DLL still has to be
    // parsed -- so a value baked in here is one short as soon as imports interleave, and
    // the call lands on a null terminator, which is address zero. Emit the import index
    // and let the writer substitute the slot once every import is recorded.
    if extlast >= 0 then
    begin
      e(0xB8); fixup(FX_SLOT, extlast); e32(0);
    end
    else imm(sl);
    push;
    n := 0;
    while tok = 44 do
    begin
      next;
      if n >= 15 then fail("winapi() takes at most fifteen arguments");
      argint; push;
      n := n + 1;
    end;
    rparen;
    return winemit(n);
  end;
  // A slot is an index into the import address table, so a wrong one is a call to
  // whatever happens to sit there: no message, no crash at a recognisable place, just
  // wrong behaviour. When the slot is a literal -- which is how every call in lib/ writes
  // it -- the compiler knows enough to refuse, so it does.
  if tok = TK_INT then
    if (tval < 0) or (tval >= NIMP) then
      fail("winapi(): that import slot does not exist");
  argint; push;
  n := 0;
  while tok = 44 do
  begin
    next;
    if n >= 15 then fail("winapi() takes at most fifteen arguments");
    argint; push;
    n := n + 1;
  end;
  rparen;
  return winemit(n);
end;

function dobuiltin(b: int): int;
var t, ok, bad, li, gi, n, i, nsys: int;
begin
  if b = 1 then
  begin
    lparen; t := expr; want(t, T_CHAR, "ord"); rparen;
    return T_INT;
  end;
  if b = 2 then
  begin
    lparen; argint; rparen;
    e(0x48); e(0x3D); e32(255);
    ok := jfwd(0x0F, 0x86);
    trap("chr() argument outside 0..255");
    patch(ok);
    return T_CHAR;
  end;
  if (b >= 3) and (b <= 5) then
  begin
    lparen; argint; push; comma; argint; rparen;
    xchgac;
    e(0x48);
    if b = 3 then e(0x21) else if b = 4 then e(0x09) else e(0x31);
    e(0xC8);
    return T_INT;
  end;
  if b = 6 then
  begin
    lparen; argint; rparen;
    e(0x48); e(0xF7); e(0xD0);
    return T_INT;
  end;
  if b = 7 then
  begin
    lparen;
    if tok <> TK_ID then fail("len() needs an array name");
    if not resolvevar then failundeclared;
    next;
    n := codelen; i := nfx;
    t := pathaddr(spli, spgi);
    if refisarr = 0 then fail("len() needs an array name");
    if refidx = 0 then
    begin
      codelen := n; nfx := i;
    end;
    reflen;
    rparen;
    return T_INT;
  end;
  if b = 8 then
  begin
    lparen;
    if tok <> TK_ID then fail("addr() needs a variable");
    if not resolvevar then failundeclared;
    next;
    t := pathaddr(spli, spgi);
    rparen;
    return T_INT;
  end;
  if b = 9 then
  begin
    // slen reads the eight bytes BEFORE the text, where the length sits. A str variable
    // that was never assigned is (address 0, length 0) -- variables are zeroed, the spec
    // says so -- and reading [rax-8] then dereferences address -8 and the process dies
    // with a segfault and no message at all. In a language where every array index is
    // checked, that is the one hole.
    //
    // So: a null address answers 0, which is the length such a string has. Two
    // instructions, and it makes the zeroing promise true instead of an exception to it.
    lparen; t := expr; want(t, T_STR, "slen"); rparen;
    e(0x48); e(0x85); e(0xC0);                  // test rax, rax
    ok := jfwd(0x0F, 0x84);                     // je -> leave rax at 0
    e(0x48); e(0x8B); e(0x40); e(0xF8);         // mov rax, [rax-8]
    patch(ok);
    return T_INT;
  end;
  if b = 10 then
  begin
    // The bound lives in the eight bytes BEFORE the text, so comparing the index against
    // it is itself a dereference: on a zeroed str (address 0) the cmp below read address
    // -8 and the process died with a segfault before its own trap could fire. The guard
    // was present and correct -- it was unreachable. A check that has to dereference its
    // own operand does not protect against a broken operand.
    //
    // A null address therefore traps: index 0 lies outside 0..-1, which is exactly the
    // message already emitted here. Note the difference with slen, which ANSWERS 0: the
    // length of an empty string is 0, but the character at position 0 does not exist.
    lparen; t := expr; want(t, T_STR, "schar"); push;
    comma; argint; rparen;
    popc;
    e(0x48); e(0x85); e(0xC9);                  // test rcx, rcx   (rcx = the string)
    bad := jfwd(0x0F, 0x84);                    // je -> the trap below
    e(0x48); e(0x3B); e(0x41); e(0xF8);
    ok := jfwd(0x0F, 0x82);
    patch(bad);
    trap("string index out of range");
    patch(ok);
    e(0x48); e(0x01); e(0xC8);
    e(0x48); e(0x0F); e(0xB6); e(0x00);
    return T_CHAR;
  end;
  if b = 11 then
  begin
    lparen; argint; rparen;
    e(0x48); e(0x89); e(0xC7);
    imm(231); syscallinsn;
    return T_VOID;
  end;
  if b = 16 then return dowinapi;
  if b = 19 then
  begin
    // winproc(name): the address of a routine, as an int, so Windows can call it back.
    //
    // This is NOT addr() on a routine and deliberately not spelled like it. It exists for
    // one thing -- a callback an API demands -- and the name says so. Opening addr() to
    // every routine would put a function pointer in a language that does not have one; a
    // separate builtin keeps the door exactly as wide as the need.
    if winmode = 0 then fail("winproc() is only available in a Windows executable");
    lparen;
    if tok <> TK_ID then fail("winproc() takes the name of a routine");
    li := fnbyname2;
    if li < 0 then fail("winproc(): no such routine");
    next; rparen;
    //
    // An ADAPTER, not the routine's own address. Windows hands a callback its arguments in
    // rcx, rdx, r8, r9; a Wantzel routine expects them in rdi, rsi, rdx, rcx. Returning the
    // bare address would compile and then read the wrong registers -- the kind of failure
    // that shows up as nonsense rather than as an error.
    //
    // So the compiler emits a small shim next to the code and hands back ITS address. The
    // shim moves the four registers across and calls the routine. Four is not a limit we
    // picked: it is how many the Windows convention passes in registers, and every callback
    // in the Win32 surface -- window procedures, dialog procedures, enumerators, hooks,
    // timers, comparators -- fits in it. A callback that takes fewer simply ignores the
    // rest, so this shape does not need revisiting per API.
    //
    // rcx and rdx have to go via r10/r11 because writing rdi first would destroy rcx
    // before it has been read.
    gi := jfwd(0, 0xE9);                         // jump over the shim
    n := codelen;                                // the shim's address
    // rdi, rsi and rbx are NONVOLATILE on Windows and VOLATILE on Linux -- the one place
    // the two conventions disagree about who owns a register. Wantzel routines use rdi and
    // rsi for their first two parameters, so a callback that did not save them would hand
    // Windows back its own registers with our values in them. That is not a crash at the
    // call; it is a crash later, somewhere else, which is the worst kind.
    e(0x57);                                     // push rdi
    e(0x56);                                     // push rsi
    e(0x53);                                     // push rbx
    e(0x49); e(0x89); e(0xCA);                   // mov r10, rcx
    e(0x49); e(0x89); e(0xD3);                   // mov r11, rdx
    e(0x4C); e(0x89); e(0xD7);                   // mov rdi, r10
    e(0x4C); e(0x89); e(0xDE);                   // mov rsi, r11
    e(0x4C); e(0x89); e(0xC2);                   // mov rdx, r8
    e(0x4C); e(0x89); e(0xC9);                   // mov rcx, r9
    // 32 bytes of shadow space, which the CALLER must provide on this platform. Three
    // pushes plus the return address already leave rsp 16-aligned, so 32 keeps it so.
    e(0x48); e(0x83); e(0xEC); e(0x20);          // sub rsp, 32
    e(0xE8); fixup(FX_CALL, li); e32(0);         // call the routine
    e(0x48); e(0x83); e(0xC4); e(0x20);          // add rsp, 32
    e(0x5B);                                     // pop rbx
    e(0x5E);                                     // pop rsi
    e(0x5F);                                     // pop rdi
    e(0xC3);                                     // ret, with the result already in rax
    patch(gi);
    e(0x48); e(0xB8); fixup(FX_SHIM, n); e64(0); // mov rax, <address of the shim>
    return T_INT;
  end;
  if b = 17 then
  begin
    // poke(addr, byte): store one byte at an absolute address
    lparen; argint; push; comma; argint; rparen;
    popc;
    e(0x88); e(0x01);
    return T_VOID;
  end;
  if b = 18 then
  begin
    // peek(addr): read one byte from an absolute address
    lparen; argint; rparen;
    e(0x48); e(0x0F); e(0xB6); e(0x00);
    return T_INT;
  end;
  if b = 14 then
  begin
    lparen; t := expr; want(t, T_STR, "sadr"); rparen;
    return T_INT;
  end;
  if b = 15 then
  begin
    lparen;
    arrayarg(T_CHAR);
    comma; argint; push;
    comma; argint; push;
    comma; t := expr; want(t, T_CHAR, "scan"); push;
    rparen;
    e(0x41); e(0x58);
    e(0x59);
    e(0x5A);
    e(0x5E);
    e(0x5F);
    e(0x48); e(0x39); e(0xCA);
    n := jfwd(0x0F, 0x87);
    e(0x48); e(0x39); e(0xF1);
    ok := jfwd(0x0F, 0x86);
    patch(n);
    trap("scan() range lies outside the array");
    patch(ok);
    e(0xE8); e32(scanaddr - (codelen + 4));
    return T_INT;
  end;
  if b = 12 then
  begin
    lparen; rparen;
    immbss(0); e(0x48); e(0x8B); e(0x00); e(0x48); e(0x8B); e(0x00);
    return T_INT;
  end;
  if b = 13 then
  begin
    lparen; argint; push; comma; argint; rparen;
    push;
    e(0x5E); e(0x5F);
    e(0xE8); e32(argaddr - (codelen + 4));
    return T_CHAR;
  end;
  if (b = 28) or (b = 29) then
  begin
    // trunc(real): int, round(real): int
    lparen; t := expr; want(t, T_REAL, "trunc/round"); rparen;
    xmm0rax;
    e(0xF2); e(0x48); e(0x0F);
    if b = 28 then e(0x2C) else e(0x2D);
    e(0xC0);
    return T_INT;
  end;
  if b = 30 then
  begin
    // sqrt(real): real
    lparen; t := expr; want(t, T_REAL, "sqrt"); rparen;
    xmm0rax;
    e(0xF2); e(0x0F); e(0x51); e(0xC0);
    raxxmm0;
    return T_REAL;
  end;
  if b = 31 then
  begin
    // pack32(real): int -- the IEEE single bits
    lparen; t := expr; want(t, T_REAL, "pack32"); rparen;
    xmm0rax;
    e(0xF2); e(0x0F); e(0x5A); e(0xC0);
    e(0x66); e(0x0F); e(0x7E); e(0xC0);
    return T_INT;
  end;
  if b = 33 then fail("view(addr, count) can only be passed where an array parameter is expected");
  if b = 32 then
  begin
    // unpack32(int): real
    lparen; argint; rparen;
    e(0x66); e(0x0F); e(0x6E); e(0xC0);
    e(0xF3); e(0x0F); e(0x5A); e(0xC0);
    raxxmm0;
    return T_REAL;
  end;
  nsys := b - 20;
  lparen;
  argint; push;
  n := 0;
  while n < nsys do
  begin
    comma; argint; push;
    n := n + 1;
  end;
  rparen;
  i := nsys - 1;
  while i >= 0 do
  begin
    popsys(i);
    i := i - 1;
  end;
  e(0x58);
  syscallinsn;
  return T_INT;
end;

function factor: int;
var t, b, fi, li, gi, sp, sf: int;
begin
  lvpos := codelen; lvfx := nfx; lvkind := 0;
  if tok = TK_INT then
  begin
    imm(tval); next;
    lvkind := 1; lvimm := tval; lvtype := T_INT;
    return T_INT;
  end;
  if tok = TK_CHR then
  begin
    imm(tval); next;
    lvkind := 1; lvimm := tval; lvtype := T_CHAR;
    return T_CHAR;
  end;
  if tok = TK_REAL then
  begin
    imm(tval); next;
    return T_REAL;
  end;
  if tok = KW_REAL then
  begin
    // real(int): real
    next; lparen; argint; rparen;
    xmm0rax;
    e(0xF2); e(0x48); e(0x0F); e(0x2A); e(0xC0);
    raxxmm0;
    return T_REAL;
  end;
  if tok = TK_STR then begin immdata(tval); next; return T_STR; end;
  if tok = KW_TRUE then begin imm(1); next; return T_BOOL; end;
  if tok = KW_FALSE then begin imm(0); next; return T_BOOL; end;
  if tok = 40 then
  begin
    next;
    t := expr;
    if tok <> 41 then fail("missing )");
    next;
    lvkind := 0;
    return t;
  end;
  if tok = 45 then
  begin
    next;
    sp := codelen; sf := nfx;
    t := factor;
    if t = T_REAL then
    begin
      e(0x48); e(0x0F); e(0xBA); e(0xF8); e(63);
      lvkind := 0;
      return T_REAL;
    end;
    want(t, T_INT, "unary -");
    if lvkind = 1 then
    begin
      codelen := sp; nfx := sf;
      imm(0 - lvimm);
      lvimm := 0 - lvimm; lvkind := 1; lvtype := T_INT;
      return T_INT;
    end;
    e(0x48); e(0xF7); e(0xD8);
    lvkind := 0;
    return T_INT;
  end;
  if tok = KW_NOT then
  begin
    next;
    t := factor;
    want(t, T_BOOL, "not");
    e(0x48); e(0x83); e(0xF0); e(1);
    lvkind := 0;
    return T_BOOL;
  end;
  if tok = TK_ID then
  begin
    b := bicode;
    if b <> 0 then
    begin
      next;
      t := dobuiltin(b);
      lvkind := 0;
      return t;
    end;
    fi := findfn;
    li := findloc;
    gi := -1;
    if li < 0 then gi := findglob;
    if (li < 0) and (gi < 0) and (fi >= 0) then
    begin
      next;
      if frtyp[fi] = T_VOID then fail("a procedure has no value");
      t := callfn(fi);
      lvkind := 0;
      return t;
    end;
    if (li < 0) and (gi >= 0) and (gkind[gi] = SK_CONST) then
    begin
      if gtyp[gi] = T_STR then
      begin
        immdata(gval[gi]);
        next;
        return T_STR;
      end;
      imm(gval[gi]);
      next;
      if gtyp[gi] = T_REAL then return T_REAL;
      lvkind := 1; lvimm := gval[gi]; lvtype := gtyp[gi];
      return gtyp[gi];
    end;
    if li >= 0 then
    begin
      if lkind[li] = SK_CONST then
      begin
        if ltyp[li] = T_STR then
        begin
          immdata(loff[li]);
          next;
          return T_STR;
        end;
        imm(loff[li]);
        next;
        if ltyp[li] = T_REAL then return T_REAL;
        lvkind := 1; lvimm := loff[li]; lvtype := ltyp[li];
        return ltyp[li];
      end;
    end;
    fplen := 0;
    if (li < 0) and (gi < 0) then
    begin
      if not splitname then failundeclared;
      li := spli; gi := spgi;
    end;
    next;
    if (fplen = 0) and (tok = 91) then
    begin
      if li >= 0 then t := ltyp[li] else t := gtyp[gi];
      if t < T_REC then
      begin
        t := elemsetup(li, gi);
        if tok = 46 then fail("only a record has fields");
        elemload;
        lvkind := 0;
        return t;
      end;
    end;
    if (fplen = 0) and (li >= 0) then
    begin
      if (larr[li] = 0) and (ltyp[li] < T_REC) then
      begin
        loadlocal(loff[li], ltyp[li]);
        lvkind := 2; lvoff := loff[li]; lvtype := ltyp[li];
        return ltyp[li];
      end;
    end;
    if (fplen = 0) and (gi >= 0) then
    begin
      if (garr[gi] = 0) and (gtyp[gi] < T_REC) then
      begin
        if gkind[gi] = SK_CONST then fail("cannot take the value of a constant this way");
        loadglobal(gval[gi], gtyp[gi]);
        lvkind := 3; lvoff := gval[gi]; lvtype := gtyp[gi];
        return gtyp[gi];
      end;
    end;
    t := pathaddr(li, gi);
    if refisarr <> 0 then fail("an array can only be used with a subscript, len() or addr()");
    if t >= T_REC then fail("a record has no value of its own; use its fields");
    loadind(t);
    lvkind := 0;
    return t;
  end;
  fail("expression expected");
  return 0;
end;

function term: int;
var lt, rt, op, ok, lab, pp, pf: int;
    folded: bool;
begin
  lt := factor;
  while (tok = 42) or (tok = 47) or (tok = KW_DIV) or (tok = KW_MOD) or (tok = KW_AND)
        or (tok = KW_SHL) or (tok = KW_SHR) do
  begin
    op := tok;
    next;
    if lt = T_REAL then
    begin
      if (op <> 42) and (op <> 47) then fail("a real supports * and /; use trunc() or round() for integer division");
      push;
      rt := factor;
      want(rt, T_REAL, "arithmetic");
      xchgac;
      if op = 42 then realop(0x59) else realop(0x5E);
      lvkind := 0;
    end
    else if op = 47 then fail("/ divides reals; use div for integers")
    else if op = KW_AND then
    begin
      want(lt, T_BOOL, "and");
      e(0x48); e(0x85); e(0xC0);
      lab := jfwd(0x0F, 0x84);
      rt := factor;
      want(rt, T_BOOL, "and");
      patch(lab);
      lvkind := 0;
      lt := T_BOOL;
    end
    else
    begin
      want(lt, T_INT, "arithmetic");
      pp := codelen; pf := nfx;
      push;
      rt := factor;
      want(rt, T_INT, "arithmetic");
      folded := false;
      if lvkind <> 0 then folded := fold2(op, pp, pf);
      if not folded then
      begin
        xchgac;
        if op = 42 then
        begin
          e(0x48); e(0x0F); e(0xAF); e(0xC1);
        end
        else if op = KW_SHL then
        begin
          e(0x48); e(0xD3); e(0xE0);
        end
        else if op = KW_SHR then
        begin
          e(0x48); e(0xD3); e(0xF8);
        end
        else
        begin
          e(0x48); e(0x85); e(0xC9);
          ok := jfwd(0x0F, 0x85);
          trap("division by zero");
          patch(ok);
          divcode(op);
        end;
      end;
      lvkind := 0;
      lt := T_INT;
    end;
  end;
  return lt;
end;

function simple: int;
var lt, rt, op, lab, pp, pf: int;
    folded: bool;
begin
  lt := term;
  while (tok = 43) or (tok = 45) or (tok = KW_OR) do
  begin
    op := tok;
    next;
    if op = KW_OR then
    begin
      want(lt, T_BOOL, "or");
      e(0x48); e(0x85); e(0xC0);
      lab := jfwd(0x0F, 0x85);
      rt := term;
      want(rt, T_BOOL, "or");
      patch(lab);
      lvkind := 0;
      lt := T_BOOL;
    end
    else if lt = T_REAL then
    begin
      push;
      rt := term;
      want(rt, T_REAL, "arithmetic");
      xchgac;
      if op = 43 then realop(0x58) else realop(0x5C);
      lvkind := 0;
    end
    else
    begin
      want(lt, T_INT, "arithmetic");
      pp := codelen; pf := nfx;
      push;
      rt := term;
      want(rt, T_INT, "arithmetic");
      folded := false;
      if lvkind <> 0 then folded := fold2(op, pp, pf);
      if not folded then
      begin
        xchgac;
        if op = 43 then
        begin
          e(0x48); e(0x01); e(0xC8);
        end
        else
        begin
          e(0x48); e(0x29); e(0xC8);
        end;
      end;
      lvkind := 0;
      lt := T_INT;
    end;
  end;
  return lt;
end;

function expr: int;
var lt, rt, op, cc, pp, pf: int;
    folded: bool;
begin
  lt := simple;
  if (tok = 61) or (tok = TK_NE) or (tok = 60) or (tok = 62)
     or (tok = TK_LE) or (tok = TK_GE) then
  begin
    op := tok;
    next;
    pp := codelen; pf := nfx;
    push;
    rt := simple;
    if lt <> rt then want(rt, lt, "comparison");
    if (op = 61) or (op = TK_NE) then
    begin
      if lt = T_STR then fail("strings cannot be compared with = or <>; compare their characters");
      if lt = T_VOID then fail("cannot compare these values");
    end
    else
    begin
      if (lt <> T_INT) and (lt <> T_CHAR) and (lt <> T_REAL) then fail("only int, char and real can be ordered");
    end;
    if lt = T_REAL then
    begin
      xchgac;
      xmm0rax; xmm1rcx;
      e(0x66); e(0x0F);
      if (op = 61) or (op = TK_NE) then e(0x2E) else e(0x2F);
      e(0xC1);
      lvkind := 0;
      if op = 61 then
      begin
        e(0x0F); e(0x94); e(0xC0);
        e(0x0F); e(0x9B); e(0xC1);
        e(0x20); e(0xC8);
      end
      else if op = TK_NE then
      begin
        e(0x0F); e(0x95); e(0xC0);
        e(0x0F); e(0x9A); e(0xC1);
        e(0x08); e(0xC8);
      end
      else
      begin
        if op = 60 then cc := 0x92
        else if op = 62 then cc := 0x97
        else if op = TK_LE then cc := 0x96
        else cc := 0x93;
        e(0x0F); e(cc); e(0xC0);
      end;
      e(0x48); e(0x0F); e(0xB6); e(0xC0);
      return T_BOOL;
    end;
    folded := false;
    if lvkind <> 0 then folded := fold2(0, pp, pf);
    if not folded then
    begin
      xchgac;
      e(0x48); e(0x39); e(0xC8);
    end;
    lvkind := 0;
    if op = 61 then cc := 0x94
    else if op = TK_NE then cc := 0x95
    else if op = 60 then cc := 0x9C
    else if op = 62 then cc := 0x9F
    else if op = TK_LE then cc := 0x9E
    else cc := 0x9D;
    e(0x0F); e(cc); e(0xC0);
    e(0x48); e(0x0F); e(0xB6); e(0xC0);
    return T_BOOL;
  end;
  return lt;
end;

// ------------------------------------------------------------------
// statements
// ------------------------------------------------------------------

procedure stmt; forward;

function condition(ctx: str): int;
var t: int;
begin
  t := expr;
  want(t, T_BOOL, ctx);
  e(0x48); e(0x85); e(0xC0);
  return jfwd(0x0F, 0x84);
end;

procedure epilogue;
begin
  e(0x48); e(0x89); e(0xEC);
  e(0x5D);
  e(0xC3);
end;

procedure stmtlist; forward;
function cexpr: int; forward;

// a hidden 8-byte slot in the current frame
function hidden: int;
begin
  frame := frame + 8;
  return 0 - frame;
end;

// jump chains: each pending rel32 holds the offset of the previous one
function read32(o: int): int;
var v: int;
begin
  v := ord(code[o]);
  v := bor(v, ord(code[o + 1]) shl 8);
  v := bor(v, ord(code[o + 2]) shl 16);
  v := bor(v, ord(code[o + 3]) shl 24);
  return v;
end;

procedure chainpatch(h: int);
var nxt: int;
begin
  while h <> 0 do
  begin
    nxt := read32(h);
    patch(h);
    h := nxt;
  end;
end;

// for v := a to b do s   |   for v := b downto a do s
procedure dofor;
var li, gi, t, slot, down, top, lab, ob, oc, i: int;
begin
  next;
  if tok <> TK_ID then fail("for needs a variable");
  li := findloc; gi := -1;
  if li < 0 then gi := findglob;
  if (li < 0) and (gi < 0) then fail("undeclared identifier");
  if li >= 0 then
  begin
    if (lkind[li] = SK_CONST) or (larr[li] <> 0) or (ltyp[li] <> T_INT) then fail("a for variable is a plain int variable");
  end
  else
  begin
    if (gkind[gi] = SK_CONST) or (garr[gi] <> 0) or (gtyp[gi] <> T_INT) then fail("a for variable is a plain int variable");
  end;
  next;
  if tok <> TK_ASSIGN then fail("missing := in for");
  next;
  t := expr; want(t, T_INT, "for start value");
  if li >= 0 then storelocal(loff[li], T_INT) else storeglobal(gval[gi], T_INT);
  if tok = KW_TO then down := 0
  else if tok = KW_DOWNTO then down := 1
  else fail("missing to or downto");
  next;
  t := expr; want(t, T_INT, "for end value");
  slot := hidden;
  storelocal(slot, T_INT);
  if tok <> KW_DO then fail("missing do");
  next;
  top := codelen;
  if li >= 0 then loadlocal(loff[li], T_INT) else loadglobal(gval[gi], T_INT);
  e(0x48); e(0x3B); e(0x85); e32(slot);
  if down <> 0 then lab := jfwd(0x0F, 0x8C) else lab := jfwd(0x0F, 0x8F);
  ob := brkbase; oc := cntbase; brkbase := nbrk; cntbase := ncnt;
  stmt;
  i := cntbase;
  while i < ncnt do
  begin
    patch(cntfix[i]);
    i := i + 1;
  end;
  if li >= 0 then loadlocal(loff[li], T_INT) else loadglobal(gval[gi], T_INT);
  if down <> 0 then
  begin
    e(0x48); e(0x83); e(0xE8); e(1);
  end
  else
  begin
    e(0x48); e(0x83); e(0xC0); e(1);
  end;
  if li >= 0 then storelocal(loff[li], T_INT) else storeglobal(gval[gi], T_INT);
  jmpto(0, 0xE9, top);
  patch(lab);
  i := brkbase;
  while i < nbrk do
  begin
    patch(brkfix[i]);
    i := i + 1;
  end;
  nbrk := brkbase; ncnt := cntbase; brkbase := ob; cntbase := oc;
end;


procedure stmtlist;
begin
  while true do
  begin
    stmt;
    if tok <> 59 then return;
    next;
  end;
end;

procedure stmt;
var lab, lab2, top, ob, oc, i, t, fi, li, gi, b, sk, so, st: int;
begin
  if tok = KW_BEGIN then
  begin
    next;
    stmtlist;
    if tok <> KW_END then fail("missing end");
    next;
    return;
  end;
  if tok = KW_IF then
  begin
    next;
    lab := condition("if condition");
    if tok <> KW_THEN then fail("missing then");
    next;
    stmt;
    if tok = KW_ELSE then
    begin
      next;
      lab2 := jfwd(0, 0xE9);
      patch(lab);
      stmt;
      patch(lab2);
    end
    else patch(lab);
    return;
  end;
  if tok = KW_WHILE then
  begin
    next;
    top := codelen;
    lab := condition("while condition");
    if tok <> KW_DO then fail("missing do");
    next;
    ob := brkbase; oc := cntbase; brkbase := nbrk; cntbase := ncnt;
    stmt;
    i := cntbase;
    while i < ncnt do
    begin
      e32at(cntfix[i], top - (cntfix[i] + 4));
      i := i + 1;
    end;
    jmpto(0, 0xE9, top);
    patch(lab);
    i := brkbase;
    while i < nbrk do
    begin
      patch(brkfix[i]);
      i := i + 1;
    end;
    nbrk := brkbase; ncnt := cntbase; brkbase := ob; cntbase := oc;
    return;
  end;
  if tok = KW_RETURN then
  begin
    next;
    if curret = T_VOID then
    begin
      if (tok <> 59) and (tok <> KW_END) and (tok <> KW_ELSE) then
        fail("a procedure cannot return a value");
      e(0x48); e(0x31); e(0xC0);
    end
    else
    begin
      t := expr;
      want(t, curret, "return value");
    end;
    epilogue;
    return;
  end;
  if tok = KW_BREAK then
  begin
    next;
    if brkbase < 0 then fail("break outside a loop");
    if nbrk >= 256 then fail("too many break statements");
    brkfix[nbrk] := jfwd(0, 0xE9);
    nbrk := nbrk + 1;
    return;
  end;
  if tok = KW_CONTINUE then
  begin
    next;
    if cntbase < 0 then fail("continue outside a loop");
    if ncnt >= 256 then fail("too many continue statements");
    cntfix[ncnt] := jfwd(0, 0xE9);
    ncnt := ncnt + 1;
    return;
  end;
  if tok = KW_FOR then
  begin
    dofor;
    return;
  end;
  if tok = KW_ELSE then fail("unexpected else (no ';' may precede it)");
  if (tok = TK_ID) and eqt("case") then fail("'case' is no longer part of the language; write an if-chain: if x = a then ... else if x = b then ... else ...");
  if (tok = TK_ID) and eqt("repeat") then fail("'repeat ... until' is no longer part of the language; write 'while true do begin ... if done then break; end'");
  if tok = TK_ID then
  begin
    b := bicode;
    if b <> 0 then
    begin
      next;
      t := dobuiltin(b);
      if (t <> T_VOID) and (b <> 16) and ((b < 21) or (b > 26)) then fail("the value of this call is not used");
      return;
    end;
    li := findloc;
    gi := -1;
    if li < 0 then gi := findglob;
    fplen := 0;
    if (li < 0) and (gi < 0) then
    begin
      fi := findfn;
      if fi >= 0 then
      begin
        next;
        if frtyp[fi] <> T_VOID then fail("the value of this function call is not used");
        t := callfn(fi);
        return;
      end;
      if not splitname then failundeclared;
      li := spli; gi := spgi;
    end;
    next;
    if li >= 0 then
    begin
      if lkind[li] = SK_CONST then fail("cannot assign to or take the address of a constant");
    end;
    if (fplen = 0) and (tok = TK_ASSIGN) and (li >= 0) then
    begin
      if (larr[li] = 0) and (ltyp[li] < T_REC) then
      begin
        t := ltyp[li];
        next;
        i := expr;
        want(i, t, "assignment");
        storelocal(loff[li], t);
        return;
      end;
    end;
    if (fplen = 0) and (tok = TK_ASSIGN) and (li < 0) and (gi >= 0) then
    begin
      if (garr[gi] = 0) and (gkind[gi] = SK_VAR) and (gtyp[gi] < T_REC) then
      begin
        t := gtyp[gi];
        next;
        i := expr;
        want(i, t, "assignment");
        storeglobal(gval[gi], t);
        return;
      end;
    end;
    if (fplen = 0) and (tok = 91) then
    begin
      if li >= 0 then t := ltyp[li] else t := gtyp[gi];
      if t < T_REC then
      begin
        t := elemsetup(li, gi);
        if tok = 46 then fail("only a record has fields");
        sk := elkind; so := eloff; st := eltype;
        if tok <> TK_ASSIGN then fail("missing := in assignment");
        next;
        push;
        i := expr;
        want(i, st, "assignment");
        popc;
        elkind := sk; eloff := so; eltype := st;
        elemstore;
        return;
      end;
    end;
    t := pathaddr(li, gi);
    if tok <> TK_ASSIGN then fail("missing := in assignment");
    next;
    if refisarr <> 0 then fail("an array cannot be assigned as a whole");
    push;
    if t >= T_REC then
    begin
      // whole-record copy
      if tok <> TK_ID then fail("a record can only be assigned from another record");
      if not resolvevar then failundeclared;
      next;
      i := pathaddr(spli, spgi);
      if (i <> t) or (refisarr <> 0) then fail("record types differ in assignment");
      e(0x48); e(0x89); e(0xC6);
      e(0x5F);
      e(0x48); e(0xC7); e(0xC1); e32(tsize(t));
      e(0xF3); e(0xA4);
      return;
    end;
    i := expr;
    want(i, t, "assignment");
    popc;
    storeind(t);
    return;
  end;
end;

// ------------------------------------------------------------------
// declarations
// ------------------------------------------------------------------

function cfactor: int;
var v, gi: int;
begin
  if tok = TK_INT then
  begin
    v := tval;
    next;
    return v;
  end;
  if tok = 45 then
  begin
    next;
    return 0 - cfactor;
  end;
  if tok = 40 then
  begin
    next;
    v := cexpr;
    if tok <> 41 then fail("missing )");
    next;
    return v;
  end;
  if tok = TK_ID then
  begin
    gi := findloc;
    if gi >= 0 then
    begin
      if lkind[gi] <> SK_CONST then fail("a constant is required here");
      if ltyp[gi] <> T_INT then fail("an integer constant is required here");
      v := loff[gi];
      next;
      return v;
    end;
    gi := findglob;
    if gi < 0 then fail("undeclared constant");
    if gkind[gi] <> SK_CONST then fail("a constant is required here");
    if gtyp[gi] <> T_INT then fail("an integer constant is required here");
    v := gval[gi];
    next;
    return v;
  end;
  fail("constant expression expected");
  return 0;
end;

function cterm: int;
var v: int;
begin
  v := cfactor;
  while tok = 42 do
  begin
    next;
    v := v * cfactor;
  end;
  return v;
end;

// continue a constant expression whose first term is already known
function cexprfrom(v: int): int;
var op: int;
begin
  while (tok = 43) or (tok = 45) do
  begin
    op := tok;
    next;
    if op = 43 then v := v + cterm else v := v - cterm;
  end;
  return v;
end;

function cexpr: int;
begin
  return cexprfrom(cterm);
end;

function basetype: int;
var t: int;
begin
  if tok = KW_INT then t := T_INT
  else if tok = KW_CHAR then t := T_CHAR
  else if tok = KW_BOOL then t := T_BOOL
  else if tok = KW_STR then t := T_STR
  else if tok = KW_REAL then t := T_REAL
  else if tok = TK_ID then
  begin
    t := findtype;
    if t < 0 then fail("type expected");
    t := T_REC + t;
  end
  else
  begin
    fail("type expected");
    return 0;
  end;
  next;
  return t;
end;

function partype: int;
var t: int;
begin
  ptarr := 0; ptlo := 0; pthi := 0;
  if tok = KW_ARRAY then
  begin
    next;
    if tok <> 91 then fail("missing [ in array type");
    next;
    ptlo := cexpr;
    if tok <> TK_RANGE then fail("missing .. in array bounds");
    next;
    pthi := cexpr;
    if tok <> 93 then fail("missing ] in array type");
    next;
    if pthi < ptlo then fail("empty array bounds");
    if tok <> KW_OF then fail("missing of in array type");
    next;
    ptarr := 1;
  end;
  t := basetype;
  return t;
end;

procedure declvars(islocal: int);
var n, i, t, sz, nb: int;
begin
  next;
  if tok <> TK_ID then fail("variable name expected");
  while tok = TK_ID do
  begin
    n := 0;
    while true do
    begin
      if bicode <> 0 then fail("that name is built in");
      if findfn >= 0 then failtaken("name already used by a routine");
      if findtype >= 0 then failtaken("name already used by a type");
      if islocal <> 0 then
      begin
        if findloc >= 0 then failtaken("duplicate local declaration");
      end
      else
      begin
        if findglob >= 0 then fail("duplicate global declaration");
      end;
      if n >= 64 then fail("too many names in one declaration");
      tmpnam[n] := intern;
      n := n + 1;
      next;
      if tok <> 44 then break;
      next;
      if tok <> TK_ID then fail("variable name expected");
    end;
    if tok <> 58 then fail("missing : in declaration");
    next;
    t := partype;
    nb := 1;
    if ptarr <> 0 then nb := pthi - ptlo + 1;
    sz := nb * tsize(t);
    while (sz mod 8) <> 0 do sz := sz + 1;
    i := 0;
    while i < n do
    begin
      if islocal <> 0 then
      begin
        if nloc >= MAXL then fail("too many locals");
        lnam[nloc] := tmpnam[i]; ltyp[nloc] := t; lkind[nloc] := SK_VAR;
        larr[nloc] := ptarr; llo[nloc] := ptlo; lhi[nloc] := pthi;
        frame := frame + sz;
        loff[nloc] := 0 - frame;
        nloc := nloc + 1;
      end
      else
      begin
        if ngl >= MAXG then fail("too many globals");
        gnam[ngl] := tmpnam[i]; gkind[ngl] := SK_VAR; gtyp[ngl] := t;
        garr[ngl] := ptarr; glo[ngl] := ptlo; ghi[ngl] := pthi;
        gfile[ngl] := declloc;
        gval[ngl] := bsslen;
        bsslen := bsslen + sz;
        gindex(ngl);
        ngl := ngl + 1;
      end;
      i := i + 1;
    end;
    if tok <> 59 then fail("missing ; after declaration");
    next;
  end;
end;

// type NAME = record <names: type;>... end;
// declschema is defined below but called from decltypes: a schema is now declared with
// 'type X = schema ... end', so the type declaration is what dispatches to it.
procedure declschema; forward;

procedure decltypes;
var r, n, i, t, nb, sz, off, al: int;
begin
  next;
  if tok <> TK_ID then fail("type name expected");
  while tok = TK_ID do
  begin
    if bicode <> 0 then fail("that name is built in");
    if (findglob >= 0) or (findfn >= 0) or (findtype >= 0) then failtaken("duplicate declaration");
    if nrt >= MAXR then fail("too many record types");
    r := nrt;
    // the name, kept as bytes before it is interned: a schema needs it in schname/scnam
    // and we do not know yet which of the two kinds this declaration is
    i := 0;
    while tbuf[i] <> chr(0) do
    begin
      if i >= 62 then fail("type name too long");
      tnamebuf[i] := tbuf[i];
      i := i + 1;
    end;
    tnamebuf[i] := chr(0);
    rtnam[r] := intern; rtf0[r] := nfd; rtnf[r] := 0; rtsize[r] := 0;
    next;
    if tok <> 61 then fail("missing = in type declaration");
    next;
    // TWO KINDS BEHIND THE SAME '=': a record, which is a memory layout, or a schema,
    // which is a JSON contract. They share the notation and nothing else -- declschema
    // touches none of the record tables -- and that is exactly why the notation may be
    // shared: the word after '=' says which kind it is, in the place where a reader
    // already looks for it.
    if tok = KW_SCHEMA then
    begin
      if nsc >= MAXS then fail("too many schemas");
      i := 0;
      while tnamebuf[i] <> chr(0) do
      begin
        schname[i] := tnamebuf[i];
        scnam[nsc * 64 + i] := tnamebuf[i];
        i := i + 1;
      end;
      schname[i] := chr(0);
      scnam[nsc * 64 + i] := chr(0);
      next;
      declschema;
      continue;
    end;
    if tok <> KW_RECORD then fail("a type is declared as 'record ... end' or 'schema ... end'");
    next;
    off := 0;
    while tok = TK_ID do
    begin
      n := 0;
      while true do
      begin
        if n >= 64 then fail("too many names in one declaration");
        i := rtf0[r];
        while i < nfd do
        begin
          if nameq(fdnam[i]) then fail("duplicate field name");
          i := i + 1;
        end;
        tmpnam[n] := intern;
        n := n + 1;
        next;
        if tok <> 44 then break;
        next;
        if tok <> TK_ID then fail("field name expected");
      end;
      if tok <> 58 then fail("missing : in field declaration");
      next;
      t := partype;
      if t = T_REC + r then fail("a record cannot contain itself");
      nb := 1;
      if ptarr <> 0 then nb := pthi - ptlo + 1;
      sz := nb * tsize(t);
      al := 8;
      if tsize(t) = 1 then al := 1;
      i := 0;
      while i < n do
      begin
        if nfd >= MAXRF then fail("too many record fields");
        while (off mod al) <> 0 do off := off + 1;
        fdnam[nfd] := tmpnam[i]; fdtyp[nfd] := t; fdoff[nfd] := off;
        fdarr[nfd] := ptarr; fdlo[nfd] := ptlo; fdhi[nfd] := pthi;
        off := off + sz;
        nfd := nfd + 1;
        rtnf[r] := rtnf[r] + 1;
        i := i + 1;
      end;
      if tok <> 59 then fail("missing ; after a field");
      next;
    end;
    if tok <> KW_END then fail("missing end of the record");
    next;
    if tok <> 59 then fail("missing ; after the type");
    next;
    while (off mod 8) <> 0 do off := off + 1;
    if off = 0 then fail("a record needs at least one field");
    rtsize[r] := off;
    nrt := nrt + 1;
  end;
end;

procedure declconsts(islocal: int);
var o, v, t: int;
begin
  next;
  if tok <> TK_ID then fail("constant name expected");
  while tok = TK_ID do
  begin
    if bicode <> 0 then fail("that name is built in");
    if islocal <> 0 then
    begin
      if findloc >= 0 then failtaken("duplicate local declaration");
    end
    else
    begin
      if (findglob >= 0) or (findfn >= 0) or (findtype >= 0) then failtaken("duplicate declaration");
    end;
    o := intern;
    next;
    if tok <> 61 then fail("missing = in constant declaration");
    next;
    if tok = TK_CHR then
    begin
      v := tval;
      next;
      t := T_CHAR;
    end
    else if tok = TK_STR then
    begin
      v := tval;
      next;
      t := T_STR;
    end
    else if tok = KW_TRUE then
    begin
      next;
      v := 1;
      t := T_BOOL;
    end
    else if tok = KW_FALSE then
    begin
      next;
      v := 0;
      t := T_BOOL;
    end
    else if tok = TK_REAL then
    begin
      v := tval;
      next;
      t := T_REAL;
    end
    else if tok = 45 then
    begin
      next;
      if tok = TK_REAL then
      begin
        v := bxor(tval, 1 shl 63);
        next;
        t := T_REAL;
      end
      else
      begin
        v := cexprfrom(0 - cterm);
        t := T_INT;
      end;
    end
    else
    begin
      v := cexpr;
      t := T_INT;
    end;
    if islocal <> 0 then
    begin
      if nloc >= MAXL then fail("too many locals");
      lnam[nloc] := o; lkind[nloc] := SK_CONST; ltyp[nloc] := t; loff[nloc] := v;
      larr[nloc] := 0; llo[nloc] := 0; lhi[nloc] := 0;
      nloc := nloc + 1;
    end
    else
    begin
      if ngl >= MAXG then fail("too many globals");
      gnam[ngl] := o; gkind[ngl] := SK_CONST; gval[ngl] := v; gtyp[ngl] := t;
      garr[ngl] := 0; glo[ngl] := 0; ghi[ngl] := 0;
      gfile[ngl] := declloc;
      gindex(ngl);
      ngl := ngl + 1;
    end;
    if tok <> 59 then fail("missing ; after constant declaration");
    next;
  end;
end;


// ------------------------------------------------------------------
// schema: parse the declaration, then generate Wantzel source for it
// ------------------------------------------------------------------
// A schema is a record type plus a generated parser, writer and JSON
// Schema text.  The generated text is appended to the source buffer and
// entered through the same mechanism as an include, so it is compiled like
// any other code.

// One byte of generated source, with the room checked BEFORE the write -- the same
// reason as dput above: a check afterwards has already stored the byte that does not
// fit, which turns "the source is too large" into a bounds trap inside this compiler.
procedure sput(c: char);
begin
  if srclen >= SRCMAX then fail("generated source is too large");
  src[srclen] := c;
  srclen := srclen + 1;
end;

procedure gen(t: str);
var i, n: int;
begin
  n := slen(t);
  i := 0;
  while i < n do
  begin
    sput(schar(t, i));
    i := i + 1;
  end;
end;

procedure gennum(v: int);
var n, i: int;
begin
  n := numstr(v);
  i := 0;
  while i < n do
  begin
    sput(nbuf[i]);
    i := i + 1;
  end;
end;

procedure genname;
var i: int;
begin
  i := 0;
  while schname[i] <> chr(0) do
  begin
    sput(schname[i]);
    i := i + 1;
  end;
end;

procedure genfld(f: int);
var i: int;
begin
  i := 0;
  while sfld[f * 64 + i] <> chr(0) do
  begin
    sput(sfld[f * 64 + i]);
    i := i + 1;
  end;
end;

procedure genr(f: int);
begin
  gen("r[0].");
  genfld(f);
end;

procedure gensub(f: int);
var i: int;
begin
  i := 0;
  while scnam[sfsub[f] * 64 + i] <> chr(0) do
  begin
    sput(scnam[sfsub[f] * 64 + i]);
    i := i + 1;
  end;
end;

procedure genjs(f: int);
var i: int;
begin
  i := 0;
  while sfjson[f * 64 + i] <> chr(0) do
  begin
    sput(sfjson[f * 64 + i]);
    i := i + 1;
  end;
end;

procedure genquoted(e: int);
var i: int;
begin
  sput('"');
  i := 0;
  while senum[e * 64 + i] <> chr(0) do
  begin
    sput(senum[e * 64 + i]);
    i := i + 1;
  end;
  sput('"');
end;

procedure genident(e: int);
var i, c: int;
begin
  i := 0;
  while senum[e * 64 + i] <> chr(0) do
  begin
    c := ord(senum[e * 64 + i]);
    if not (isal(c) or isdg(c)) then c := 95;
    sput(chr(c));
    i := i + 1;
  end;
end;

// the Wantzel type of a field's element
procedure genelemtype(f: int);
var t: int;
begin
  t := sftype[f];
  if (t = SF_INT) or (t = SF_ENUM) then gen("int")
  else if t = SF_REAL then gen("real")
  else if t = SF_BOOL then gen("bool")
  else if t = SF_SUB then gensub(f);
end;

// the record fields of one schema field
procedure gendecl(f: int);
var t: int;
begin
  t := sftype[f];
  gen("  ");
  if sfarr[f] <> 0 then
  begin
    if t = SF_TEXTN then
    begin
      genfld(f); gen(": array[0.."); gennum(sfcount[f] * sftlen[f] - 1); gen("] of char;\n  ");
      genfld(f); gen("_len: array[0.."); gennum(sfcount[f] - 1); gen("] of int;\n  ");
    end
    else
    begin
      genfld(f); gen(": array[0.."); gennum(sfcount[f] - 1); gen("] of "); genelemtype(f); gen(";\n  ");
    end;
    genfld(f); gen("_n: int;\n  ");
  end
  else if (t = SF_TEXT) or (t = SF_JSON) then
  begin
    genfld(f); gen("_at: int;\n  "); genfld(f); gen("_end: int;\n  ");
  end
  else if t = SF_TEXTN then
  begin
    genfld(f); gen(": array[0.."); gennum(sftlen[f] - 1); gen("] of char;\n  ");
    genfld(f); gen("_n: int;\n  ");
  end
  else
  begin
    genfld(f); gen(": "); genelemtype(f); gen(";\n  ");
  end;
  genfld(f); gen("_ok: bool;\n  "); genfld(f); gen("_null: bool;\n");
end;

// read one value at `at` into target tgt (0: the field, 1: element v1)
procedure genread(f: int; tgt: int);
var t, ei: int;
begin
  t := sftype[f];
  if t = SF_INT then
  begin
    gen("        at := json.number(b, at, last);\n        if at < 0 then return -1;\n        ");
    genr(f); if tgt <> 0 then gen("[v1]"); gen(" := json.ival;\n");
  end
  else if t = SF_REAL then
  begin
    gen("        at := json.real(b, at, last);\n        if at < 0 then return -1;\n        ");
    genr(f); if tgt <> 0 then gen("[v1]"); gen(" := json.rval;\n");
  end
  else if t = SF_BOOL then
  begin
    gen("        at := json.boolean(b, at, last);\n        if at < 0 then return -1;\n        ");
    genr(f); if tgt <> 0 then gen("[v1]"); gen(" := json.bval;\n");
  end
  else if t = SF_TEXT then
  begin
    gen("        at := json.string(b, at, last);\n        if at < 0 then return -1;\n        ");
    genr(f); gen("_at := json.sat;\n        "); genr(f); gen("_end := json.send;\n");
  end
  else if t = SF_JSON then
  begin
    gen("        v0 := json.ws(b, at, last);\n        at := json.skip(b, at, last);\n        if at < 0 then return -1;\n        ");
    genr(f); gen("_at := v0;\n        "); genr(f); gen("_end := at;\n");
  end
  else if t = SF_ENUM then
  begin
    gen("        at := json.string(b, at, last);\n        if at < 0 then return -1;\n        ");
    genr(f); gen(" := -1;\n");
    ei := 0;
    while ei < sfen[f] do
    begin
      if ei = 0 then gen("        if json.eq(b, json.sat, json.send, ")
      else gen("        else if json.eq(b, json.sat, json.send, ");
      genquoted(sfe0[f] + ei);
      gen(") then "); genr(f); gen(" := "); gennum(ei); gen("\n");
      ei := ei + 1;
    end;
    gen("        else ;\n");
  end
  else if t = SF_TEXTN then
  begin
    gen("        at := json.string(b, at, last);\n        if at < 0 then return -1;\n");
    if tgt <> 0 then
    begin
      gen("        n := json.copystr(b, json.sat, json.send, "); genr(f);
      gen("[v1 * "); gennum(sftlen[f]); gen("..v1 * "); gennum(sftlen[f]); gen(" + "); gennum(sftlen[f] - 1); gen("]);\n");
      gen("        if n < 0 then return -1;\n        "); genr(f); gen("_len[v1] := n;\n");
    end
    else
    begin
      gen("        n := json.copystr(b, json.sat, json.send, "); genr(f); gen(");\n");
      gen("        if n < 0 then return -1;\n        "); genr(f); gen("_n := n;\n");
    end;
  end
  else if t = SF_SUB then
  begin
    gen("        at := "); gensub(f); gen(".parse(b, at, last, "); genr(f);
    if tgt <> 0 then gen("[v1..v1]");
    gen(");\n        if at < 0 then return -1;\n");
  end;
end;

// one "if json.eq(...) then <read the value> end else" arm
procedure genarm(f: int);
begin
  gen("    if json.eq(b, k0, k1, \""); genjs(f); gen("\") then\n    begin\n");
  gen("      if json.isnull(b, at, last) then\n      begin\n");
  gen("        at := json.ws(b, at, last) + 4;\n        "); genr(f); gen("_null := true;\n      end\n      else\n      begin\n");
  if sfarr[f] <> 0 then
  begin
    gen("        at := json.ws(b, at, last);\n        if at >= last then return -1;\n");
    gen("        if b[at] <> '[' then return -1;\n        at := at + 1;\n        v1 := 0;\n");
    gen("        while true do\n        begin\n");
    gen("        at := json.ws(b, at, last);\n        if at >= last then return -1;\n");
    gen("        if b[at] = ']' then\n        begin\n          at := at + 1;\n          break;\n        end;\n");
    gen("        if b[at] = ',' then\n        begin\n          at := at + 1;\n          continue;\n        end;\n");
    gen("        if v1 >= "); gennum(sfcount[f]); gen(" then return -1;\n");
    genread(f, 1);
    gen("        v1 := v1 + 1;\n        end;\n        "); genr(f); gen("_n := v1;\n");
  end
  else genread(f, 0);
  gen("      end;\n      "); genr(f); gen("_ok := true;\n    end\n    else ");
end;

// The truncation test that follows every appending call in a generated writer.
// json.putreal, json.putraw, json.putstr, io.push and io.pushnum truncate at len(dst)
// instead of signalling, so after such a call `at = len(dst)` is the only
// evidence that something was dropped.  For an error message truncation is harmless;
// for a JSON object it is not -- what comes out is not a shorter object but a syntax
// error -- so the writer turns it into the refusal -1 here.
procedure genfull;
begin
  gen("      if at >= len(dst) then return -1;\n");
end;

// write one value; the field (tgt 0) or element v1 (tgt 1)
procedure genput(f: int; tgt: int);
var t, ei: int;
begin
  t := sftype[f];
  if t = SF_INT then
  begin
    gen("      at := io.pushnum(dst, at, "); genr(f); if tgt <> 0 then gen("[v1]"); gen(");\n");
    genfull;
  end
  else if t = SF_REAL then
  begin
    // json.putreal is the one appender that neither truncates nor signals: without room
    // for its longest form (32 bytes of headroom) it writes NOTHING and returns `at`
    // unchanged, which would leave a key with no value at all in the output -- invalid
    // JSON that the len(dst) test below cannot see, because `at` never reached the end.
    // So the room is tested here, before the call, and a refusal comes out instead.
    gen("      if (at < 0) or (at + 32 > len(dst)) then return -1;\n");
    gen("      at := json.putreal(dst, at, "); genr(f); if tgt <> 0 then gen("[v1]"); gen(");\n");
    genfull;
  end
  else if t = SF_BOOL then
  begin
    gen("      if "); genr(f); if tgt <> 0 then gen("[v1]");
    gen(" then at := io.push(dst, at, \"true\") else at := io.push(dst, at, \"false\");\n");
    genfull;
  end
  else if t = SF_TEXT then
  begin
    gen("      at := json.putb(dst, at, '\"');\n      at := json.putraw(dst, at, src, "); genr(f); gen("_at, "); genr(f); gen("_end);\n");
    genfull;
    gen("      at := json.putb(dst, at, '\"');\n");
  end
  else if t = SF_JSON then
  begin
    gen("      at := json.putraw(dst, at, src, "); genr(f); gen("_at, "); genr(f); gen("_end);\n");
    genfull;
  end
  else if t = SF_ENUM then
  begin
    ei := 0;
    while ei < sfen[f] do
    begin
      if ei = 0 then gen("      if ") else gen("      else if ");
      genr(f); gen(" = "); gennum(ei); gen(" then at := json.putstr(dst, at, "); genquoted(sfe0[f] + ei); gen(")\n");   // no ';' before else
      ei := ei + 1;
    end;
    if sfen[f] > 0 then gen("      else ") else gen("      ");
    gen("at := io.push(dst, at, \"null\");\n");
    genfull;
  end
  else if t = SF_TEXTN then
  begin
    if tgt <> 0 then
    begin
      gen("      at := json.putslice(dst, at, "); genr(f); gen(", v1 * "); gennum(sftlen[f]);
      gen(", v1 * "); gennum(sftlen[f]); gen(" + "); genr(f); gen("_len[v1]);\n");
    end
    else
    begin
      gen("      at := json.putslice(dst, at, "); genr(f); gen(", 0, "); genr(f); gen("_n);\n");
    end;
  end
  else if t = SF_SUB then
  begin
    gen("      at := "); gensub(f); gen(".write(dst, at, "); genr(f); if tgt <> 0 then gen("[v1..v1]"); gen(", src);\n");
  end;
end;

procedure genschema;
var f, ei: int;
begin
  // --- the record type ---
  gen("\ntype\n  "); genname; gen(" = record\n");
  f := 0;
  while f < nfld do
  begin
    gendecl(f);
    f := f + 1;
  end;
  gen("  end;\n");
  // --- enum constants and the field count ---
  gen("const\n");
  f := 0;
  while f < nfld do
  begin
    if sftype[f] = SF_ENUM then
    begin
      ei := 0;
      while ei < sfen[f] do
      begin
        gen("  "); genname; gen("."); genfld(f); gen(".");
        genident(sfe0[f] + ei);
        gen(" = "); gennum(ei); gen(";\n");
        ei := ei + 1;
      end;
    end;
    f := f + 1;
  end;
  gen("  "); genname; gen(".fields = "); gennum(nfld); gen(";\n");
  // --- clear ---
  gen("\nprocedure "); genname; gen(".clear(r: array of "); genname; gen(");\nbegin\n");
  f := 0;
  while f < nfld do
  begin
    if sfarr[f] <> 0 then begin gen("  "); genr(f); gen("_n := 0;\n"); end
    else if sftype[f] = SF_INT then begin gen("  "); genr(f); gen(" := 0;\n"); end
    else if sftype[f] = SF_ENUM then begin gen("  "); genr(f); gen(" := -1;\n"); end
    else if sftype[f] = SF_REAL then begin gen("  "); genr(f); gen(" := real(0);\n"); end
    else if sftype[f] = SF_BOOL then begin gen("  "); genr(f); gen(" := false;\n"); end
    else if (sftype[f] = SF_TEXT) or (sftype[f] = SF_JSON) then
    begin
      gen("  "); genr(f); gen("_at := 0;\n  "); genr(f); gen("_end := 0;\n");
    end
    else if sftype[f] = SF_TEXTN then begin gen("  "); genr(f); gen("_n := 0;\n"); end
    else if sftype[f] = SF_SUB then begin gen("  "); gensub(f); gen(".clear("); genr(f); gen(");\n"); end;
    gen("  "); genr(f); gen("_ok := false;\n  "); genr(f); gen("_null := false;\n");
    f := f + 1;
  end;
  gen("end;\n");
  // --- parse ---
  gen("\nfunction "); genname; gen(".parse(b: array of char; at: int; last: int; r: array of "); genname;
  gen("): int;\nvar k0, k1, v0, v1, n: int;\nbegin\n  "); genname; gen(".clear(r);\n");
  gen("  k0 := 0; k1 := 0; v0 := 0; v1 := 0; n := 0;\n");
  gen("  json.badkey0 := 0; json.badkey1 := 0;\n");
  gen("  at := json.ws(b, at, last);\n");
  gen("  if at >= last then return -1;\n");
  gen("  if b[at] <> '{' then return -1;\n");
  gen("  at := at + 1;\n");
  gen("  while true do\n  begin\n");
  gen("    at := json.ws(b, at, last);\n");
  gen("    if at >= last then return -1;\n");
  gen("    if b[at] = '}' then\n    begin\n");
  f := 0;
  while f < nfld do
  begin
    if sfopt[f] = 0 then
    begin
      gen("      if (not "); genr(f); gen("_ok) or "); genr(f); gen("_null then return -1;\n");
    end;
    f := f + 1;
  end;
  gen("      return at + 1;\n    end;\n");
  gen("    if b[at] = ',' then\n    begin\n      at := at + 1;\n      continue;\n    end;\n");
  gen("    at := json.string(b, at, last);\n");
  gen("    if at < 0 then return -1;\n");
  gen("    k0 := json.sat;\n    k1 := json.send;\n");
  gen("    at := json.ws(b, at, last);\n");
  gen("    if at >= last then return -1;\n");
  gen("    if b[at] <> ':' then return -1;\n");
  gen("    at := at + 1;\n");
  f := 0;
  while f < nfld do
  begin
    genarm(f);
    f := f + 1;
  end;
  // An UNKNOWN KEY IS REFUSED, and the chain used to end in a json.skip that swallowed it
  //.  A caller that sent a renamed or removed field got a normal answer
  // computed with the default in place of what it asked for: nothing refused, nothing
  // warned, and the wrong number travelled on.  json.badkey0/1 name the key, because
  // parse returns -1 for every failure and an unknown key is the one the caller can fix.
  gen("\n    begin\n      json.badkey0 := k0; json.badkey1 := k1;\n      return -1;\n    end;\n");
  gen("  end;\n  return -1;\nend;\n");
  // --- write ---
  gen("\n// Returns the position after the object, or -1 when it does not fit in dst.\n");
  gen("  // A short buffer is a refusal, not a truncation: half a JSON object is not a\n");
  gen("  // shorter object but a syntax error, and this text goes out as the\n");
  gen("  // structuredContent of a protocol reply.\n");
  gen("function "); genname; gen(".write(dst: array of char; at: int; r: array of "); genname;
  gen("; src: array of char): int;\nvar v1: int;\n    first: bool;\nbegin\n");
  gen("  at := json.putb(dst, at, '{');\n  first := true;\n  v1 := 0;\n");
  f := 0;
  while f < nfld do
  begin
    if sfopt[f] <> 0 then
    begin
      gen("  if "); genr(f); gen("_ok then\n");
    end;
    gen("  begin\n    if not first then at := json.putb(dst, at, ',');\n    first := false;\n");
    gen("    at := io.push(dst, at, \"\\\""); genjs(f); gen("\\\":\");\n    if at >= len(dst) then return -1;\n");
    gen("    if "); genr(f); gen("_null then\n    begin\n      at := io.push(dst, at, \"null\");\n      if at >= len(dst) then return -1;\n    end\n    else\n    begin\n");
    if sfarr[f] <> 0 then
    begin
      gen("      at := json.putb(dst, at, '[');\n");
      gen("      for v1 := 0 to "); genr(f); gen("_n - 1 do\n      begin\n");
      gen("      if v1 > 0 then at := json.putb(dst, at, ',');\n");
      genput(f, 1);
      gen("      end;\n      at := json.putb(dst, at, ']');\n");
    end
    else genput(f, 0);
    gen("    end;\n  end;\n");
    f := f + 1;
  end;
  gen("  return json.putb(dst, at, '}');\nend;\n");
end;

// --- the JSON Schema text ---
procedure jsc(c: int);
begin
  if jslen >= JSMAX - 1 then fail("the JSON Schema of this schema is too large");
  jsbuf[jslen] := chr(c);
  jslen := jslen + 1;
end;

procedure jss(s: str);
var i: int;
begin
  i := 0;
  while i < slen(s) do
  begin
    jsc(ord(schar(s, i)));
    i := i + 1;
  end;
end;

procedure jsnum(v: int);
var n, i: int;
begin
  n := numstr(v);
  i := 0;
  while i < n do
  begin
    jsc(ord(nbuf[i]));
    i := i + 1;
  end;
end;

// a NUL-terminated text from the data segment, escaped
procedure jsdat(o: int);
var c: int;
begin
  while dat[o] <> chr(0) do
  begin
    c := ord(dat[o]);
    if (c = 34) or (c = 92) then begin jsc(92); jsc(c); end
    else if c = 10 then begin jsc(92); jsc(110); end
    else if c < 32 then jsc(32)
    else jsc(c);
    o := o + 1;
  end;
end;

procedure jsraw(o: int);
begin
  while dat[o] <> chr(0) do
  begin
    jsc(ord(dat[o]));
    o := o + 1;
  end;
end;

// the schema of one element
procedure jselem(f: int);
var t, ei, i: int;
begin
  t := sftype[f];
  if t = SF_INT then jss("{\"type\":\"integer\"}")
  else if t = SF_REAL then jss("{\"type\":\"number\"}")
  else if t = SF_BOOL then jss("{\"type\":\"boolean\"}")
  else if t = SF_TEXT then jss("{\"type\":\"string\"}")
  else if t = SF_TEXTN then
  begin
    jss("{\"type\":\"string\",\"maxLength\":"); jsnum(sftlen[f]); jsc(125);
  end
  else if t = SF_JSON then jss("{}")
  else if t = SF_SUB then jsraw(scjs[sfsub[f]])
  else
  begin
    jss("{\"type\":\"string\",\"enum\":[");
    ei := 0;
    while ei < sfen[f] do
    begin
      if ei > 0 then jsc(44);
      jsc(34);
      i := 0;
      while senum[(sfe0[f] + ei) * 64 + i] <> chr(0) do
      begin
        jsc(ord(senum[(sfe0[f] + ei) * 64 + i]));
        i := i + 1;
      end;
      jsc(34);
      ei := ei + 1;
    end;
    jss("]}");
  end;
end;

procedure jskey(f: int);
var i: int;
begin
  jsc(34);
  i := 0;
  while sfjson[f * 64 + i] <> chr(0) do
  begin
    jsc(ord(sfjson[f * 64 + i]));
    i := i + 1;
  end;
  jsc(34);
end;

procedure genjsonschema;
var f, i, first: int;
begin
  jslen := 0;
  jss("{\"type\":\"object\",\"properties\":{");
  f := 0;
  while f < nfld do
  begin
    if f > 0 then jsc(44);
    jskey(f); jsc(58);
    if sfarr[f] <> 0 then
    begin
      jss("{\"type\":\"array\",\"items\":"); jselem(f); jss(",\"maxItems\":"); jsnum(sfcount[f]);
      if sfdesc[f] >= 0 then
      begin
        jss(",\"description\":\""); jsdat(sfdesc[f]); jsc(34);
      end;
      jsc(125);
    end
    else if sfdesc[f] >= 0 then
    begin
      jselem(f);
      jslen := jslen - 1;                     // reopen the element object
      if sftype[f] = SF_JSON then jss("\"description\":\"")
      else jss(",\"description\":\"");
      jsdat(sfdesc[f]); jsc(34); jsc(125);
    end
    else jselem(f);
    f := f + 1;
  end;
  jss("},\"required\":[");
  first := 1;
  f := 0;
  while f < nfld do
  begin
    if sfopt[f] = 0 then
    begin
      if first = 0 then jsc(44);
      first := 0;
      jskey(f);
    end;
    f := f + 1;
  end;
  jss("]}");
  jsc(0);
  // into the data segment, as the value of the str constant Name.jsonschema
  while (datlen mod 8) <> 0 do dput(0);
  i := 0;
  while i < 8 do
  begin
    dput(band((jslen - 1) shr (i * 8), 255));
    i := i + 1;
  end;
  scjs[nsc] := datlen;
  i := 0;
  while i < jslen do
  begin
    dput(ord(jsbuf[i]));
    i := i + 1;
  end;
end;

// the schema whose name is in tbuf, or -1
function findschema: int;
var i, j: int;
begin
  i := 0;
  while i < nsc do
  begin
    j := 0;
    while scnam[i * 64 + j] = tbuf[j] do
    begin
      if tbuf[j] = chr(0) then return i;
      j := j + 1;
    end;
    i := i + 1;
  end;
  return -1;
end;

// type NAME = schema <field: type[?] ["description"];>... end;
// declschema -- the body of one schema, from the field list to 'end'.
//
// THE NAME AND THE '=' AND THE WORD 'schema' ARE ALREADY READ by decltypes, which is the
// only caller. Since 17-09-2026 a schema is declared the way every other type is:
//
//   type Rpc = schema  jsonrpc: text; end;
//
// so there is no 'schema' keyword at the start of a declaration to dispatch on any more.
// The name is in schname/scnam, put there by the caller, and the current token is the
// first field.
procedure declschema;
var i, f, fi, lo, hi: int;
begin
  nfld := 0;
  nenum := 0;
  while tok = TK_ID do
  begin
    if nfld >= MAXFLD then fail("too many fields in a schema");
    i := 0;
    while tbuf[i] <> chr(0) do
    begin
      if i >= 62 then fail("field name too long");
      sfld[nfld * 64 + i] := tbuf[i];
      sfjson[nfld * 64 + i] := obuf[i];
      i := i + 1;
    end;
    sfld[nfld * 64 + i] := chr(0);
    sfjson[nfld * 64 + i] := chr(0);
    sfopt[nfld] := 0; sfe0[nfld] := 0; sfen[nfld] := 0; sfarr[nfld] := 0;
    sfcount[nfld] := 0; sftlen[nfld] := 0; sfsub[nfld] := -1; sfdesc[nfld] := -1;
    next;
    if tok <> 58 then fail("missing : after a schema field");
    next;
    if tok = KW_ARRAY then
    begin
      next;
      if tok <> 91 then fail("missing [ in array field");
      next;
      lo := cexpr;
      if tok <> TK_RANGE then fail("missing .. in array bounds");
      next;
      hi := cexpr;
      if tok <> 93 then fail("missing ] in array field");
      next;
      if (lo <> 0) or (hi < 0) then fail("a schema array is declared array[0..N] of ...");
      if tok <> KW_OF then fail("missing of in array field");
      next;
      sfarr[nfld] := 1;
      sfcount[nfld] := hi + 1;
    end;
    if tok = KW_INT then
    begin
      sftype[nfld] := SF_INT;
      next;
    end
    else if tok = KW_BOOL then
    begin
      sftype[nfld] := SF_BOOL;
      next;
    end
    else if tok = KW_REAL then
    begin
      sftype[nfld] := SF_REAL;
      next;
    end
    else if (tok = TK_ID) and eqt("text") then
    begin
      next;
      sftype[nfld] := SF_TEXT;
      if tok = 91 then
      begin
        // text[N]: a copy
        next;
        sftype[nfld] := SF_TEXTN;
        sftlen[nfld] := cexpr;
        if sftlen[nfld] < 1 then fail("text[N] needs N >= 1");
        if tok <> 93 then fail("missing ] after the text length");
        next;
      end
      else if tok = KW_OF then
      begin
        next;
        sftype[nfld] := SF_ENUM;
        if tok <> 40 then fail("missing ( after 'of'");
        next;
        sfe0[nfld] := nenum;
        while true do
        begin
          if tok <> TK_STR then fail("a quoted value is expected here");
          if nenum >= MAXENUM then fail("too many enumerated values");
          i := 0;
          while dat[tval + i] <> chr(0) do
          begin
            if i >= 62 then fail("enumerated value too long");
            senum[nenum * 64 + i] := dat[tval + i];
            i := i + 1;
          end;
          senum[nenum * 64 + i] := chr(0);
          datlen := datmark;
          nenum := nenum + 1;
          sfen[nfld] := sfen[nfld] + 1;
          next;
          if tok <> 44 then break;
          next;
        end;
        if tok <> 41 then fail("missing ) after the values");
        next;
      end;
    end
    else if (tok = TK_ID) and eqt("json") then
    begin
      sftype[nfld] := SF_JSON;
      next;
    end
    else if (tok = TK_ID) and (findschema >= 0) then
    begin
      sftype[nfld] := SF_SUB;
      sfsub[nfld] := findschema;
      next;
    end
    else fail("a schema field is int, real, bool, text, text[N], text of (...), json, or a schema declared earlier");
    if sfarr[nfld] <> 0 then
    begin
      if (sftype[nfld] = SF_TEXT) or (sftype[nfld] = SF_JSON) or (sftype[nfld] = SF_ENUM) then
        fail("a schema array holds int, real, bool, text[N] or a schema");
    end;
    if tok = 63 then
    begin
      sfopt[nfld] := 1;
      next;
    end;
    if tok = TK_STR then
    begin
      sfdesc[nfld] := tval;            // the description stays in the data segment
      next;
    end;
    if tok <> 59 then fail("missing ; after a schema field");
    next;
    nfld := nfld + 1;
  end;
  if tok <> KW_END then fail("missing end of the schema");
  next;
  if tok <> 59 then fail("missing ; after the schema");
  // the JSON Schema text and its str constant
  genjsonschema;
  i := 0;
  while schname[i] <> chr(0) do
  begin
    tbuf[i] := schname[i];
    i := i + 1;
  end;
  tbuf[i] := '.'; tbuf[i + 1] := 'j'; tbuf[i + 2] := 's'; tbuf[i + 3] := 'o'; tbuf[i + 4] := 'n';
  tbuf[i + 5] := 's'; tbuf[i + 6] := 'c'; tbuf[i + 7] := 'h'; tbuf[i + 8] := 'e'; tbuf[i + 9] := 'm'; tbuf[i + 10] := 'a'; tbuf[i + 11] := chr(0);
  if ngl >= MAXG then fail("too many globals");
  gnam[ngl] := intern; gkind[ngl] := SK_CONST; gtyp[ngl] := T_STR; gval[ngl] := scjs[nsc];
  garr[ngl] := 0; glo[ngl] := 0; ghi[ngl] := 0;
  gfile[ngl] := 0 - 1;                  // compiler-generated: always public
  gindex(ngl);
  ngl := ngl + 1;
  nsc := nsc + 1;
  // generate, then compile the generated text like an include
  if incdepth >= 16 then fail("includes nested too deeply");
  pathbuf[0] := '<';
  f := 1;
  i := 0;
  while schname[i] <> chr(0) do
  begin
    pathbuf[f] := schname[i];
    f := f + 1;
    i := i + 1;
  end;
  pathbuf[f] := '>';
  pathbuf[f + 1] := chr(0);
  fi := addfile;
  incpos[incdepth] := pos; incend[incdepth] := srcend;
  incline[incdepth] := line; incfile[incdepth] := curfile;
  incdepth := incdepth + 1;
  f := srclen;
  genschema;
  pos := f; srcend := srclen; line := 1; curfile := fi;
  next;
end;

// ------------------------------------------------------------------
// tools: a declared tool table becomes tools/list text and a dispatcher
// ------------------------------------------------------------------

procedure gentl(i: int);
var j: int;
begin
  j := 0;
  while tlnam[i * 64 + j] <> chr(0) do
  begin
    sput(tlnam[i * 64 + j]);
    j := j + 1;
  end;
end;

procedure gensc(k: int);
var j: int;
begin
  j := 0;
  while scnam[k * 64 + j] <> chr(0) do
  begin
    sput(scnam[k * 64 + j]);
    j := j + 1;
  end;
end;

procedure jstl(i: int);
var j: int;
begin
  j := 0;
  while tlnam[i * 64 + j] <> chr(0) do
  begin
    jsc(ord(tlnam[i * 64 + j]));
    j := j + 1;
  end;
end;

procedure gentools;
var i: int;
begin
  // --- the tools/list text, as the str constant tool.list ---
  jslen := 0;
  i := 0;
  while i < ntl do
  begin
    if i > 0 then jsc(44);
    jss("{\"name\":\""); jstl(i); jss("\",\"description\":\""); jsdat(tldesc[i]);
    jss("\",\"inputSchema\":"); jsraw(scjs[tlin[i]]);
    jss(",\"outputSchema\":"); jsraw(scjs[tlout[i]]);
    jss(",\"annotations\":{\"readOnlyHint\":"); if tlro[i] <> 0 then jss("true") else jss("false");
    jss(",\"destructiveHint\":"); if tldes[i] <> 0 then jss("true") else jss("false");
    jss(",\"idempotentHint\":"); if tlid[i] <> 0 then jss("true") else jss("false");
    jss("}}");
    i := i + 1;
  end;
  jsc(0);
  while (datlen mod 8) <> 0 do dput(0);
  i := 0;
  while i < 8 do
  begin
    dput(band((jslen - 1) shr (i * 8), 255));
    i := i + 1;
  end;
  tlseen := datlen;
  i := 0;
  while i < jslen do
  begin
    dput(ord(jsbuf[i]));
    i := i + 1;
  end;
  i := 0;
  while i < slen("tool.list") do
  begin
    tbuf[i] := schar("tool.list", i);
    i := i + 1;
  end;
  tbuf[i] := chr(0);
  if ngl >= MAXG then fail("too many globals");
  gnam[ngl] := intern; gkind[ngl] := SK_CONST; gtyp[ngl] := T_STR; gval[ngl] := tlseen;
  garr[ngl] := 0; glo[ngl] := 0; ghi[ngl] := 0;
  gfile[ngl] := 0 - 1;                  // compiler-generated: always public
  gindex(ngl);
  ngl := ngl + 1;
  // --- constants, argument/result records, handler declarations ---
  gen("\nconst\n  tool.count = "); gennum(ntl); gen(";\n");
  i := 0;
  while i < ntl do
  begin
    gen("  tool.id_"); gentl(i); gen(" = "); gennum(i); gen(";\n");
    i := i + 1;
  end;
  gen("var\n  tool.err: array[0..255] of char;\n  tool.errn: int;\n  tool.vbuf: array[0..1048575] of char;\n  tool.vn: int;\n");
  i := 0;
  while i < ntl do
  begin
    gen("  tool.in_"); gentl(i); gen(": "); gensc(tlin[i]); gen(";\n");
    gen("  tool.out_"); gentl(i); gen(": "); gensc(tlout[i]); gen(";\n");
    i := i + 1;
  end;
  gen("\n// a handler returns 0, or calls tool.fail with a message and returns its result\n");
  gen("function tool.fail(s: str): int;\nbegin\n  tool.errn := io.push(tool.err, 0, s);\n  return 1;\nend;\n");
  i := 0;
  while i < ntl do
  begin
    gen("function tool."); gentl(i); gen("(a: array of "); gensc(tlin[i]); gen("; r: array of "); gensc(tlout[i]); gen("): int; forward;\n");
    i := i + 1;
  end;
  // --- byname ---
  gen("\nfunction tool.byname(b: array of char; at: int; upto: int): int;\nbegin\n");
  i := 0;
  while i < ntl do
  begin
    gen("  if json.eq(b, at, upto, \""); gentl(i); gen("\") then return "); gennum(i); gen(";\n");
    i := i + 1;
  end;
  gen("  return -1;\nend;\n");
  // --- run: parse arguments, call the handler, write the result JSON into dst ---
  gen("\n// returns the length written, -1 for bad arguments, -2 when the handler failed\n");
  gen("  // (see tool.err), -3 when the result JSON does not fit in dst.  The writer\n");
  gen("  // refuses rather than truncating -- half an object is a syntax error -- and -3\n");
  gen("  // keeps that apart from -1, which would blame the caller's arguments for it.\n");
  gen("function tool.run(idx: int; b: array of char; at: int; upto: int; dst: array of char): int;\nvar rc: int;\nbegin\n  rc := 0;\n  tool.errn := 0;\n");
  i := 0;
  while i < ntl do
  begin
    if i = 0 then gen("  if idx = ") else gen("  else if idx = ");
    gennum(i); gen(" then\n    begin\n      if "); gensc(tlin[i]); gen(".parse(b, at, upto, tool.in_"); gentl(i); gen(") < 0 then return -1;\n");
    gen("      "); gensc(tlout[i]); gen(".clear(tool.out_"); gentl(i); gen(");\n");
    gen("      tool.vn := 0;\n      rc := tool."); gentl(i); gen("(tool.in_"); gentl(i); gen(", tool.out_"); gentl(i); gen(");\n");
    gen("      if rc <> 0 then return -2;\n");
    gen("      rc := "); gensc(tlout[i]); gen(".write(dst, 0, tool.out_"); gentl(i); gen(", tool.vbuf);\n");
    gen("      if rc < 0 then return -3;\n      return rc;\n    end");
    // No ';' before an 'else', so an arm closes bare and the chain is ended once, after
    // the loop. A trailing ';' here is the error the parser reports as 'unexpected else'.
    if i < ntl - 1 then gen("\n") else gen(";\n");
    i := i + 1;
  end;
  gen("  return -1;\nend;\n");
end;

// tools  <name>(<InSchema>): <OutSchema> "<description>" [readonly] [idempotent] [destructive]; ... end;
procedure decltools;
var i, f, fi: int;
begin
  if ntl > 0 then fail("tools are declared once");
  next;
  while tok = TK_ID do
  begin
    if ntl >= MAXT then fail("too many tools");
    i := 0;
    while tbuf[i] <> chr(0) do
    begin
      if i >= 62 then fail("tool name too long");
      tlnam[ntl * 64 + i] := tbuf[i];
      i := i + 1;
    end;
    tlnam[ntl * 64 + i] := chr(0);
    tlro[ntl] := 0; tlid[ntl] := 0; tldes[ntl] := 0; tldesc[ntl] := -1;
    tlline[ntl] := line; tlfile[ntl] := curfile;   // the writer's own line, for the error
    next;
    if tok <> 40 then fail("a tool is declared as name(InSchema): OutSchema \"description\"");
    next;
    if (tok <> TK_ID) or (findschema < 0) then fail("the argument type of a tool is a schema");
    tlin[ntl] := findschema;
    next;
    if tok <> 41 then fail("missing ) after the tool argument type");
    next;
    if tok <> 58 then fail("missing : before the tool result type");
    next;
    if (tok <> TK_ID) or (findschema < 0) then fail("the result type of a tool is a schema");
    tlout[ntl] := findschema;
    next;
    if tok <> TK_STR then fail("a tool needs a description in quotes");
    tldesc[ntl] := tval;
    next;
    while tok = TK_ID do
    begin
      if eqt("readonly") then tlro[ntl] := 1
      else if eqt("idempotent") then tlid[ntl] := 1
      else if eqt("destructive") then tldes[ntl] := 1
      else fail("a tool annotation is readonly, idempotent or destructive");
      next;
    end;
    if tok <> 59 then fail("missing ; after a tool");
    next;
    ntl := ntl + 1;
  end;
  if tok <> KW_END then fail("missing end of the tools");
  next;
  if tok <> 59 then fail("missing ; after the tools");
  if ntl = 0 then fail("the tools block is empty");
  if incdepth >= 16 then fail("includes nested too deeply");
  i := 0;
  while i < slen("<tools>") do
  begin
    pathbuf[i] := schar("<tools>", i);
    i := i + 1;
  end;
  pathbuf[i] := chr(0);
  fi := addfile;
  tlfwdfile := fi; tlfwdn := 0;       // see declroutine: the forwards below get the
                                      // writer's own line rather than a line of <tools>
  incpos[incdepth] := pos; incend[incdepth] := srcend;
  incline[incdepth] := line; incfile[incdepth] := curfile;
  incdepth := incdepth + 1;
  f := srclen;
  gentools;
  pos := f; srcend := srclen; line := 1; curfile := fi;
  next;
end;

// ------------------------------------------------------------------
// routines
// ------------------------------------------------------------------

procedure storeparam(i: int; off: int);
begin
  if i = 0 then begin e(0x48); e(0x89); e(0xBD); end
  else if i = 1 then begin e(0x48); e(0x89); e(0xB5); end
  else if i = 2 then begin e(0x48); e(0x89); e(0x95); end
  else if i = 3 then begin e(0x48); e(0x89); e(0x8D); end
  else if i = 4 then begin e(0x4C); e(0x89); e(0x85); end
  else if i = 5 then begin e(0x4C); e(0x89); e(0x8D); end
  else if i = 6 then begin e(0x4C); e(0x89); e(0xA5); end
  else if i = 7 then begin e(0x4C); e(0x89); e(0xAD); end
  else if i = 8 then begin e(0x4C); e(0x89); e(0xB5); end
  else begin e(0x4C); e(0x89); e(0xBD); end;
  e32(off);
end;

procedure declroutine(isproc: int);
var fi, known, np, t, o, i: int;
    zlea, zcnt, ztop, zdone, parmbytes, endline, saveline, pisarr, nr: int;
begin
  next;
  if tok <> TK_ID then fail("routine name expected");
  if bicode <> 0 then fail("that name is built in");
  if findglob >= 0 then failtaken("name already used by a variable or constant");
  fi := findfn;
  known := 0;
  if fi >= 0 then
  begin
    if fdef[fi] <> 0 then failtaken("routine already defined");
    known := 1;
  end
  else
  begin
    if nfn >= MAXF then fail("too many routines");
    fi := nfn;
    nfn := nfn + 1;
    fnam[fi] := intern; fdef[fi] := 0; fadr[fi] := 0;
    fvis[fi] := declloc;
    findex(fi);
  end;
  next;
  nloc := 0;
  frame := 0;
  np := 0;
  if tok = 40 then
  begin
    next;
    while true do
    begin
      if tok <> TK_ID then fail("parameter name expected");
      o := 0;
      while true do
      begin
        if bicode <> 0 then fail("that name is built in");
        if findloc >= 0 then fail("duplicate parameter name");
        if nloc >= MAXL then fail("too many locals");
        lnam[nloc] := intern; larr[nloc] := 0; llo[nloc] := 0; lhi[nloc] := 0; lkind[nloc] := SK_VAR;
        nloc := nloc + 1;
        o := o + 1;
        next;
        if tok <> 44 then break;
        next;
      end;
      if tok <> 58 then fail("missing : in parameter list");
      next;
      pisarr := 0;
      if tok = KW_ARRAY then
      begin
        next;
        if tok <> KW_OF then fail("an array parameter is written 'array of <type>'");
        next;
        pisarr := 2;
      end;
      t := basetype;
      if (t >= T_REC) and (pisarr = 0) then fail("a record parameter is passed as 'array of <type>' (a one-element slice will do)");
      i := nloc - o;
      while i < nloc do
      begin
        ltyp[i] := t; larr[i] := pisarr;
        frame := frame + 8;
        loff[i] := 0 - frame;
        if pisarr <> 0 then frame := frame + 8;
        i := i + 1;
      end;
      np := nloc;
      if tok <> 59 then break;
      next;
    end;
    if tok <> 41 then fail("missing ) in parameter list");
    next;
    np := nloc;
  end;
  nr := 0;
  i := 0;
  while i < np do
  begin
    nr := nr + 1;
    if larr[i] <> 0 then nr := nr + 1;
    i := i + 1;
  end;
  if (np > MAXP) or (nr > MAXP) then fail("a routine may take at most ten arguments (an array counts as two)");
  if isproc <> 0 then t := T_VOID
  else
  begin
    if tok <> 58 then fail("missing : before the result type");
    next;
    t := basetype;
    if t >= T_REC then fail("a function cannot return a record; fill one through an array parameter");
  end;
  if known <> 0 then
  begin
    if fnpar[fi] <> np then fail("parameter count differs from the forward declaration");
    if frtyp[fi] <> t then fail("result type differs from the forward declaration");
    i := 0;
    while i < np do
    begin
      if fptyp[fi * MAXP + i] <> ltyp[i] then fail("parameter type differs from the forward declaration");
      if fparr[fi * MAXP + i] <> larr[i] then fail("parameter type differs from the forward declaration");
      i := i + 1;
    end;
  end
  else
  begin
    fnpar[fi] := np;
    frtyp[fi] := t;
    fnreg[fi] := nr;
    i := 0;
    while i < np do
    begin
      fptyp[fi * MAXP + i] := ltyp[i];
      fparr[fi * MAXP + i] := larr[i];
      i := i + 1;
    end;
  end;
  if tok <> 59 then fail("missing ; after the routine header");
  next;
  if tok = KW_FORWARD then
  begin
    // the line of the DECLARATION, before next() walks past the ';' onto the following
    // line -- otherwise an unresolved forward is reported one line too far down.
    fline[fi] := line;
    ffile[fi] := curfile;
    // A FORWARD OUT OF THE GENERATED <tools> TEXT POINTS AT THE WRITER'S OWN DECLARATION.
    // "<tools>:19" names a file nobody can open, and an AI writer has no way to guess
    // which tool it meant; the tools block entry is the thing they can actually change
    //.  gentools emits exactly one forward per tool, in table order, so
    // the n-th one here is tool n.
    if (curfile = tlfwdfile) and (tlfwdn < ntl) then
    begin
      fline[fi] := tlline[tlfwdn];
      ffile[fi] := tlfile[tlfwdn];
      tlfwdn := tlfwdn + 1;
    end;
    next;
    if tok <> 59 then fail("missing ; after forward");
    next;
    return;
  end;
  parmbytes := frame;
  fadr[fi] := codelen;
  fdef[fi] := 1;
  curfn := fi;
  curret := t;
  nbrk := 0; ncnt := 0; brkbase := -1; cntbase := -1;
  e(0x55);
  e(0x48); e(0x89); e(0xE5);
  e(0x48); e(0x81); e(0xEC); framepatch := codelen; e32(0);
  e(0x48); e(0x8D); e(0x85); zlea := codelen; e32(0);
  e(0x49); e(0xBB); zcnt := codelen; e64(0);
  ztop := codelen;
  e(0x4D); e(0x85); e(0xDB);
  zdone := jfwd(0x0F, 0x84);
  e(0x48); e(0xC7); e(0x00); e32(0);
  e(0x48); e(0x83); e(0xC0); e(8);
  e(0x49); e(0x83); e(0xEB); e(1);
  jmpto(0, 0xE9, ztop);
  patch(zdone);
  i := 0;
  nr := 0;
  while i < np do
  begin
    storeparam(nr, loff[i]); nr := nr + 1;
    if larr[i] <> 0 then
    begin
      storeparam(nr, loff[i] - 8); nr := nr + 1;
    end;
    i := i + 1;
  end;
  while (tok = KW_VAR) or (tok = KW_CONST) do
  begin
    if tok = KW_VAR then declvars(1) else declconsts(1);
  end;
  if tok <> KW_BEGIN then fail("missing begin in routine body");
  next;
  stmtlist;
  if tok <> KW_END then fail("missing end in routine body");
  endline := line;
  next;
  if tok <> 59 then fail("missing ; after routine body");
  next;
  if t = T_VOID then
  begin
    e(0x48); e(0x31); e(0xC0);
    epilogue;
  end
  else
  begin
    saveline := line;
    line := endline;
    trap("function ended without executing a return");
    line := saveline;
  end;
  while (frame mod 16) <> 0 do frame := frame + 8;
  e32at(framepatch, frame);
  e32at(zlea, 0 - frame);
  i := (frame - parmbytes) div 8;
  e32at(zcnt, i);
  e32at(zcnt + 4, i shr 32);
  nloc := 0;                                      // locals do not outlive the routine
end;

// ------------------------------------------------------------------
// the Windows runtime, compiled into every .exe before the program
// ------------------------------------------------------------------
// System calls are emulated in Wantzel on top of kernel32: __wsys receives the
// Linux number and arguments, __winit turns the command line into an
// argc/argv block.  The text is entered like an include named <windows>.

procedure genwin;
begin
  gen("// Windows runtime: the Linux system calls a Wantzel program uses, mapped onto\n");
  gen("  // kernel32 and ws2_32.  __wsys receives the Linux syscall number and its\n");
  gen("  // arguments and does the Windows equivalent; __winit turns the command line\n");
  gen("  // into an argc/argv block.  All of this is ordinary Wantzel, compiled into every\n");
  gen("  // .exe ahead of the program, so the code generator needs no Windows knowledge.\n");
  gen("  // epoll is emulated over WSAPoll, with a small interest table kept here.\n");
  gen("const\n");
  gen("  __K_GETSTDHANDLE = 0;\n");
  gen("  __K_WRITEFILE = 1;\n");
  gen("  __K_READFILE = 2;\n");
  gen("  __K_CREATEFILEA = 3;\n");
  gen("  __K_CLOSEHANDLE = 4;\n");
  gen("  __K_EXITPROCESS = 5;\n");
  gen("  __K_GETCMDLINE = 6;\n");
  gen("  __K_LSTRCPYN = 7;\n");
  gen("  __K_GETTIME = 8;\n");
  gen("  __K_SLEEP = 9;\n");
  gen("  __K_GETATTREX = 10;\n");
  gen("  __K_FINDFIRST = 11;\n");
  gen("  __K_FINDNEXT = 12;\n");
  gen("  __K_FINDCLOSE = 13;\n");
  gen("  __K_CREATEMAP = 14;\n");
  gen("  __K_MAPVIEW = 15;\n");
  gen("  __K_UNMAPVIEW = 16;\n");
  gen("  __K_FLUSHVIEW = 17;\n");
  gen("  __K_FLUSHFILE = 18;\n");
  gen("  __K_MOVEFILE = 19;\n");
  gen("  __K_SETPTR = 20;\n");
  gen("  __K_SETEOF = 21;\n");
  gen("  __K_DELETEFILE = 22;\n");
  gen("  __K_CREATEDIR = 23;\n");
  gen("  __K_REMOVEDIR = 24;\n");
  gen("  __K_LOCKFILE = 25;\n");
  gen("  __K_UNLOCKFILE = 26;\n");
  gen("  __W_WSASTARTUP = 28;\n");
  gen("  __W_SOCKET = 29;\n");
  gen("  __W_CLOSESOCKET = 30;\n");
  gen("  __W_SETSOCKOPT = 31;\n");
  gen("  __W_IOCTL = 32;\n");
  gen("  __W_BIND = 33;\n");
  gen("  __W_LISTEN = 34;\n");
  gen("  __W_ACCEPT = 35;\n");
  gen("  __W_SEND = 36;\n");
  gen("  __W_RECV = 37;\n");
  gen("  __W_WSAPOLL = 38;\n");
  gen("  __A_RANDOM = 40;\n");
  gen("  __WMAXFD = 1024;\n");
  gen("var\n");
  gen("  __wargv: array[0..63] of int;\n");
  gen("  __wargs: array[0..4095] of char;\n");
  gen("  __wdig: array[0..31] of char;\n");
  gen("  __wcount, __wdummy, __wstarted: int;\n");
  gen("  __wsh: array[0..__WMAXFD - 1] of int;   // socket handle for small fd, or 0\n");
  gen("  __wev: array[0..__WMAXFD - 1] of int;   // epoll events requested for fd\n");
  gen("  __wpoll: array[0..__WMAXFD * 16 - 1] of char;   // WSAPOLLFD array\n");
  gen("  __wrow: array[0..__WMAXFD - 1] of int;   // poll row -> fd\n");
  gen("  __wsa: array[0..15] of char;   // a working sockaddr\n");
  gen("  __wtime: array[0..7] of char;\n");
  gen("  __wdh: array[0..__WMAXFD - 1] of int;   // FindFirst handle per dir fd, or 0\n");
  gen("  __wdfirst: array[0..__WMAXFD - 1] of int;   // 1 = first entry already in __wfd32\n");
  gen("  __wfind: array[0..319] of char;   // WIN32_FIND_DATAA\n");
  gen("  __wpath: array[0..1039] of char;   // path + backslash-star\n");
  gen("  __wovl: array[0..31] of char;   // a zeroed OVERLAPPED for LockFileEx\n");
  gen("  __wpos: array[0..7] of char;   // SetFilePointerEx result\n");
  gen("\n");
  gen("procedure __wp32(b: array of char; at: int; v: int);\n");
  gen("begin\n");
  gen("  b[at]     := chr(band(v, 255));\n");
  gen("  b[at + 1] := chr(band(v shr 8, 255));\n");
  gen("  b[at + 2] := chr(band(v shr 16, 255));\n");
  gen("  b[at + 3] := chr(band(v shr 24, 255));\n");
  gen("end;\n");
  gen("\n");
  gen("function __wg32(b: array of char; at: int): int;\n");
  gen("var v: int;\n");
  gen("begin\n");
  gen("  v := ord(b[at]);\n");
  gen("  v := bor(v, ord(b[at + 1]) shl 8);\n");
  gen("  v := bor(v, ord(b[at + 2]) shl 16);\n");
  gen("  v := bor(v, ord(b[at + 3]) shl 24);\n");
  gen("  return v;\n");
  gen("end;\n");
  gen("\n");
  gen("function __whandle(fd: int): int;\n");
  gen("begin\n");
  gen("  if fd = 0 then return winapi(__K_GETSTDHANDLE, 0 - 10);\n");
  gen("  if fd = 1 then return winapi(__K_GETSTDHANDLE, 0 - 11);\n");
  gen("  if fd = 2 then return winapi(__K_GETSTDHANDLE, 0 - 12);\n");
  gen("  return fd;\n");
  gen("end;\n");
  gen("\n");
  gen("function __wissock(fd: int): bool;\n");
  gen("begin\n");
  gen("  return (fd > 2) and (fd < __WMAXFD) and (__wsh[fd] > 0);\n");
  gen("end;\n");
  gen("\n");
  gen("function __wisdir(fd: int): bool;\n");
  gen("begin\n");
  gen("  return (fd > 2) and (fd < __WMAXFD) and (__wdh[fd] <> 0);\n");
  gen("end;\n");
  gen("\n");
  gen("\n");
  gen("function __wwrite(fd: int; a: int; n: int): int;\n");
  gen("var ok, r: int;\n");
  gen("begin\n");
  gen("  if __wissock(fd) then\n");
  gen("  begin\n");
  gen("    r := winapi(__W_SEND, __wsh[fd], a, n, 0);\n");
  gen("    if r < 0 then return 0 - 11;   // treat as EAGAIN-ish\n");
  gen("    return r;\n");
  gen("  end;\n");
  gen("  __wcount := 0;\n");
  gen("  ok := winapi(__K_WRITEFILE, __whandle(fd), a, n, addr(__wcount), 0);\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0 - 1;\n");
  gen("  return band(__wcount, 0xFFFFFFFF);\n");
  gen("end;\n");
  gen("\n");
  gen("function __wread(fd: int; a: int; n: int): int;\n");
  gen("var ok, r: int;\n");
  gen("begin\n");
  gen("  if __wissock(fd) then\n");
  gen("  begin\n");
  gen("    r := winapi(__W_RECV, __wsh[fd], a, n, 0);\n");
  gen("    if r < 0 then return 0 - 11;\n");
  gen("    return r;\n");
  gen("  end;\n");
  gen("  __wcount := 0;\n");
  gen("  ok := winapi(__K_READFILE, __whandle(fd), a, n, addr(__wcount), 0);\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0;\n");
  gen("  return band(__wcount, 0xFFFFFFFF);\n");
  gen("end;\n");
  gen("\n");
  gen("function __wopen(path: int; flags: int): int;\n");
  gen("var access, disp, h: int;\n");
  gen("begin\n");
  gen("  access := 0x80000000;\n");
  gen("  if band(flags, 3) = 1 then access := 0x40000000;\n");
  gen("  if band(flags, 3) = 2 then access := 0xC0000000;\n");
  gen("  disp := 3;\n");
  gen("  if band(flags, 64) <> 0 then disp := 4;\n");
  gen("  if band(flags, 512) <> 0 then disp := 5;\n");
  gen("  if band(flags, 576) = 576 then disp := 2;\n");
  gen("  h := winapi(__K_CREATEFILEA, path, access, 3, 0, disp, 0x80, 0);\n");
  gen("  if h = 0 - 1 then return 0 - 1;\n");
  gen("  if band(flags, 1024) <> 0 then __wdummy := winapi(__K_SETPTR, h, 0, 0, 2);   // O_APPEND: seek to the end\n");
  gen("  return h;\n");
  gen("end;\n");
  gen("\n");
  gen("// mmap over CreateFileMapping/MapViewOfFile; fd < 0 maps the page file\n");
  gen("function __wmmap(n: int; prot: int; fd: int; off: int): int;\n");
  gen("var h, m, a, p, acc: int;\n");
  gen("begin\n");
  gen("  p := 2; acc := 4;   // PAGE_READONLY, FILE_MAP_READ\n");
  gen("  if band(prot, 2) <> 0 then\n");
  gen("  begin\n");
  gen("    p := 4; acc := 0x0F001F;   // PAGE_READWRITE, FILE_MAP_ALL_ACCESS\n");
  gen("  end;\n");
  gen("  if fd < 0 then\n");
  gen("  begin\n");
  gen("    m := winapi(__K_CREATEMAP, 0 - 1, 0, p, n shr 32, band(n, 0xFFFFFFFF), 0);\n");
  gen("    if m = 0 then return 0 - 12;\n");
  gen("    a := winapi(__K_MAPVIEW, m, acc, 0, 0, n);\n");
  gen("  end\n");
  gen("  else\n");
  gen("  begin\n");
  gen("    h := __whandle(fd);\n");
  gen("    m := winapi(__K_CREATEMAP, h, 0, p, 0, 0, 0);\n");
  gen("    if m = 0 then return 0 - 12;\n");
  gen("    a := winapi(__K_MAPVIEW, m, acc, off shr 32, band(off, 0xFFFFFFFF), n);\n");
  gen("  end;\n");
  gen("  __wdummy := winapi(__K_CLOSEHANDLE, m);\n");
  gen("  if a = 0 then return 0 - 12;\n");
  gen("  return a;\n");
  gen("end;\n");
  gen("\n");
  gen("function __wlseek(fd: int; off: int; whence: int): int;\n");
  gen("var ok: int;\n");
  gen("begin\n");
  gen("  ok := winapi(__K_SETPTR, __whandle(fd), off, addr(__wpos[0]), whence);\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0 - 22;\n");
  gen("  return bor(band(__wg32(__wpos, 0), 0xFFFFFFFF), __wg32(__wpos, 4) shl 32);\n");
  gen("end;\n");
  gen("\n");
  gen("function __wftruncate(fd: int; n: int): int;\n");
  gen("var h, ok: int;\n");
  gen("begin\n");
  gen("  h := __whandle(fd);\n");
  gen("  ok := winapi(__K_SETPTR, h, n, 0, 0);\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0 - 22;\n");
  gen("  ok := winapi(__K_SETEOF, h);\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0 - 22;\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("// flock: LOCK_SH 1, LOCK_EX 2, LOCK_NB 4, LOCK_UN 8 over the whole file\n");
  gen("function __wflock(fd: int; op: int): int;\n");
  gen("var h, flags, ok, i: int;\n");
  gen("begin\n");
  gen("  h := __whandle(fd);\n");
  gen("  i := 0;\n");
  gen("  while i < 32 do\n");
  gen("  begin\n");
  gen("    __wovl[i] := chr(0);\n");
  gen("    i := i + 1;\n");
  gen("  end;\n");
  gen("  if band(op, 8) <> 0 then\n");
  gen("  begin\n");
  gen("    ok := winapi(__K_UNLOCKFILE, h, 0, 0xFFFFFFFF, 0xFFFFFFFF, addr(__wovl[0]));\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  flags := 0;\n");
  gen("  if band(op, 2) <> 0 then flags := 2;\n");
  gen("  if band(op, 4) <> 0 then flags := bor(flags, 1);\n");
  gen("  ok := winapi(__K_LOCKFILE, h, flags, 0, 0xFFFFFFFF, 0xFFFFFFFF, addr(__wovl[0]));\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0 - 11;\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("procedure __wclose(fd: int);\n");
  gen("begin\n");
  gen("  if __wisdir(fd) then\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__K_FINDCLOSE, __wdh[fd]);\n");
  gen("    __wdh[fd] := 0;\n");
  gen("    __wsh[fd] := 0;\n");
  gen("    return;\n");
  gen("  end;\n");
  gen("  if __wissock(fd) then\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__W_CLOSESOCKET, __wsh[fd]);\n");
  gen("    __wsh[fd] := 0;\n");
  gen("    __wev[fd] := 0;\n");
  gen("  end\n");
  gen("  else __wdummy := winapi(__K_CLOSEHANDLE, fd);\n");
  gen("end;\n");
  gen("\n");
  gen("procedure __wputs(s: str);\n");
  gen("begin\n");
  gen("  __wdummy := __wwrite(2, sadr(s), slen(s));\n");
  gen("end;\n");
  gen("\n");
  gen("procedure __wneedwsa;\n");
  gen("var b: array[0..511] of char;\n");
  gen("begin\n");
  gen("  if __wstarted <> 0 then return;\n");
  gen("  __wstarted := 1;\n");
  gen("  __wdummy := winapi(__W_WSASTARTUP, 0x0202, addr(b[0]));\n");
  gen("end;\n");
  gen("\n");
  gen("function __wslot: int;\n");
  gen("var i: int;\n");
  gen("begin\n");
  gen("  i := 3;\n");
  gen("  while i < __WMAXFD do\n");
  gen("  begin\n");
  gen("    if __wsh[i] = 0 then return i;\n");
  gen("    i := i + 1;\n");
  gen("  end;\n");
  gen("  return 0 - 1;\n");
  gen("end;\n");
  gen("\n");
  gen("function __wsock: int;\n");
  gen("var h, fd: int;\n");
  gen("begin\n");
  gen("  __wneedwsa;\n");
  gen("  h := winapi(__W_SOCKET, 2, 1, 6);\n");
  gen("  if h = 0 - 1 then return 0 - 24;\n");
  gen("  fd := __wslot;\n");
  gen("  if fd < 0 then\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__W_CLOSESOCKET, h);\n");
  gen("    return 0 - 24;\n");
  gen("  end;\n");
  gen("  __wsh[fd] := h;\n");
  gen("  __wev[fd] := 0;\n");
  gen("  return fd;\n");
  gen("end;\n");
  gen("\n");
  gen("// Winsock's sockaddr_in matches Linux's byte for byte for AF_INET: family at\n");
  gen("  // 0 (2), port big-endian at 2, address at 4.  So the caller's 16-byte buffer\n");
  gen("  // passes straight through.\n");
  gen("function __wbind(fd: int; sa: int; sln: int): int;\n");
  gen("var r: int;\n");
  gen("begin\n");
  gen("  if not __wissock(fd) then return 0 - 9;\n");
  gen("  r := winapi(__W_BIND, __wsh[fd], sa, sln);\n");
  gen("  if r < 0 then return 0 - 98;\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("function __wlisten(fd: int; backlog: int): int;\n");
  gen("var r: int;\n");
  gen("begin\n");
  gen("  if not __wissock(fd) then return 0 - 9;\n");
  gen("  r := winapi(__W_LISTEN, __wsh[fd], backlog);\n");
  gen("  if r < 0 then return 0 - 98;\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("function __waccept(fd: int): int;\n");
  gen("var h, nfd, nb: int;\n");
  gen("begin\n");
  gen("  if not __wissock(fd) then return 0 - 9;\n");
  gen("  h := winapi(__W_ACCEPT, __wsh[fd], 0, 0);\n");
  gen("  if h = 0 - 1 then return 0 - 11;   // WSAEWOULDBLOCK -> EAGAIN\n");
  gen("  nfd := __wslot;\n");
  gen("  if nfd < 0 then\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__W_CLOSESOCKET, h);\n");
  gen("    return 0 - 24;\n");
  gen("  end;\n");
  gen("  __wsh[nfd] := h;\n");
  gen("  __wev[nfd] := 0;\n");
  gen("  nb := 1;\n");
  gen("  __wp32(__wsa, 0, nb);\n");
  gen("  __wdummy := winapi(__W_IOCTL, h, 0x8004667E, addr(__wsa[0]));   // FIONBIO\n");
  gen("  return nfd;\n");
  gen("end;\n");
  gen("\n");
  gen("function __wsetopt(fd: int; opt: int; a: int; sln: int): int;\n");
  gen("begin\n");
  gen("  if not __wissock(fd) then return 0 - 9;\n");
  gen("  // SO_REUSEADDR is 4 on Windows; SO_REUSEPORT does not exist, ignore it\n");
  gen("  if opt = 15 then return 0;\n");
  gen("  __wdummy := winapi(__W_SETSOCKOPT, __wsh[fd], 0xFFFF, 4, a, sln);\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("function __wnonblock(fd: int): int;\n");
  gen("var nb: int;\n");
  gen("begin\n");
  gen("  if not __wissock(fd) then return 0;\n");
  gen("  nb := 1;\n");
  gen("  __wp32(__wsa, 0, nb);\n");
  gen("  __wdummy := winapi(__W_IOCTL, __wsh[fd], 0x8004667E, addr(__wsa[0]));\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("procedure __wput32abs(a: int; v: int);\n");
  gen("begin\n");
  gen("  poke(a, band(v, 255));\n");
  gen("  poke(a + 1, band(v shr 8, 255));\n");
  gen("  poke(a + 2, band(v shr 16, 255));\n");
  gen("  poke(a + 3, band(v shr 24, 255));\n");
  gen("end;\n");
  gen("\n");
  gen("// epoll_ctl: op 1=ADD, 2=DEL, 3=MOD.  The event mask sits at [ev+0].\n");
  gen("function __wepctl(op: int; fd: int; ev: int): int;\n");
  gen("var mask: int;\n");
  gen("begin\n");
  gen("  if (fd < 3) or (fd >= __WMAXFD) then return 0 - 9;\n");
  gen("  if op = 2 then\n");
  gen("  begin\n");
  gen("    __wev[fd] := 0;\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  mask := bor(peek(ev), peek(ev + 1) shl 8);\n");
  gen("  mask := bor(mask, peek(ev + 2) shl 16);\n");
  gen("  mask := bor(mask, peek(ev + 3) shl 24);\n");
  gen("  __wev[fd] := mask;\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("// epoll_wait: build a WSAPOLLFD array from the interest table, poll it, then\n");
  gen("  // write ready events into the caller's array (12 bytes each: events, fd).\n");
  gen("function __wepwait(a: int; maxev: int; timeout: int): int;\n");
  gen("var i, np, r, k, out, revents, ev, base, pe: int;\n");
  gen("begin\n");
  gen("  np := 0;\n");
  gen("  i := 3;\n");
  gen("  while i < __WMAXFD do\n");
  gen("  begin\n");
  gen("    if (__wsh[i] <> 0) and (__wev[i] <> 0) then\n");
  gen("    begin\n");
  gen("      base := np * 16;\n");
  gen("      __wp32(__wpoll, base, band(__wsh[i], 0xFFFFFFFF));\n");
  gen("      __wp32(__wpoll, base + 4, __wsh[i] shr 32);\n");
  gen("      ev := 0;\n");
  gen("      if band(__wev[i], 1) <> 0 then ev := bor(ev, 0x0300);   // IN -> RDNORM|RDBAND\n");
  gen("      if band(__wev[i], 4) <> 0 then ev := bor(ev, 0x0010);   // OUT -> WRNORM\n");
  gen("      __wpoll[base + 8] := chr(band(ev, 255));\n");
  gen("      __wpoll[base + 9] := chr(band(ev shr 8, 255));\n");
  gen("      __wpoll[base + 10] := chr(0);\n");
  gen("      __wpoll[base + 11] := chr(0);\n");
  gen("      __wpoll[base + 12] := chr(0);\n");
  gen("      __wpoll[base + 13] := chr(0);\n");
  gen("      __wpoll[base + 14] := chr(0);\n");
  gen("      __wpoll[base + 15] := chr(0);\n");
  gen("      __wrow[np] := i;\n");
  gen("      np := np + 1;\n");
  gen("    end;\n");
  gen("    i := i + 1;\n");
  gen("  end;\n");
  gen("  if np = 0 then\n");
  gen("  begin\n");
  gen("    if timeout > 0 then __wdummy := winapi(__K_SLEEP, timeout);\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  r := winapi(__W_WSAPOLL, addr(__wpoll[0]), np, timeout);\n");
  gen("  if band(r, 0xFFFFFFFF) = 0xFFFFFFFF then return 0 - 4;\n");
  gen("  if r = 0 then return 0;\n");
  gen("  out := 0;\n");
  gen("  k := 0;\n");
  gen("  while k < np do\n");
  gen("  begin\n");
  gen("    base := k * 16;\n");
  gen("    revents := bor(ord(__wpoll[base + 10]), ord(__wpoll[base + 11]) shl 8);\n");
  gen("    if revents <> 0 then\n");
  gen("    begin\n");
  gen("      ev := 0;\n");
  gen("      if band(revents, 0x0300) <> 0 then ev := bor(ev, 1);   // IN\n");
  gen("      if band(revents, 0x0010) <> 0 then ev := bor(ev, 4);   // OUT\n");
  gen("      if band(revents, 0x0001) <> 0 then ev := bor(ev, 8);   // ERR\n");
  gen("      if band(revents, 0x0002) <> 0 then ev := bor(ev, 16);   // HUP\n");
  gen("      pe := a + out * 12;\n");
  gen("      __wput32abs(pe, ev);\n");
  gen("      __wput32abs(pe + 4, __wrow[k]);\n");
  gen("      __wput32abs(pe + 8, 0);\n");
  gen("      out := out + 1;\n");
  gen("      if out >= maxev then return out;\n");
  gen("    end;\n");
  gen("    k := k + 1;\n");
  gen("  end;\n");
  gen("  return out;\n");
  gen("end;\n");
  gen("\n");
  gen("// clock_gettime-ish: return nanoseconds since the Unix epoch, good enough for\n");
  gen("  // the io.now() the library exposes.  FILETIME is 100ns ticks since 1601.\n");
  gen("function __wnow: int;\n");
  gen("var lo, hi, t: int;\n");
  gen("begin\n");
  gen("  __wdummy := winapi(__K_GETTIME, addr(__wtime[0]));\n");
  gen("  lo := __wg32(__wtime, 0);\n");
  gen("  hi := __wg32(__wtime, 4);\n");
  gen("  t := bor(lo, hi shl 32);\n");
  gen("  t := t - 116444736000000000;   // 1601 -> 1970 in 100ns ticks\n");
  gen("  return t * 100;   // 100ns -> ns\n");
  gen("end;\n");
  gen("\n");
  gen("// WIN32_FIND_DATAA: dwFileAttributes at 0, ftLastWriteTime at 20 (8 bytes),\n");
  gen("  // nFileSizeHigh at 28, nFileSizeLow at 32, cFileName at 44 (260 bytes).\n");
  gen("function __wattr_isdir(attr: int): bool;\n");
  gen("begin\n");
  gen("  return band(attr, 16) <> 0;   // FILE_ATTRIBUTE_DIRECTORY\n");
  gen("end;\n");
  gen("\n");
  gen("// GetFileAttributesExA fills a WIN32_FILE_ATTRIBUTE_DATA (36 bytes):\n");
  gen("  // attributes at 0, ftLastWriteTime at 20, sizeHigh at 28, sizeLow at 32.\n");
  gen("function __wstatinto(path: int; stbuf: int): int;\n");
  gen("var ok, attr, mode, sz, lo, hi, mt, mlo, mhi: int;\n");
  gen("begin\n");
  gen("  ok := winapi(__K_GETATTREX, path, 0, addr(__wfind[0]));   // GetFileAttributesExA\n");
  gen("  if band(ok, 0xFFFFFFFF) = 0 then return 0 - 2;\n");
  gen("  attr := __wg32(__wfind, 0);\n");
  gen("  mode := 0x8000;   // S_IFREG\n");
  gen("  if __wattr_isdir(attr) then mode := 0x4000;   // S_IFDIR\n");
  gen("  mode := bor(mode, 0x1FF);   // rwxrwxrwx bits\n");
  gen("  lo := __wg32(__wfind, 32);\n");
  gen("  hi := __wg32(__wfind, 28);\n");
  gen("  sz := bor(band(lo, 0xFFFFFFFF), hi shl 32);\n");
  gen("  mlo := __wg32(__wfind, 20);\n");
  gen("  mhi := __wg32(__wfind, 24);\n");
  gen("  mt := bor(band(mlo, 0xFFFFFFFF), mhi shl 32);\n");
  gen("  mt := mt - 116444736000000000;\n");
  gen("  mt := mt div 10000000;   // 100ns ticks -> seconds\n");
  gen("  // mode at offset 24, size at 48, mtime at 88 (see lib/fs.wz)\n");
  gen("  __wput32abs(stbuf + 24, mode);\n");
  gen("  __wput32abs(stbuf + 48, band(sz, 0xFFFFFFFF));\n");
  gen("  __wput32abs(stbuf + 52, sz shr 32);\n");
  gen("  __wput32abs(stbuf + 88, band(mt, 0xFFFFFFFF));\n");
  gen("  __wput32abs(stbuf + 92, mt shr 32);\n");
  gen("  return 0;\n");
  gen("end;\n");
  gen("\n");
  gen("// opendir(path): start a FindFirstFileA over path\\* and return a dir fd\n");
  gen("function __wopendir(path: int): int;\n");
  gen("var i, o, h, fd: int;\n");
  gen("    c: char;\n");
  gen("begin\n");
  gen("  o := 0;\n");
  gen("  while o < 1030 do\n");
  gen("  begin\n");
  gen("    c := chr(peek(path + o));\n");
  gen("    if c = chr(0) then break;\n");
  gen("    __wpath[o] := c;\n");
  gen("    o := o + 1;\n");
  gen("  end;\n");
  gen("  if (o > 0) and (__wpath[o - 1] <> '/') and (__wpath[o - 1] <> chr(92)) then\n");
  gen("  begin\n");
  gen("    __wpath[o] := chr(92);\n");
  gen("    o := o + 1;\n");
  gen("  end;\n");
  gen("  __wpath[o] := '*';\n");
  gen("  __wpath[o + 1] := chr(0);\n");
  gen("  h := winapi(__K_FINDFIRST, addr(__wpath[0]), addr(__wfind[0]));\n");
  gen("  if h = 0 - 1 then return 0 - 2;\n");
  gen("  fd := __wslot;\n");
  gen("  if fd < 0 then\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__K_FINDCLOSE, h);\n");
  gen("    return 0 - 24;\n");
  gen("  end;\n");
  gen("  __wsh[fd] := 0 - 2;   // mark the slot busy but not a socket\n");
  gen("  __wdh[fd] := h;\n");
  gen("  __wdfirst[fd] := 1;   // the first entry is already in __wfind\n");
  gen("  return fd;\n");
  gen("end;\n");
  gen("\n");
  gen("// getdents into the caller's buffer at address a, capacity cap.  Emits Linux\n");
  gen("  // dirent64-ish records: reclen (2 bytes) at +16, type (1 byte) at +18, the\n");
  gen("  // NUL-terminated name from +19.  Returns bytes written, or 0 at the end.\n");
  gen("function __wgetdents(fd: int; a: int; cap: int): int;\n");
  gen("var used, attr, i, nl, reclen, base, more, t: int;\n");
  gen("    c: char;\n");
  gen("begin\n");
  gen("  if not __wisdir(fd) then return 0 - 9;\n");
  gen("  used := 0;\n");
  gen("  while true do\n");
  gen("  begin\n");
  gen("    if __wdfirst[fd] = 0 then\n");
  gen("    begin\n");
  gen("      more := winapi(__K_FINDNEXT, __wdh[fd], addr(__wfind[0]));\n");
  gen("      if band(more, 0xFFFFFFFF) = 0 then break;\n");
  gen("    end;\n");
  gen("    __wdfirst[fd] := 0;\n");
  gen("    // name length\n");
  gen("    nl := 0;\n");
  gen("    while nl < 259 do\n");
  gen("    begin\n");
  gen("      if __wfind[44 + nl] = chr(0) then break;\n");
  gen("      nl := nl + 1;\n");
  gen("    end;\n");
  gen("    reclen := 19 + nl + 1;\n");
  gen("    reclen := (reclen + 7) div 8 * 8;\n");
  gen("    if used + reclen > cap then\n");
  gen("    begin\n");
  gen("      // no room: reprocess this entry next call by pretending it is first\n");
  gen("      __wdfirst[fd] := 1;\n");
  gen("      break;\n");
  gen("    end;\n");
  gen("    base := a + used;\n");
  gen("    __wput32abs(base, 0);   // d_ino low\n");
  gen("    __wput32abs(base + 4, 0);\n");
  gen("    __wput32abs(base + 8, 0);   // d_off\n");
  gen("    __wput32abs(base + 12, 0);\n");
  gen("    poke(base + 16, band(reclen, 255));\n");
  gen("    poke(base + 17, band(reclen shr 8, 255));\n");
  gen("    attr := __wg32(__wfind, 0);\n");
  gen("    t := 8;   // DT_REG\n");
  gen("    if __wattr_isdir(attr) then t := 4;   // DT_DIR\n");
  gen("    poke(base + 18, t);\n");
  gen("    i := 0;\n");
  gen("    while i < nl do\n");
  gen("    begin\n");
  gen("      poke(base + 19 + i, ord(__wfind[44 + i]));\n");
  gen("      i := i + 1;\n");
  gen("    end;\n");
  gen("    poke(base + 19 + nl, 0);\n");
  gen("    used := used + reclen;\n");
  gen("  end;\n");
  gen("  return used;\n");
  gen("end;\n");
  gen("\n");
  gen("\n");
  gen("function __wsys(nr: int; a: int; b: int; c: int; d: int; e: int; f: int): int;\n");
  gen("var t: int;\n");
  gen("begin\n");
  gen("  if nr = 1 then return __wwrite(a, b, c);\n");
  gen("  if nr = 0 then return __wread(a, b, c);\n");
  gen("  if nr = 2 then\n");
  gen("  begin\n");
  gen("    if band(b, 65536) <> 0 then return __wopendir(a);   // O_DIRECTORY\n");
  gen("    return __wopen(a, b);\n");
  gen("  end;\n");
  gen("  if (nr = 4) or (nr = 6) then return __wstatinto(a, b);   // stat / lstat\n");
  gen("  if nr = 217 then return __wgetdents(a, b, c);   // getdents\n");
  gen("  if nr = 3 then\n");
  gen("  begin\n");
  gen("    __wclose(a);\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 41 then return __wsock;   // socket\n");
  gen("  if nr = 49 then return __wbind(a, b, c);   // bind\n");
  gen("  if nr = 50 then return __wlisten(a, b);   // listen\n");
  gen("  if nr = 43 then return __waccept(a);   // accept\n");
  gen("  if nr = 288 then return __waccept(a);   // accept4\n");
  gen("  if nr = 54 then return __wsetopt(a, c, d, e);   // setsockopt\n");
  gen("  if nr = 72 then return __wnonblock(a);   // fcntl F_SETFL\n");
  gen("  if nr = 44 then return __wwrite(a, b, c);   // sendto -> send\n");
  gen("  if nr = 48 then return 0;   // shutdown: no-op\n");
  gen("  if nr = 291 then return 1000000;   // epoll_create -> token\n");
  gen("  if nr = 233 then return __wepctl(b, c, d);   // epoll_ctl\n");
  gen("  if nr = 232 then return __wepwait(b, c, d);   // epoll_wait\n");
  gen("  if nr = 228 then   // clock_gettime: fill the timespec\n");
  gen("  begin\n");
  gen("    t := __wnow;\n");
  gen("    __wput32abs(b, band(t div 1000000000, 0xFFFFFFFF));\n");
  gen("    __wput32abs(b + 4, (t div 1000000000) shr 32);\n");
  gen("    __wput32abs(b + 8, t mod 1000000000);\n");
  gen("    __wput32abs(b + 12, 0);\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 9 then return __wmmap(b, c, e, f);   // mmap\n");
  gen("  if nr = 11 then   // munmap\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__K_UNMAPVIEW, a);\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 26 then   // msync\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__K_FLUSHVIEW, a, b);\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 74 then   // fsync\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__K_FLUSHFILE, __whandle(a));\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 82 then   // rename\n");
  gen("  begin\n");
  gen("    t := winapi(__K_MOVEFILE, a, b, 9);   // REPLACE_EXISTING | WRITE_THROUGH\n");
  gen("    if band(t, 0xFFFFFFFF) = 0 then return 0 - 2;\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 8 then return __wlseek(a, b, c);   // lseek\n");
  gen("  if nr = 77 then return __wftruncate(a, b);   // ftruncate\n");
  gen("  if nr = 87 then   // unlink\n");
  gen("  begin\n");
  gen("    t := winapi(__K_DELETEFILE, a);\n");
  gen("    if band(t, 0xFFFFFFFF) = 0 then return 0 - 2;\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 83 then   // mkdir\n");
  gen("  begin\n");
  gen("    t := winapi(__K_CREATEDIR, a, 0);\n");
  gen("    if band(t, 0xFFFFFFFF) = 0 then return 0 - 17;\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 84 then   // rmdir\n");
  gen("  begin\n");
  gen("    t := winapi(__K_REMOVEDIR, a);\n");
  gen("    if band(t, 0xFFFFFFFF) = 0 then return 0 - 2;\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 73 then return __wflock(a, b);   // flock\n");
  gen("  if nr = 318 then   // getrandom\n");
  gen("  begin\n");
  gen("    t := winapi(__A_RANDOM, a, b);\n");
  gen("    if band(t, 0xFF) = 0 then return 0 - 1;\n");
  gen("    return b;\n");
  gen("  end;\n");
  gen("  if nr = 35 then   // nanosleep\n");
  gen("  begin\n");
  gen("    __wdummy := winapi(__K_SLEEP, 1);\n");
  gen("    return 0;\n");
  gen("  end;\n");
  gen("  if nr = 90 then return 0;   // chmod: no-op\n");
  // readlink: -1, NOT a trap. Windows has no /proc/self/exe, and setlibdir asks for it
  // first to find lib/ without trusting argv[0]. Returning the error is what makes it
  // fall back to argv[0]; trapping here killed wantzel.exe before it compiled anything.
  // The equivalent on Windows is GetModuleFileNameA, reachable through winapi() by name
  // without a compiler change -- worth doing when something needs the real path here.
  gen("  if nr = 89 then return 0 - 1;   // readlink: no /proc, caller falls back\n");
  gen("  if nr = 57 then return 0;   // fork: no worker processes, run single-process\n");
  gen("  if nr = 61 then return 0;   // wait4: nothing to wait for\n");
  gen("  if (nr = 60) or (nr = 231) then winapi(__K_EXITPROCESS, band(a, 0xFFFFFFFF));\n");
  gen("  __wputs(\"runtime error: an unsupported system call was made on Windows\\n\");\n");
  gen("  winapi(__K_EXITPROCESS, 70);\n");
  gen("  return 0 - 1;\n");
  gen("end;\n");
  gen("\n");
  gen("function __winit: int;\n");
  gen("var i, o, n, k, na: int;\n");
  gen("    inq: bool;\n");
  gen("    c: char;\n");
  gen("begin\n");
  gen("  __wdummy := winapi(__K_GETCMDLINE);\n");
  gen("  __wdummy := winapi(__K_LSTRCPYN, addr(__wargs[0]), __wdummy, 4095);\n");
  gen("  __wargs[4095] := chr(0);\n");
  gen("  i := 0; o := 0; na := 0;\n");
  gen("  while true do\n");
  gen("  begin\n");
  gen("    while (__wargs[i] = chr(32)) or (__wargs[i] = chr(9)) do i := i + 1;\n");
  gen("    if __wargs[i] = chr(0) then break;\n");
  gen("    if na >= 62 then break;\n");
  gen("    __wargv[na + 1] := addr(__wargs[o]);\n");
  gen("    na := na + 1;\n");
  gen("    inq := false;\n");
  gen("    while true do\n");
  gen("    begin\n");
  gen("      c := __wargs[i];\n");
  gen("      if c = chr(0) then break;\n");
  gen("      if (not inq) and ((c = chr(32)) or (c = chr(9))) then break;\n");
  gen("      if c = chr(92) then\n");
  gen("      begin\n");
  gen("        n := 0;\n");
  gen("        while __wargs[i] = chr(92) do\n");
  gen("        begin\n");
  gen("          n := n + 1;\n");
  gen("          i := i + 1;\n");
  gen("        end;\n");
  gen("        if __wargs[i] = chr(34) then\n");
  gen("        begin\n");
  gen("          k := 0;\n");
  gen("          while k < n div 2 do\n");
  gen("          begin\n");
  gen("            __wargs[o] := chr(92);\n");
  gen("            o := o + 1;\n");
  gen("            k := k + 1;\n");
  gen("          end;\n");
  gen("          if (n mod 2) = 1 then\n");
  gen("          begin\n");
  gen("            __wargs[o] := chr(34);\n");
  gen("            o := o + 1;\n");
  gen("          end\n");
  gen("          else inq := not inq;\n");
  gen("          i := i + 1;\n");
  gen("        end\n");
  gen("        else\n");
  gen("        begin\n");
  gen("          k := 0;\n");
  gen("          while k < n do\n");
  gen("          begin\n");
  gen("            __wargs[o] := chr(92);\n");
  gen("            o := o + 1;\n");
  gen("            k := k + 1;\n");
  gen("          end;\n");
  gen("        end;\n");
  gen("      end\n");
  gen("      else if c = chr(34) then\n");
  gen("      begin\n");
  gen("        inq := not inq;\n");
  gen("        i := i + 1;\n");
  gen("      end\n");
  gen("      else\n");
  gen("      begin\n");
  gen("        __wargs[o] := c;\n");
  gen("        o := o + 1;\n");
  gen("        i := i + 1;\n");
  gen("      end;\n");
  gen("    end;\n");
  gen("    c := __wargs[i];\n");
  gen("    __wargs[o] := chr(0);\n");
  gen("    o := o + 1;\n");
  gen("    if c <> chr(0) then i := i + 1;\n");
  gen("  end;\n");
  gen("  __wargv[0] := na;\n");
  gen("  __wargv[na + 1] := 0;\n");
  gen("  return addr(__wargv[0]);\n");
  gen("end;\n");
end;

procedure injectwin;
var fi, f, i: int;
begin
  if incdepth >= 16 then fail("includes nested too deeply");
  i := 0;
  while i < 9 do
  begin
    pathbuf[i] := schar("<windows>", i);
    i := i + 1;
  end;
  pathbuf[9] := chr(0);
  fi := addfile;
  incpos[incdepth] := pos; incend[incdepth] := srcend;
  incline[incdepth] := line; incfile[incdepth] := curfile;
  incdepth := incdepth + 1;
  f := srclen;
  genwin;
  pos := f; srcend := srclen; line := 1; curfile := fi;
  next;
end;

// ------------------------------------------------------------------
// program
// ------------------------------------------------------------------

procedure emitprelude;
var i, j, k: int;
begin
  entryoff := 0;
  if winmode <> 0 then
  begin
    // __sysraw: hand the Linux register set to __wsys(nr, a, b, c, d, e, f)
    sysrawaddr := codelen;
    e(0x41); e(0x54);
    e(0x4D); e(0x89); e(0xCC);
    e(0x4D); e(0x89); e(0xC1);
    e(0x4D); e(0x89); e(0xD0);
    e(0x48); e(0x89); e(0xD1);
    e(0x48); e(0x89); e(0xF2);
    e(0x48); e(0x89); e(0xFE);
    e(0x48); e(0x89); e(0xC7);
    e(0xE8); fixup(FX_WSYS, 0); e32(0);
    e(0x41); e(0x5C);
    e(0xC3);
    // entry: __winit builds an argc/argv block; its address goes where a
    // Linux executable keeps its initial stack pointer
    entryoff := codelen;
    e(0xE8); fixup(FX_WINIT, 0); e32(0);
    e(0x49); e(0xBA); fixup(FX_BSS, 0); e64(0);
    e(0x49); e(0x89); e(0x02);
  end
  else
  begin
    e(0x49); e(0xBA); fixup(FX_BSS, 0); e64(0);
    e(0x49); e(0x89); e(0x22);
  end;
  e(0xE8); mainpatch := codelen; e32(0);
  e(0x31); e(0xFF);
  imm(231); syscallinsn;
  emittrap;
  argaddr := codelen;
  e(0x49); e(0xBA); fixup(FX_BSS, 0); e64(0);
  e(0x4D); e(0x8B); e(0x12);
  e(0x49); e(0x3B); e(0x3A);
  e(0x0F); e(0x83); e32(43);
  e(0x4D); e(0x8B); e(0x5C); e(0xFA); e(0x08);
  e(0x31); e(0xC0);
  e(0x49); e(0x0F); e(0xB6); e(0x0C); e(0x03);
  e(0x48); e(0x85); e(0xC9);
  e(0x0F); e(0x84); e32(22);
  e(0x48); e(0x39); e(0xF0);
  e(0x0F); e(0x84); e32(9);
  e(0x48); e(0x83); e(0xC0); e(0x01);
  e(0xE9); e32(0 - 32);
  e(0x48); e(0x89); e(0xC8);
  e(0xC3);
  e(0x31); e(0xC0);
  e(0xC3);
  // __scan(rdi=base, rsi=len, rdx=from, rcx=to, r8b=byte) -> rax
  // sixteen bytes per step, with a byte loop for the tail
  scanaddr := codelen;
  e(0x66); e(0x41); e(0x0F); e(0x6E); e(0xC8);
  e(0x66); e(0x0F); e(0x60); e(0xC9);
  e(0x66); e(0x0F); e(0x61); e(0xC9);
  e(0x66); e(0x0F); e(0x70); e(0xC9); e(0x00);
  e(0x48); e(0x89); e(0xD0);
  i := codelen;
  e(0x4C); e(0x8D); e(0x58); e(0x10);
  e(0x49); e(0x39); e(0xCB);
  j := jfwd(0x0F, 0x87);
  e(0xF3); e(0x0F); e(0x6F); e(0x04); e(0x07);
  e(0x66); e(0x0F); e(0x74); e(0xC1);
  e(0x66); e(0x44); e(0x0F); e(0xD7); e(0xC8);
  e(0x45); e(0x85); e(0xC9);
  k := jfwd(0x0F, 0x85);
  e(0x4C); e(0x89); e(0xD8);
  jmpto(0, 0xE9, i);
  patch(k);
  e(0x45); e(0x0F); e(0xBC); e(0xC9);
  e(0x4C); e(0x01); e(0xC8);
  e(0xC3);
  patch(j);
  i := codelen;
  e(0x48); e(0x39); e(0xC8);
  j := jfwd(0x0F, 0x83);
  e(0x44); e(0x0F); e(0xB6); e(0x14); e(0x07);
  e(0x45); e(0x39); e(0xC2);
  k := jfwd(0x0F, 0x84);
  e(0x48); e(0x83); e(0xC0); e(0x01);
  jmpto(0, 0xE9, i);
  patch(j); patch(k);
  e(0xC3);
end;

procedure parseprogram;
var i, nunres: int;
begin
  emitprelude;
  // The Windows runtime is injected BEFORE the first token is read. injectwin saves the
  // read position and returns to it when the injected source ends, so anything already
  // read at that moment would be lost. With nothing read yet, the saved position is the
  // start of the file and the first real token is read on the way back -- on Linux the
  // plain next reads it directly.
  if winmode <> 0 then injectwin else next;
  while true do
  begin
    // A source that still carries the old 'program <name>;' header gets told so. The
    // header never did anything -- the name was stored nowhere and an included file was
    // never treated differently -- and requiring it made a library impossible to compile
    // on its own.
    if (tok = TK_ID) and eqt("program") then
      fail("the 'program' header is no longer part of the language; delete that line");
    if tok = KW_INCLUDE then doinclude
    // 'schema X = record ... end' was its own top-level declaration until 17-09-2026.
    // It is now 'type X = schema ... end', so decltypes dispatches on it and there is no
    // second keyword at the start of a declaration. Naming the old form explicitly costs
    // one comparison and saves the reader of an older source a puzzle.
    else if tok = KW_SCHEMA then
      fail("a schema is declared as 'type X = schema ... end;'")
    else if tok = KW_TOOLS then decltools
    // ---- `local` IN FRONT OF A DECLARATION: VISIBLE IN THIS FILE ONLY ------------------
    //
    // declloc carries the file number until the declaration has been read, then goes back
    // to -1 (public). That -1 is the default, so all existing source compiles unchanged --
    // `local` is purely something you WRITE.
    //
    // ONLY for var, const, procedure and function. A type or a schema cannot be made local
    // (yet); saying so here beats leaving it as a silent limitation.
    else if tok = KW_LOCAL then
    begin
      next;
      declloc := curfile;
      if tok = KW_CONST then declconsts(0)
      else if tok = KW_VAR then declvars(0)
      else if tok = KW_FUNCTION then declroutine(0)
      else if tok = KW_PROCEDURE then declroutine(1)
      else fail("after 'local' comes var, const, procedure or function");
      declloc := 0 - 1;
    end
    else if tok = KW_CONST then declconsts(0)
    else if tok = KW_TYPE then decltypes
    else if tok = KW_VAR then declvars(0)
    else if tok = KW_FUNCTION then declroutine(0)
    else if tok = KW_PROCEDURE then declroutine(1)
    else break;
  end;
  // Report EVERY unresolved forward, not just the first: a program that serves HTTP
  // defines several hooks from more than one library, and fixing them one compile at a
  // time is the slow path.  Each is named, at the file and line of its declaration.
  i := 0;
  nunres := 0;
  while i < nfn do
  begin
    if fdef[i] = 0 then
    begin
      wrs(2, "wantzel: "); wrfile(2, ffile[i]); wrs(2, ":"); wrnum(2, fline[i]);
      wrs(2, ": forward declared routine "); wrnam(2, fnam[i]);
      wrs(2, " is never defined\n");
      nunres := nunres + 1;
    end;
    i := i + 1;
  end;
  if nunres > 0 then halt(1);
  if tok <> KW_BEGIN then fail("missing begin of the main program");
  next;
  mainaddr := codelen;
  nloc := 0; frame := 0; curfn := -1; curret := T_VOID;
  nbrk := 0; ncnt := 0; brkbase := -1; cntbase := -1;
  e(0x55); e(0x48); e(0x89); e(0xE5);
  e(0x48); e(0x81); e(0xEC); framepatch := codelen; e32(0);
  stmtlist;
  if tok <> KW_END then fail("missing end of the main program");
  next;
  if tok <> 46 then fail("missing . after the final end");
  next;
  if tok <> TK_EOF then fail("text after the end of the program");
  e(0x48); e(0x31); e(0xC0);
  epilogue;
  while (frame mod 16) <> 0 do frame := frame + 8;
  e32at(framepatch, frame);
  e32at(mainpatch, mainaddr - (mainpatch + 4));
end;

// ------------------------------------------------------------------
// ELF output
// ------------------------------------------------------------------

procedure ph(b: int);
begin
  hdr[hlen] := chr(band(b, 255));
  hlen := hlen + 1;
end;

procedure ph16(v: int);
begin
  ph(v); ph(v shr 8);
end;

procedure ph32(v: int);
begin
  ph16(v); ph16(v shr 16);
end;

procedure ph64(v: int);
begin
  ph32(v); ph32(v shr 32);
end;

procedure writeelf;
var datava, bssva, filesz, memsz, i, k, v, fd: int;
begin
  while (codelen mod 8) <> 0 do e(0x90);
  datava := VBASE + HDRLEN + codelen;
  filesz := HDRLEN + codelen + datlen;
  bssva := VBASE + filesz;
  while (bssva mod 8) <> 0 do bssva := bssva + 1;
  memsz := (bssva - VBASE) + bsslen;

  i := 0;
  while i < nfx do
  begin
    k := fxkind[i];
    if k = FX_CALL then e32at(fxoff[i], fadr[fxval[i]] - (fxoff[i] + 4))
    else if k = FX_BSS32 then e32at(fxoff[i], bssva + fxval[i])
    else
    begin
      if k = FX_DATA then v := datava + fxval[i] else v := bssva + fxval[i];
      e32at(fxoff[i], v);
      e32at(fxoff[i] + 4, v shr 32);
    end;
    i := i + 1;
  end;

  hlen := 0;
  ph(0x7F); ph(69); ph(76); ph(70);
  ph(2); ph(1); ph(1); ph(0);
  ph(0); ph(0); ph(0); ph(0); ph(0); ph(0); ph(0); ph(0);
  ph16(2); ph16(0x3E); ph32(1);
  ph64(VBASE + HDRLEN);
  ph64(64); ph64(0); ph32(0);
  ph16(64); ph16(56); ph16(1); ph16(64); ph16(0); ph16(0);
  ph32(1); ph32(7);
  ph64(0); ph64(VBASE); ph64(VBASE);
  ph64(filesz); ph64(memsz); ph64(0x1000);

  fd := opn(addr(outname[0]), 577, 493);
  if fd < 0 then fail("cannot create the output file");
  wrbuf(fd, addr(hdr[0]), hlen);
  wrbuf(fd, addr(code[0]), codelen);
  wrbuf(fd, addr(dat[0]), datlen);
  cls(fd);
  chm(addr(outname[0]), 493);
end;

// ------------------------------------------------------------------
// PE output: a 64-bit Windows executable
// ------------------------------------------------------------------
// Three sections: .text, .rdata (the string data followed by the import
// tables for kernel32) and .bss.  No relocations, so the image is fixed at
// VBASE, exactly like the ELF; no section is both writable and executable.

procedure pd(b: int);
begin
  dput(b);
end;

procedure pd16(v: int);
begin
  pd(v); pd(v shr 8);
end;

procedure pd32(v: int);
begin
  pd16(v); pd16(v shr 16);
end;

procedure pds(s: str);
var i: int;
begin
  i := 0;
  while i < slen(s) do
  begin
    pd(ord(schar(s, i)));
    i := i + 1;
  end;
  pd(0);
end;

procedure phs(s: str);
var i: int;
begin
  i := 0;
  while i < slen(s) do
  begin
    ph(ord(schar(s, i)));
    i := i + 1;
  end;
end;

// The import address table, in slot order; winapi() indexes it.
// Imported functions, in IAT slot order.  winapi(slot) calls slot*8 into the
// IAT.  The first WSBASE slots live in kernel32, the rest in ws2_32; the two
// DLLs get their own null-terminated thunk arrays, which is why the slot after
// the last kernel32 entry is reserved as a gap (see the IAT layout below).
// Record a (DLL, function) pair the source asked for and return its import slot, or -1
// when a table is full. Looking up an existing pair first means naming the same function
// twice costs one entry, not two.
function extslot(dl: int; dn: int; fn: int; fl: int): int;
var i, k, o, d: int;
begin
  // Is this a DLL the compiler already imports, and a function it already has? Then reuse
  // that slot. A function it does NOT have gets an entry of its own below, which means a
  // second directory entry naming the same library. That is legal in PE and deliberate:
  // the built-in names and the source-named ones are two separate runs in the name table,
  // and interleaving them would put the IAT out of step with the names.
  i := 0;
  while i < 4 do
  begin
    if eqname(dn, dl, dllname(i)) then
    begin
      k := builtinslot(i, fn, fl);
      if k >= 0 then begin extlast := 0 - 1; return k; end;   // built-in: reuse that slot
      i := 4;                           // known DLL, function we do not have: see below
    end
    else i := i + 1;
  end;
  // which extra DLL is this? compare against the names already recorded
  d := 0 - 1;
  i := 0;
  while i < nextd do
  begin
    o := extdnam[i]; k := 0;
    while (k < dl) and (extnam[o + k] = extnam[dn + k]) do k := k + 1;
    if (k = dl) and (ord(extnam[o + k]) = 0) then d := i;
    i := i + 1;
  end;
  if d < 0 then
  begin
    if nextd >= MAXEXTD then return 0 - 1;
    d := nextd; extdnam[d] := dn; nextd := nextd + 1;
  end;
  // already imported this function from this DLL?
  i := 0;
  while i < next_ do
  begin
    if extdll[i] = d then
    begin
      o := extfn[i]; k := 0;
      while (k < fl) and (extnam[o + k] = extnam[fn + k]) do k := k + 1;
      if (k = fl) and (ord(extnam[o + k]) = 0) then
      begin extlast := i; return extiat(i); end;
    end;
    i := i + 1;
  end;
  if next_ >= MAXEXT then return 0 - 1;
  extdll[next_] := d; extfn[next_] := fn; next_ := next_ + 1;
  extlast := next_ - 1;
  return extiat(next_ - 1);
end;

// Which extra import sits at grouped position p -- the inverse of the walk in extiat.
// The import directory writes one entry per DLL with that DLL's names together, while
// extdll/extfn hold them in the order the source named them. Reading extfn[p] directly
// filed CreateFontA under user32 and MessageBoxA under gdi32: names the loader cannot
// resolve, so the slot stays zero and the call lands on address zero.
function extat(p: int): int;
var d, k, seen: int;
begin
  seen := 0;
  d := 0;
  while d < nextd do
  begin
    k := 0;
    while k < next_ do
    begin
      if extdll[k] = d then
      begin
        if seen = p then return k;
        seen := seen + 1;
      end;
      k := k + 1;
    end;
    d := d + 1;
  end;
  return 0;
end;

// The name of import i: built-in ones are literals, the rest live in extnam. impnamelen
// and pdsimp below handle both, because a str cannot be built at runtime here.
function impnamelen(i: int): int;
var o: int;
begin
  if i < NIMP then return slen(impname(i));
  o := extfn[extat(i - NIMP)];
  return zlen(extnam, o);
end;

procedure pdsimp(i: int);
var o, k: int;
begin
  if i < NIMP then begin pds(impname(i)); return; end;
  o := extfn[extat(i - NIMP)]; k := 0;
  while ord(extnam[o + k]) <> 0 do begin pd(ord(extnam[o + k])); k := k + 1; end;
  pd(0);
end;

function impname(i: int): str;
begin
  if i = 0 then return "GetStdHandle";
  if i = 1 then return "WriteFile";
  if i = 2 then return "ReadFile";
  if i = 3 then return "CreateFileA";
  if i = 4 then return "CloseHandle";
  if i = 5 then return "ExitProcess";
  if i = 6 then return "GetCommandLineA";
  if i = 7 then return "lstrcpynA";
  if i = 8 then return "GetSystemTimeAsFileTime";
  if i = 9 then return "Sleep";
  if i = 10 then return "GetFileAttributesExA";
  if i = 11 then return "FindFirstFileA";
  if i = 12 then return "FindNextFileA";
  if i = 13 then return "FindClose";
  if i = 14 then return "CreateFileMappingA";
  if i = 15 then return "MapViewOfFile";
  if i = 16 then return "UnmapViewOfFile";
  if i = 17 then return "FlushViewOfFile";
  if i = 18 then return "FlushFileBuffers";
  if i = 19 then return "MoveFileExA";
  if i = 20 then return "SetFilePointerEx";
  if i = 21 then return "SetEndOfFile";
  if i = 22 then return "DeleteFileA";
  if i = 23 then return "CreateDirectoryA";
  if i = 24 then return "RemoveDirectoryA";
  if i = 25 then return "LockFileEx";
  if i = 26 then return "UnlockFileEx";
  // ws2_32, from name 27
  if i = 27 then return "WSAStartup";
  if i = 28 then return "socket";
  if i = 29 then return "closesocket";
  if i = 30 then return "setsockopt";
  if i = 31 then return "ioctlsocket";
  if i = 32 then return "bind";
  if i = 33 then return "listen";
  if i = 34 then return "accept";
  if i = 35 then return "send";
  if i = 36 then return "recv";
  if i = 37 then return "WSAPoll";
  // advapi32
  if i = 38 then return "SystemFunction036";
  // user32, from name 39: the smallest set that puts a window on the screen with an
  // editable text area in it. No gdi32: an EDIT control draws itself, and brings
  // scrolling, selection and clipboard with it.
  if i = 39 then return "RegisterClassExA";
  if i = 40 then return "CreateWindowExA";
  if i = 41 then return "DefWindowProcA";
  if i = 42 then return "GetMessageA";
  if i = 43 then return "TranslateMessage";
  if i = 44 then return "DispatchMessageA";
  if i = 45 then return "PostQuitMessage";
  if i = 46 then return "ShowWindow";
  return "SendMessageA";
end;

// The DLLs, as a table instead of three hand-kept constants. Adding one is a row here and
// a row in dllfirst -- the import directory and the IAT/ILT below are written by a loop
// over ndll, so nothing else counts DLLs by hand. That is deliberate: when the three
// groups were unrolled, a fourth DLL twice produced an .exe that built, had the right
// size, and hung -- once because iatlen assumed three terminators, once because a loop
// ran to NIMP past its own group.
function ndll: int;
begin
  return 4 + nextd;                    // the built-in four, plus what the source named
end;

// The built-in DLL names are literals; a name the source asked for lives in extnam and is
// written out by dllnamew below, because a str cannot be built at runtime here.
function dllname(d: int): str;
begin
  if d = 0 then return "KERNEL32.dll";
  if d = 1 then return "WS2_32.dll";
  if d = 2 then return "ADVAPI32.dll";
  return "USER32.dll";
end;

// length of DLL d's name, built-in or source-named
function dllnamelen(d: int): int;
var o: int;
begin
  if d < 4 then return slen(dllname(d));
  o := extdnam[d - 4];
  return zlen(extnam, o);
end;

// emit DLL d's name plus its NUL, into the data block
procedure pdsdll(d: int);
var o, i: int;
begin
  if d < 4 then begin pds(dllname(d)); return; end;
  o := extdnam[d - 4]; i := 0;
  while ord(extnam[o + i]) <> 0 do begin pd(ord(extnam[o + i])); i := i + 1; end;
  pd(0);
end;

// index of the first function of DLL d in impname(); dllfirst(ndll) is the total
function dllfirst(d: int): int;
var i, n: int;
begin
  if d = 0 then return 0;
  if d = 1 then return KCOUNT;
  if d = 2 then return KCOUNT + WCOUNT;
  if d = 3 then return KCOUNT + WCOUNT + ACOUNT;
  // the extra DLLs follow, each with the functions the source named from it
  n := NIMP; i := 0;
  while (i < d - 4) and (i < nextd) do
  begin
    n := n + extcount(i);
    i := i + 1;
  end;
  return n;
end;

// how many functions the source named from extra DLL e
function extcount(e: int): int;
var i, n: int;
begin
  n := 0; i := 0;
  while i < next_ do
  begin
    if extdll[i] = e then n := n + 1;
    i := i + 1;
  end;
  return n;
end;

// length of a NUL-terminated name in a char array
function zlen(a: array of char; at: int): int;
var n: int;
begin
  n := 0;
  while ord(a[at + n]) <> 0 do n := n + 1;
  return n;
end;

// offset of hint/name entry i within the name block */
function impoff(i: int): int;
var o, k, n: int;
begin
  o := 0;
  k := 0;
  while k < i do
  begin
    n := 3 + impnamelen(k);
    if (n mod 2) = 1 then n := n + 1;
    o := o + n;
    k := k + 1;
  end;
  return o;
end;

function align(v: int; a: int): int;
begin
  while (v mod a) <> 0 do v := v + 1;
  return v;
end;

procedure writepe;
var textrva, textraw, rdatarva, rdataraw, bssrva, imgsize: int;
    codeva, datava, bssva, iatva, idt, iat, names, i, k, v, fd, wsys, winit: int;
    iatlen, d, dnam: int;
begin
  // The IAT (and an identical ILT) each hold KCOUNT kernel32 thunks, a null,
  // WCOUNT ws2_32 thunks, a null, ACOUNT advapi32 thunks, and a null:
  // NIMP + 3 eight-byte entries.
  iatlen := 8 * (NIMP + next_ + ndll); // every import, plus one terminator per DLL
  while (codelen mod 8) <> 0 do e(0x90);
  while (datlen mod 8) <> 0 do pd(0);
  textrva := 0x1000;
  rdatarva := align(textrva + codelen, 0x1000);
  idt := datlen;
  iat := idt + 20 * (ndll + 1);          // one entry per DLL, plus a null one
  names := iat + iatlen + iatlen;        // IAT, then ILT, then the names
  // --- import directory table: one entry per DLL, then a null one ---
  d := 0;
  dnam := impoff(NIMP + next_);          // the DLL names sit after the hint/name table
  while d < ndll do
  begin
    // thunk k of DLL d sits at slot dllfirst(d) + d + k: every earlier group has
    // contributed its own functions plus one terminator.
    v := 8 * (dllfirst(d) + d);
    pd32(rdatarva + iat + iatlen + v);            // this DLL's ILT
    pd32(0); pd32(0);
    pd32(rdatarva + names + dnam);                // its name
    pd32(rdatarva + iat + v);                     // its IAT
    dnam := dnam + dllnamelen(d) + 1;
    d := d + 1;
  end;
  pd32(0); pd32(0); pd32(0); pd32(0); pd32(0);    // null directory entry
  // --- the IAT, then an identical ILT ---
  k := 0;
  while k < 2 do
  begin
    d := 0;
    while d < ndll do
    begin
      i := dllfirst(d);
      while i < dllfirst(d + 1) do
      begin
        pd32(rdatarva + names + impoff(i)); pd32(0);
        i := i + 1;
      end;
      pd32(0); pd32(0);                           // one terminator per DLL
      d := d + 1;
    end;
    k := k + 1;
  end;
  // --- hint/name table ---
  i := 0;
  while i < NIMP + next_ do
  begin
    pd16(0); pdsimp(i);
    if (impnamelen(i) mod 2) = 0 then pd(0);
    i := i + 1;
  end;
  d := 0;
  while d < ndll do begin pdsdll(d); d := d + 1; end;
  textraw := align(codelen, 512);
  rdataraw := align(datlen, 512);
  bssrva := align(rdatarva + datlen, 0x1000);
  imgsize := align(bssrva + bsslen, 0x1000);
  codeva := VBASE + textrva;
  datava := VBASE + rdatarva;
  bssva := VBASE + bssrva;
  iatva := datava + iat;
  wsys := fnbyname("__wsys");
  winit := fnbyname("__winit");

  i := 0;
  while i < nfx do
  begin
    k := fxkind[i];
    if k = FX_CALL then e32at(fxoff[i], fadr[fxval[i]] - (fxoff[i] + 4))
    else if k = FX_BSS32 then e32at(fxoff[i], bssva + fxval[i])
    else if k = FX_WSYS then e32at(fxoff[i], fadr[wsys] - (fxoff[i] + 4))
    else if k = FX_WINIT then e32at(fxoff[i], fadr[winit] - (fxoff[i] + 4))
    else if k = FX_IAT then e32at(fxoff[i], iatva - (codeva + fxoff[i] + 4))
    else if k = FX_SLOT then e32at(fxoff[i], extiat(fxval[i]))
    else if k = FX_SHIM then
    begin
      v := codeva + fxval[i];
      e32at(fxoff[i], v);
      e32at(fxoff[i] + 4, v shr 32);
    end
    else if k = FX_FADR then
    begin
      // The address a callback needs: absolute, because Windows calls it from its own
      // code and nothing rip-relative would mean anything there.
      v := codeva + fadr[fxval[i]];
      e32at(fxoff[i], v);
      e32at(fxoff[i] + 4, v shr 32);
    end
    else
    begin
      if k = FX_DATA then v := datava + fxval[i] else v := bssva + fxval[i];
      e32at(fxoff[i], v);
      e32at(fxoff[i] + 4, v shr 32);
    end;
    i := i + 1;
  end;

  hlen := 0;
  // DOS header and stub
  ph(77); ph(90); ph16(0x90); ph16(3); ph16(0); ph16(4);
  ph16(0); ph16(0xFFFF); ph16(0); ph16(0xB8);
  ph16(0); ph16(0); ph16(0); ph16(0x40);
  while hlen < 60 do ph(0);
  ph32(0x80);
  ph(0x0E); ph(0x1F); ph(0xBA); ph(0x0E); ph(0); ph(0xB4); ph(0x09);
  ph(0xCD); ph(0x21); ph(0xB8); ph(0x01); ph(0x4C); ph(0xCD); ph(0x21);
  phs("This program cannot be run in DOS mode.");
  ph(13); ph(13); ph(10); ph(36);
  while hlen < 128 do ph(0);
  // PE signature and COFF header
  ph(80); ph(69); ph(0); ph(0);
  ph16(0x8664); ph16(3); ph32(0); ph32(0); ph32(0); ph16(240); ph16(0x23);
  // optional header
  ph16(0x20B); ph(1); ph(0);
  ph32(textraw); ph32(rdataraw); ph32(align(bsslen, 512));
  ph32(textrva + entryoff); ph32(textrva);
  ph64(VBASE);
  ph32(0x1000); ph32(512);
  ph16(6); ph16(0); ph16(0); ph16(0); ph16(6); ph16(0);
  ph32(0);
  ph32(imgsize); ph32(HDRMAX); ph32(0);
  ph16(3); ph16(0x8100);
  ph64(0x800000); ph64(0x800000); ph64(0x100000); ph64(0x1000);
  ph32(0); ph32(16);
  ph32(0); ph32(0);
  ph32(rdatarva + idt); ph32(60);
  i := 0;
  while i < 10 do
  begin
    ph32(0); ph32(0);
    i := i + 1;
  end;
  ph32(rdatarva + iat); ph32(iatlen);
  ph32(0); ph32(0); ph32(0); ph32(0); ph32(0); ph32(0);
  // section table
  phs(".text"); ph(0); ph(0); ph(0);
  ph32(codelen); ph32(textrva); ph32(textraw); ph32(HDRMAX);
  ph32(0); ph32(0); ph16(0); ph16(0); ph32(0x60000020);
  phs(".rdata"); ph(0); ph(0);
  ph32(datlen); ph32(rdatarva); ph32(rdataraw); ph32(HDRMAX + textraw);
  ph32(0); ph32(0); ph16(0); ph16(0); ph32(0x40000040);
  phs(".bss"); ph(0); ph(0); ph(0); ph(0);
  ph32(bsslen); ph32(bssrva); ph32(0); ph32(0);
  ph32(0); ph32(0); ph16(0); ph16(0); ph32(0xC0000080);
  while hlen < HDRMAX do ph(0);

  while (codelen mod 512) <> 0 do e(0);
  while (datlen mod 512) <> 0 do pd(0);
  fd := opn(addr(outname[0]), 577, 493);
  if fd < 0 then fail("cannot create the output file");
  wrbuf(fd, addr(hdr[0]), hlen);
  wrbuf(fd, addr(code[0]), codelen);
  wrbuf(fd, addr(dat[0]), datlen);
  cls(fd);
  chm(addr(outname[0]), 493);
end;

function compile: int;
var n: int;
begin
  line := 1;
  srclen := 0; fnplen := 0; nfiles := 0; incdepth := 0;
  // PUBLIC IS THE DEFAULT: without `local` in front, every name is visible exactly as it
  // always was, so existing source compiles unchanged.
  declloc := 0 - 1;
  curfile := addfile;
  n := readfile;
  if n < 0 then
  begin
    wrs(2, "wantzel: cannot open "); wrname(2); wrs(2, "\n");
    return 1;
  end;
  pos := 0;
  srcend := n;
  bsslen := 8;
  parseprogram;
  if winmode <> 0 then writepe else writeelf;
  return 0;
end;

function argeq(a: int; s: str): bool;
var i: int;
begin
  i := 0;
  while true do
  begin
    if ord(argch(a, i)) <> sch(s, i) then return false;
    if sch(s, i) = 0 then return true;
    i := i + 1;
  end;
  return false;
end;
