// wantzel.wz -- the compiler as a command-line program.
//
// The compiler ITSELF is in compiler.wz, which has no main program and can therefore be
// included by anything. This file is what makes it an executable: the argument handling,
// and one line to run it.

include "compiler.wz";

// wzmain -- everything the command line does, so that the program itself is one line.
//
// WHY IT IS A ROUTINE. A file ending in `end.` is a PROGRAM, and a program cannot be
// included by another one: `include "wantzel.wz";` followed by your own `begin` gives
// "text after the end of the program". That makes the compiler unusable as a component --
// an editor that wants to compile has to find, ship and start a second binary, which is
// where every path problem comes from: finding it on PATH, and finding lib/ beside it.
//
// With the body in a routine, the program below is `begin wzmain; end.` and a host can
// include everything above it and call what it needs.
//
// THE halt() CALLS STAY, AND THAT IS DELIBERATE. An error is reported from 234 places
// across 45 mutually recursive routines; threading a return value back through all of them
// is not a refactor but a rewrite of the parser's control flow, and the bootstrap fixed
// point is exactly what would break quietly while that happened. A host that must survive
// a failed compile calls this in a fork: the child may halt, the parent reads its exit
// code. fork, shared descriptors and waiting are all measured -- see
// docs/internals/what-the-system-can-already-do.md.
procedure wzmain;
begin
  // --version before the argument count check: asking a compiler what it is should not
  // require giving it a source file and an output name.
  if argc() = 2 then
  begin
    if argeq(1, "--version") or argeq(1, "-v") then
    begin
      wrs(1, "wantzel ");
      wrs(1, VERSION);
      wrs(1, "\n");
      halt(0);
    end;
  end;
  if argc() < 3 then
  begin
    wrs(2, "wantzel ");
    wrs(2, VERSION);
    wrs(2, " -- a compiler for code that AI writes: strict, dependency-free, extremely fast.\n");
    wrs(2, "Copyright (c) 2026 Floris Knol.  MIT licence.  https://github.com/wantzel/wantzel\n\n");
    wrs(2, "usage: wantzel <source.wz> <executable> [--target=linux|windows]\n");
    wrs(2, "       wantzel --version\n");
    halt(1);
  end;
  if argc() > 4 then
  begin
    wrs(2, "usage: wantzel <source.wz> <executable> [--target=linux|windows]\n");
    halt(1);
  end;
  mi := 0;
  while argch(1, mi) <> chr(0) do
  begin
    if mi >= 1022 then fail("source file name too long");
    pathbuf[mi] := argch(1, mi);
    mi := mi + 1;
  end;
  pathbuf[mi] := chr(0);
  mi := 0;
  while argch(2, mi) <> chr(0) do
  begin
    if mi >= 255 then fail("output file name too long");
    outname[mi] := argch(2, mi);
    mi := mi + 1;
  end;
  outname[mi] := chr(0);
  outnamelen := mi;
  // THE TARGET COMES FROM --target= AND FROM NOWHERE ELSE.
  //
  // A name ending in .exe used to select Windows on its own, which made the output NAME
  // a second and invisible way to choose the target: 'wantzel x.wz backup.exe' handed
  // back a Windows binary nobody asked for. One way per concept, and a hidden second way
  // is the worst kind -- a generator that picks an output name does not know the
  // extension decides anything.
  //
  // A .exe name without --target is REFUSED rather than quietly built for Linux: the two
  // contradict each other, and saying so costs nothing.
  winmode := 0;
  tgiven := false;
  if argc() = 4 then
  begin
    if argeq(3, "--target=windows") or argeq(3, "-twindows") then begin winmode := 1; tgiven := true; end
    else if argeq(3, "--target=linux") or argeq(3, "-tlinux") then begin winmode := 0; tgiven := true; end
    else
    begin
      wrs(2, "wantzel: unknown option (use --target=linux or --target=windows)\n");
      halt(1);
    end;
  end;
  if (not tgiven) and (mi >= 4) then
  begin
    if (outname[mi - 4] = '.') and (lower(ord(outname[mi - 3])) = 101)
       and (lower(ord(outname[mi - 2])) = 120) and (lower(ord(outname[mi - 1])) = 101) then
    begin
      wrs(2, "wantzel: the output name ends in .exe but no target was given; add --target=windows (or --target=linux to build an ELF under that name)\n");
      halt(1);
    end;
  end;
  setlibdir;
  halt(compile);
end;

begin
  wzmain;
end.
